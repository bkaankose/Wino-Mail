<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- PackageVersion entries also pin transitive dependencies, so security fixes can be applied here. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ColorHashSharp" Version="1.1.0" />
    <PackageVersion Include="CommunityToolkit.Common" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.RangeSelector" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.TabbedCommandBar" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.TokenizingTextBox" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Extensions" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.Labs.WinUI.Controls.MarkdownTextBlock" Version="0.1.250926-build.2293" />
    <PackageVersion Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" Version="0.1.250926-build.2293" />
    <PackageVersion Include="EmailValidation" Version="1.4.0" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.0" />
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <PackageVersion Include="IsExternalInit" Version="1.0.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Source generators must not reference a newer Roslyn than the SDK compiler (CS9057). Keep in step with the .NET SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- The desktop relay socket (Wino.PushRelay.Socket); 10.0.13 fixes CVE-2026-70159 in SignalR.Common. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Graph.Core" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.90.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.90.1" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" />
    <PackageVersion Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageVersion Include="Wino.Mail.Contracts" Version="3.0.0-alpha.11" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Wino.Mail.AI.Abstractions" Version="3.0.0-alpha.5" />
    <PackageVersion Include="Wino.Mail.AI.ContentProcessing" Version="3.0.0-alpha.5" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="morelinq" Version="4.4.0" />
    <PackageVersion Include="Nito.AsyncEx" Version="5.1.2" />
    <PackageVersion Include="Nito.AsyncEx.Tasks" Version="5.1.2" />
    <PackageVersion Include="NodaTime" Version="3.3.5" />
    <PackageVersion Include="Sentry.Serilog" Version="6.12.0" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.5" />
    <!-- Transitive via MimeKit; 10.0.13 fixes CVE-2026-84008 and CVE-2026-70162. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.10" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <PackageVersion Include="HtmlKit" Version="1.3.0" />
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="TimePeriodLibrary.NET" Version="2.1.6" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="System.Text.Encodings.Web" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="WinUIEx" Version="2.9.3" />
    <!-- Android (net10.0-android) platform packages -->
    <PackageVersion Include="Xamarin.AndroidX.Browser" Version="1.10.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <!-- Sentry.Bindings.Android 6.12 pins these two below 2.9.3 while current AndroidX needs Lifecycle 2.11; they are
         lifted to the Lifecycle version the rest of the graph uses, as Gradle would (NU1608 remains until Sentry updates). -->
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Common.Java8" Version="2.11.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <!-- androidx.webkit 1.16 and later require minSdk 24; 1.15 is the last release for the API 23 floor. -->
    <PackageVersion Include="Xamarin.AndroidX.WebKit" Version="1.15.0.2" />
    <!-- Pull to synchronize in the mail list (Wino.Mail.Android). -->
    <PackageVersion Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.2.0.3" />
    <!-- Android head (Wino.Mail.Android): single activity, fragments and Material Components. -->
    <PackageVersion Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
    <PackageVersion Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
    <PackageVersion Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />
    <!-- Gmail sign-in through Play services AuthorizationClient (Wino.Platform.Android). play-services-auth 22 requires
         minSdk 24; 21.6.0 is the last release for the API 23 floor. It pulls androidx.fragment 1.9.0 (lifted above). -->
    <PackageVersion Include="Xamarin.GooglePlayServices.Auth" Version="121.6.0.2" />
    <!-- Credential Manager for Wino Account Google sign-in (GetSignInWithGoogleOption with the web serverClientId). -->
    <PackageVersion Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
    <PackageVersion Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
    <PackageVersion Include="Xamarin.Google.Android.Libraries.Identity.GoogleId" Version="1.1.0.16" />
    <!-- Background flush of queued changes (WorkManager) and relay pushes (FCM, compile-only until Firebase is
         registered) in Wino.Platform.Android and the head. Both need minSdk 23 at these versions. -->
    <PackageVersion Include="Xamarin.AndroidX.Work.Runtime" Version="2.11.2.1" />
    <PackageVersion Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <!-- WorkManager 2.11 pins tracing-ktx 1.3 while androidx.fragment 1.9 brings tracing 2.0; lifted like Gradle would. -->
    <PackageVersion Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="2.0.0" />
  </ItemGroup>
</Project>