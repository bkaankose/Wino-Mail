<Project>
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<IsAotCompatible>true</IsAotCompatible>
		<Configurations>Debug;Release</Configurations>
		<WinoIsReleaseBuild Condition="'$(Configuration)' == 'Release'">true</WinoIsReleaseBuild>
	</PropertyGroup>

	<!-- WinoTargetPlatform selects the platform build policy and the shared projects' target frameworks.
	     An explicit value (Windows or MacOS) wins; otherwise the native host decides. Other hosts receive
	     no platform defaults and must pass the platform explicitly. -->
	<PropertyGroup Condition="'$(WinoTargetPlatform)' == ''">
		<WinoTargetPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</WinoTargetPlatform>
		<WinoTargetPlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">MacOS</WinoTargetPlatform>
	</PropertyGroup>

	<Import Project="build/Wino.Windows.props" Condition="'$(WinoTargetPlatform)' == 'Windows'" />
</Project>
