  <ItemGroup>
    <None Include="Assets\AppEntries\CalendarAssets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <None Include="Assets\AppEntries\MailAssets\Square44x44Logo.targetsize-24_altform-unplated.png" />
  </ItemGroup>
  <Import Project="$(WapProjPath)\Microsoft.DesktopBridge.targets" />
  <!--
    WAP indexes manifest resources at $(OutDir)Assets for the generated MSIX,
    while Visual Studio registers $(OutDir)AppX for loose deployment. The WAP
    targets don't mirror those root assets into AppX, leaving the registered
    manifest and PRI pointing at files that are not present. Keep the loose
    deployment layout aligned without declaring duplicate PRI resources.
  -->
  <Target Name="CopyPackageRootAssetsToLooseDeployment" AfterTargets="Build" Condition="Exists('$(OutDir)Assets') and Exists('$(OutDir)AppX')">
    <ItemGroup>
      <_PackageRootAsset Include="$(OutDir)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageRootAsset)" DestinationFiles="@(_PackageRootAsset->'$(OutDir)AppX\Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)AppxManifest.xml" DestinationFiles="$(OutDir)AppX\AppxManifest.xml" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)AppxManifest.xml')" />
    <Copy SourceFiles="$(OutDir)resources.pri" DestinationFiles="$(OutDir)AppX\resources.pri" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)resources.pri')" />
  </Target>
  <Target Name="CopyModernUwpToLooseDeployment" AfterTargets="Build" Condition="Exists('..\Wino.Mail.Uwp\bin\win-$(Platform)\publish') and Exists('$(OutDir)AppX')">
    <ItemGroup>
      <_ModernUwpPublishedFile Include="..\Wino.Mail.Uwp\bin\win-$(Platform)\publish\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ModernUwpPublishedFile)" DestinationFiles="@(_ModernUwpPublishedFile->'$(OutDir)AppX\Wino.Mail.Uwp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
