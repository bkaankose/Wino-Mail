<Page
    x:Class="Wino.Mail.Controls.Playground.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wino.Mail.Controls.Playground"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <NavigationView
        x:Name="Navigation"
        Header="Wino Mail Controls Playground"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        SelectionChanged="NavigationSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                AutomationProperties.AutomationId="AccountIconNavigationItem"
                Content="Account icon"
                Tag="accountIcon">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE046;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Contact picture" Tag="contact">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE008;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="MailListSelectionNavigationItem"
                Content="Mail list selection"
                Tag="mailList">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xF509;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="EditorNavigationItem"
                Content="Compose editor"
                Tag="editor">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xF3DC;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="SearchBarNavigationItem"
                Content="Search bar"
                Tag="searchBar">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xEA7D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="IntelligenceHeaderNavigationItem"
                Content="Intelligence header"
                Icon="Emoji2"
                Tag="intelligenceHeader" />
            <NavigationViewItem
                AutomationProperties.AutomationId="IntelligenceProgressNavigationItem"
                Content="Intelligence progress"
                Tag="intelligenceProgress">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE895;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="SynchronizationButtonNavigationItem"
                Content="Synchronization button"
                Tag="synchronizationButton">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE060;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="HoverActionsNavigationItem"
                Content="Hover actions"
                Tag="hoverActions">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xF509;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="ShimmerNavigationItem"
                Content="Shimmer"
                Tag="shimmer">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE094;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="ContextFlyoutNavigationItem"
                Content="Context flyout"
                Tag="contextFlyout">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE014;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                AutomationProperties.AutomationId="HotKeyInputNavigationItem"
                Content="Hot key input"
                Tag="hotKeyInput">
                <NavigationViewItem.Icon>
                    <accountIcon:WinoFontIcon Glyph="&#xE052;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Frame
                x:Name="ContentFrame"
                AutomationProperties.AutomationId="PlaygroundContentFrame"
                CacheSize="1" />

            <InfoBar
                x:Name="LifetimeStatusInfoBar"
                Title="Control lifetime verification"
                Grid.Row="1"
                Margin="12,0,12,12"
                AutomationProperties.AutomationId="LifetimeStatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="LifetimeStatusText"
                        AutomationProperties.AutomationId="LifetimeStatusText"
                        Text="Navigate to another page to verify that the current page is released."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="RunMemorySweepButton"
                            AutomationProperties.AutomationId="RunMemorySweepButton"
                            Click="RunMemorySweepClicked"
                            Content="Run memory sweep" />
                        <Button
                            x:Name="CancelMemorySweepButton"
                            AutomationProperties.AutomationId="CancelMemorySweepButton"
                            Click="CancelMemorySweepClicked"
                            Content="Cancel"
                            IsEnabled="False" />
                        <TextBlock
                            x:Name="FrameStateText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="LifetimeFrameStateText" />
                    </StackPanel>
                    <Expander Header="Lifetime trace">
                        <ListView
                            x:Name="LifetimeTraceList"
                            MaxHeight="140"
                            AutomationProperties.AutomationId="LifetimeTraceList"
                            ItemsSource="{x:Bind LifetimeTrace, Mode=OneWay}" />
                    </Expander>
                </StackPanel>
            </InfoBar>
        </Grid>
    </NavigationView>
</Page>
