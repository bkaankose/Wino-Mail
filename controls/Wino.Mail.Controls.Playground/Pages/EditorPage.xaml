<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:Wino.Editor">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="3"><TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Compose editor" /><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The production Wino editor is hosted directly, including its format, insert, table, and security command surfaces." /></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="12"><Border Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><StackPanel Spacing="12"><TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Message details" /><TextBox AutomationProperties.AutomationId="ComposeToTextBox" Header="To" Text="design-review@contoso.com" /><TextBox AutomationProperties.AutomationId="ComposeCcTextBox" Header="Cc" PlaceholderText="Add recipients" /><TextBox AutomationProperties.AutomationId="ComposeSubjectTextBox" Header="Subject" Text="Design review follow-up" /></StackPanel></Border><InfoBar IsClosable="False" IsOpen="True" Severity="Informational" Title="Try the editor" Message="Use the toolbar and edit the compose surface directly." /></StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"><editor:WinoMailEditor x:Name="ComposeEditor" AutomationProperties.AutomationId="ComposeEditor" Loaded="ComposeEditor_Loaded" /></Border>
        </Grid>
    </Grid>
</Page>
