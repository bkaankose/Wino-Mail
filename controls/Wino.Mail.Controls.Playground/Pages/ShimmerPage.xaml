<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.ShimmerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shimmer="using:Wino.Mail.Controls.Shimmer"
    AutomationProperties.AutomationId="ShimmerPageRoot"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Shimmer" />
                <TextBlock
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Skeleton placeholders for content that is still loading. A composition highlight sweeps across the block; it stops when IsActive is false and when the Windows animation preference is off, leaving the flat resting fill."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        x:Name="AnimationsToggle"
                        AutomationProperties.AutomationId="ShimmerAnimationsToggle"
                        Header="Sweep"
                        IsOn="True"
                        OffContent="Resting"
                        OnContent="Running"
                        Toggled="AnimationsToggled" />
                    <ToggleSwitch
                        x:Name="ThemeToggle"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ShimmerThemeToggle"
                        Header="Theme"
                        OffContent="Light"
                        OnContent="Dark"
                        Toggled="ThemeToggled" />
                </Grid>
            </Border>

            <Border
                x:Name="SampleSurface"
                Grid.Row="2"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sizes and radii" />

                        <shimmer:WinoShimmer
                            x:Name="WideBar"
                            Grid.Row="1"
                            Height="18"
                            CornerRadius="4" />
                        <shimmer:WinoShimmer
                            x:Name="ShortBar"
                            Grid.Row="2"
                            Width="220"
                            Height="13"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />
                        <shimmer:WinoShimmer
                            x:Name="CircleBlock"
                            Grid.Row="3"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Left"
                            CornerRadius="18" />
                        <shimmer:WinoShimmer
                            x:Name="TallBlock"
                            Grid.Row="4"
                            Height="120"
                            CornerRadius="6" />
                    </Grid>

                    <!--  The reader's own skeleton, so its proportions can be judged at real scale.  -->
                    <Grid
                        x:Name="ShimmerReaderSkeleton"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="ShimmerReaderSkeleton"
                        RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Reading pane skeleton" />

                        <shimmer:WinoShimmer
                            x:Name="ReaderSubjectBar"
                            Grid.Row="1"
                            Height="18"
                            MaxWidth="360"
                            HorizontalAlignment="Left"
                            CornerRadius="4" />

                        <Grid Grid.Row="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <shimmer:WinoShimmer
                                x:Name="ReaderAvatar"
                                Width="36"
                                Height="36"
                                CornerRadius="18" />
                            <Grid
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <shimmer:WinoShimmer
                                    x:Name="ReaderSenderBar"
                                    Width="220"
                                    Height="13"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4" />
                                <shimmer:WinoShimmer
                                    x:Name="ReaderDateBar"
                                    Grid.Row="1"
                                    Width="140"
                                    Height="11"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="3" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <shimmer:WinoShimmer
                                x:Name="ReaderBodyLine1"
                                Height="13"
                                CornerRadius="4" />
                            <shimmer:WinoShimmer
                                x:Name="ReaderBodyLine2"
                                Grid.Row="1"
                                Height="13"
                                CornerRadius="4" />
                            <shimmer:WinoShimmer
                                x:Name="ReaderBodyLine3"
                                Grid.Row="2"
                                Width="380"
                                Height="13"
                                HorizontalAlignment="Left"
                                CornerRadius="4" />
                            <shimmer:WinoShimmer
                                x:Name="ReaderBodyBlock"
                                Grid.Row="3"
                                Height="140"
                                CornerRadius="6" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="3"
                MaxWidth="760"
                HorizontalAlignment="Left"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Turn off animations in Windows (Settings, Accessibility, Visual effects) and reopen this page: every block above must render as a flat fill with no sweep."
                TextWrapping="WrapWholeWords" />
        </Grid>
    </ScrollViewer>
</Page>
