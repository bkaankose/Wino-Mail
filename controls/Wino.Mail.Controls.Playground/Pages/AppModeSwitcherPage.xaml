<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.AppModeSwitcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="820" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="App mode switcher" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="A strip of mutually exclusive modes with a separate settings affordance beside it. Each glyph is an app icon minus its tile; selecting a mode slides an accent tile back under it, so it reads as that app icon again and follows the app's accent colour. Settings sits outside the card because opening it is not the same kind of action as choosing what the window shows. Nothing here uses a storyboard or a visual state."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Both orientations at the widths they actually get: an open navigation pane
                and a collapsed rail. The tile and the gear are only judgeable in context,
                so the surrounding surfaces match the shell rather than the page.
            -->
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Open pane (248px)" />
                    <Border
                        Width="248"
                        Padding="8,8,8,12"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="PaneSwitcher"
                            AutomationProperties.AutomationId="PlaygroundPaneAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem Label="Mail">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="Calendar">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="Contacts">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="To do">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Collapsed rail (48px)" />
                    <Border
                        Width="48"
                        Padding="0,8"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="RailSwitcher"
                            AutomationProperties.AutomationId="PlaygroundRailAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            Orientation="Vertical"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem Label="Mail">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="Calendar">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="Contacts">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                            <appMode:WinoAppModeSwitcherItem Label="To do">
                                <appMode:WinoAppModeSwitcherItem.Icon>
                                    <ImageIcon
                                        Width="30"
                                        Height="30"
                                        Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg" />
                                </appMode:WinoAppModeSwitcherItem.Icon>
                            </appMode:WinoAppModeSwitcherItem>
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="State" />

                <!--  "None" is the state a host uses while settings owns the window.  -->
                <RadioButtons
                    x:Name="SelectionButtons"
                    AutomationProperties.AutomationId="PlaygroundAppModeSelection"
                    Header="Selected index"
                    SelectedIndex="0"
                    SelectionChanged="SelectionChanged">
                    <x:String>0 - Mail</x:String>
                    <x:String>1 - Calendar</x:String>
                    <x:String>2 - Contacts</x:String>
                    <x:String>3 - To do</x:String>
                    <x:String>-1 - None</x:String>
                </RadioButtons>

                <ToggleSwitch
                    x:Name="SettingsSelectedToggle"
                    Header="Is settings selected"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="SettingsVisibleToggle"
                    Header="Is settings visible"
                    IsOn="True"
                    Toggled="StateChanged" />

                <TextBox
                    x:Name="SettingsLabelBox"
                    Header="Settings label"
                    Text="Settings"
                    TextChanged="StateChanged" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
