<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.AppModeSwitcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="980" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="App mode switcher" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="A strip of mutually exclusive destinations, Settings included: every cell shares one sliding tile, so exactly one is ever lit. Each mode glyph is an app icon minus its tile, recoloured at runtime so its blues follow the app accent. In Light every glyph rests on a chip tinted from that same accent, which becomes the selection tile when the mode is picked. Nothing here uses a storyboard or a visual state."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--
                Both orientations at the widths they actually get: an open navigation pane
                and a collapsed rail. The tile and the chips are only judgeable in context,
                so the surrounding surfaces match the shell rather than the page.
            -->
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Open pane (248px)" />
                    <Border
                        x:Name="PaneSurface"
                        Width="248"
                        Padding="8,8,8,12"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="PaneSwitcher"
                            AutomationProperties.AutomationId="PlaygroundPaneAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Mail.svg"
                                Label="Mail" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Calendar.svg"
                                Label="Calendar" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/People.svg"
                                Label="Contacts" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/ToDo.svg"
                                Label="To do" />
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Collapsed rail (48px)" />
                    <Border
                        x:Name="RailSurface"
                        Width="48"
                        Padding="0,8"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="RailSwitcher"
                            AutomationProperties.AutomationId="PlaygroundRailAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            Orientation="Vertical"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Mail.svg"
                                Label="Mail" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Calendar.svg"
                                Label="Calendar" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/People.svg"
                                Label="Contacts" />
                            <appMode:WinoAppModeSwitcherItem
                                GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/ToDo.svg"
                                Label="To do" />
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Accent" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Mutates SystemAccentColor the way the theme service does, then tells the control to look again. The glyph blues and the Light resting chip both follow; the chip keeps the same weight whichever accent is chosen, so only its hue moves."
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="AccentSwatches"
                    Orientation="Horizontal"
                    Spacing="8" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="State" />

                <ComboBox
                    x:Name="SurfaceThemeBox"
                    Width="220"
                    Header="Surface theme"
                    SelectedIndex="0"
                    SelectionChanged="SurfaceThemeChanged">
                    <ComboBoxItem Content="Inherit" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>

                <!--  "None" is the state a host uses while some other surface owns the window.  -->
                <RadioButtons
                    x:Name="SelectionButtons"
                    AutomationProperties.AutomationId="PlaygroundAppModeSelection"
                    Header="Selected index"
                    SelectedIndex="0"
                    SelectionChanged="SelectionChanged">
                    <x:String>0 - Mail</x:String>
                    <x:String>1 - Calendar</x:String>
                    <x:String>2 - Contacts</x:String>
                    <x:String>3 - To do</x:String>
                    <x:String>-1 - None</x:String>
                </RadioButtons>

                <ToggleSwitch
                    x:Name="MonochromeToggle"
                    Header="Monochrome"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="SettingsSelectedToggle"
                    Header="Is settings selected"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="SettingsVisibleToggle"
                    Header="Is settings visible"
                    IsOn="True"
                    Toggled="StateChanged" />

                <TextBox
                    x:Name="SettingsLabelBox"
                    Header="Settings label"
                    Text="Settings"
                    TextChanged="StateChanged" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
