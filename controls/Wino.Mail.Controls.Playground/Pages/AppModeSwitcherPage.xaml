<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.AppModeSwitcherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="PageLoaded"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="980" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="App mode switcher" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="A strip of mutually exclusive destinations, Settings included: every cell shares one sliding tile, so exactly one is ever lit. Each mode glyph is an app icon minus its tile, taken from {ThemeResource AppIconMail} and friends: the theme dictionary picks the Light or Dark artwork, and the control recolours its blues to follow the app accent. Nothing here uses a storyboard or a visual state."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  These samples keep the page-local surface setting visible. The footer copy is
                  the same control hosted by the playground NavigationView, like the real app.  -->
            <StackPanel Orientation="Horizontal" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Open pane (248px)" />
                    <Border
                        x:Name="PaneSurface"
                        Width="248"
                        Padding="8,8,8,12"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="PaneSwitcher"
                            AutomationProperties.AutomationId="PlaygroundPaneAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconMail}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Mail.svg"
                                Label="Mail" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconCalendar}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Calendar.svg"
                                Label="Calendar" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconPeople}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/People.svg"
                                Label="Contacts" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconToDo}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/ToDo.svg"
                                Label="To do" />
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Collapsed rail (48px)" />
                    <Border
                        x:Name="RailSurface"
                        Width="48"
                        Padding="0,8"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <appMode:WinoAppModeSwitcher
                            x:Name="RailSwitcher"
                            AutomationProperties.AutomationId="PlaygroundRailAppModeSwitcher"
                            ModeInvoked="SwitcherModeInvoked"
                            Orientation="Vertical"
                            SettingsInvoked="SwitcherSettingsInvoked"
                            SettingsLabel="Settings">
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconMail}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Mail.svg"
                                Label="Mail" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconCalendar}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Calendar.svg"
                                Label="Calendar" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconPeople}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/People.svg"
                                Label="Contacts" />
                            <appMode:WinoAppModeSwitcherItem
                                Glyph="{ThemeResource AppIconToDo}"
                                MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/ToDo.svg"
                                Label="To do" />
                        </appMode:WinoAppModeSwitcher>
                    </Border>
                </StackPanel>
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="The live footer switcher is hosted by the navigation pane. Its monochrome artwork follows the State setting below along with these samples."
                TextWrapping="Wrap" />

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Accent" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="Mutates SystemAccentColor the way the theme service does, then tells the control to look again. The glyph blues follow, keylines included; the selection tile does not, because it is a plain theme brush."
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="AccentSwatches"
                    Orientation="Horizontal"
                    Spacing="8" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="State" />

                <ComboBox
                    x:Name="SurfaceThemeBox"
                    Width="220"
                    Header="Surface theme"
                    SelectedIndex="0"
                    SelectionChanged="SurfaceThemeChanged">
                    <ComboBoxItem Content="Inherit" Tag="Default" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>

                <!--  "None" is the state a host uses while some other surface owns the window.  -->
                <RadioButtons
                    x:Name="SelectionButtons"
                    AutomationProperties.AutomationId="PlaygroundAppModeSelection"
                    Header="Selected index"
                    SelectedIndex="0"
                    SelectionChanged="SelectionChanged">
                    <x:String>0 - Mail</x:String>
                    <x:String>1 - Calendar</x:String>
                    <x:String>2 - Contacts</x:String>
                    <x:String>3 - To do</x:String>
                    <x:String>-1 - None</x:String>
                </RadioButtons>

                <ToggleSwitch
                    x:Name="MonochromeToggle"
                    Header="Monochrome"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="SettingsSelectedToggle"
                    Header="Is settings selected"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="SettingsVisibleToggle"
                    Header="Is settings visible"
                    IsOn="True"
                    Toggled="StateChanged" />

                <TextBox
                    x:Name="SettingsLabelBox"
                    Header="Settings label"
                    Text="Settings"
                    TextChanged="StateChanged" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
