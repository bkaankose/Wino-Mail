<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.SynchronizationButtonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:syncButton="using:Wino.Mail.Controls.SynchronizationButton"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="820" Spacing="20">

            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Synchronization button" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="Title bar button that reports whatever the active shell mode is synchronizing. Idle it is a plain icon button; while synchronizing it swaps the glyph for a progress ring and expands to show its description."
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Live control over a title bar coloured surface.  -->
            <Border
                Padding="8,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel
                    HorizontalAlignment="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <syncButton:WinoSynchronizationButton
                        x:Name="LiveButton"
                        AutomationProperties.AutomationId="PlaygroundSynchronizationButton"
                        Click="LiveButtonClicked"
                        Description="Syncing Inbox"
                        IdleToolTip="Synchronize mail" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Wino Mail" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="State" />

                <ToggleSwitch
                    x:Name="SynchronizingToggle"
                    Header="Is synchronizing"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="IndeterminateToggle"
                    Header="Is indeterminate"
                    IsOn="True"
                    Toggled="StateChanged" />

                <ToggleSwitch
                    x:Name="EnabledToggle"
                    Header="Is enabled"
                    IsOn="True"
                    Toggled="StateChanged" />

                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Progress" />
                    <Slider
                        x:Name="ProgressSlider"
                        AutomationProperties.Name="Synchronization progress"
                        Maximum="100"
                        Minimum="0"
                        ValueChanged="ProgressChanged"
                        Value="42" />
                </StackPanel>

                <TextBox
                    x:Name="DescriptionBox"
                    Header="Description"
                    Text="Syncing Inbox"
                    TextChanged="StateChanged" />

                <TextBox
                    x:Name="ToolTipBox"
                    Header="Idle tooltip"
                    Text="Synchronize mail"
                    TextChanged="StateChanged" />

                <Button
                    AutomationProperties.AutomationId="PlaygroundRunFakeSyncButton"
                    Click="RunFakeSynchronizationClicked"
                    Content="Run a fake determinate synchronization" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Every state" />
                <Border
                    Padding="8,6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <syncButton:WinoSynchronizationButton IdleToolTip="Idle" />
                        <syncButton:WinoSynchronizationButton
                            Description="Syncing Inbox"
                            IsIndeterminate="False"
                            IsSynchronizing="True"
                            Progress="42" />
                        <syncButton:WinoSynchronizationButton
                            Description="Syncing calendars"
                            IsIndeterminate="True"
                            IsSynchronizing="True" />
                        <syncButton:WinoSynchronizationButton IdleToolTip="Disabled" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
