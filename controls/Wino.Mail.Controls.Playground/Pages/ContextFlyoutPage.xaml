<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.ContextFlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="32"
            HorizontalAlignment="Left"
            Spacing="20">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Context flyout" />
            <TextBlock
                MaxWidth="640"
                Text="Right-click the card or use the button. Menus are plain .NET definitions built in code-behind. The card opts into root search and header commands; the button enables search only after entering a submenu."
                TextWrapping="Wrap" />

            <Border
                Padding="24"
                AutomationProperties.AutomationId="ContextFlyoutPlaygroundTarget"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Border.ContextFlyout>
                    <contextFlyout:WinoContextFlyout
                        x:Name="CardContextFlyout"
                        HeaderItemsSource="{x:Bind HeaderItems, Mode=OneTime}"
                        IsSearchEnabled="True"
                        ItemsSource="{x:Bind CardItems, Mode=OneTime}" />
                </Border.ContextFlyout>
                <TextBlock Text="Right-click this card" />
            </Border>

            <Button AutomationProperties.AutomationId="BoundContextFlyoutButton" Content="Bound items">
                <Button.Flyout>
                    <contextFlyout:WinoContextFlyout x:Name="BoundContextFlyout" ItemsSource="{x:Bind BoundItems, Mode=OneTime}" />
                </Button.Flyout>
            </Button>

            <TextBlock
                x:Name="StatusTextBlock"
                AutomationProperties.AutomationId="ContextFlyoutPlaygroundStatus"
                Text="No command invoked." />
        </StackPanel>
    </ScrollViewer>
</Page>
