<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>Wino.Mail.Controls</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      WMC1510: a ResourceDictionary has no x:Class, so DataTemplates in Themes/Generic.xaml cannot
      use x:DataType/x:Bind and must bind by property path. The compiler cannot prove those paths
      survive trimming. They do: every type bound this way is marked [GeneratedBindableCustomProperty].
      Keep that invariant when adding templates here, or this suppression stops being true.
    -->
    <NoWarn>$(NoWarn);WMC1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" />
    <!--
      Keep WinUI's transitive SDK tooling aligned with the app project.
      Otherwise solution builds can load an older task assembly from this
      project before importing newer MSIX targets from Wino.Mail.WinUI.
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Mail.Controls.Core\Wino.Mail.Controls.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WinoIcons.ttf"
             TargetPath="Assets\WinoIcons.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <!--
      The app mode glyphs: each app icon with its tile removed, one set per surface. Light and
      Dark are paired by Themes\WinoAppIcons.xaml; Mono is the monochrome switcher's own set.
    -->
    <Content Include="Assets\AppModes\**\*.svg" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Wino.Mail.Controls.Tests" />
  </ItemGroup>
</Project>
