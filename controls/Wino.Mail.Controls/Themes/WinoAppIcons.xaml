<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The four app mode icons: each app icon with its tile removed, as an ImageSource that can
        be dropped straight onto an ImageIcon or an ImageIconSource.

            <ImageIcon Source="{ThemeResource AppIconMail}" />

        There is one asset per theme rather than one asset recoloured per surface. An SVG cannot
        reference a theme resource - Direct2D rasterises it from a file, long after XAML has
        resolved anything - so the choice has to be made outside the artwork, and making it here
        means it is made by the theme dictionary rather than by every control that shows an icon.

        The variants differ only in the paper regions: the Light set carries an accent keyline
        where a white region would otherwise meet a white card. Everything else - shapes,
        proportions, blues - is identical, so the two are the same icon and not two designs.

        HighContrast takes the Light set. The keyline is what gives these shapes an edge when
        the system palette owns the surfaces around them, and it is wanted whichever high
        contrast theme is running.

        WinoAppModeSwitcher takes the UriSource back off these and recolours the markup so the
        blues follow SystemAccentColor. Anything else uses them as they are, in the real Wino
        blues. Keep them SvgImageSource with a UriSource for that reason: a stream-loaded source
        has no Uri to recover, and cannot re-rasterise itself when the display scale changes.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SvgImageSource x:Key="AppIconMail" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/Mail.svg" />
            <SvgImageSource x:Key="AppIconCalendar" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/Calendar.svg" />
            <SvgImageSource x:Key="AppIconPeople" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/People.svg" />
            <SvgImageSource x:Key="AppIconToDo" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/ToDo.svg" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SvgImageSource x:Key="AppIconMail" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Dark/Mail.svg" />
            <SvgImageSource x:Key="AppIconCalendar" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Dark/Calendar.svg" />
            <SvgImageSource x:Key="AppIconPeople" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Dark/People.svg" />
            <SvgImageSource x:Key="AppIconToDo" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Dark/ToDo.svg" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SvgImageSource x:Key="AppIconMail" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/Mail.svg" />
            <SvgImageSource x:Key="AppIconCalendar" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/Calendar.svg" />
            <SvgImageSource x:Key="AppIconPeople" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/People.svg" />
            <SvgImageSource x:Key="AppIconToDo" UriSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Light/ToDo.svg" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
