<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout"
    xmlns:intelligence="using:Wino.Mail.Controls.IntelligenceHeader"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:intelligenceTiles="using:Wino.Mail.Controls.IntelligenceTileBar"
    xmlns:local="using:Wino.Mail.Controls.SearchBar"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:shimmer="using:Wino.Mail.Controls.Shimmer"
    xmlns:syncButton="using:Wino.Mail.Controls.SynchronizationButton"
    xmlns:winoPrimitives="using:Wino.Mail.Controls.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Wino.Mail.Controls/Themes/WinoIntelligenceBranding.xaml" />
        <ResourceDictionary Source="ms-appx:///Wino.Mail.Controls/IntelligenceProgressRing/WinoIntelligenceProgressRing.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemFillColorAttentionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!--  The skeleton is a resting surface, so the sweep only has to read a shade brighter than the block it crosses.  -->
            <SolidColorBrush x:Key="WinoShimmerBaseBrush" Color="#14000000" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="#59FFFFFF" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="WinoSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--
                Light theme puts a near-white field on a near-white surface, so unlike dark it needs a
                resting hairline to read as a search box at all - the same call the Settings app makes.
                Focus keeps that hairline and thickens the bottom edge on top of it.
            -->
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="WinoSearchBarSemanticBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSearchBarSemanticBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--
                The selection tile. Deliberately far lighter than a control fill: this strip is
                on screen for the whole session, so the tile only has to be findable, not
                emphatic. Anything heavier reads as a pressed button and wears on the eye.
            -->
            <!--
                The tile is a tint rather than a fill now, so the glyph on it stays the
                ordinary primary text colour instead of inverting to white against it.
            -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemFillColorAttentionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <SolidColorBrush x:Key="WinoShimmerBaseBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="#1FFFFFFF" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="WinoSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--  Dark keeps the field borderless at rest: the fill alone separates it from the surface.  -->
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">0</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">0,0,0,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="WinoSearchBarSemanticBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSearchBarSemanticBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A touch more than Light takes: the same weight of ink reads lighter on a dark card.  -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WinoIntelligenceIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="WinoShimmerBaseBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="Transparent" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="WinoSearchBarSemanticBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarSemanticBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <!--  High contrast has no low-alpha tints, so the selected glyph sits on the highlight fill and must invert with it.  -->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <StaticResource x:Key="WinoIntelligenceIconBrush" ResourceKey="WinoIntelligenceBrandIconBrush" />
    <StaticResource x:Key="WinoSearchBarIntelligenceIconBrush" ResourceKey="WinoIntelligenceBrandIconBrush" />
    <StaticResource x:Key="WinoIntelligenceSparklePathData" ResourceKey="WinoIntelligenceBrandSparklePathData" />

    <DataTemplate x:Key="WinoSearchBarHistoryItemTemplate">
        <Grid
            MinHeight="36"
            Padding="8,4"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoSearchBarFilterButtonStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  Reuses the search bar gradient so every intelligence affordance shares one identity.  -->
    <StaticResource x:Key="WinoIntelligenceHeaderSparkleBrush" ResourceKey="WinoSearchBarIntelligenceIconBrush" />

    <Style
        x:Key="WinoIntelligenceHeaderTriggerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        A ResourceDictionary has no x:Class, so x:DataType (and therefore x:Bind) is unavailable here
        and these paths must use Binding. Trimming stays safe because WinoIntelligenceReply is marked
        [GeneratedBindableCustomProperty], which preserves these properties for AOT. See the
        WMC1510 NoWarn in Wino.Mail.Controls.csproj.
    -->
    <DataTemplate x:Key="WinoIntelligenceHeaderReplyItemTemplate">
        <StackPanel Padding="10,7" Spacing="3">
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                Text="{Binding Tone}" />
            <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WinoIntelligenceHeaderSimilarItemTemplate">
        <Grid
            MinHeight="54"
            Padding="8,6"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Subject}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Meta}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding ScoreText}" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoIntelligenceChipButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,5,13,5" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Cancel sits inside the chip so a request is aborted where it was started. A Button nested in a
        Button is fine: the inner one handles the pointer, so the outer Click never fires.
    -->
    <Style
        x:Key="WinoIntelligenceChipCancelButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WinoIntelligencePanelIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="WinoSearchBarContactSuggestionTemplate">
        <Grid
            MinHeight="48"
            Padding="7,4"
            ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="28"
                Height="28"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Address}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        The field is a Border wrapping a chrome-less AutoSuggestBox. The text box keeps its own
        template but every border and background theme resource is overridden to transparent in its
        Resources scope, so the Border alone paints the field. The FieldStates visual states in the
        template paint that Border for focus and for the semantic ("Meaning") state.
    -->
    <Style
        x:Key="WinoSearchBarFieldTextBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Sized to sit inside a 32px field. The border stays transparent in every state, checked
        included: the field itself carries the semantic highlight, so outlining the pill as well
        states it twice.
    -->
    <Style
        x:Key="WinoSearchBarMeaningToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0,9,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
        x:Key="WinoSearchBarInlineIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="local:WinoSearchBar">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WinoSearchBar">
                    <Grid x:Name="PART_LayoutRoot">
                        <!--
                            TextControlThemeMinHeight (32px) is the stock AutoSuggestBox height. The bar
                            has to match it so it drops into the app TitleBar without growing the row.
                            A 16px radius gives the field the fully rounded Windows Settings search shape;
                            everything inside is sized to fit within that.
                        -->
                        <Border
                            x:Name="PART_FieldBorder"
                            Height="{ThemeResource TextControlThemeMinHeight}"
                            Padding="9,0,2,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource WinoSearchBarFieldBackgroundBrush}"
                            BorderBrush="{ThemeResource WinoSearchBarFieldBorderBrush}"
                            BorderThickness="{ThemeResource WinoSearchBarFieldBorderThickness}"
                            CornerRadius="16">
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    The query icon leads the field the way Windows Settings does. It is
                                    decoration, not a button: submitting is Enter, so the icon is hit-test
                                    invisible and its right margin is what keeps the caret clear of it.
                                -->
                                <ContentPresenter
                                    x:Name="PART_QueryIconPresenter"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    IsHitTestVisible="False" />

                                <AutoSuggestBox
                                    x:Name="PART_AutoSuggestBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoSearchBarInput"
                                    AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                    TextBoxStyle="{StaticResource WinoSearchBarFieldTextBoxStyle}">
                                    <!--
                                        Theme resources resolve up the tree from the templated parent, so
                                        overriding them here strips the inner field's chrome without
                                        re-templating TextBox. TextControlBorderThemeThicknessFocused is the
                                        one that matters: without it the focused state paints a 2px underline
                                        inside our Border.
                                    -->
                                    <AutoSuggestBox.Resources>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                    </AutoSuggestBox.Resources>
                                </AutoSuggestBox>

                                <!--
                                    Meaning is a modifier on the single search action, not a second submit
                                    button. Its checked state is what tells the user which kind of query
                                    Enter will run, so it carries a label and not just the sparkle.
                                -->
                                <ToggleButton
                                    x:Name="PART_MeaningToggleButton"
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="WinoSearchBarMeaningToggle"
                                    AutomationProperties.Name="{TemplateBinding MeaningToggleText}"
                                    Style="{StaticResource WinoSearchBarMeaningToggleStyle}">
                                    <ToggleButton.Resources>
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                    </ToggleButton.Resources>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Grid
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center">
                                            <Viewbox x:Name="PART_MeaningSparkle" Stretch="Uniform">
                                                <PathIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Data="{StaticResource WinoIntelligenceBrandSparklePathData}"
                                                    Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                                            </Viewbox>
                                            <intelligenceProgress:WinoIntelligenceProgressRing
                                                x:Name="PART_SemanticBusyRing"
                                                Animation="Dots"
                                                AutomationProperties.AccessibilityView="Raw"
                                                AutomationProperties.AutomationId="WinoSearchBarSemanticBusyRing"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="PART_MeaningToggleLabel"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{TemplateBinding MeaningToggleText}" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!--
                            Compact mode: the whole field collapses to this single icon, and the field
                            itself is re-parented into the popup below it. One AutoSuggestBox serves both
                            layouts, so text, focus and suggestions survive a window resize.
                        -->
                        <Button
                            x:Name="PART_CompactButton"
                            Width="32"
                            Height="32"
                            MinWidth="32"
                            MinHeight="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WinoSearchBarCompactButton"
                            AutomationProperties.Name="{TemplateBinding SearchButtonText}"
                            Style="{StaticResource WinoSearchBarInlineIconButtonStyle}"
                            ToolTipService.ToolTip="{TemplateBinding SearchButtonText}"
                            Visibility="Collapsed">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE721;" />
                        </Button>

                        <Button
                            x:Name="PART_SearchOptionsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WinoSearchBarOptionsButton"
                            AutomationProperties.Name="{TemplateBinding SearchOptionsText}"
                            Style="{StaticResource WinoSearchBarInlineIconButtonStyle}"
                            ToolTipService.ToolTip="{TemplateBinding SearchOptionsText}"
                            Visibility="Collapsed">
                            <FontIcon
                                x:Name="PART_SearchOptionsChevronIcon"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </Button>

                        <Popup
                            x:Name="PART_SearchPopup"
                            IsLightDismissEnabled="False"
                            ShouldConstrainToRootBounds="True">
                            <Border
                                x:Name="PART_SearchPopupRoot"
                                Padding="12"
                                Background="{ThemeResource WinoSearchBarPopupBackgroundBrush}"
                                BackgroundSizing="InnerBorderEdge"
                                BorderBrush="{ThemeResource WinoSearchBarPopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}"
                                Translation="0,0,32">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>

                                <Grid>
                                    <ContentControl
                                        x:Name="PART_CompactFieldHost"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        IsTabStop="False"
                                        Visibility="Collapsed" />

                                    <StackPanel x:Name="PART_HistoryPanel" Spacing="4">
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PART_HistoryHeadingText"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{TemplateBinding RecentSearchesText}" />
                                            <Button
                                                x:Name="PART_ClearHistoryButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="WinoSearchBarClearHistoryButton"
                                                Content="{TemplateBinding ClearHistoryText}"
                                                Style="{StaticResource TextBlockButtonStyle}" />
                                        </Grid>
                                        <ListView
                                            x:Name="PART_HistoryList"
                                            MaxHeight="280"
                                            AutomationProperties.AutomationId="WinoSearchBarHistoryList"
                                            IsItemClickEnabled="True"
                                            ItemTemplate="{StaticResource WinoSearchBarHistoryItemTemplate}"
                                            SelectionMode="None" />
                                        <!--
                                            Only reachable when the list empties while the popup is open;
                                            focus no longer opens an empty popup.
                                        -->
                                        <TextBlock
                                            x:Name="PART_EmptyHistoryText"
                                            Margin="8,10,8,14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{TemplateBinding EmptyHistoryText}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PART_OptionsPanel"
                                        Spacing="12"
                                        Visibility="Collapsed">
                                        <Border
                                            x:Name="PART_SemanticExplanationPanel"
                                            Padding="10,8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Top"
                                                    Stretch="Uniform">
                                                    <PathIcon Data="{StaticResource WinoIntelligenceBrandSparklePathData}" Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                                                </Viewbox>
                                                <TextBlock
                                                    x:Name="PART_SemanticExplanationTextBlock"
                                                    Grid.Column="1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{TemplateBinding SemanticSearchExplanationText}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </Border>

                                        <StackPanel x:Name="PART_MailOptionsPanel" Spacing="12">
                                            <Grid ColumnSpacing="12" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding ScopeLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_ScopeComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarScopeComboBox"
                                                        AutomationProperties.Name="{TemplateBinding ScopeLabelText}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding ReachLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_ReachComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarReachComboBox"
                                                        AutomationProperties.Name="{TemplateBinding ReachLabelText}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!--
                                                    From resolves against the contact index. The token replaces
                                                    the suggest box once a contact is chosen, so the row keeps a
                                                    single height either way.
                                                -->
                                                <StackPanel Grid.Row="1" Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding SenderLabelText}" />
                                                    <Grid MinHeight="32">
                                                        <AutoSuggestBox
                                                            x:Name="PART_SenderSuggestBox"
                                                            HorizontalAlignment="Stretch"
                                                            AutomationProperties.AutomationId="WinoSearchBarSenderSuggestBox"
                                                            AutomationProperties.Name="{TemplateBinding SenderLabelText}"
                                                            ItemTemplate="{StaticResource WinoSearchBarContactSuggestionTemplate}"
                                                            PlaceholderText="{TemplateBinding SenderPlaceholderText}" />
                                                        <Border
                                                            x:Name="PART_SenderToken"
                                                            Padding="3,3,3,3"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            Visibility="Collapsed">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    Width="24"
                                                                    Height="24"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="12">
                                                                    <TextBlock
                                                                        x:Name="PART_SenderTokenInitials"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10" />
                                                                </Border>
                                                                <TextBlock
                                                                    x:Name="PART_SenderTokenName"
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Button
                                                                    x:Name="PART_SenderTokenRemoveButton"
                                                                    Grid.Column="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Padding="0"
                                                                    AutomationProperties.AutomationId="WinoSearchBarSenderTokenRemoveButton"
                                                                    AutomationProperties.Name="{TemplateBinding RemoveSenderText}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="12">
                                                                    <FontIcon
                                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                        FontSize="10"
                                                                        Glyph="&#xE711;" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding DateLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_DateComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarDateComboBox"
                                                        AutomationProperties.Name="{TemplateBinding DateLabelText}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton
                                                    x:Name="PART_AttachmentsButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarAttachmentsButton"
                                                    Content="{TemplateBinding AttachmentsFilterText}"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                                <ToggleButton
                                                    x:Name="PART_UnreadButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarUnreadButton"
                                                    Content="{TemplateBinding UnreadFilterText}"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                                <ToggleButton
                                                    x:Name="PART_FlaggedButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarFlaggedButton"
                                                    Content="{TemplateBinding FlaggedFilterText}"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="PART_ResetButton"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="WinoSearchBarResetButton"
                                                Content="{TemplateBinding ResetText}" />
                                            <Button
                                                x:Name="PART_PanelSearchButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="WinoSearchBarPanelSearchButton"
                                                Content="{TemplateBinding SearchButtonText}"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>

                        <!--
                            The control only names the state it is in; every property that state
                            implies is set here. Field chrome is one group of three mutually
                            exclusive states rather than separate focus and semantic groups: two
                            groups writing the same three properties would make the winner depend on
                            which GoToState ran last, and Meaning has to win over focus.
                        -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FieldStates">
                                <VisualState x:Name="FieldRest" />
                                <VisualState x:Name="FieldFocused">
                                    <VisualState.Setters>
                                        <!--  A focused Fluent text field thickens its bottom edge; here that edge is the whole border.  -->
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource WinoSearchBarFieldFocusedBackgroundBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderBrush" Value="{ThemeResource WinoSearchBarFieldFocusedBorderBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderThickness" Value="{ThemeResource WinoSearchBarFieldFocusedBorderThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="FieldMeaning">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource WinoSearchBarSemanticBackgroundBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderBrush" Value="{ThemeResource WinoSearchBarSemanticBorderBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="LayoutStates">
                                <VisualState x:Name="WideLayout" />
                                <VisualState x:Name="CompactLayout">
                                    <VisualState.Setters>
                                        <Setter Target="PART_CompactButton.Visibility" Value="Visible" />
                                        <Setter Target="PART_CompactFieldHost.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ModeStates">
                                <VisualState x:Name="MailMode" />
                                <VisualState x:Name="SettingsMode">
                                    <VisualState.Setters>
                                        <Setter Target="PART_MailOptionsPanel.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="MeaningToggleStates">
                                <VisualState x:Name="MeaningToggleVisible" />
                                <VisualState x:Name="MeaningToggleCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="PART_MeaningToggleButton.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SemanticBusyStates">
                                <VisualState x:Name="SemanticIdle" />
                                <VisualState x:Name="SemanticBusy">
                                    <VisualState.Setters>
                                        <Setter Target="PART_MeaningSparkle.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_SemanticBusyRing.Visibility" Value="Visible" />
                                        <Setter Target="PART_SemanticBusyRing.IsActive" Value="True" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SemanticExplanationStates">
                                <VisualState x:Name="SemanticExplanationHidden" />
                                <VisualState x:Name="SemanticExplanationVisible">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SemanticExplanationPanel.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="SenderStates">
                                <VisualState x:Name="NoSenderSelected" />
                                <VisualState x:Name="SenderSelected">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SenderToken.Visibility" Value="Visible" />
                                        <Setter Target="PART_SenderSuggestBox.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="HistoryStates">
                                <VisualState x:Name="HasHistory" />
                                <VisualState x:Name="NoHistory">
                                    <VisualState.Setters>
                                        <Setter Target="PART_HistoryList.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ClearHistoryButton.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_EmptyHistoryText.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="intelligence:WinoIntelligenceHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="intelligence:WinoIntelligenceHeader">
                    <Grid
                        x:Name="PART_LayoutRoot"
                        Background="{ThemeResource WinoIntelligenceHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource WinoIntelligenceHeaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid.Resources>
                            <!--
                                Hosts may define an app-wide implicit StackPanel style carrying an
                                EntranceThemeTransition. Implicit-style lookup walks up to
                                Application.Resources, so it would otherwise slide every panel of this
                                header in from the top each time the header is shown or expanded.
                            -->
                            <Style TargetType="StackPanel">
                                <Setter Property="ChildrenTransitions" Value="{x:Null}" />
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PART_HeaderToggleButton"
                                MinHeight="40"
                                Padding="10,5"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoIntelligenceHeaderToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                                <!--
                                    Everything the collapsed header shows lives on this one row: title,
                                    the optional briefing fact text, and whichever status text applies.
                                -->
                                <Grid x:Name="PART_HeaderContentRoot" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource WinoIntelligenceBrandSparklePathData}"
                                        Foreground="{StaticResource WinoIntelligenceHeaderSparkleBrush}" />
                                    <TextBlock
                                        x:Name="PART_TitleTextBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="PART_BriefingFactTextBlock"
                                        Grid.Column="2"
                                        MaxWidth="360"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                    <!--  Subtitle and processing status are mutually exclusive, so they share this cell.  -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PART_SubtitleTextBlock"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="11"
                                            Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            x:Name="PART_ProcessingStatusPanel"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="Collapsed">
                                            <intelligenceProgress:WinoIntelligenceProgressRing
                                                x:Name="PART_ProcessingProgressRing"
                                                Width="12"
                                                Height="12"
                                                Animation="Dots"
                                                AutomationProperties.AccessibilityView="Raw"
                                                IsActive="False" />
                                            <TextBlock
                                                x:Name="PART_ProcessingStatusTextBlock"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <FontIcon
                                        x:Name="PART_ChevronIcon"
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="10"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        Glyph="&#xE70D;" />
                                </Grid>
                            </Button>
                            <StackPanel
                                Grid.Column="1"
                                Margin="6,4,6,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    x:Name="PART_ProcessButton"
                                    Padding="9,3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderProcessButton"
                                    Content="{TemplateBinding ProcessButtonText}"
                                    CornerRadius="4"
                                    FontSize="11"
                                    Visibility="Collapsed" />
                                <HyperlinkButton
                                    x:Name="PART_CopyCodeButton"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderCopyCodeButton"
                                    Content="{TemplateBinding CopyCodeText}"
                                    FontSize="11"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="PART_BodyRoot"
                            Grid.Row="1"
                            Padding="12"
                            BorderBrush="{ThemeResource WinoIntelligenceHeaderSeparatorBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <intelligenceTiles:WinoMailIntelligenceTileBar AutomationProperties.AutomationId="WinoIntelligenceHeaderTileBar" Items="{TemplateBinding IntelligenceTiles}" />
                                <StackPanel x:Name="PART_FactsPanel" Spacing="6">
                                    <Border
                                        x:Name="PART_DeadlineFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderDeadlinePillForegroundBrush}"
                                                Glyph="&#xE823;" />
                                            <TextBlock
                                                x:Name="PART_DeadlineFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="PART_AddToCalendarButton"
                                                Grid.Column="2"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderAddToCalendarButton"
                                                Content="{TemplateBinding AddToCalendarButtonText}"
                                                Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="PART_NeedsReplyFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderNeedsReplyPillForegroundBrush}"
                                                Glyph="&#xE97A;" />
                                            <TextBlock
                                                x:Name="PART_NeedsReplyFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border
                                    x:Name="PART_InsightsLockedPanel"
                                    Padding="10,8"
                                    Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PART_InsightsLockedTextBlock"
                                        FontSize="12"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </Border>

                                <!--
                                    The action rail. Every chip has the same internal shape:
                                    [icon][label][result dot][hint]. Progress and cancel live in the
                                    feature's detail panel, so a chip never changes size while it runs.
                                    
                                    The rail wraps instead of using a fixed 2x2 grid. Chips are sized to their
                                    own content and a hidden chip releases its slot, so the rail stays a
                                    single tidy run of buttons however many features are available, and only
                                    spills onto a second line when the reading pane is too narrow for them.
                                -->
                                <winoPrimitives:WinoWrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button
                                        x:Name="PART_SummaryChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummarizeButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="SummaryChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE8A5;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SummaryChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_SummaryResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_SummaryChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_RepliesChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderDraftRepliesButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="RepliesChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE97A;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_RepliesChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_RepliesResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_RepliesChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
