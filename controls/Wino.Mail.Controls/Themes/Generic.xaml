                                            <Grid
                                                x:Name="PART_RepliesWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_RepliesWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Rewrite"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_RepliesCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <ListView
                                                x:Name="PART_SuggestedRepliesList"
                                                MaxHeight="240"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderSuggestedRepliesList"
                                                IsItemClickEnabled="True"
                                                ItemTemplate="{StaticResource WinoIntelligenceHeaderReplyItemTemplate}"
                                                SelectionMode="None"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <!--  Keep configuration, progress, and result on one compact horizontal rail.  -->
                                    <Border
                                        x:Name="PART_TranslatePanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding TranslatePanelHeadingText}" />
                                                <Button
                                                    x:Name="PART_TranslateCloseButton"
                                                    Grid.Column="1"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateCloseButton"
                                                    AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                    Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                    <FontIcon
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>

                                            <StackPanel
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <ComboBox
                                                    x:Name="PART_TranslationSourceComboBox"
                                                    MinWidth="140"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslationSource">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                    Glyph="&#xE72A;" />
                                                <ComboBox
                                                    x:Name="PART_TranslationTargetComboBox"
                                                    MinWidth="140"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslationTarget">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button
                                                    x:Name="PART_TranslationRunButton"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateButton"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <StackPanel
                                                    x:Name="PART_TranslationWaitingPanel"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="Collapsed">
                                                    <intelligenceProgress:WinoIntelligenceProgressRing
                                                        x:Name="PART_TranslationWaitingRing"
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Animation="Translate"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        IsActive="False" />
                                                    <TextBlock
                                                        x:Name="PART_TranslationBusyTextBlock"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <Button
                                                        x:Name="PART_TranslateCancelButton"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateCancelButton"
                                                        Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="PART_TranslationAppliedPanel"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="Collapsed">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        x:Name="PART_TranslationStatusTextBlock"
                                                        MaxWidth="180"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="PART_SimilarPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SimilarMailHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_SimilarRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SimilarCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid
                                                x:Name="PART_SimilarWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_SimilarWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Cubes"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_SimilarCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <ListView
                                                x:Name="PART_SimilarMailList"
                                                MaxHeight="260"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarMailList"
                                                IsItemClickEnabled="True"
                                                ItemTemplate="{StaticResource WinoIntelligenceHeaderSimilarItemTemplate}"
                                                SelectionMode="None"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Title bar synchronization button. Idle it is a plain 32x32 icon button carrying the
        WinoIcons Sync glyph; while synchronizing it swaps that glyph for a ProgressRing and
        expands to the right to show its description. Nothing here names what is being
        synchronized - the host supplies every string.
    -->
    <Style TargetType="syncButton:WinoSynchronizationButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncButton:WinoSynchronizationButton">
                    <!--
                        The button keeps a fixed 36x36 layout footprint, matching the pane toggle
                        next to it, so growing the pill never reflows the title bar. Everything
                        that grows lives in the Canvas below, which measures its child with
                        unbounded width and does not clip it, so the pill overhangs to the right
                        without taking any layout space.
                    -->
                    <!--
                        No CornerRadius here on purpose: a rounded panel clips its children,
                        which would cut the overhanging pill back to the 36px footprint. The
                        radius lives on the hover layer and the pill instead.
                    -->
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <Canvas>
                            <!--
                                Sized from the content rather than wrapping it, so the icon stays
                                visible while the pill itself is collapsed. The width is applied in
                                code: ActualWidth does not raise change notifications, so a binding
                                to it would freeze at the collapsed size. Its visibility is what the
                                implicit show/hide animations run on.
                            -->
                            <Border
                                x:Name="PART_PillBackground"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="36"
                                Height="36"
                                Background="{ThemeResource WinoSynchronizationButtonActiveBackgroundBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed" />

                            <Grid
                                x:Name="HoverLayer"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="36"
                                Height="36"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                            <StackPanel
                                x:Name="PART_OverlayContent"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Height="36"
                                Orientation="Horizontal">
                                <Grid Width="36" Height="36">
                                    <!--
                                        The controls library packages its own copy of WinoIcons.ttf, so the
                                        Sync glyph resolves here without a reference back to the app.
                                    -->
                                    <accountIcon:WinoFontIcon
                                        x:Name="PART_SyncIcon"
                                        FontSize="14"
                                        Foreground="{TemplateBinding Foreground}"
                                        Glyph="&#xE895;" />
                                    <ProgressRing
                                        x:Name="PART_ProgressRing"
                                        Width="16"
                                        Height="16"
                                        Foreground="{ThemeResource WinoSynchronizationButtonActiveForegroundBrush}"
                                        IsActive="False"
                                        IsIndeterminate="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}"
                                        Maximum="100"
                                        Minimum="0"
                                        Visibility="Collapsed"
                                        Value="{Binding Progress, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Grid>

                                <TextBlock
                                    x:Name="PART_DescriptionText"
                                    MaxWidth="260"
                                    Margin="4,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource WinoSynchronizationButtonActiveForegroundBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Canvas>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <!--
                                        Only the glyph dims. The host keeps the button enabled while a
                                        synchronization is running, so the pill is never washed out.
                                    -->
                                    <VisualState.Setters>
                                        <Setter Target="PART_OverlayContent.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--  Idle draws the glyph; Synchronizing draws the ring and the description.  -->
                            <VisualStateGroup x:Name="SynchronizationStates">
                                <VisualState x:Name="Idle" />
                                <VisualState x:Name="Synchronizing">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SyncIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ProgressRing.Visibility" Value="Visible" />
                                        <Setter Target="PART_ProgressRing.IsActive" Value="True" />
                                        <Setter Target="PART_DescriptionText.Visibility" Value="Visible" />
                                        <Setter Target="PART_PillBackground.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="contextFlyout:WinoContextFlyoutPresenter">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="contextFlyout:WinoContextFlyoutPresenter">
                    <Border
                        MaxWidth="300"
                        Padding="4"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="PART_SearchRow"
                                Margin="0,0,0,4"
                                ColumnSpacing="4"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PART_BackButton"
                                    Width="0"
                                    Height="36"
                                    Padding="0,0,4,0"
                                    AutomationProperties.AutomationId="WinoContextFlyoutBackButton"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Button.Resources>
                                        <Storyboard x:Key="ShowBackButtonStoryboard">
                                            <DoubleAnimation
                                                EnableDependentAnimation="True"
                                                Storyboard.TargetProperty="Width"
                                                From="0"
                                                To="36"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="X"
                                                From="-8"
                                                To="0"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                        <Storyboard x:Key="HideBackButtonStoryboard">
                                            <DoubleAnimation
                                                EnableDependentAnimation="True"
                                                Storyboard.TargetProperty="Width"
                                                From="36"
                                                To="0"
                                                Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="X"
                                                From="0"
                                                To="-8"
                                                Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </Button.Resources>
                                    <Button.RenderTransform>
                                        <TranslateTransform X="-8" />
                                    </Button.RenderTransform>
                                    <Viewbox Width="12" Height="12">
                                        <SymbolIcon Symbol="Back" />
                                    </Viewbox>
                                </Button>
                                <TextBox
                                    x:Name="PART_SearchBox"
                                    Grid.Column="1"
                                    Height="36"
                                    AutomationProperties.AutomationId="WinoContextFlyoutSearchBox" />
                            </Grid>
                            <ItemsRepeater
                                x:Name="PART_HeaderItems"
                                Grid.Row="1"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoContextFlyoutHeaderItems"
                                ItemTemplate="{StaticResource WinoContextFlyoutHeaderItemTemplate}"
                                Visibility="Collapsed">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="3"
                                        MinColumnSpacing="4"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Grid Grid.Row="2">
                                <ListView
                                    x:Name="PART_ItemsList"
                                    MaxHeight="360"
                                    Padding="0"
                                    AutomationProperties.AutomationId="WinoContextFlyoutItemsList"
                                    IsItemClickEnabled="True"
                                    ItemTemplateSelector="{StaticResource WinoContextFlyoutTemplateSelector}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <!--  Rows are commands, not a selection. The container adds no height; each item template owns its own metrics.  -->
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <TextBlock
                                    x:Name="PART_EmptyText"
                                    Margin="12,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoContextFlyoutEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="shimmer:WinoShimmer">
        <Setter Property="Background" Value="{ThemeResource WinoShimmerBaseBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource WinoShimmerHighlightBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <!--  A placeholder carries no information, so it stays out of the accessibility tree entirely.  -->
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shimmer:WinoShimmer">
                    <Border
                        x:Name="PART_ShimmerRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
