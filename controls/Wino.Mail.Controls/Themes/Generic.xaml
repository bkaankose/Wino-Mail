<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout"
    xmlns:intelligence="using:Wino.Mail.Controls.IntelligenceHeader"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:intelligenceTiles="using:Wino.Mail.Controls.IntelligenceTileBar"
    xmlns:local="using:Wino.Mail.Controls.SearchBar"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:shimmer="using:Wino.Mail.Controls.Shimmer"
    xmlns:syncButton="using:Wino.Mail.Controls.SynchronizationButton"
    xmlns:winoPrimitives="using:Wino.Mail.Controls.Primitives">

    <ResourceDictionary.MergedDictionaries>
        <contextFlyout:WinoContextFlyoutResources />
        <ResourceDictionary Source="ms-appx:///Wino.Mail.Controls/Themes/WinoIntelligenceBranding.xaml" />
        <ResourceDictionary Source="ms-appx:///Wino.Mail.Controls/IntelligenceProgressRing/WinoIntelligenceProgressRing.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemFillColorAttentionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!--  The skeleton is a resting surface, so the sweep only has to read a shade brighter than the block it crosses.  -->
            <SolidColorBrush x:Key="WinoShimmerBaseBrush" Color="#14000000" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="#59FFFFFF" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="WinoSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--
                Light theme puts a near-white field on a near-white surface, so unlike dark it needs a
                resting hairline to read as a search box at all - the same call the Settings app makes.
                Focus keeps that hairline and thickens the bottom edge on top of it.
            -->
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="WinoSearchBarOnlineBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSearchBarOnlineBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--
                The selection tile. Deliberately far lighter than a control fill: this strip is
                on screen for the whole session, so the tile only has to be findable, not
                emphatic. Anything heavier reads as a pressed button and wears on the eye.
            -->
            <!--
                The tile is a tint rather than a fill now, so the glyph on it stays the
                ordinary primary text colour instead of inverting to white against it.
            -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemFillColorAttentionBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <SolidColorBrush x:Key="WinoShimmerBaseBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="#1FFFFFFF" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="WinoSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--  Dark keeps the field borderless at rest: the fill alone separates it from the surface.  -->
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">0</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">0,0,0,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="WinoSearchBarOnlineBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="WinoSearchBarOnlineBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A touch more than Light takes: the same weight of ink reads lighter on a dark card.  -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WinoIntelligenceIconBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarPopupBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSeparatorBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderDeadlinePillForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderNeedsReplyPillForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="WinoShimmerBaseBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <SolidColorBrush x:Key="WinoShimmerHighlightBrush" Color="Transparent" />
            <StaticResource x:Key="WinoMailIntelligenceTileBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="WinoMailIntelligenceTileForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="WinoSynchronizationButtonActiveForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <Thickness x:Key="WinoSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="WinoSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="WinoSearchBarFieldBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarFieldFocusedBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="WinoSearchBarOnlineBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoSearchBarOnlineBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <!--  High contrast has no low-alpha tints, so the selected glyph sits on the highlight fill and must invert with it.  -->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <StaticResource x:Key="WinoIntelligenceIconBrush" ResourceKey="WinoIntelligenceBrandIconBrush" />
    <StaticResource x:Key="WinoIntelligenceSparklePathData" ResourceKey="WinoIntelligenceBrandSparklePathData" />

    <!--  A recent search, or the clear-history action that ends the list. Binds SearchBarHistoryEntry.  -->
    <DataTemplate x:Key="WinoSearchBarHistoryItemTemplate">
        <Grid
            MinHeight="32"
            Padding="0,4"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{Binding Glyph}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding Text}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoSearchBarFilterButtonStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <StaticResource x:Key="WinoIntelligenceHeaderSparkleBrush" ResourceKey="WinoIntelligenceBrandIconBrush" />

    <Style
        x:Key="WinoIntelligenceHeaderTriggerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        A ResourceDictionary has no x:Class, so x:DataType (and therefore x:Bind) is unavailable here
        and these paths must use Binding. Trimming stays safe because WinoIntelligenceReply is marked
        [GeneratedBindableCustomProperty], which preserves these properties for AOT. See the
        WMC1510 NoWarn in Wino.Mail.Controls.csproj.
    -->
    <DataTemplate x:Key="WinoIntelligenceHeaderReplyItemTemplate">
        <StackPanel Padding="10,7" Spacing="3">
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                Text="{Binding Tone}" />
            <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WinoIntelligenceHeaderSimilarItemTemplate">
        <Grid
            MinHeight="54"
            Padding="8,6"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Subject}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Meta}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding ScoreText}" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoIntelligenceChipButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,5,13,5" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Cancel sits inside the chip so a request is aborted where it was started. A Button nested in a
        Button is fine: the inner one handles the pointer, so the outer Click never fires.
    -->
    <Style
        x:Key="WinoIntelligenceChipCancelButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WinoIntelligencePanelIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="WinoSearchBarContactSuggestionTemplate">
        <Grid
            MinHeight="48"
            Padding="7,4"
            ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="28"
                Height="28"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Address}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        A chrome-less text box for the AutoSuggestBox inside the field. The field Border paints the
        background, border and focus line, and the control owns the clear button, so this template
        keeps only the placeholder and the text host. Dropping the stock template also drops its
        delete button, which its visual states would otherwise bring back next to ours.
    -->
    <Style x:Key="WinoSearchBarFieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource TextControlSelectionHighlightColor}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            x:Name="PlaceholderTextContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding PlaceholderText}"
                            Foreground="{ThemeResource TextControlPlaceholderForeground}"
                            IsHitTestVisible="False"
                            TextWrapping="NoWrap" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            ZoomMode="Disabled" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundDisabled}" />
                                        <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource TextControlPlaceholderForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The buttons inside the field. The stock button template paints a raised control fill and an
        elevation border on hover, which reads as a second text box inside the field. Here hover and
        press only lay a subtle fill over the button's own background.
    -->
    <Style x:Key="WinoSearchBarSubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            x:Name="StateOverlay"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The page-owned scope button at the left edge of the field. A soft chip, one step below a button.  -->
    <Style
        x:Key="WinoSearchBarChipButtonStyle"
        BasedOn="{StaticResource WinoSearchBarSubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!--
        Sized to sit inside a 32px field. The border stays transparent in every state, checked
        included: the field itself carries the online highlight, so outlining the pill as well
        states it twice.
    -->
    <Style
        x:Key="WinoSearchBarReachToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
        x:Key="WinoSearchBarInlineIconButtonStyle"
        BasedOn="{StaticResource WinoSearchBarSubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!--
        Left to right the field reads: search glyph, page scope, query, clear, Local/Online reach,
        page filters. Every part lives inside the field and keeps its place whether the field has
        focus or not, so the query never moves under the pointer.
    -->
    <Style TargetType="local:WinoSearchBar">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HistoryItemTemplate" Value="{StaticResource WinoSearchBarHistoryItemTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WinoSearchBar">
                    <Grid x:Name="PART_LayoutRoot">
                        <Border
                            x:Name="PART_FieldBorder"
                            Height="32"
                            Background="{ThemeResource WinoSearchBarFieldBackgroundBrush}"
                            BorderBrush="{ThemeResource WinoSearchBarFieldBorderBrush}"
                            BorderThickness="{ThemeResource WinoSearchBarFieldBorderThickness}"
                            CornerRadius="16">
                            <Grid>
                                <Border
                                    x:Name="PART_OnlineTint"
                                    Background="{ThemeResource WinoSearchBarOnlineBackgroundBrush}"
                                    CornerRadius="16"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                                <!--
                                    The input spans the whole field so its suggestion list is as wide as the
                                    field. The leading and trailing parts sit on top of it, and the control
                                    pads the text box by their widths so the query runs between them.
                                -->
                                <StackPanel
                                    x:Name="PART_LeadingHost"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Canvas.ZIndex="1"
                                    Orientation="Horizontal">
                                    <FontIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE721;"
                                        IsHitTestVisible="False" />
                                    <StackPanel
                                        x:Name="PART_HeaderHost"
                                        Margin="-4,0,0,0"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="PART_HeaderButton"
                                            AutomationProperties.AutomationId="WinoSearchBarHeaderButton"
                                            Style="{StaticResource WinoSearchBarChipButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    MaxWidth="140"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{TemplateBinding SelectedHeaderButtonTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="8"
                                                    Glyph="&#xE70D;" />
                                            </StackPanel>
                                        </Button>
                                        <Rectangle
                                            Width="1"
                                            Height="16"
                                            Margin="8,0,10,0"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <AutoSuggestBox
                                    x:Name="PART_AutoSuggestBox"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.AutomationId="WinoSearchBarInput"
                                    AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                    TextBoxStyle="{StaticResource WinoSearchBarFieldTextBoxStyle}" />
                                <StackPanel
                                    x:Name="PART_TrailingHost"
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Right"
                                    Canvas.ZIndex="1"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="PART_ClearButton"
                                        AutomationProperties.AutomationId="WinoSearchBarClearButton"
                                        Style="{StaticResource WinoSearchBarInlineIconButtonStyle}"
                                        Visibility="Collapsed">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="10"
                                            Glyph="&#xE711;" />
                                    </Button>
                                    <ToggleButton
                                        x:Name="PART_ReachButton"
                                        Margin="2,0"
                                        AutomationProperties.AutomationId="WinoSearchBarReachButton"
                                        Style="{StaticResource WinoSearchBarReachToggleStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon
                                                x:Name="PART_ReachIcon"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontSize="13" />
                                            <TextBlock
                                                x:Name="PART_ReachLabel"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button
                                        x:Name="PART_FilterButton"
                                        Margin="4,0,0,0"
                                        AutomationProperties.AutomationId="WinoSearchBarFilterButton"
                                        Style="{StaticResource WinoSearchBarInlineIconButtonStyle}"
                                        Visibility="Collapsed">
                                        <!--  The filter glyph comes from the library's own WinoIcons.ttf copy.  -->
                                        <accountIcon:WinoFontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Glyph="&#xE71C;" />
                                    </Button>
                                </StackPanel>
                                <Border
                                    x:Name="PART_FocusUnderline"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource WinoSearchBarFieldFocusedBorderBrush}"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Button
                            x:Name="PART_CompactButton"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="WinoSearchBarCompactButton"
                            AutomationProperties.Name="{TemplateBinding SearchButtonText}"
                            Style="{StaticResource WinoSearchBarInlineIconButtonStyle}"
                            ToolTipService.ToolTip="{TemplateBinding SearchButtonText}"
                            Visibility="Collapsed">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="16"
                                Glyph="&#xE721;" />
                        </Button>
                        <Popup
                            x:Name="PART_SearchPopup"
                            DesiredPlacement="BottomEdgeAlignedLeft"
                            IsLightDismissEnabled="True"
                            ShouldConstrainToRootBounds="True">
                            <Border
                                Width="380"
                                Padding="6"
                                Background="{ThemeResource WinoSearchBarPopupBackgroundBrush}"
                                BorderBrush="{ThemeResource WinoSearchBarPopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ContentControl
                                    x:Name="PART_CompactFieldHost"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                            </Border>
                        </Popup>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource WinoSearchBarFieldFocusedBackgroundBrush}" />
                                        <Setter Target="PART_FocusUnderline.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!--  Online already outlines the whole field, so focus adds no underline on top of it.  -->
                                <VisualState x:Name="FocusedOnline">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource WinoSearchBarFieldFocusedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ReachStates">
                                <VisualState x:Name="Local" />
                                <VisualState x:Name="Online">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OnlineTint.Visibility" Value="Visible" />
                                        <Setter Target="PART_FieldBorder.BorderBrush" Value="{ThemeResource WinoSearchBarOnlineBorderBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="intelligence:WinoIntelligenceHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="intelligence:WinoIntelligenceHeader">
                    <Grid
                        x:Name="PART_LayoutRoot"
                        Background="{ThemeResource WinoIntelligenceHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource WinoIntelligenceHeaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid.Resources>
                            <!--
                                Hosts may define an app-wide implicit StackPanel style carrying an
                                EntranceThemeTransition. Implicit-style lookup walks up to
                                Application.Resources, so it would otherwise slide every panel of this
                                header in from the top each time the header is shown or expanded.
                            -->
                            <Style TargetType="StackPanel">
                                <Setter Property="ChildrenTransitions" Value="{x:Null}" />
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            The whole row reacts to the pointer, not only the toggle button: the action
                            column on the right would otherwise stay unlit while the rest of the row
                            changes colour. The button's own hover and pressed fills are cleared so the
                            two backgrounds below are the only feedback.
                        -->
                        <Grid x:Name="PART_HeaderRow" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="PART_HeaderHoverBackground"
                                Grid.ColumnSpan="2"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Border
                                x:Name="PART_HeaderPressedBackground"
                                Grid.ColumnSpan="2"
                                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                            <Button
                                x:Name="PART_HeaderToggleButton"
                                MinHeight="40"
                                Padding="10,5"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoIntelligenceHeaderToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                </Button.Resources>
                                <!--
                                    Everything the collapsed header shows lives on this one row: title,
                                    the optional briefing fact text, and whichever status text applies.
                                -->
                                <Grid x:Name="PART_HeaderContentRoot" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource WinoIntelligenceBrandSparklePathData}"
                                        Foreground="{StaticResource WinoIntelligenceHeaderSparkleBrush}" />
                                    <TextBlock
                                        x:Name="PART_TitleTextBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="PART_BriefingFactTextBlock"
                                        Grid.Column="2"
                                        MaxWidth="360"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                    <!--  Subtitle and processing status are mutually exclusive, so they share this cell.  -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PART_SubtitleTextBlock"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="11"
                                            Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            x:Name="PART_ProcessingStatusPanel"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="Collapsed">
                                            <intelligenceProgress:WinoIntelligenceProgressRing
                                                x:Name="PART_ProcessingProgressRing"
                                                Width="12"
                                                Height="12"
                                                Animation="Dots"
                                                AutomationProperties.AccessibilityView="Raw"
                                                IsActive="False" />
                                            <TextBlock
                                                x:Name="PART_ProcessingStatusTextBlock"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <FontIcon
                                        x:Name="PART_ChevronIcon"
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="10"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        Glyph="&#xE70D;" />
                                </Grid>
                            </Button>
                            <StackPanel
                                Grid.Column="1"
                                Margin="6,4,6,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    x:Name="PART_ProcessButton"
                                    Padding="9,3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderProcessButton"
                                    Content="{TemplateBinding ProcessButtonText}"
                                    CornerRadius="4"
                                    FontSize="11"
                                    Visibility="Collapsed" />
                                <HyperlinkButton
                                    x:Name="PART_CopyCodeButton"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderCopyCodeButton"
                                    Content="{TemplateBinding CopyCodeText}"
                                    FontSize="11"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="PART_BodyRoot"
                            Grid.Row="1"
                            Padding="12"
                            BorderBrush="{ThemeResource WinoIntelligenceHeaderSeparatorBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <intelligenceTiles:WinoMailIntelligenceTileBar x:Name="PART_IntelligenceTileBar" AutomationProperties.AutomationId="WinoIntelligenceHeaderTileBar" />
                                <StackPanel x:Name="PART_FactsPanel" Spacing="6">
                                    <Border
                                        x:Name="PART_DeadlineFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderDeadlinePillForegroundBrush}"
                                                Glyph="&#xE823;" />
                                            <TextBlock
                                                x:Name="PART_DeadlineFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="PART_AddToCalendarButton"
                                                Grid.Column="2"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderAddToCalendarButton"
                                                Content="{TemplateBinding AddToCalendarButtonText}"
                                                Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="PART_NeedsReplyFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderNeedsReplyPillForegroundBrush}"
                                                Glyph="&#xE97A;" />
                                            <TextBlock
                                                x:Name="PART_NeedsReplyFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border
                                    x:Name="PART_InsightsLockedPanel"
                                    Padding="10,8"
                                    Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PART_InsightsLockedTextBlock"
                                        FontSize="12"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </Border>

                                <!--
                                    The action rail. Every chip has the same internal shape:
                                    [icon][label][result dot][hint]. Progress and cancel live in the
                                    feature's detail panel, so a chip never changes size while it runs.
                                    
                                    The rail wraps instead of using a fixed 2x2 grid. Chips are sized to their
                                    own content and a hidden chip releases its slot, so the rail stays a
                                    single tidy run of buttons however many features are available, and only
                                    spills onto a second line when the reading pane is too narrow for them.
                                -->
                                <winoPrimitives:WinoWrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button
                                        x:Name="PART_TranslateChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateChipButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="TranslateChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xF2B7;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_TranslateChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_TranslateResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_TranslateChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_SummaryChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummarizeButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="SummaryChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE8A5;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SummaryChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_SummaryResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_SummaryChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_RepliesChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderDraftRepliesButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="RepliesChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE97A;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_RepliesChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_RepliesResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_RepliesChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_SimilarChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderFindSimilarButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="SimilarChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE721;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SimilarChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_SimilarResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_SimilarChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                </winoPrimitives:WinoWrapPanel>

                                <Grid
                                    x:Name="PART_PanelHost"
                                    AutomationProperties.LiveSetting="Polite"
                                    Visibility="Collapsed">
                                    <Border
                                        x:Name="PART_SummaryPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SummaryHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_SummaryCopyButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCopyButton"
                                                        AutomationProperties.Name="{TemplateBinding CopyText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SummaryRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SummaryCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid
                                                x:Name="PART_SummaryWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_SummaryWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Summarize"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_SummaryCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SummaryResultTextBlock"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="PART_RepliesPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SuggestedRepliesHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_RepliesRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_RepliesCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
