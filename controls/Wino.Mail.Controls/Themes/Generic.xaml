    <DataTemplate x:Key="WinoSearchBarHistoryItemTemplate">
        <Grid
            MinHeight="36"
            Padding="8,4"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE81C;" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoSearchBarFilterButtonStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  Reuses the search bar gradient so every intelligence affordance shares one identity.  -->
    <StaticResource x:Key="WinoIntelligenceHeaderSparkleBrush" ResourceKey="WinoSearchBarIntelligenceIconBrush" />

    <Style
        x:Key="WinoIntelligenceHeaderTriggerButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        A ResourceDictionary has no x:Class, so x:DataType (and therefore x:Bind) is unavailable here
        and these paths must use Binding. Trimming stays safe because WinoIntelligenceReply is marked
        [GeneratedBindableCustomProperty], which preserves these properties for AOT. See the
        WMC1510 NoWarn in Wino.Mail.Controls.csproj.
    -->
    <DataTemplate x:Key="WinoIntelligenceHeaderReplyItemTemplate">
        <StackPanel Padding="10,7" Spacing="3">
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                Text="{Binding Tone}" />
            <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="WinoIntelligenceHeaderSimilarItemTemplate">
        <Grid
            MinHeight="54"
            Padding="8,6"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Subject}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Meta}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="{Binding ScoreText}" />
        </Grid>
    </DataTemplate>

    <Style
        x:Key="WinoIntelligenceChipButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="11,5,13,5" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Cancel sits inside the chip so a request is aborted where it was started. A Button nested in a
        Button is fine: the inner one handles the pointer, so the outer Click never fires.
    -->
    <Style
        x:Key="WinoIntelligenceChipCancelButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="WinoIntelligencePanelIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <DataTemplate x:Key="WinoSearchBarContactSuggestionTemplate">
        <Grid
            MinHeight="48"
            Padding="7,4"
            ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="28"
                Height="28"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="{Binding Initials}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Address}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        The field is a Border wrapping a chrome-less AutoSuggestBox. The text box keeps its own
        template but every border and background theme resource is overridden to transparent in its
        Resources scope, so the Border alone paints the field. WinoSearchBar.SynchronizeFieldVisuals
        repaints that Border for focus and for the semantic ("Meaning") state.
    -->
    <Style
        x:Key="WinoSearchBarFieldTextBoxStyle"
        BasedOn="{StaticResource DefaultTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Sized to sit inside a 32px field. The border stays transparent in every state, checked
        included: the field itself carries the semantic highlight, so outlining the pill as well
        states it twice.
    -->
    <Style
        x:Key="WinoSearchBarMeaningToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0,9,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
        x:Key="WinoSearchBarInlineIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="local:WinoSearchBar">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:WinoSearchBar">
                    <Grid x:Name="PART_LayoutRoot" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            TextControlThemeMinHeight (32px) is the stock AutoSuggestBox height. The bar
                            has to match it so it drops into the app TitleBar without growing the row;
                            everything inside is sized to fit within that.
                        -->
                        <Border
                            x:Name="PART_FieldBorder"
                            Height="{ThemeResource TextControlThemeMinHeight}"
                            Padding="9,0,2,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource TextControlBackground}"
                            BorderBrush="{ThemeResource TextControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <Grid ColumnSpacing="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <AutoSuggestBox
                                    x:Name="PART_AutoSuggestBox"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoSearchBarInput"
                                    AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                    TextBoxStyle="{StaticResource WinoSearchBarFieldTextBoxStyle}">
                                    <!--
                                        Theme resources resolve up the tree from the templated parent, so
                                        overriding them here strips the inner field's chrome without
                                        re-templating TextBox. TextControlBorderThemeThicknessFocused is the
                                        one that matters: without it the focused state paints a 2px underline
                                        inside our Border.
                                    -->
                                    <AutoSuggestBox.Resources>
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                    </AutoSuggestBox.Resources>
                                </AutoSuggestBox>

                                <!--
                                    Meaning is a modifier on the single search action, not a second submit
                                    button. Its checked state is what tells the user which kind of query
                                    Enter will run, so it carries a label and not just the sparkle.
                                -->
                                <ToggleButton
                                    x:Name="PART_MeaningToggleButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="WinoSearchBarMeaningToggle"
                                    Style="{StaticResource WinoSearchBarMeaningToggleStyle}">
                                    <ToggleButton.Resources>
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
                                    </ToggleButton.Resources>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Grid
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center">
                                            <Viewbox x:Name="PART_MeaningSparkle" Stretch="Uniform">
                                                <PathIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Data="{StaticResource WinoIntelligenceSparklePathData}"
                                                    Foreground="{StaticResource WinoIntelligenceIconBrush}" />
                                            </Viewbox>
                                            <intelligenceProgress:WinoIntelligenceProgressRing
                                                x:Name="PART_SemanticBusyRing"
                                                Animation="Dots"
                                                AutomationProperties.AccessibilityView="Raw"
                                                AutomationProperties.AutomationId="WinoSearchBarSemanticBusyRing"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock
                                            x:Name="PART_MeaningToggleLabel"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </ToggleButton>

                                <Button
                                    x:Name="PART_QueryButton"
                                    Grid.Column="2"
                                    Width="22"
                                    Height="22"
                                    MinWidth="22"
                                    MinHeight="22"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoSearchBarQueryButton"
                                    IsTabStop="False"
                                    Style="{StaticResource WinoSearchBarInlineIconButtonStyle}" />
                            </Grid>
                        </Border>

                        <Button
                            x:Name="PART_SearchOptionsButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WinoSearchBarOptionsButton"
                            Style="{StaticResource WinoSearchBarInlineIconButtonStyle}">
                            <FontIcon
                                x:Name="PART_SearchOptionsChevronIcon"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="12"
                                Glyph="&#xE70D;" />
                        </Button>

                        <Popup
                            x:Name="PART_SearchPopup"
                            IsLightDismissEnabled="False"
                            ShouldConstrainToRootBounds="True">
                            <Border
                                x:Name="PART_SearchPopupRoot"
                                Padding="12"
                                Background="{ThemeResource WinoSearchBarPopupBackgroundBrush}"
                                BackgroundSizing="InnerBorderEdge"
                                BorderBrush="{ThemeResource WinoSearchBarPopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <Border.Shadow>
                                    <ThemeShadow />
                                </Border.Shadow>
                                <Border.Translation>0,0,32</Border.Translation>
                                <Grid>
                                    <StackPanel x:Name="PART_HistoryPanel" Spacing="4">
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                x:Name="PART_HistoryHeadingText"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold" />
                                            <Button
                                                x:Name="PART_ClearHistoryButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="WinoSearchBarClearHistoryButton"
                                                Style="{StaticResource TextBlockButtonStyle}" />
                                        </Grid>
                                        <ListView
                                            x:Name="PART_HistoryList"
                                            MaxHeight="280"
                                            AutomationProperties.AutomationId="WinoSearchBarHistoryList"
                                            IsItemClickEnabled="True"
                                            ItemTemplate="{StaticResource WinoSearchBarHistoryItemTemplate}"
                                            SelectionMode="None" />
                                        <!--
                                            Only reachable when the list empties while the popup is open;
                                            focus no longer opens an empty popup.
                                        -->
                                        <TextBlock
                                            x:Name="PART_EmptyHistoryText"
                                            Margin="8,10,8,14"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PART_OptionsPanel"
                                        Spacing="12"
                                        Visibility="Collapsed">
                                        <Border
                                            x:Name="PART_SemanticExplanationPanel"
                                            Padding="10,8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Top"
                                                    Stretch="Uniform">
                                                    <PathIcon Data="{StaticResource WinoIntelligenceSparklePathData}" Foreground="{StaticResource WinoIntelligenceIconBrush}" />
                                                </Viewbox>
                                                <TextBlock
                                                    x:Name="PART_SemanticExplanationTextBlock"
                                                    Grid.Column="1"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    TextWrapping="WrapWholeWords" />
                                            </Grid>
                                        </Border>

                                        <StackPanel x:Name="PART_MailOptionsPanel" Spacing="12">
                                            <Grid ColumnSpacing="12" RowSpacing="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding ScopeLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_ScopeComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarScopeComboBox">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding ReachLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_ReachComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarReachComboBox">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <!--
                                                    From resolves against the contact index. The token replaces
                                                    the suggest box once a contact is chosen, so the row keeps a
                                                    single height either way.
                                                -->
                                                <StackPanel Grid.Row="1" Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding SenderLabelText}" />
                                                    <Grid MinHeight="32">
                                                        <AutoSuggestBox
                                                            x:Name="PART_SenderSuggestBox"
                                                            HorizontalAlignment="Stretch"
                                                            AutomationProperties.AutomationId="WinoSearchBarSenderSuggestBox"
                                                            ItemTemplate="{StaticResource WinoSearchBarContactSuggestionTemplate}" />
                                                        <Border
                                                            x:Name="PART_SenderToken"
                                                            Padding="3,3,3,3"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                                            Visibility="Collapsed">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border
                                                                    Width="24"
                                                                    Height="24"
                                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                    CornerRadius="12">
                                                                    <TextBlock
                                                                        x:Name="PART_SenderTokenInitials"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        FontSize="10" />
                                                                </Border>
                                                                <TextBlock
                                                                    x:Name="PART_SenderTokenName"
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Button
                                                                    x:Name="PART_SenderTokenRemoveButton"
                                                                    Grid.Column="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Padding="0"
                                                                    AutomationProperties.AutomationId="WinoSearchBarSenderTokenRemoveButton"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="12">
                                                                    <FontIcon
                                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                        FontSize="10"
                                                                        Glyph="&#xE711;" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="4">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding DateLabelText}" />
                                                    <ComboBox
                                                        x:Name="PART_DateComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        AutomationProperties.AutomationId="WinoSearchBarDateComboBox">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Title}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ToggleButton
                                                    x:Name="PART_AttachmentsButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarAttachmentsButton"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                                <ToggleButton
                                                    x:Name="PART_UnreadButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarUnreadButton"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                                <ToggleButton
                                                    x:Name="PART_FlaggedButton"
                                                    AutomationProperties.AutomationId="WinoSearchBarFlaggedButton"
                                                    Style="{StaticResource WinoSearchBarFilterButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="PART_ResetButton"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="WinoSearchBarResetButton" />
                                            <Button
                                                x:Name="PART_PanelSearchButton"
                                                Grid.Column="1"
                                                AutomationProperties.AutomationId="WinoSearchBarPanelSearchButton"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="intelligence:WinoIntelligenceHeader">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="intelligence:WinoIntelligenceHeader">
                    <Grid
                        x:Name="PART_LayoutRoot"
                        Background="{ThemeResource WinoIntelligenceHeaderBackgroundBrush}"
                        BorderBrush="{ThemeResource WinoIntelligenceHeaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="PART_HeaderToggleButton"
                                MinHeight="40"
                                Padding="10,5"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoIntelligenceHeaderToggleButton"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                                <!--
                                    Everything the collapsed header shows lives on this one row: title,
                                    the optional briefing fact text, and whichever status text applies.
                                -->
                                <Grid x:Name="PART_HeaderContentRoot" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource WinoIntelligenceSparklePathData}"
                                        Foreground="{StaticResource WinoIntelligenceHeaderSparkleBrush}" />
                                    <TextBlock
                                        x:Name="PART_TitleTextBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="PART_BriefingFactTextBlock"
                                        Grid.Column="2"
                                        MaxWidth="360"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="Collapsed" />
                                    <!--  Subtitle and processing status are mutually exclusive, so they share this cell.  -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PART_SubtitleTextBlock"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="11"
                                            Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            x:Name="PART_ProcessingStatusPanel"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="Collapsed">
                                            <intelligenceProgress:WinoIntelligenceProgressRing
                                                x:Name="PART_ProcessingProgressRing"
                                                Width="12"
                                                Height="12"
                                                Animation="Dots"
                                                AutomationProperties.AccessibilityView="Raw"
                                                IsActive="False" />
                                            <TextBlock
                                                x:Name="PART_ProcessingStatusTextBlock"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <FontIcon
                                        x:Name="PART_ChevronIcon"
                                        Grid.Column="4"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="10"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        Glyph="&#xE70D;" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="PART_ProcessButton"
                                Grid.Column="1"
                                Margin="6,4,6,4"
                                Padding="9,3"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="WinoIntelligenceHeaderProcessButton"
                                Content="{TemplateBinding ProcessButtonText}"
                                CornerRadius="4"
                                FontSize="11"
                                Visibility="Collapsed" />
                        </Grid>

                        <Border
                            x:Name="PART_BodyRoot"
                            Grid.Row="1"
                            Padding="12"
                            BorderBrush="{ThemeResource WinoIntelligenceHeaderSeparatorBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <StackPanel x:Name="PART_FactsPanel" Spacing="6">
                                    <Border
                                        x:Name="PART_DeadlineFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderDeadlinePillForegroundBrush}"
                                                Glyph="&#xE823;" />
                                            <TextBlock
                                                x:Name="PART_DeadlineFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                            <Button
                                                x:Name="PART_AddToCalendarButton"
                                                Grid.Column="2"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderAddToCalendarButton"
                                                Content="{TemplateBinding AddToCalendarButtonText}"
                                                Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="PART_NeedsReplyFactCard"
                                        Padding="10,8"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderNeedsReplyPillForegroundBrush}"
                                                Glyph="&#xE97A;" />
                                            <TextBlock
                                                x:Name="PART_NeedsReplyFactTextBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border
                                    x:Name="PART_InsightsLockedPanel"
                                    Padding="10,8"
                                    Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="PART_InsightsLockedTextBlock"
                                        FontSize="12"
                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                        TextWrapping="WrapWholeWords" />
                                </Border>

                                <!--
                                    The action rail. Every chip has the same internal shape:
                                    [icon][label][result dot][hint]. Progress and cancel live in the
                                    feature's detail panel, so a chip never changes size while it runs.
                                    
                                    The rail wraps instead of using a fixed 2x2 grid. Chips are sized to their
                                    own content and a hidden chip releases its slot, so the rail stays a
                                    single tidy run of buttons however many features are available, and only
                                    spills onto a second line when the reading pane is too narrow for them.
                                -->
                                <winoPrimitives:WinoWrapPanel HorizontalSpacing="6" VerticalSpacing="6">
                                    <Button
                                        x:Name="PART_SummaryChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummarizeButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="SummaryChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE8A5;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SummaryChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_SummaryResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_SummaryChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_RepliesChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderDraftRepliesButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="RepliesChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE97A;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_RepliesChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_RepliesResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_RepliesChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_TranslateChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateChipButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="TranslateChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xF2B7;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_TranslateChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_TranslateResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_TranslateChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button
                                        x:Name="PART_SimilarChipButton"
                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderFindSimilarButton"
                                        Style="{StaticResource WinoIntelligenceChipButtonStyle}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center">
                                                <FontIcon
                                                    x:Name="SimilarChipGlyph"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="&#xE721;" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SimilarChipLabel"
                                                Grid.Column="1"
                                                VerticalAlignment="Center" />
                                            <Ellipse
                                                x:Name="PART_SimilarResultDot"
                                                Grid.Column="2"
                                                Width="6"
                                                Height="6"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Name="PART_SimilarChipHint"
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                </winoPrimitives:WinoWrapPanel>

                                <Grid
                                    x:Name="PART_PanelHost"
                                    AutomationProperties.LiveSetting="Polite"
                                    Visibility="Collapsed">
                                    <Border
                                        x:Name="PART_SummaryPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SummaryHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_SummaryCopyButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCopyButton"
                                                        AutomationProperties.Name="{TemplateBinding CopyText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SummaryRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SummaryCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid
                                                x:Name="PART_SummaryWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_SummaryWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Summarize"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_SummaryCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderSummaryCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PART_SummaryResultTextBlock"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="PART_RepliesPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SuggestedRepliesHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_RepliesRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_RepliesCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid
                                                x:Name="PART_RepliesWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_RepliesWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Rewrite"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_RepliesCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderRepliesCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <ListView
                                                x:Name="PART_SuggestedRepliesList"
                                                MaxHeight="240"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderSuggestedRepliesList"
                                                IsItemClickEnabled="True"
                                                ItemTemplate="{StaticResource WinoIntelligenceHeaderReplyItemTemplate}"
                                                SelectionMode="None"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                    <!--  Keep configuration, progress, and result on one compact horizontal rail.  -->
                                    <Border
                                        x:Name="PART_TranslatePanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding TranslatePanelHeadingText}" />
                                                <Button
                                                    x:Name="PART_TranslateCloseButton"
                                                    Grid.Column="1"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateCloseButton"
                                                    AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                    Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                    <FontIcon
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Glyph="&#xE711;" />
                                                </Button>
                                            </Grid>

                                            <StackPanel
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <ComboBox
                                                    x:Name="PART_TranslationSourceComboBox"
                                                    MinWidth="140"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslationSource">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                    Glyph="&#xE72A;" />
                                                <ComboBox
                                                    x:Name="PART_TranslationTargetComboBox"
                                                    MinWidth="140"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslationTarget">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button
                                                    x:Name="PART_TranslationRunButton"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateButton"
                                                    Style="{StaticResource AccentButtonStyle}" />
                                                <StackPanel
                                                    x:Name="PART_TranslationWaitingPanel"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    Visibility="Collapsed">
                                                    <intelligenceProgress:WinoIntelligenceProgressRing
                                                        x:Name="PART_TranslationWaitingRing"
                                                        Width="28"
                                                        Height="28"
                                                        VerticalAlignment="Center"
                                                        Animation="Translate"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        IsActive="False" />
                                                    <TextBlock
                                                        x:Name="PART_TranslationBusyTextBlock"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                                    <Button
                                                        x:Name="PART_TranslateCancelButton"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderTranslateCancelButton"
                                                        Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                                </StackPanel>
                                                <StackPanel
                                                    x:Name="PART_TranslationAppliedPanel"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Visibility="Collapsed">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.AccessibilityView="Raw"
                                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                        Glyph="&#xE73E;" />
                                                    <TextBlock
                                                        x:Name="PART_TranslationStatusTextBlock"
                                                        MaxWidth="180"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="PART_SimilarPanel"
                                        Padding="10"
                                        Background="{ThemeResource WinoIntelligenceHeaderCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource WinoIntelligenceHeaderCardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{TemplateBinding SimilarMailHeadingText}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button
                                                        x:Name="PART_SimilarRegenerateButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarRegenerateButton"
                                                        AutomationProperties.Name="{TemplateBinding RegenerateText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                                    </Button>
                                                    <Button
                                                        x:Name="PART_SimilarCloseButton"
                                                        AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarCloseButton"
                                                        AutomationProperties.Name="{TemplateBinding ClosePanelText}"
                                                        Style="{StaticResource WinoIntelligencePanelIconButtonStyle}">
                                                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Grid
                                                x:Name="PART_SimilarWaitingPanel"
                                                ColumnSpacing="12"
                                                Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <intelligenceProgress:WinoIntelligenceProgressRing
                                                    x:Name="PART_SimilarWaitingRing"
                                                    Width="36"
                                                    Height="36"
                                                    VerticalAlignment="Center"
                                                    Animation="Cubes"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    IsActive="False" />
                                                <Rectangle
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    RadiusX="2"
                                                    RadiusY="2" />
                                                <Button
                                                    x:Name="PART_SimilarCancelButton"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarCancelButton"
                                                    Style="{StaticResource WinoIntelligenceHeaderTriggerButtonStyle}" />
                                            </Grid>
                                            <ListView
                                                x:Name="PART_SimilarMailList"
                                                MaxHeight="260"
                                                AutomationProperties.AutomationId="WinoIntelligenceHeaderSimilarMailList"
                                                IsItemClickEnabled="True"
                                                ItemTemplate="{StaticResource WinoIntelligenceHeaderSimilarItemTemplate}"
                                                SelectionMode="None"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

