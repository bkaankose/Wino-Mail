<UserControl
    x:Class="Wino.Mail.Controls.HoverActions.HoverActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:local="using:Wino.Mail.Controls.HoverActions"
    HorizontalAlignment="Right"
    VerticalAlignment="Center">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HoverActionFlagCheckedBackgroundBrush" Color="#FFFFC83D" />
                    <SolidColorBrush x:Key="HoverActionReadCheckedBackgroundBrush" Color="#FF0078D4" />
                    <SolidColorBrush x:Key="HoverActionCheckedForegroundBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HoverActionFlagCheckedBackgroundBrush" Color="#FFFFC83D" />
                    <SolidColorBrush x:Key="HoverActionReadCheckedBackgroundBrush" Color="#FF4CC2FF" />
                    <SolidColorBrush x:Key="HoverActionCheckedForegroundBrush" Color="#FF000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="HoverActionFlagCheckedBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="HoverActionReadCheckedBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="HoverActionCheckedForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style
                x:Key="HoverActionButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style
                x:Key="HoverActionToggleButtonStyle"
                BasedOn="{StaticResource DefaultToggleButtonStyle}"
                TargetType="ToggleButton">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="LayoutRoot">
                                <Border
                                    x:Name="RootBorder"
                                    Background="{ThemeResource ButtonBackground}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <Border
                                    x:Name="CheckedBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0" />
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.92" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.82" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="LayoutRoot.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="CheckedBackground.Opacity" Value="1" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource HoverActionCheckedForegroundBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ActionButtonTemplate" x:DataType="local:HoverActionButtonItem">
                <Button
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                    Click="ActionButtonClicked"
                    Style="{StaticResource HoverActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}">
                    <accountIcon:WinoFontIcon FontSize="16" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="FlagToggleTemplate" x:DataType="local:HoverActionButtonItem">
                <ToggleButton
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                    Background="{ThemeResource HoverActionFlagCheckedBackgroundBrush}"
                    Click="ActionButtonClicked"
                    IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                    Style="{StaticResource HoverActionToggleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}">
                    <accountIcon:WinoFontIcon FontSize="16" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                </ToggleButton>
            </DataTemplate>

            <DataTemplate x:Key="ReadToggleTemplate" x:DataType="local:HoverActionButtonItem">
                <ToggleButton
                    AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                    Background="{ThemeResource HoverActionReadCheckedBackgroundBrush}"
                    Click="ActionButtonClicked"
                    IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                    Style="{StaticResource HoverActionToggleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}">
                    <accountIcon:WinoFontIcon FontSize="16" Glyph="{x:Bind Glyph, Mode=OneTime}" />
                </ToggleButton>
            </DataTemplate>

            <local:HoverActionTemplateSelector
                x:Key="HoverActionTemplateSelector"
                ButtonTemplate="{StaticResource ActionButtonTemplate}"
                FlagToggleTemplate="{StaticResource FlagToggleTemplate}"
                ReadToggleTemplate="{StaticResource ReadToggleTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        Padding="2"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <ItemsControl
            x:Name="ActionsItemsControl"
            ItemTemplateSelector="{StaticResource HoverActionTemplateSelector}"
            ItemsSource="{x:Bind ActionItems, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Border>
</UserControl>
