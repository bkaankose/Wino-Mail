<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral presentation helpers shared by the native heads: typed bindings, design tokens,
       theme surface identifiers and the Domain-typed control rules (Controls/). No UI framework references; Native AOT and trimming clean. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Wino.Presentation</RootNamespace>
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Wino.Core.Domain\Wino.Core.Domain.csproj" />
    <ProjectReference Include="..\Wino.Mail.Controls.Core\Wino.Mail.Controls.Core.csproj" />
  </ItemGroup>
</Project>
