<Page
    x:Class="Wino.Mail.Controls.Playground.Pages.MailListInteractionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:contact="using:Wino.Mail.Controls.ContactPicture"
    xmlns:controls="using:Wino.Mail.Controls.MailListView"
    xmlns:core="using:Wino.Mail.Controls.Core"
    xmlns:models="using:Wino.Mail.Controls.Playground.Models">
    <Page.Resources>
        <!--  Mirrors the app's medium row: avatar, sender, subject, preview, date. No hover actions, flags or attachments.  -->
        <DataTemplate x:Key="LabSingleTemplate" x:DataType="core:MailListRow">
            <Grid Padding="8,8,12,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <contact:WinoContactPicture
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    ContactPicture="{x:Bind models:MailListLabFormat.ContactPicture(SourceItem), Mode=OneTime}"
                    FontSize="12"
                    IsFaviconEnabled="False"
                    IsGravatarEnabled="False" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        FontWeight="SemiBold"
                        Text="{Binding SourceItem.Sender, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Text="{Binding SourceItem.Subject, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.Preview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Spacing="2">
                    <Ellipse
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        x:SuppressXamlTrimWarnings="True"
                        Fill="{ThemeResource SystemAccentColor}"
                        Opacity="{Binding SourceItem.UnreadOpacity, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.DateText, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.RevisionText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LabThreadHeaderTemplate" x:DataType="core:MailListRow">
            <Grid Padding="8,8,12,8" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <contact:WinoContactPicture
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    ContactPicture="{x:Bind models:MailListLabFormat.ContactPicture(SourceItem), Mode=OneTime}"
                    FontSize="12"
                    IsFaviconEnabled="False"
                    IsGravatarEnabled="False" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <accountIcon:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Glyph="{x:Bind models:MailListLabFormat.ChevronGlyph(IsExpanded), Mode=OneWay}" />
                        <TextBlock
                            x:SuppressXamlTrimWarnings="True"
                            FontWeight="SemiBold"
                            Text="{Binding SourceItem.Sender, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Padding="6,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind models:MailListLabFormat.ThreadCount(Thread), Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Text="{Binding SourceItem.Subject, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.Preview, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Spacing="2">
                    <Ellipse
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        x:SuppressXamlTrimWarnings="True"
                        Fill="{ThemeResource SystemAccentColor}"
                        Opacity="{Binding SourceItem.UnreadOpacity, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.DateText, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.RevisionText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LabThreadChildTemplate" x:DataType="core:MailListRow">
            <Grid Padding="32,6,12,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <contact:WinoContactPicture
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    ContactPicture="{x:Bind models:MailListLabFormat.ContactPicture(SourceItem), Mode=OneTime}"
                    FontSize="10"
                    IsFaviconEnabled="False"
                    IsGravatarEnabled="False" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        FontWeight="SemiBold"
                        Text="{Binding SourceItem.Sender, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.Subject, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Spacing="2">
                    <Ellipse
                        Width="8"
                        Height="8"
                        HorizontalAlignment="Right"
                        x:SuppressXamlTrimWarnings="True"
                        Fill="{ThemeResource SystemAccentColor}"
                        Opacity="{Binding SourceItem.UnreadOpacity, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.DateText, Mode=OneWay}" />
                    <TextBlock
                        x:SuppressXamlTrimWarnings="True"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding SourceItem.RevisionText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LabGroupHeaderTemplate" x:DataType="core:MailListGroup">
            <Border
                Margin="0,0,0,4"
                Padding="12,6"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="6">
                <TextBlock
                    FontWeight="SemiBold"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind models:MailListLabFormat.GroupHeader(Key), Mode=OneTime}" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="3">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Mail list interactions" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Add, update and remove single mails and threads, switch sorting and grouping, and watch selection and scroll position stay put." />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="16,10,16,0"
                        Orientation="Horizontal"
                        Spacing="16">
                        <TextBlock
                            x:Name="RowCountText"
                            AutomationProperties.AutomationId="LabRowCountText"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="0 rows" />
                        <TextBlock
                            x:Name="ScrollOffsetText"
                            AutomationProperties.AutomationId="LabScrollOffsetText"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="offset 0" />
                        <TextBlock
                            x:Name="ItemCountText"
                            AutomationProperties.AutomationId="LabItemCountText"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.ItemCount, Mode=OneWay}" />
                    </StackPanel>
                    <controls:WinoMailListView
                        x:Name="MailList"
                        Grid.Row="1"
                        Margin="4,0,4,4"
                        AutomationProperties.AutomationId="MailLabList"
                        GroupHeaderTemplate="{StaticResource LabGroupHeaderTemplate}"
                        IsHoverActionsEnabled="False"
                        MailItemsSource="{x:Bind ViewModel.Items}"
                        ProjectionOptions="{x:Bind ViewModel.ProjectionOptions, Mode=OneWay}"
                        SelectAdjacentOnRemoval="{x:Bind AutoSelectToggle.IsOn, Mode=OneWay}"
                        SelectionMode="Extended"
                        SelectionSnapshotChanged="OnSelectionSnapshotChanged"
                        SingleItemTemplate="{StaticResource LabSingleTemplate}"
                        ThreadChildTemplate="{StaticResource LabThreadChildTemplate}"
                        ThreadExpansionChanged="OnThreadExpansionChanged"
                        ThreadHeaderTemplate="{StaticResource LabThreadHeaderTemplate}">
                        <controls:WinoMailListView.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" Invoked="DeleteAcceleratorInvoked" />
                        </controls:WinoMailListView.KeyboardAccelerators>
                        <controls:WinoMailListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel AreStickyGroupHeadersEnabled="True" GroupPadding="4,0,4,4" />
                            </ItemsPanelTemplate>
                        </controls:WinoMailListView.ItemsPanel>
                    </controls:WinoMailListView>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Projection" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox
                                    x:Name="SortCombo"
                                    MinWidth="150"
                                    AutomationProperties.AutomationId="LabSortCombo"
                                    Header="Sort"
                                    SelectedIndex="0"
                                    SelectionChanged="SortChanged">
                                    <ComboBoxItem Content="Date" Tag="{x:Bind core:MailListSortMode.Date}" />
                                    <ComboBoxItem Content="Name" Tag="{x:Bind core:MailListSortMode.Name}" />
                                    <ComboBoxItem Content="None" Tag="{x:Bind core:MailListSortMode.None}" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="GroupCombo"
                                    MinWidth="150"
                                    AutomationProperties.AutomationId="LabGroupCombo"
                                    Header="Group"
                                    SelectedIndex="0"
                                    SelectionChanged="GroupChanged">
                                    <ComboBoxItem Content="Date" Tag="{x:Bind core:MailListGroupMode.Date}" />
                                    <ComboBoxItem Content="Name" Tag="{x:Bind core:MailListGroupMode.Name}" />
                                    <ComboBoxItem Content="None" Tag="{x:Bind core:MailListGroupMode.None}" />
                                </ComboBox>
                            </StackPanel>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="LabThreadingToggle"
                                Header="Threading"
                                IsOn="{x:Bind ViewModel.IsThreadingEnabled, Mode=TwoWay}" />
                            <ToggleSwitch
                                AutomationProperties.AutomationId="LabPinnedFirstToggle"
                                Header="Pinned first"
                                IsOn="{x:Bind ViewModel.IsPinnedFirst, Mode=TwoWay}" />
                            <ToggleSwitch
                                x:Name="AutoSelectToggle"
                                AutomationProperties.AutomationId="LabAutoSelectToggle"
                                Header="Select next item on removal"
                                IsOn="True" />
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Single item" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Update actions apply to the active (last selected) mail."
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabAddSingle"
                                    Click="AddSingle_Click"
                                    Content="Add single" />
                                <Button
                                    AutomationProperties.AutomationId="LabRemoveSelected"
                                    Click="RemoveSelected_Click"
                                    Content="Remove selected" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabUpdateSubject"
                                    Click="UpdateSubject_Click"
                                    Content="Edit subject" />
                                <Button
                                    AutomationProperties.AutomationId="LabMoveDay"
                                    Click="MoveDay_Click"
                                    Content="Move a day back" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabRenameSender"
                                    Click="RenameSender_Click"
                                    Content="Rename sender" />
                                <Button
                                    AutomationProperties.AutomationId="LabTogglePin"
                                    Click="TogglePin_Click"
                                    Content="Toggle pin" />
                                <Button
                                    AutomationProperties.AutomationId="LabToggleRead"
                                    Click="ToggleRead_Click"
                                    Content="Toggle read" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Threads" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabAddThread"
                                    Click="AddThread_Click"
                                    Content="Add 3-mail thread" />
                                <Button
                                    AutomationProperties.AutomationId="LabRemoveThread"
                                    Click="RemoveThread_Click"
                                    Content="Remove selected threads" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabAddReply"
                                    Click="AddReply_Click"
                                    Content="Reply to active (newer)" />
                                <Button
                                    AutomationProperties.AutomationId="LabAddOlderReply"
                                    Click="AddOlderReply_Click"
                                    Content="Reply to active (older)" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Bulk" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabBulkAdd"
                                    Click="BulkAdd_Click"
                                    Content="Add 40 singles + 10 threads" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabRemoveEveryOther"
                                    Click="RemoveEveryOther_Click"
                                    Content="Remove every other" />
                                <Button
                                    AutomationProperties.AutomationId="LabRemoveOldest"
                                    Click="RemoveOldest_Click"
                                    Content="Remove 20 oldest" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="LabReset"
                                    Click="Reset_Click"
                                    Content="Reset" />
                                <Button
                                    AutomationProperties.AutomationId="LabClear"
                                    Click="Clear_Click"
                                    Content="Clear" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Inspector" />
                            <TextBlock FontWeight="SemiBold" Text="Active mail" />
                            <TextBlock
                                x:Name="ActiveItemText"
                                AutomationProperties.AutomationId="LabActiveText"
                                Text="(none)"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Selected mails" />
                            <TextBlock
                                x:Name="SelectionText"
                                AutomationProperties.AutomationId="LabSelectionText"
                                Text="(none)"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Expanded threads" />
                            <TextBlock
                                x:Name="ExpandedText"
                                AutomationProperties.AutomationId="LabExpandedText"
                                Text="(none)"
                                TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="Collection log" />
                            <ItemsControl AutomationProperties.AutomationId="LabLog" ItemsSource="{x:Bind ViewModel.Log}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
