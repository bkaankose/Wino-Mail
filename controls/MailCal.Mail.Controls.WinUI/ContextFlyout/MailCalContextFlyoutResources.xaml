<ResourceDictionary
    x:Class="MailCal.Mail.Controls.ContextFlyout.MailCalContextFlyoutResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:MailCal.Mail.Controls.AccountIcon"
    xmlns:local="using:MailCal.Mail.Controls.ContextFlyout">

    <DataTemplate x:Key="MailCalContextFlyoutItemTemplate" x:DataType="local:ContextFlyoutRow">
        <Grid
            MinHeight="36"
            Padding="8,0,12,0"
            ColumnSpacing="8"
            ToolTipService.ToolTip="{x:Bind Text, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <accountIcon:MailCalFontIcon
                x:Name="ItemThemedIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasThemedIcon, Mode=OneTime}"
                FontSize="16"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <accountIcon:MailCalFontIcon
                x:Name="ItemColoredIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasColoredIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{x:Bind IconForeground, Mode=OneTime}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Column="2"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ShortcutText, Mode=OneTime}"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutDestructiveItemTemplate" x:DataType="local:ContextFlyoutRow">
        <Grid
            MinHeight="36"
            Padding="8,0,12,0"
            ColumnSpacing="8"
            ToolTipService.ToolTip="{x:Bind Text, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <accountIcon:MailCalFontIcon
                x:Name="DestructiveThemedIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasThemedIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <accountIcon:MailCalFontIcon
                x:Name="DestructiveColoredIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasColoredIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{x:Bind IconForeground, Mode=OneTime}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Column="2"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ShortcutText, Mode=OneTime}"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutToggleItemTemplate" x:DataType="local:ContextFlyoutRow">
        <Grid
            MinHeight="36"
            Padding="8,0,12,0"
            ColumnSpacing="8"
            ToolTipService.ToolTip="{x:Bind Text, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <accountIcon:MailCalFontIcon
                x:Name="ToggleCheckGlyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind IsChecked, Mode=OneTime}"
                FontSize="14"
                Glyph="&#xE00B;" />
            <accountIcon:MailCalFontIcon
                x:Name="ToggleThemedIcon"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasThemedIcon, Mode=OneTime}"
                FontSize="16"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <accountIcon:MailCalFontIcon
                x:Name="ToggleColoredIcon"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasColoredIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{x:Bind IconForeground, Mode=OneTime}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ShortcutText, Mode=OneTime}"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutRadioItemTemplate" x:DataType="local:ContextFlyoutRow">
        <Grid
            MinHeight="36"
            Padding="8,0,12,0"
            ColumnSpacing="8"
            ToolTipService.ToolTip="{x:Bind Text, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <accountIcon:MailCalFontIcon
                x:Name="RadioCheckGlyph"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind IsChecked, Mode=OneTime}"
                FontSize="14"
                Glyph="&#xE096;" />
            <accountIcon:MailCalFontIcon
                x:Name="RadioThemedIcon"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasThemedIcon, Mode=OneTime}"
                FontSize="16"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <accountIcon:MailCalFontIcon
                x:Name="RadioColoredIcon"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasColoredIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{x:Bind IconForeground, Mode=OneTime}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Column="3"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ShortcutText, Mode=OneTime}"
                TextWrapping="NoWrap" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutSubItemTemplate" x:DataType="local:ContextFlyoutRow">
        <Grid
            MinHeight="36"
            Padding="8,0,12,0"
            ColumnSpacing="8"
            ToolTipService.ToolTip="{x:Bind Text, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <accountIcon:MailCalFontIcon
                x:Name="SubItemThemedIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasThemedIcon, Mode=OneTime}"
                FontSize="16"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <accountIcon:MailCalFontIcon
                x:Name="SubItemColoredIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind HasColoredIcon, Mode=OneTime}"
                FontSize="16"
                Foreground="{x:Bind IconForeground, Mode=OneTime}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <Viewbox
                Grid.Column="2"
                Width="12"
                Height="12"
                VerticalAlignment="Center">
                <accountIcon:MailCalFontIcon Glyph="&#xE00E;" />
            </Viewbox>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutSeparatorTemplate">
        <Rectangle
            Height="1"
            Margin="0,3"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            IsHitTestVisible="False" />
    </DataTemplate>

    <DataTemplate x:Key="MailCalContextFlyoutHeaderItemTemplate" x:DataType="local:ContextFlyoutHeaderRow">
        <AppBarButton
            MinWidth="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
            AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneTime}"
            Label="{x:Bind Label, Mode=OneTime}"
            LabelPosition="Default"
            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneTime}">
            <AppBarButton.Icon>
                <accountIcon:MailCalFontIcon FontSize="20" Glyph="{x:Bind Glyph, Mode=OneTime}" />
            </AppBarButton.Icon>
        </AppBarButton>
    </DataTemplate>

    <local:MailCalContextFlyoutTemplateSelector
        x:Key="MailCalContextFlyoutTemplateSelector"
        DestructiveItemTemplate="{StaticResource MailCalContextFlyoutDestructiveItemTemplate}"
        ItemTemplate="{StaticResource MailCalContextFlyoutItemTemplate}"
        RadioItemTemplate="{StaticResource MailCalContextFlyoutRadioItemTemplate}"
        SeparatorTemplate="{StaticResource MailCalContextFlyoutSeparatorTemplate}"
        SubItemTemplate="{StaticResource MailCalContextFlyoutSubItemTemplate}"
        ToggleItemTemplate="{StaticResource MailCalContextFlyoutToggleItemTemplate}" />

</ResourceDictionary>
