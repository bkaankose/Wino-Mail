<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:MailCal.Mail.Controls.AccountIcon"
    xmlns:contextFlyout="using:MailCal.Mail.Controls.ContextFlyout"
    xmlns:controls="using:MailCal.Mail.Controls"
    xmlns:local="using:MailCal.Mail.Controls.SearchBar"
    xmlns:mailCalPrimitives="using:MailCal.Mail.Controls.Primitives"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:shimmer="using:MailCal.Mail.Controls.Shimmer"
    xmlns:syncButton="using:MailCal.Mail.Controls.SynchronizationButton">

    <ResourceDictionary.MergedDictionaries>
        <contextFlyout:MailCalContextFlyoutResources />
        <controls:MailCalItemTemplates />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="MailCalSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="MailCalSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <!--  The skeleton is a resting surface, so the sweep only has to read a shade brighter than the block it crosses.  -->
            <SolidColorBrush x:Key="MailCalShimmerBaseBrush" Color="#14000000" />
            <SolidColorBrush x:Key="MailCalShimmerHighlightBrush" Color="#59FFFFFF" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="MailCalSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="MailCalSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--
                Light theme puts a near-white field on a near-white surface, so unlike dark it needs a
                resting hairline to read as a search box at all - the same call the Settings app makes.
                Focus keeps that hairline and thickens the bottom edge on top of it.
            -->
            <Thickness x:Key="MailCalSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="MailCalSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="MailCalSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="MailCalSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="MailCalSearchBarOnlineBackgroundBrush"
                Opacity="0.10"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="MailCalSearchBarOnlineBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--
                The selection tile. Deliberately far lighter than a control fill: this strip is
                on screen for the whole session, so the tile only has to be findable, not
                emphatic. Anything heavier reads as a pressed button and wears on the eye.
            -->
            <!--
                The tile is a tint rather than a fill now, so the glyph on it stays the
                ordinary primary text colour instead of inverting to white against it.
            -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="MailCalSearchBarPopupBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="MailCalSearchBarPopupBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <SolidColorBrush x:Key="MailCalShimmerBaseBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="MailCalShimmerHighlightBrush" Color="#1FFFFFFF" />
            <!--  The active pill is the system accent at low alpha so a user's Windows accent carries through.  -->
            <SolidColorBrush
                x:Key="MailCalSynchronizationButtonActiveBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="MailCalSynchronizationButtonActiveForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <!--  Dark keeps the field borderless at rest: the fill alone separates it from the surface.  -->
            <Thickness x:Key="MailCalSearchBarFieldBorderThickness">0</Thickness>
            <Thickness x:Key="MailCalSearchBarFieldFocusedBorderThickness">0,0,0,2</Thickness>
            <StaticResource x:Key="MailCalSearchBarFieldBorderBrush" ResourceKey="TextControlBorderBrush" />
            <StaticResource x:Key="MailCalSearchBarFieldBackgroundBrush" ResourceKey="TextControlBackground" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBackgroundBrush" ResourceKey="TextControlBackgroundFocused" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A tint, not a fill. The accent at low alpha reads as "this query is different" while keeping the placeholder legible.  -->
            <SolidColorBrush
                x:Key="MailCalSearchBarOnlineBackgroundBrush"
                Opacity="0.18"
                Color="{ThemeResource SystemAccentColor}" />
            <StaticResource x:Key="MailCalSearchBarOnlineBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <!--  A touch more than Light takes: the same weight of ink reads lighter on a dark card.  -->
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MailCalSearchBarPopupBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalSearchBarPopupBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MailCalShimmerBaseBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <SolidColorBrush x:Key="MailCalShimmerHighlightBrush" Color="Transparent" />
            <StaticResource x:Key="MailCalSynchronizationButtonActiveBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="MailCalSynchronizationButtonActiveForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <Thickness x:Key="MailCalSearchBarFieldBorderThickness">1</Thickness>
            <Thickness x:Key="MailCalSearchBarFieldFocusedBorderThickness">1,1,1,2</Thickness>
            <StaticResource x:Key="MailCalSearchBarFieldBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MailCalSearchBarFieldBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalSearchBarFieldFocusedBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="MailCalSearchBarOnlineBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalSearchBarOnlineBorderBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <!--  High contrast has no low-alpha tints, so the selected glyph sits on the highlight fill and must invert with it.  -->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style
        x:Key="MailCalSearchBarFilterButtonStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        A chrome-less text box for the AutoSuggestBox inside the field. The field Border paints the
        background, border and focus line, and the control owns the clear button, so this template
        keeps only the placeholder and the text host. Dropping the stock template also drops its
        delete button, which its visual states would otherwise bring back next to ours.
    -->
    <Style x:Key="MailCalSearchBarFieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource TextControlSelectionHighlightColor}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            x:Name="PlaceholderTextContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding PlaceholderText}"
                            Foreground="{ThemeResource TextControlPlaceholderForeground}"
                            IsHitTestVisible="False"
                            TextWrapping="NoWrap" />
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                            IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                            VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                            ZoomMode="Disabled" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Focused" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentElement.Foreground" Value="{ThemeResource TextControlForegroundDisabled}" />
                                        <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="{ThemeResource TextControlPlaceholderForegroundDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The buttons inside the field. The stock button template paints a raised control fill and an
        elevation border on hover, which reads as a second text box inside the field. Here hover and
        press only lay a subtle fill over the button's own background.
    -->
    <Style x:Key="MailCalSearchBarSubtleButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border
                            x:Name="StateOverlay"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The page-owned scope button at the left edge of the field. A soft chip, one step below a button.  -->
    <Style
        x:Key="MailCalSearchBarChipButtonStyle"
        BasedOn="{StaticResource MailCalSearchBarSubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!--
        Sized to sit inside a 32px field. The border stays transparent in every state, checked
        included: the field itself carries the online highlight, so outlining the pill as well
        states it twice.
    -->
    <Style
        x:Key="MailCalSearchBarReachToggleStyle"
        BasedOn="{StaticResource DefaultToggleButtonStyle}"
        TargetType="ToggleButton">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style
        x:Key="MailCalSearchBarInlineIconButtonStyle"
        BasedOn="{StaticResource MailCalSearchBarSubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!--
        Left to right the field reads: search glyph, page scope, query, clear, Local/Online reach,
        page filters. Every part lives inside the field and keeps its place whether the field has
        focus or not, so the query never moves under the pointer.
    -->
    <Style TargetType="local:MailCalSearchBar">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HistoryItemTemplate" Value="{StaticResource MailCalSearchBarHistoryItemTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MailCalSearchBar">
                    <Grid x:Name="PART_LayoutRoot">
                        <Border
                            x:Name="PART_FieldBorder"
                            Height="32"
                            Background="{ThemeResource MailCalSearchBarFieldBackgroundBrush}"
                            BorderBrush="{ThemeResource MailCalSearchBarFieldBorderBrush}"
                            BorderThickness="{ThemeResource MailCalSearchBarFieldBorderThickness}"
                            CornerRadius="16">
                            <Grid>
                                <Border
                                    x:Name="PART_OnlineTint"
                                    Background="{ThemeResource MailCalSearchBarOnlineBackgroundBrush}"
                                    CornerRadius="16"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                                <!--
                                    The input spans the whole field so its suggestion list is as wide as the
                                    field. The leading and trailing parts sit on top of it, and the control
                                    pads the text box by their widths so the query runs between them.
                                -->
                                <StackPanel
                                    x:Name="PART_LeadingHost"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Canvas.ZIndex="1"
                                    Orientation="Horizontal">
                                    <accountIcon:MailCalFontIcon
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="14"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xEA7D;"
                                        IsHitTestVisible="False" />
                                    <StackPanel
                                        x:Name="PART_HeaderHost"
                                        Margin="-4,0,0,0"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="PART_HeaderButton"
                                            AutomationProperties.AutomationId="MailCalSearchBarHeaderButton"
                                            Style="{StaticResource MailCalSearchBarChipButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock
                                                    MaxWidth="140"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{TemplateBinding SelectedHeaderButtonTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <accountIcon:MailCalFontIcon
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontSize="8"
                                                    Glyph="&#xE02A;" />
                                            </StackPanel>
                                        </Button>
                                        <Rectangle
                                            Width="1"
                                            Height="16"
                                            Margin="8,0,10,0"
                                            VerticalAlignment="Center"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <AutoSuggestBox
                                    x:Name="PART_AutoSuggestBox"
                                    VerticalAlignment="Stretch"
                                    AutomationProperties.AutomationId="MailCalSearchBarInput"
                                    AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                    TextBoxStyle="{StaticResource MailCalSearchBarFieldTextBoxStyle}" />
                                <StackPanel
                                    x:Name="PART_TrailingHost"
                                    Margin="0,0,2,0"
                                    HorizontalAlignment="Right"
                                    Canvas.ZIndex="1"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="PART_ClearButton"
                                        AutomationProperties.AutomationId="MailCalSearchBarClearButton"
                                        Style="{StaticResource MailCalSearchBarInlineIconButtonStyle}"
                                        Visibility="Collapsed">
                                        <accountIcon:MailCalFontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="10"
                                            Glyph="&#xF008;" />
                                    </Button>
                                    <ToggleButton
                                        x:Name="PART_ReachButton"
                                        Margin="2,0"
                                        AutomationProperties.AutomationId="MailCalSearchBarReachButton"
                                        Style="{StaticResource MailCalSearchBarReachToggleStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <accountIcon:MailCalFontIcon
                                                x:Name="PART_ReachIcon"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontSize="13" />
                                            <TextBlock
                                                x:Name="PART_ReachLabel"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button
                                        x:Name="PART_FilterButton"
                                        Margin="4,0,0,0"
                                        AutomationProperties.AutomationId="MailCalSearchBarFilterButton"
                                        Style="{StaticResource MailCalSearchBarInlineIconButtonStyle}"
                                        Visibility="Collapsed">
                                        <!--  The filter glyph comes from the library's own MailCalIcons.ttf copy.  -->
                                        <accountIcon:MailCalFontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="14"
                                            Glyph="&#xE71C;" />
                                    </Button>
                                </StackPanel>
                                <Border
                                    x:Name="PART_FocusUnderline"
                                    Height="1"
                                    Margin="14,0"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource MailCalSearchBarFieldFocusedBorderBrush}"
                                    CornerRadius="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Button
                            x:Name="PART_CompactButton"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="MailCalSearchBarCompactButton"
                            AutomationProperties.Name="{TemplateBinding SearchButtonText}"
                            Style="{StaticResource MailCalSearchBarInlineIconButtonStyle}"
                            ToolTipService.ToolTip="{TemplateBinding SearchButtonText}"
                            Visibility="Collapsed">
                            <accountIcon:MailCalFontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="16"
                                Glyph="&#xEA7D;" />
                        </Button>
                        <Popup
                            x:Name="PART_SearchPopup"
                            DesiredPlacement="BottomEdgeAlignedLeft"
                            IsLightDismissEnabled="True"
                            ShouldConstrainToRootBounds="True">
                            <Border
                                Width="380"
                                Padding="6"
                                Background="{ThemeResource MailCalSearchBarPopupBackgroundBrush}"
                                BorderBrush="{ThemeResource MailCalSearchBarPopupBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource OverlayCornerRadius}">
                                <ContentControl
                                    x:Name="PART_CompactFieldHost"
                                    HorizontalContentAlignment="Stretch"
                                    IsTabStop="False" />
                            </Border>
                        </Popup>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource MailCalSearchBarFieldFocusedBackgroundBrush}" />
                                        <Setter Target="PART_FocusUnderline.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <!--  Online already outlines the whole field, so focus adds no underline on top of it.  -->
                                <VisualState x:Name="FocusedOnline">
                                    <VisualState.Setters>
                                        <Setter Target="PART_FieldBorder.Background" Value="{ThemeResource MailCalSearchBarFieldFocusedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ReachStates">
                                <VisualState x:Name="Local" />
                                <VisualState x:Name="Online">
                                    <VisualState.Setters>
                                        <Setter Target="PART_OnlineTint.Visibility" Value="Visible" />
                                        <Setter Target="PART_FieldBorder.BorderBrush" Value="{ThemeResource MailCalSearchBarOnlineBorderBrush}" />
                                        <Setter Target="PART_FieldBorder.BorderThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Title bar synchronization button. Idle it is a plain 32x32 icon button carrying the
        MailCalIcons Sync glyph; while synchronizing it swaps that glyph for a ProgressRing and
        expands to the right to show its description. Nothing here names what is being
        synchronized - the host supplies every string.
    -->
    <Style TargetType="syncButton:MailCalSynchronizationButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="syncButton:MailCalSynchronizationButton">
                    <!--
                        The button keeps a fixed 36x36 layout footprint, matching the pane toggle
                        next to it, so growing the pill never reflows the title bar. Everything
                        that grows lives in the Canvas below, which measures its child with
                        unbounded width and does not clip it, so the pill overhangs to the right
                        without taking any layout space.
                    -->
                    <!--
                        No CornerRadius here on purpose: a rounded panel clips its children,
                        which would cut the overhanging pill back to the 36px footprint. The
                        radius lives on the hover layer and the pill instead.
                    -->
                    <Grid x:Name="LayoutRoot" Background="{TemplateBinding Background}">
                        <Canvas>
                            <!--
                                Sized from the content rather than wrapping it, so the icon stays
                                visible while the pill itself is collapsed. The width is applied in
                                code: ActualWidth does not raise change notifications, so a binding
                                to it would freeze at the collapsed size. Its visibility is what the
                                implicit show/hide animations run on.
                            -->
                            <Border
                                x:Name="PART_PillBackground"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="36"
                                Height="36"
                                Background="{ThemeResource MailCalSynchronizationButtonActiveBackgroundBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Visibility="Collapsed" />

                            <Grid
                                x:Name="HoverLayer"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Width="36"
                                Height="36"
                                CornerRadius="{TemplateBinding CornerRadius}" />

                            <StackPanel
                                x:Name="PART_OverlayContent"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Height="36"
                                Orientation="Horizontal">
                                <Grid Width="36" Height="36">
                                    <!--
                                        The controls library packages its own copy of MailCalIcons.ttf, so the
                                        Sync glyph resolves here without a reference back to the app.
                                    -->
                                    <accountIcon:MailCalFontIcon
                                        x:Name="PART_SyncIcon"
                                        FontSize="14"
                                        Foreground="{TemplateBinding Foreground}"
                                        Glyph="&#xE895;" />
                                    <ProgressRing
                                        x:Name="PART_ProgressRing"
                                        Width="16"
                                        Height="16"
                                        Foreground="{ThemeResource MailCalSynchronizationButtonActiveForegroundBrush}"
                                        IsActive="False"
                                        IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                        Maximum="100"
                                        Minimum="0"
                                        Visibility="Collapsed"
                                        Value="{TemplateBinding Progress}" />
                                </Grid>

                                <TextBlock
                                    x:Name="PART_DescriptionText"
                                    MaxWidth="260"
                                    Margin="4,0,12,0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource MailCalSynchronizationButtonActiveForegroundBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{TemplateBinding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Canvas>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <!--
                                        Only the glyph dims. The host keeps the button enabled while a
                                        synchronization is running, so the pill is never washed out.
                                    -->
                                    <VisualState.Setters>
                                        <Setter Target="PART_OverlayContent.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--  Idle draws the glyph; Synchronizing draws the ring and the description.  -->
                            <VisualStateGroup x:Name="SynchronizationStates">
                                <VisualState x:Name="Idle" />
                                <VisualState x:Name="Synchronizing">
                                    <VisualState.Setters>
                                        <Setter Target="PART_SyncIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ProgressRing.Visibility" Value="Visible" />
                                        <Setter Target="PART_ProgressRing.IsActive" Value="True" />
                                        <Setter Target="PART_DescriptionText.Visibility" Value="Visible" />
                                        <Setter Target="PART_PillBackground.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="contextFlyout:MailCalContextFlyoutPresenter">
        <Setter Property="MinWidth" Value="75" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="contextFlyout:MailCalContextFlyoutPresenter">
                    <Border
                        MaxWidth="300"
                        Padding="4"
                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="PART_SearchRow"
                                Margin="0,0,0,4"
                                ColumnSpacing="4"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PART_BackButton"
                                    Width="0"
                                    Height="36"
                                    Padding="0,0,4,0"
                                    AutomationProperties.AutomationId="MailCalContextFlyoutBackButton"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    IsTabStop="False"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Button.Resources>
                                        <Storyboard x:Key="ShowBackButtonStoryboard">
                                            <DoubleAnimation
                                                EnableDependentAnimation="True"
                                                Storyboard.TargetProperty="Width"
                                                From="0"
                                                To="36"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="X"
                                                From="-8"
                                                To="0"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                        <Storyboard x:Key="HideBackButtonStoryboard">
                                            <DoubleAnimation
                                                EnableDependentAnimation="True"
                                                Storyboard.TargetProperty="Width"
                                                From="36"
                                                To="0"
                                                Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="X"
                                                From="0"
                                                To="-8"
                                                Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </Button.Resources>
                                    <Button.RenderTransform>
                                        <TranslateTransform X="-8" />
                                    </Button.RenderTransform>
                                    <Viewbox Width="12" Height="12">
                                        <accountIcon:MailCalFontIcon Glyph="&#xE00D;" />
                                    </Viewbox>
                                </Button>
                                <TextBox
                                    x:Name="PART_SearchBox"
                                    Grid.Column="1"
                                    Height="36"
                                    AutomationProperties.AutomationId="MailCalContextFlyoutSearchBox" />
                            </Grid>
                            <ItemsRepeater
                                x:Name="PART_HeaderItems"
                                Grid.Row="1"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="MailCalContextFlyoutHeaderItems"
                                ItemTemplate="{StaticResource MailCalContextFlyoutHeaderItemTemplate}"
                                Visibility="Collapsed">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MaximumRowsOrColumns="3"
                                        MinColumnSpacing="4"
                                        MinRowSpacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Grid Grid.Row="2">
                                <ListView
                                    x:Name="PART_ItemsList"
                                    MaxHeight="360"
                                    Padding="0"
                                    AutomationProperties.AutomationId="MailCalContextFlyoutItemsList"
                                    IsItemClickEnabled="True"
                                    ItemTemplateSelector="{StaticResource MailCalContextFlyoutTemplateSelector}"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <!--  Rows are commands, not a selection. The container adds no height; each item template owns its own metrics.  -->
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <TextBlock
                                    x:Name="PART_EmptyText"
                                    Margin="12,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="MailCalContextFlyoutEmptyText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="shimmer:MailCalShimmer">
        <Setter Property="Background" Value="{ThemeResource MailCalShimmerBaseBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource MailCalShimmerHighlightBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <!--  A placeholder carries no information, so it stays out of the accessibility tree entirely.  -->
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shimmer:MailCalShimmer">
                    <Border
                        x:Name="PART_ShimmerRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
