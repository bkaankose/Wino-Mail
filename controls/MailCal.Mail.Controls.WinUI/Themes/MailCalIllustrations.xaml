<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette for the empty-state illustrations. The system has four colour roles and no more:
        accent (the subject), warm (the single optimistic note), neutrals (the container), surface.
        
        Accent tints are NOT brushes. Shapes fill with the accent brush and set Opacity (0.20 soft,
        0.45 mid) so the whole family follows SystemAccentColor without a second set of resources.
        
        MailCalIllustrationAccentBrush aliases AccentFillColorDefaultBrush, and NewThemeService.SetBrushResource
        mutates that brush instance in place rather than replacing it. The alias therefore tracks whatever
        accent the active app theme installs (Forest teal, Nighty gold, Garden green) with nothing to sync.
        
        These values are the Default and system-theme baseline. App themes in AppThemes/*.xaml are merged
        into Application.Resources AFTER this dictionary, so any of them may override the surface, line,
        line-soft, warm and shadow keys to sit correctly on a wallpaper. Only Default.xaml deliberately
        overrides nothing: on Mica the baseline is already the right answer.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush" Color="#D6D6E0" />
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush" Color="#E9E9F1" />
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush" Color="#F2B33D" />
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush" Color="#12141428" />
            <SolidColorBrush x:Key="MailCalIllustrationBrandSolidBrush" Color="#3B84E8" />
            <StaticResource x:Key="MailCalIllustrationAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush" Color="#3C3C43" />
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush" Color="#52525D" />
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush" Color="#46464F" />
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush" Color="#F5C05C" />
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush" Color="#52000000" />
            <SolidColorBrush x:Key="MailCalIllustrationBrandSolidBrush" Color="#7FBAFF" />
            <StaticResource x:Key="MailCalIllustrationAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MailCalIllustrationSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalIllustrationLineBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MailCalIllustrationLineSoftBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="MailCalIllustrationWarmBrush" ResourceKey="SystemColorHotlightColorBrush" />
            <StaticResource x:Key="MailCalIllustrationShadowBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailCalIllustrationBrandSolidBrush" ResourceKey="SystemColorHotlightColorBrush" />
            <StaticResource x:Key="MailCalIllustrationAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
