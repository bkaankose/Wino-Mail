<ResourceDictionary
    x:Class="Wino.Mail.Controls.WinoItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:coreIntelligence="using:Wino.Mail.Controls.Core.IntelligenceHeader"
    xmlns:coreSearch="using:Wino.Mail.Controls.Core.SearchBar"
    xmlns:local="using:Wino.Mail.Controls.SearchBar">

    <!--
        Item templates for the controls in Generic.xaml. They live in a class-backed dictionary so
        they can declare x:DataType and use compiled x:Bind, which trimming and Native AOT can
        verify. Generic.xaml has no x:Class and would need reflection-based {Binding} paths.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WinoIntelligenceHeaderSecondaryTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--  A recent search, or the clear-history action that ends the list.  -->
    <DataTemplate x:Key="WinoSearchBarHistoryItemTemplate" x:DataType="local:SearchBarHistoryEntry">
        <Grid
            MinHeight="32"
            Padding="0,4"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <accountIcon:WinoFontIcon
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind Glyph, Mode=OneTime}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{x:Bind Text, Mode=OneTime}"
                TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="WinoIntelligenceHeaderReplyItemTemplate" x:DataType="coreIntelligence:WinoIntelligenceReply">
        <StackPanel Padding="10,7" Spacing="3">
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                Text="{x:Bind Tone, Mode=OneTime}" />
            <TextBlock Text="{x:Bind Text, Mode=OneTime}" TextWrapping="WrapWholeWords" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="WinoIntelligenceHeaderSimilarItemTemplate" x:DataType="coreIntelligence:WinoIntelligenceSimilarMailItem">
        <Grid
            MinHeight="54"
            Padding="8,6"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="30"
                Height="30"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="15">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{x:Bind Initials, Mode=OneTime}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind Subject, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource WinoIntelligenceHeaderSecondaryTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Meta, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="{x:Bind ScoreText, Mode=OneTime}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="WinoSearchBarContactSuggestionTemplate" x:DataType="coreSearch:SearchBarContactSuggestion">
        <Grid
            MinHeight="48"
            Padding="7,4"
            ColumnSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="28"
                Height="28"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Text="{x:Bind Initials, Mode=OneTime}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Address, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WinoIntelligenceLanguageOptionTemplate" x:DataType="coreIntelligence:WinoIntelligenceLanguageOption">
        <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
    </DataTemplate>
</ResourceDictionary>
