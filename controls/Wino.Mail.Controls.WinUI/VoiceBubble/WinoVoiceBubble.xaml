<UserControl
    x:Class="Wino.Mail.Controls.VoiceBubble.WinoVoiceBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:core="using:Wino.Mail.Controls.Core.VoiceBubble"
    HorizontalAlignment="Right"
    VerticalAlignment="Bottom"
    IsTabStop="False"
    KeyDown="ControlKeyDown"
    Loaded="ControlLoaded"
    Unloaded="ControlUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="WinoVoiceBubbleBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
                    <SolidColorBrush x:Key="WinoVoiceBubbleBarBrush" Color="#00A8F8" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBackgroundBrush" ResourceKey="SolidBackgroundFillColorQuarternaryBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="WinoVoiceBubbleBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
                    <SolidColorBrush x:Key="WinoVoiceBubbleBarBrush" Color="#0070D8" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBackgroundBrush" ResourceKey="SolidBackgroundFillColorQuarternaryBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBorderBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="WinoVoiceBubbleBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleBarBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                    <StaticResource x:Key="WinoVoiceBubbleCancelBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Severity glyphs are drawn the way InfoBar draws them: a filled status circle with the symbol on top. The owner chose these system glyphs over WinoIcons so the bubble matches InfoBar.  -->
            <Style x:Key="WinoVoiceBubbleGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource InfoBarIconFontSize}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>

            <!--  A part of the request that can't be done, under its account. Code fills the text block, the grid's second child.  -->
            <DataTemplate x:Key="WinoVoiceBubbleNoticeTemplate">
                <Border
                    Padding="8,6"
                    Background="{ThemeResource InfoBarWarningSeverityBackgroundBrush}"
                    CornerRadius="4">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Top">
                            <TextBlock
                                Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                                Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                            <TextBlock
                                Foreground="{ThemeResource InfoBarWarningSeverityIconForeground}"
                                Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                Text="{StaticResource InfoBarWarningIconGlyph}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </DataTemplate>
            <!--  The header of a step group whose account could not be matched, drawn like InfoBar's warning glyph.  -->
            <DataTemplate x:Key="WinoVoiceBubbleWarningGlyphTemplate">
                <Grid
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                        Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource InfoBarWarningSeverityIconForeground}"
                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                        Text="{StaticResource InfoBarWarningIconGlyph}" />
                </Grid>
            </DataTemplate>

            <!--  A question's choice, or the account header above the choices that belong to it.  -->
            <DataTemplate x:Key="WinoVoiceBubbleChoiceTemplate" x:DataType="core:VoiceBubbleChoice">
                <Grid MinHeight="32" AutomationProperties.Name="{x:Bind Title}">
                    <StackPanel
                        Padding="0,8,0,2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind IsHeader}">
                        <accountIcon:WinoAccountIcon
                            VerticalAlignment="Center"
                            Account="{x:Bind Account}"
                            IconSize="16" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.7"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Grid
                        Padding="0,4"
                        ColumnSpacing="8"
                        Visibility="{x:Bind IsItem}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <accountIcon:WinoAccountIcon
                            VerticalAlignment="Center"
                            Account="{x:Bind Account}"
                            IconSize="20"
                            Visibility="{x:Bind HasItemAccount}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Opacity="0.7"
                                Text="{x:Bind Detail}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasDetail}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </DataTemplate>

            <Style x:Key="WinoVoiceBubbleBarStyle" TargetType="Rectangle">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="23" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{ThemeResource WinoVoiceBubbleBarBrush}" />
                <Setter Property="RadiusX" Value="1.5" />
                <Setter Property="RadiusY" Value="1.5" />
            </Style>

            <!--  Three dots bounce in turn while the plan is being prepared; each repeats on its own one-second cycle.  -->
            <Storyboard x:Name="DotsStoryboard">
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot1Transform"
                    Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.4"
                        Value="-5" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.8"
                        Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot1"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.45" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0.15"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot2Transform"
                    Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.4"
                        Value="-5" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.8"
                        Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0.15"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot2"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.45" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0.3"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot3Transform"
                    Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.4"
                        Value="-5" />
                    <SplineDoubleKeyFrame
                        KeySpline="0.37,0 0.63,1"
                        KeyTime="0:0:0.8"
                        Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames
                    BeginTime="0:0:0.3"
                    RepeatBehavior="Forever"
                    Storyboard.TargetName="Dot3"
                    Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.45" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.4" Value="1" />
                    <LinearDoubleKeyFrame KeyTime="0:0:0.8" Value="0.45" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1" Value="0.45" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <!--
            The host grid carries the enter and exit transforms. The pill's own size is animated in code
            from one state's measured content to the next, and the inner grid clips the content while it does.
        -->
        <Grid
            x:Name="BubbleHost"
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0"
            RenderTransformOrigin="1,1"
            Visibility="Collapsed">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="BubbleTransform" />
            </Grid.RenderTransform>

            <Border
                x:Name="Pill"
                Width="44"
                Height="44"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{ThemeResource WinoVoiceBubbleBackgroundBrush}"
                BorderBrush="{ThemeResource WinoVoiceBubbleBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerEntered="PillPointerEntered"
                PointerExited="PillPointerExited">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid x:Name="PillContent" SizeChanged="PillContentSizeChanged">
                    <StackPanel
                        x:Name="ContentRoot"
                        Padding="5,5,10,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="6">
                        <StackPanel
                            x:Name="HeaderRow"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Grid
                                x:Name="IconHost"
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="IconButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleSendButton"
                                    AutomationProperties.Name="Send"
                                    Click="IconButtonClicked"
                                    CornerRadius="8"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Send">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                Content="{TemplateBinding Content}"
                                                CornerRadius="{TemplateBinding CornerRadius}" />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="ms-appx:///Wino.Mail.Controls.WinUI/Assets/WinoLogo.png" />
                                </Button>

                                <Button
                                    x:Name="CancelButton"
                                    Width="16"
                                    Height="16"
                                    Margin="0,-4,-4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleCancelButton"
                                    AutomationProperties.Name="Cancel"
                                    Background="{ThemeResource WinoVoiceBubbleCancelBackgroundBrush}"
                                    BorderBrush="{ThemeResource WinoVoiceBubbleCancelBorderBrush}"
                                    BorderThickness="1"
                                    Click="CancelButtonClicked"
                                    CornerRadius="8"
                                    IsTabStop="False"
                                    Opacity="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}">
                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path
                                        Width="7"
                                        Height="7"
                                        Data="M0,0 L7,7 M7,0 L0,7"
                                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.6" />
                                </Button>

                                <Grid
                                    x:Name="CompletionBadge"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,-4,-4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <Ellipse Fill="{ThemeResource WinoVoiceBubbleBackgroundBrush}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource InfoBarSuccessSeverityIconBackground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{ThemeResource InfoBarSuccessSeverityIconForeground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarSuccessIconGlyph}" />
                                </Grid>
                            </Grid>

                            <!--  The control adds the bars. They are scaled through UIElement.Scale, so voice levels never cause a layout pass.  -->
                            <StackPanel
                                x:Name="BarsPanel"
                                Height="24"
                                Margin="0,0,2,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Listening"
                                Orientation="Horizontal"
                                Spacing="2.33"
                                Visibility="Collapsed" />

                            <StackPanel
                                x:Name="DotsPanel"
                                Height="24"
                                Padding="4,0,6,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Analyzing"
                                Orientation="Horizontal"
                                Spacing="5"
                                Visibility="Collapsed">
                                <Ellipse
                                    x:Name="Dot1"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource WinoVoiceBubbleBarBrush}"
                                    Opacity="0.45">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="Dot1Transform" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    x:Name="Dot2"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource WinoVoiceBubbleBarBrush}"
                                    Opacity="0.45">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="Dot2Transform" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    x:Name="Dot3"
                                    Width="6"
                                    Height="6"
                                    Fill="{ThemeResource WinoVoiceBubbleBarBrush}"
                                    Opacity="0.45">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="Dot3Transform" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </StackPanel>

                            <StackPanel
                                x:Name="InlineConfirmationPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Grid x:Name="InlineQuestionGlyph" VerticalAlignment="Center">
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="&#xF142;" />
                                </Grid>
                                <TextBlock
                                    x:Name="InlineConfirmationText"
                                    MaxWidth="300"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="InlineConfirmButton"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleConfirmButton"
                                    Click="ConfirmButtonClicked"
                                    Content="{x:Bind ConfirmText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="InlineDeclineButton"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleDeclineButton"
                                    Click="DeclineButtonClicked"
                                    Content="{x:Bind DeclineText, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="StepsConfirmationPanel"
                                Width="300"
                                Padding="0,6,0,0"
                                Spacing="10"
                                Visibility="Collapsed">
                                <StackPanel x:Name="StepsList" Spacing="10" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button
                                        x:Name="StepsConfirmButton"
                                        AutomationProperties.AutomationId="WinoVoiceBubbleStepsConfirmButton"
                                        Click="ConfirmButtonClicked"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="StepsDeclineButton"
                                        AutomationProperties.AutomationId="WinoVoiceBubbleStepsDeclineButton"
                                        Click="DeclineButtonClicked"
                                        Content="{x:Bind DeclineText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Fixed size, so filtering never resizes the card. The list is virtualized and filled in one batch.  -->
                            <StackPanel
                                x:Name="QuestionPanel"
                                Width="300"
                                Padding="0,6,0,0"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Top">
                                        <TextBlock
                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                                            Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                            Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                                        <TextBlock
                                            Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                                            Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                            Text="&#xF142;" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="QuestionTextBlock"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="WinoVoiceBubbleQuestion"
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind QuestionText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </Grid>
                                <TextBox
                                    x:Name="QuestionSearchBox"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleQuestionSearch"
                                    AutomationProperties.Name="{x:Bind QuestionSearchPlaceholder, Mode=OneWay}"
                                    PlaceholderText="{x:Bind QuestionSearchPlaceholder, Mode=OneWay}"
                                    PreviewKeyDown="QuestionSearchBoxPreviewKeyDown"
                                    TextChanged="QuestionSearchBoxTextChanged" />
                                <Grid Height="216">
                                    <ListView
                                        x:Name="QuestionList"
                                        AutomationProperties.AutomationId="WinoVoiceBubbleQuestionChoices"
                                        AutomationProperties.Name="{x:Bind QuestionText, Mode=OneWay}"
                                        ContainerContentChanging="QuestionListContainerContentChanging"
                                        IsItemClickEnabled="True"
                                        ItemClick="QuestionListItemClick"
                                        ItemTemplate="{StaticResource WinoVoiceBubbleChoiceTemplate}"
                                        SelectionChanged="QuestionListSelectionChanged"
                                        SelectionMode="Single" />
                                    <TextBlock
                                        x:Name="QuestionEmptyTextBlock"
                                        Margin="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{x:Bind QuestionEmptyText, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{x:Bind QuestionCaption, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="QuestionCancelButton"
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="WinoVoiceBubbleQuestionCancelButton"
                                        Click="DeclineButtonClicked"
                                        Content="{x:Bind QuestionCancelText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                x:Name="MessagePanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="Collapsed">
                                <Grid
                                    x:Name="SuccessGlyph"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarSuccessSeverityIconBackground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarSuccessSeverityIconForeground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarSuccessIconGlyph}" />
                                </Grid>
                                <Grid
                                    x:Name="FailureGlyph"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarErrorSeverityIconBackground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarIconBackgroundGlyph}" />
                                    <TextBlock
                                        Foreground="{ThemeResource InfoBarErrorSeverityIconForeground}"
                                        Style="{StaticResource WinoVoiceBubbleGlyphStyle}"
                                        Text="{StaticResource InfoBarErrorIconGlyph}" />
                                </Grid>
                                <TextBlock
                                    x:Name="MessageText"
                                    MaxWidth="300"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="RetryButton"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleRetryButton"
                                    Click="RetryButtonClicked"
                                    Content="{x:Bind RetryText, Mode=OneWay}"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="CloseButton"
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="WinoVoiceBubbleDismissButton"
                                    AutomationProperties.Name="Dismiss"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CloseButtonClicked"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Visibility="Collapsed">
                                    <Path
                                        Width="8"
                                        Height="8"
                                        Data="M0,0 L8,8 M8,0 L0,8"
                                        Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="1.6" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!--  Two fixed lines under the waveform. Newer lines push older ones up behind the clip instead of growing the card.  -->
                        <Canvas
                            x:Name="TranscriptViewport"
                            Width="291"
                            Height="36"
                            Margin="4,0,0,0"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed">
                            <Canvas.Clip>
                                <RectangleGeometry Rect="0,0,291,36" />
                            </Canvas.Clip>
                            <TextBlock
                                x:Name="TranscriptText"
                                Width="291"
                                AutomationProperties.AutomationId="WinoVoiceBubbleTranscript"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="13"
                                LineHeight="18"
                                LineStackingStrategy="BlockLineHeight"
                                TextWrapping="WrapWholeWords">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TranscriptOffset" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </StackPanel>

                    <Rectangle
                        x:Name="CountdownBar"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WinoVoiceBubbleBarBrush}"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="BubbleStates">
                <VisualState x:Name="HiddenState" />
                <VisualState x:Name="ListeningState">
                    <VisualState.Setters>
                        <Setter Target="BarsPanel.Visibility" Value="Visible" />
                        <Setter Target="IconButton.IsEnabled" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AnalyzingState">
                    <VisualState.Setters>
                        <Setter Target="DotsPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ConfirmationInlineState">
                    <VisualState.Setters>
                        <Setter Target="InlineConfirmationPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ConfirmationStepsState">
                    <VisualState.Setters>
                        <Setter Target="StepsConfirmationPanel.Visibility" Value="Visible" />
                        <Setter Target="ContentRoot.Padding" Value="12,8,12,12" />
                        <!--  The account headers carry the identity here; the logo beside them never lines up.  -->
                        <Setter Target="IconHost.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="QuestionState">
                    <VisualState.Setters>
                        <Setter Target="QuestionPanel.Visibility" Value="Visible" />
                        <Setter Target="ContentRoot.Padding" Value="12,8,12,12" />
                        <Setter Target="IconHost.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SuccessState">
                    <VisualState.Setters>
                        <Setter Target="MessagePanel.Visibility" Value="Visible" />
                        <Setter Target="SuccessGlyph.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FailedState">
                    <VisualState.Setters>
                        <Setter Target="MessagePanel.Visibility" Value="Visible" />
                        <Setter Target="FailureGlyph.Visibility" Value="Visible" />
                        <Setter Target="CloseButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CollapsingState">
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="5" />
                        <Setter Target="CompletionBadge.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
