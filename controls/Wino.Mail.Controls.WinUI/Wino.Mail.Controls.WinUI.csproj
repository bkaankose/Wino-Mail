<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>Wino.Mail.Controls</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Labs.WinUI.DependencyPropertyGenerator" />
    <!--
      Keep WinUI's transitive SDK tooling aligned with the app project.
      Otherwise solution builds can load an older task assembly from this
      project before importing newer MSIX targets from Wino.Mail.WinUI.
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Mail.Controls.Core\Wino.Mail.Controls.Core.csproj" />
  </ItemGroup>

  <!-- WinoIconCodes (string constants per icon) is generated from the shared icon manifest. -->
  <PropertyGroup>
    <WinoIconCodesNamespace>Wino.Mail.Controls.AccountIcon</WinoIconCodesNamespace>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="WinoIconCodesNamespace" />
    <AdditionalFiles Include="..\..\icons\manifest.json" Link="Icons\manifest.json" />
    <ProjectReference Include="..\..\src\Wino.SourceGenerators\Wino.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WinoIcons.ttf"
             TargetPath="Assets\WinoIcons.ttf"
             CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Wino.Mail.Controls.Tests" />
  </ItemGroup>
</Project>
