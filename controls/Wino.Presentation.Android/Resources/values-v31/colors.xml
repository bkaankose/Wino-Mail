<?xml version="1.0" encoding="utf-8"?>
<!-- The Default theme's accent on Android 12 and later: the device's Material You palette (Material 3 light roles:
     primary accent1 600, primary container accent1 100, secondary container accent2 100). Other themes override the
     accent at runtime (WinoColors.AccentOverride). -->
<resources>
  <color name="wino_accent">@android:color/system_accent1_600</color>
  <color name="wino_on_accent">@android:color/system_accent1_0</color>
  <color name="wino_accent_text">@android:color/system_accent1_700</color>
  <color name="wino_accent_container">@android:color/system_accent1_100</color>
  <color name="wino_secondary_container">@android:color/system_accent2_100</color>
  <color name="wino_primary_container">@android:color/system_accent1_100</color>
</resources>
