<?xml version="1.0" encoding="utf-8"?>
<!-- The Wino zone: one rounded surface over the wallpaper (WinoZoneLayout draws the same shape in code and follows the
     custom theme's Workspace colour). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/wino_zone" />
  <stroke android:width="1dp" android:color="@color/wino_zone_stroke" />
  <corners android:radius="@dimen/wino_zone_radius" />
</shape>
