<?xml version="1.0" encoding="utf-8"?>
<!-- WinoInfoBar content (canvas Components "Info bar"): severity glyph, title and message as one wrapping paragraph,
     the optional action and close buttons. The host WinoInfoBar is a horizontal LinearLayout; the paragraph and the
     action share wino_info_bar_content, which WinoInfoBar stacks vertically when the action would squeeze the text
     (large font scales, narrow windows). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
  <com.winomail.presentation.WinoIconView
      android:id="@+id/wino_info_bar_glyph"
      android:layout_width="20dp"
      android:layout_height="20dp"
      android:layout_marginEnd="10dp" />
  <LinearLayout
      android:id="@+id/wino_info_bar_content"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal">
  <TextView
      android:id="@+id/wino_info_bar_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:lineSpacingExtra="2sp"
      android:textColor="@color/wino_text_primary"
      android:textSize="13sp" />
  <com.google.android.material.button.MaterialButton
      android:id="@+id/wino_info_bar_action"
      style="@style/Widget.Material3.Button.TonalButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minHeight="36dp"
      android:layout_marginStart="@dimen/wino_info_bar_action_spacing"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      android:minWidth="0dp"
      android:paddingStart="12dp"
      android:paddingEnd="12dp"
      android:textAllCaps="false"
      android:textSize="13sp"
      android:visibility="gone"
      app:cornerRadius="@dimen/wino_control_radius"
      xmlns:app="http://schemas.android.com/apk/res-auto" />
  </LinearLayout>
  <ImageButton
      android:id="@+id/wino_info_bar_close"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:layout_marginStart="2dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:scaleType="center"
      android:visibility="gone" />
</merge>
