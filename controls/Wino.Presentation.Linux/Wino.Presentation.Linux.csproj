<Project Sdk="Microsoft.NET.Sdk">
  <!-- GTK 4 and libadwaita presentation helpers for the Linux head: the twin of Wino.Presentation.AppKit.
       No folder may be named after a Gir.Core namespace (Gtk, Gio, Adw, ...): a namespace segment of that name would hide it.
       AllowUnsafeBlocks is for the code the GObject subclass generator emits. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;arm64</Platforms>
    <WinoTargetPlatform>Linux</WinoTargetPlatform>
    <RootNamespace>Wino.Presentation.Linux</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" />
    <PackageReference Include="GirCore.Gtk-4.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Style/wino.css" LogicalName="Wino.Presentation.Linux.Style.wino.css" />
  </ItemGroup>
  <!-- The Classic WinoIcons fonts of the Windows app (icons/README.md), registered for the process by WinoIcons. The set is
       named twice: here and in WinoIcons.SetFamily. -->
  <PropertyGroup>
    <WinoIconFontDirectory>../../src/Wino.Mail.WinUI/Assets</WinoIconFontDirectory>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(WinoIconFontDirectory)/WinoIcons.ttf" Link="Fonts/WinoIcons.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(WinoIconFontDirectory)/WinoIconsColor-Light.ttf" Link="Fonts/WinoIconsColor-Light.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(WinoIconFontDirectory)/WinoIconsColor-Dark.ttf" Link="Fonts/WinoIconsColor-Dark.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Wino.Core.Domain/Wino.Core.Domain.csproj" />
    <ProjectReference Include="../Wino.Presentation.Core/Wino.Presentation.Core.csproj" />
  </ItemGroup>
</Project>
