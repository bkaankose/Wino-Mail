<UserControl
    x:Class="Wino.Editor.WinoMailRenderer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Loaded="WinoMailRenderer_Loaded"
    Unloaded="WinoMailRenderer_Unloaded">
    <Grid Background="Transparent">
        <muxc:WebView2
            x:Name="RendererWebView2"
            AutomationProperties.AutomationId="WinoMailRendererWebView"
            DefaultBackgroundColor="Transparent"
            NavigationCompleted="RendererWebView2_NavigationCompleted"
            NavigationStarting="RendererWebView2_NavigationStarting" />
    </Grid>
</UserControl>
