<Project Sdk="Microsoft.NET.Sdk">
  <!-- UIKit twins of Wino.Mail.Controls.AppKit for the iOS and iPadOS heads: one folder per AppKit folder, the same
       C# surface wherever the concept exists, and the shared models from Wino.Mail.Controls.Core and
       Wino.Presentation.Core. References no platform service project. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RootNamespace>Wino.Mail.Controls.UIKit</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- The repository Release gate skips Apple TFMs; the iOS libraries keep warnings as errors themselves. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Wino.Core.Domain/Wino.Core.Domain.csproj" />
    <ProjectReference Include="../Wino.Presentation.UIKit/Wino.Presentation.UIKit.csproj" />
    <ProjectReference Include="../Wino.Mail.Controls.Core/Wino.Mail.Controls.Core.csproj" />
  </ItemGroup>
</Project>
