<UserControl
    x:Class="MailCal.Editor.MailCalMailRenderer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Loaded="MailCalMailRenderer_Loaded"
    Unloaded="MailCalMailRenderer_Unloaded">
    <Grid Background="Transparent">
        <muxc:WebView2
            x:Name="RendererWebView2"
            AutomationProperties.AutomationId="MailCalMailRendererWebView"
            DefaultBackgroundColor="Transparent"
            NavigationCompleted="RendererWebView2_NavigationCompleted"
            NavigationStarting="RendererWebView2_NavigationStarting" />

        <!--
            The address of the hovered or focused link, reported by the reader page. It replaces the
            WebView2 status bar and is shown only while a link is hovered.
        -->
        <Border
            x:Name="LinkTargetBar"
            MaxWidth="720"
            Margin="8,0,48,8"
            Padding="10,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="LinkTargetText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                MaxLines="1"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>
    </Grid>
</UserControl>
