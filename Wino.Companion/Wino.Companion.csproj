<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != '' and '$(Platform)' != 'AnyCPU'">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <Platforms>x86;x64;arm64</Platforms>
    <RootNamespace>Wino.Companion</RootNamespace>
    <AssemblyName>Wino.Companion</AssemblyName>
    <AssemblyTitle>Wino Mail &amp; Calendar Companion</AssemblyTitle>
    <Product>Wino Mail &amp; Calendar</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableMsixTooling>false</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\Wino_Icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Wino_Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.AppServices.Contracts\Wino.AppServices.Contracts.csproj" />
    <ProjectReference Include="..\Wino.Authentication\Wino.Authentication.csproj" />
    <ProjectReference Include="..\Wino.Core\Wino.Core.csproj" />
    <ProjectReference Include="..\Wino.Services\Wino.Services.csproj" />
  </ItemGroup>
</Project>
