{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wino Mail (Sandbox, Debug x64)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/scripts/development/start-wino.ps1\" -Target sandbox",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Wino Mail (packaged, x64)",
      "type": "coreclr",
      "request": "attach",
      "processName": "Wino.Mail.WinUI",
      "preLaunchTask": "Run Wino Mail (packaged, x64)",
      "justMyCode": true,
      "requireExactSource": true,
      "symbolOptions": {
        "searchPaths": [
          "${workspaceFolder}/src/Wino.Mail.WinUI/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64"
        ],
        "searchMicrosoftSymbolServer": false
      }
    },
    {
      "name": "Debug Wino Mail (macOS, arm64)",
      "type": "coreclr",
      "request": "launch",
      "justMyCode": true,
      "pipeTransport": {
        "pipeProgram": "/bin/zsh",
        "pipeArgs": [
          "-c",
          "${debuggerCommand}"
        ],
        "debuggerPath": "${env:HOME}/.local/share/wino-vsdbg/vsdbg",
        "pipeEnv": {
          "TMPDIR": "${env:HOME}/Library/Containers/com.winomail.macos/Data/tmp"
        },
        "quoteArgs": false
      },
      "preLaunchTask": "Build Wino Mail (macOS, arm64)",
      "program": "${workspaceFolder}/src/Wino.Mail.MacOS/bin/Debug/net10.0-macos/osx-arm64/Wino Mail.app/Contents/MacOS/Wino.Mail.MacOS",
      "cwd": "${workspaceFolder}",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_EnableDiagnostics": "1",
        "TMPDIR": "${env:HOME}/Library/Containers/com.winomail.macos/Data/tmp"
      },
      "requireExactSource": true
    }
  ]
}
