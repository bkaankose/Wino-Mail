{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mail-Cal (Sandbox, Debug x64)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pwsh -NoProfile -File \"${workspaceFolder}/scripts/development/windows/start-mailcal.ps1\" -Target sandbox",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Mail-Cal (packaged, x64)",
      "type": "coreclr",
      "request": "attach",
      "processName": "MailCal.Mail.WinUI",
      "preLaunchTask": "Run Mail-Cal (packaged, x64)",
      "justMyCode": true,
      "requireExactSource": true,
      "symbolOptions": {
        "searchPaths": [
          "${workspaceFolder}/src/MailCal.Mail.WinUI/bin/x64/Debug/net10.0-windows10.0.26100.0/win-x64"
        ],
        "searchMicrosoftSymbolServer": false
      }
    }
  ]
}
