{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Wino Mail (Sandbox, Debug x64)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/development/windows/start-wino.ps1",
        "-Target",
        "sandbox"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Wino Mail (Sandbox, no accounts)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/development/windows/start-wino.ps1",
        "-Target",
        "sandbox",
        "-NoAccounts"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail (Debug, x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.WinUI/Wino.Mail.WinUI.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64",
        "-p:RuntimeIdentifier=win-x64"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Wino Mail (packaged, x64)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/development/windows/start-wino.ps1"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail (macOS, arm64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.MacOS/Wino.Mail.MacOS.csproj",
        "-c",
        "Debug",
        "-r",
        "osx-arm64",
        "-p:WinoTargetRuntimeIdentifier=osx-arm64",
        "-p:WinoTargetPlatform=MacOS",
        "-p:EnableWindowsTargeting=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail (macOS, x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.MacOS/Wino.Mail.MacOS.csproj",
        "-c",
        "Debug",
        "-r",
        "osx-x64",
        "-p:WinoTargetRuntimeIdentifier=osx-x64",
        "-p:WinoTargetPlatform=MacOS",
        "-p:EnableWindowsTargeting=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Prepare Wino Mail macOS debugger",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/scripts/maintenance/macos/setup-macos-debugger.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "Prepare and build Wino Mail (macOS, arm64)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Prepare Wino Mail macOS debugger",
        "Build Wino Mail (macOS, arm64)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build Wino Mail (iOS Simulator, arm64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.iOS/Wino.Mail.iOS.csproj",
        "-c",
        "Debug",
        "-r",
        "iossimulator-arm64",
        "-p:WinoTargetPlatform=iOS",
        "-p:EnableWindowsTargeting=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail iOS solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/WinoMail.iOS.slnx",
        "-c",
        "Debug",
        "-p:WinoTargetPlatform=iOS",
        "-p:EnableWindowsTargeting=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail (Android, Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.Android/Wino.Mail.Android.csproj",
        "-c",
        "Debug",
        "-p:WinoTargetPlatform=Android"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Install and run Wino Mail (Android emulator)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Wino.Mail.Android/Wino.Mail.Android.csproj",
        "-c",
        "Debug",
        "-p:WinoTargetPlatform=Android",
        "-t:Run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build Wino Mail Android solution",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/WinoMail.Android.slnx",
        "-c",
        "Debug",
        "-p:WinoTargetPlatform=Android"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
