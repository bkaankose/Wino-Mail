# Radicale configuration for the Mail-Cal local lab. Plain-text passwords are intentional here.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = plain

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = info
