<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Wino.Services/Wino.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Wino.Platform.Windows/Wino.Platform.Windows.csproj" />
    <!-- Wino.Platform.Windows is compiled against CsWinRT's WinRT.Runtime, which it keeps private; without this the
         generator loads the older one from the Windows SDK projection and fails in the module initializer. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
  </ItemGroup>
</Project>
