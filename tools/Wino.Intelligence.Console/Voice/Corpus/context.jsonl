// Requests about a selection (right-click, Wino Assistant). Plan-level checks; the device applies UsesContext commands to the selection.
{"id": "context.mail-0001", "domain": "context.mail", "text": "archive these", "selection": {"kind": "Mail", "count": 3, "flags": ["unread", "folder-inbox"]}, "expect": {"actions": [["Archive"]], "checks": [{"path": "commands[0].usesContext", "equals": true}, {"path": "commands[0].mail", "empty": true}], "ops": ["Mail.Archive"], "opsContain": ["3 mail(s)"]}}
{"id": "context.mail-0002", "domain": "context.mail", "text": "reply that I'll call tomorrow", "selection": {"kind": "Mail", "count": 1, "flags": ["read", "folder-inbox"], "people": [{"role": "sender", "addressHash": "94d7c1ee0866522c"}]}, "expect": {"actions": [["CreateReplyDraft"]], "checks": [{"path": "commands[0].usesContext", "equals": true}]}}
{"id": "context.mail-0003", "domain": "context.mail", "text": "unsubscribe from all of these", "selection": {"kind": "Mail", "count": 5, "flags": ["can-unsubscribe"]}, "expect": {"actions": [["Unsubscribe"]], "checks": [{"path": "commands[0].usesContext", "equals": true}], "outcome": "Ran"}}
{"id": "context.mail-0004", "domain": "context.mail", "text": "create a task to pay this by Friday", "selection": {"kind": "Mail", "count": 1, "flags": ["attachments"]}, "expect": {"actions": [["CreateTask"]], "checks": [{"path": "commands[0].task.dueDate", "weekday": "Friday"}], "ops": ["TaskAction.CreateTask"], "opsContain": ["Pay"]}}
{"id": "context.mail-0005", "domain": "context.mail", "text": "forward it to jay.kogan@gmail.com", "selection": {"kind": "Mail", "count": 1, "flags": []}, "expect": {"actions": [["CreateReplyDraft"]], "checks": [{"path": "commands[0].draft.kind", "in": ["Forward"]}, {"path": "commands[0].usesContext", "equals": true}]}}
{"id": "context.mail-0006", "domain": "context.mail", "text": "move these to the Projects folder and mark them read", "selection": {"kind": "Mail", "count": 4, "flags": ["unread"]}, "expect": {"actions": [["MoveToFolder", "MarkRead"]], "checks": [{"path": "commands[0].usesContext", "equals": true}, {"path": "commands[0].mailChange.folderName", "contains": "Projects"}], "opsContain": ["Mail.MarkAsRead"]}}
{"id": "context.mail-0007", "domain": "context.mail", "text": "delete my standup tomorrow", "selection": {"kind": "Mail", "count": 1, "flags": []}, "expect": {"actions": [["NotActionable"]]}}
{"id": "context.mail-0008", "domain": "context.mail", "text": "summarize this", "selection": {"kind": "Mail", "count": 1, "flags": []}, "expect": {"actions": [["Summarize"]], "checks": [{"path": "commands[0].usesContext", "equals": true}]}}
{"id": "context.mail-0009", "domain": "context.mail", "text": "bunları okundu yap", "selection": {"kind": "Mail", "count": 6, "flags": ["unread"]}, "expect": {"actions": [["MarkRead"]], "checks": [{"path": "commands[0].usesContext", "equals": true}], "ops": ["Mail.MarkAsRead"], "opsContain": ["6 mail(s)"]}}
{"id": "context.event-0001", "domain": "context.event", "text": "decline it and say I'm travelling", "selection": {"kind": "Event", "count": 1, "flags": ["invitation", "attendees"]}, "expect": {"actions": [["RespondToEvent"]], "checks": [{"path": "commands[0].change.response", "equals": "Decline"}, {"path": "commands[0].usesContext", "equals": true}], "ops": ["Calendar.DeclineEvent"], "opsContain": ["travel"]}}
{"id": "context.event-0002", "domain": "context.event", "text": "email the attendees that I'm running late", "selection": {"kind": "Event", "count": 1, "flags": ["organizer", "attendees"]}, "expect": {"actions": [["CreateDraft"]], "checks": [{"path": "commands[0].draft.to", "contains": "@context.attendees"}], "opsContain": ["miroslawa.kose@gmail.com"]}}
{"id": "context.event-0003", "domain": "context.event", "text": "move it to 4 pm", "selection": {"kind": "Event", "count": 1, "flags": []}, "expect": {"actions": [["UpdateEvent"]], "checks": [{"path": "commands[0].change.newStartTime", "contains": "16:00"}, {"path": "commands[0].usesContext", "equals": true}], "opsContain": ["Calendar.ChangeStartAndEndDate", "16:00"]}}
{"id": "context.event-0004", "domain": "context.event", "text": "remind me 10 minutes before", "selection": {"kind": "Event", "count": 1, "flags": ["online-meeting"]}, "expect": {"actions": [["SetEventReminder"]], "checks": [{"path": "commands[0].change.reminderMinutes", "equals": 10}], "opsContain": ["Local.SaveReminders", "Calendar.UpdateEvent"]}}
{"id": "context.event-0005", "domain": "context.event", "text": "join it", "selection": {"kind": "Event", "count": 1, "flags": ["online-meeting"]}, "expect": {"actions": [["JoinMeeting"]]}}
{"id": "context.event-0006", "domain": "context.event", "text": "cancel the whole series", "selection": {"kind": "Event", "count": 1, "flags": ["recurring", "organizer"]}, "expect": {"actions": [["DeleteEvent"]], "checks": [{"path": "commands[0].change.scope", "in": ["Series"]}], "ops": ["Calendar.DeleteEvent"]}}
{"id": "context.task-0001", "domain": "context.task", "text": "mark these done", "selection": {"kind": "Task", "count": 3, "flags": ["overdue"]}, "expect": {"actions": [["CompleteTask"]], "checks": [{"path": "commands[0].usesContext", "equals": true}], "ops": ["TaskAction.UpdateTask", "TaskAction.UpdateTask", "TaskAction.UpdateTask"], "opsContain": ["IsCompleted=True"]}}
{"id": "context.task-0002", "domain": "context.task", "text": "move it to next Monday and make it important", "selection": {"kind": "Task", "count": 1, "flags": []}, "expect": {"actions": [["UpdateTask"]], "checks": [{"path": "commands[0].taskChange.isImportant", "equals": true}, {"path": "commands[0].taskChange.dueDate", "weekday": "Monday"}], "ops": ["TaskAction.UpdateTask"], "opsContain": ["IsImportant=True"]}}
{"id": "context.task-0003", "domain": "context.task", "text": "block an hour tomorrow at 10 for this", "selection": {"kind": "Task", "count": 1, "flags": []}, "expect": {"actions": [["CreateEvent"]], "ops": ["OpenEventEditor"]}}
{"id": "context.contact-0001", "domain": "context.contact", "text": "add them to my favorites", "selection": {"kind": "Contact", "count": 2, "flags": []}, "expect": {"actions": [["FavoriteContact"]], "checks": [{"path": "commands[0].usesContext", "equals": true}], "ops": ["Local.ApplicationLocalContactRequest", "Local.ApplicationLocalContactRequest"]}}
{"id": "context.contact-0002", "domain": "context.contact", "text": "invite her to lunch tomorrow at 1", "selection": {"kind": "Contact", "count": 1, "flags": []}, "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.attendees", "contains": "@context.contacts"}], "opsContain": ["jay.kogan@gmail.com"]}}
{"id": "context.contact-0003", "domain": "context.contact", "text": "show their mails", "selection": {"kind": "Contact", "count": 1, "flags": []}, "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.sender", "contains": "@context.contacts"}], "ops": ["OpenSearch"], "opsContain": ["jay.kogan@gmail.com"]}}
{"id": "context.folder-0001", "domain": "context.folder", "text": "mark everything here as read", "selection": {"kind": "Folder", "count": 1, "flags": []}, "expect": {"actions": [["MarkFolderRead"]], "checks": [{"path": "commands[0].usesContext", "equals": true}], "ops": ["Folder.MarkAllAsRead"]}}
{"id": "context.folder-0002", "domain": "context.folder", "text": "rename it to Clients", "selection": {"kind": "Folder", "count": 1, "flags": []}, "expect": {"actions": [["RenameFolder"]], "checks": [{"path": "commands[0].folder.newName", "contains": "Clients"}]}}
