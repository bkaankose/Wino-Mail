// Mail actions of the full catalog.
{"id": "catalog.mail-0001", "domain": "catalog.mail", "text": "move the mails from Jay Kogan to the archive folder", "expect": {"actions": [["MoveToFolder"], ["Archive"]], "opsContain": ["Archive"]}}
{"id": "catalog.mail-0002", "domain": "catalog.mail", "text": "move the GitHub mails to the Projects folder", "expect": {"actions": [["MoveToFolder"]], "checks": [{"path": "commands[0].mailChange.folderName", "contains": "project"}, {"path": "commands[0].mail.sender", "contains": "github"}]}}
{"id": "catalog.mail-0003", "domain": "catalog.mail", "text": "mark the last mail from Revolut as spam", "expect": {"actions": [["MarkJunk"]], "checks": [{"path": "commands[0].mail.sender", "contains": "revolut"}], "ops": ["Mail.MoveToJunk"]}}
{"id": "catalog.mail-0004", "domain": "catalog.mail", "text": "the Stripe mail in junk is not spam", "expect": {"actions": [["MarkNotJunk"]], "checks": [{"path": "commands[0].mail.folderSpecialType", "in": ["Junk"]}]}}
{"id": "catalog.mail-0005", "domain": "catalog.mail", "text": "always move mails from Medium to Other", "expect": {"actions": [["MoveToOther"]], "checks": [{"path": "commands[0].mailChange.always", "equals": true}]}}
{"id": "catalog.mail-0006", "domain": "catalog.mail", "text": "move the newest mail from Jay to Focused", "expect": {"actions": [["MoveToFocused"]], "ops": ["Mail.MoveToFocused"]}}
{"id": "catalog.mail-0007", "domain": "catalog.mail", "text": "pin the latest mail from Christian", "expect": {"actions": [["Pin"]], "ops": ["Local.ChangePinnedStatus"], "opsContain": ["True"]}}
{"id": "catalog.mail-0008", "domain": "catalog.mail", "text": "unpin all pinned mails from GitHub", "expect": {"actions": [["Unpin"]], "ops": ["Local.ChangePinnedStatus"], "opsContain": ["False"]}}
{"id": "catalog.mail-0009", "domain": "catalog.mail", "text": "put the invoice mails in the Finance category", "expect": {"actions": [["Categorize"]], "checks": [{"path": "commands[0].mailChange.categoryName", "contains": "Finance"}]}}
{"id": "catalog.mail-0010", "domain": "catalog.mail", "text": "remove the Red category from the mails from Jay", "expect": {"actions": [["Uncategorize"]], "checks": [{"path": "commands[0].mailChange.categoryName", "contains": "Red"}]}}
{"id": "catalog.mail-0011", "domain": "catalog.mail", "text": "send all my drafts", "expect": {"actions": [["SendDrafts"]], "checks": [{"path": "commands[0].mail.folderSpecialType", "in": ["Draft"]}]}}
{"id": "catalog.mail-0012", "domain": "catalog.mail", "text": "send the draft to Jay Kogan", "expect": {"actions": [["SendDrafts"]]}}
{"id": "catalog.mail-0013", "domain": "catalog.mail", "text": "send a mail to Jay saying I'm on my way", "expect": {"actions": [["CreateDraft"]], "opsContain": ["jay.kogan@gmail.com"]}}
{"id": "catalog.mail-0014", "domain": "catalog.mail", "text": "translate the last mail from mBank to English", "expect": {"actions": [["Translate"]], "checks": [{"path": "commands[0].mailChange.language", "contains": "en"}]}}
{"id": "catalog.mail-0015", "domain": "catalog.mail", "text": "translate hello how are you to French", "expect": {"actions": [["NotActionable"]]}}
{"id": "catalog.mail-0016", "domain": "catalog.mail", "text": "analyze my unread mails now", "expect": {"actions": [["AnalyzeMail"]]}}
{"id": "catalog.mail-0017", "domain": "catalog.mail", "text": "copy the verification code from the last Microsoft mail", "expect": {"actions": [["CopyCode"]], "checks": [{"path": "commands[0].mail.limit", "equals": 1}]}}
{"id": "catalog.mail-0018", "domain": "catalog.mail", "text": "what's my latest sign in code", "expect": {"actions": [["CopyCode"]]}}
{"id": "catalog.mail-0019", "domain": "catalog.mail", "text": "unsubscribe from Medium", "expect": {"actions": [["Unsubscribe"]], "checks": [{"path": "commands[0].mail.sender", "contains": "medium"}]}}
{"id": "catalog.mail-0020", "domain": "catalog.mail", "text": "unsubscribe from all the newsletters this week and delete them", "expect": {"actions": [["Unsubscribe", "Delete"]], "checks": [{"path": "commands[1].usesResultOf", "equals": 1}], "opsContain": ["Mail.SoftDelete"]}}
{"id": "catalog.mail-0021", "domain": "catalog.mail", "text": "reply all to the last mail from Christian saying sounds good", "expect": {"actions": [["CreateReplyDraft"]], "checks": [{"path": "commands[0].draft.kind", "in": ["ReplyAll"]}]}}
{"id": "catalog.mail-0022", "domain": "catalog.mail", "text": "forward the last invoice mail to jay.kogan@gmail.com", "expect": {"actions": [["CreateReplyDraft"]], "checks": [{"path": "commands[0].draft.kind", "in": ["Forward"]}, {"path": "commands[0].draft.to", "minCount": 1}]}}
{"id": "catalog.mail-0023", "domain": "catalog.mail", "text": "forward the last mail from Stripe", "expect": {"actions": [["NotActionable"]], "checks": [{"path": "commands[0].missing", "contains": "Recipient"}]}}
{"id": "catalog.mail-0024", "domain": "catalog.mail", "text": "undo that", "expect": {"actions": [["Undo"]], "opsContain": ["UndoLatestQueuedAction"]}}
{"id": "catalog.mail-0025", "domain": "catalog.mail", "text": "check for new mail in my Gmail", "expect": {"actions": [["SyncMail"]], "ops": ["Sync.FullFolders"]}}
{"id": "catalog.mail-0026", "domain": "catalog.mail", "text": "move it to the archive folder", "expect": {"actions": [["NotActionable"], ["Archive"], ["MoveToFolder"]]}}
{"id": "catalog.mail-0027", "domain": "catalog.mail", "text": "move the mails from Jay", "expect": {"actions": [["NotActionable"]], "checks": [{"path": "commands[0].missing", "contains": "Folder"}]}}
{"id": "catalog.mail-0028", "domain": "catalog.mail", "text": "Jay'in maillerini Projeler klasörüne taşı", "expect": {"actions": [["MoveToFolder"]], "checks": [{"path": "commands[0].mailChange.folderName", "contains": "Projeler"}]}}
// Event actions.
{"id": "catalog.event-0001", "domain": "catalog.event", "text": "remind me 15 minutes before the dentist", "expect": {"actions": [["SetEventReminder"]], "checks": [{"path": "commands[0].change.reminderMinutes", "equals": 15}], "ops": ["Local.UpdateCalendarItem", "Local.SaveReminders", "Calendar.UpdateEvent"], "opsContain": ["Dentist"]}}
{"id": "catalog.event-0002", "domain": "catalog.event", "text": "set a reminder a day before the offsite", "expect": {"actions": [["SetEventReminder"]], "checks": [{"path": "commands[0].change.reminderMinutes", "equals": 1440}]}}
{"id": "catalog.event-0003", "domain": "catalog.event", "text": "join my next meeting", "expect": {"actions": [["JoinMeeting"]], "checks": [{"path": "commands[0].events.limit", "equals": 1}]}}
{"id": "catalog.event-0004", "domain": "catalog.event", "text": "cancel the weekly standup for good", "expect": {"actions": [["DeleteEvent"]], "checks": [{"path": "commands[0].change.scope", "in": ["Series"]}]}}
{"id": "catalog.event-0005", "domain": "catalog.event", "text": "move all future standups to 10", "expect": {"actions": [["UpdateEvent"]], "checks": [{"path": "commands[0].change.scope", "in": ["Series"]}]}}
{"id": "catalog.event-0006", "domain": "catalog.event", "text": "delete tomorrow's standup", "expect": {"actions": [["DeleteEvent"]], "checks": [{"path": "commands[0].change.scope", "in": ["Occurrence"]}], "ops": ["Calendar.DeleteEvent"], "opsContain": ["standup"]}}
{"id": "catalog.event-0007", "domain": "catalog.event", "text": "find my 3 pm meeting tomorrow and email the attendees that I'm running late", "expect": {"actions": [["FindEvents", "CreateDraft"]], "checks": [{"path": "commands[1].draft.to", "contains": "@result.1"}]}}
// Task actions.
{"id": "catalog.task-0001", "domain": "catalog.task", "text": "what's on my to do list", "expect": {"actions": [["FindTasks"]], "outcome": "Ran"}}
{"id": "catalog.task-0002", "domain": "catalog.task", "text": "show my overdue tasks", "expect": {"actions": [["FindTasks"]], "checks": [{"path": "commands[0].tasks.overdue", "equals": true}], "outcome": "Ran"}}
{"id": "catalog.task-0003", "domain": "catalog.task", "text": "mark the passport task as done", "expect": {"actions": [["CompleteTask"]], "checks": [{"path": "commands[0].tasks.title", "contains": "passport"}], "ops": ["TaskAction.UpdateTask"], "opsContain": ["IsCompleted=True"]}}
{"id": "catalog.task-0004", "domain": "catalog.task", "text": "reopen the buy milk task", "expect": {"actions": [["ReopenTask"]], "ops": ["TaskAction.UpdateTask"], "opsContain": ["Buy milk"]}}
{"id": "catalog.task-0005", "domain": "catalog.task", "text": "move the passport task to Friday", "expect": {"actions": [["UpdateTask"]], "checks": [{"path": "commands[0].taskChange.dueDate", "weekday": "Friday"}], "ops": ["TaskAction.UpdateTask"], "opsContain": ["passport"]}}
{"id": "catalog.task-0006", "domain": "catalog.task", "text": "make the tax return task important", "expect": {"actions": [["UpdateTask"]], "checks": [{"path": "commands[0].taskChange.isImportant", "equals": true}], "ops": ["TaskAction.UpdateTask"], "opsContain": ["IsImportant=True"]}}
{"id": "catalog.task-0007", "domain": "catalog.task", "text": "add the rent task to my day", "expect": {"actions": [["UpdateTask"]], "checks": [{"path": "commands[0].taskChange.inMyDay", "equals": true}], "ops": ["TaskAction.UpdateTask"], "opsContain": ["MyDayDateUtc"]}}
{"id": "catalog.task-0008", "domain": "catalog.task", "text": "add a step call the embassy to the passport task", "expect": {"actions": [["AddTaskStep"]], "checks": [{"path": "commands[0].taskChange.step", "contains": "embassy"}], "ops": ["TaskAction.CreateStep"], "opsContain": ["embassy"]}}
{"id": "catalog.task-0009", "domain": "catalog.task", "text": "delete the buy milk task", "expect": {"actions": [["DeleteTask"]], "ops": ["TaskAction.DeleteTask"], "opsContain": ["Buy milk"]}}
{"id": "catalog.task-0010", "domain": "catalog.task", "text": "create a task list called Shopping", "expect": {"actions": [["CreateTaskList"]], "checks": [{"path": "commands[0].taskChange.newTitle", "contains": "Shopping"}], "ops": ["TaskAction.CreateList"], "opsContain": ["Shopping"]}}
{"id": "catalog.task-0011", "domain": "catalog.task", "text": "rename the Shopping list to Groceries", "expect": {"actions": [["RenameTaskList"]], "checks": [{"path": "commands[0].tasks.listName", "contains": "Shopping"}, {"path": "commands[0].taskChange.newTitle", "contains": "Groceries"}]}}
{"id": "catalog.task-0012", "domain": "catalog.task", "text": "find my overdue tasks and move them to tomorrow", "expect": {"actions": [["FindTasks", "UpdateTask"]], "checks": [{"path": "commands[1].usesResultOf", "equals": 1}, {"path": "commands[1].taskChange.dueDate", "date": "+1"}], "ops": ["TaskAction.UpdateTask", "TaskAction.UpdateTask"]}}
{"id": "catalog.task-0013", "domain": "catalog.task", "text": "move the passport task to the Shopping list", "expect": {"actions": [["UpdateTask"]], "checks": [{"path": "commands[0].taskChange.listName", "contains": "Shopping"}]}}
{"id": "catalog.task-0014", "domain": "catalog.task", "text": "pasaport görevini tamamlandı olarak işaretle", "expect": {"actions": [["CompleteTask"]]}}
// Contact actions.
{"id": "catalog.contact-0001", "domain": "catalog.contact", "text": "find Jay Kogan's contact", "expect": {"actions": [["FindContacts"]], "checks": [{"path": "commands[0].contacts.name", "contains": "Jay"}], "outcome": "Ran"}}
