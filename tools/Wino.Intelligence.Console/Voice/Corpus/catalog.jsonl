{"id": "catalog.contact-0006", "domain": "catalog.contact", "text": "find Jay's contact and show his mails", "expect": {"actions": [["FindContacts", "SearchMail"]], "checks": [{"path": "commands[1].mail.sender", "contains": "@result.1"}], "opsContain": ["jay.kogan@gmail.com"]}}
{"id": "catalog.contact-0007", "domain": "catalog.contact", "text": "show my favorite contacts", "expect": {"actions": [["FindContacts"]], "checks": [{"path": "commands[0].contacts.favoritesOnly", "equals": true}]}}
