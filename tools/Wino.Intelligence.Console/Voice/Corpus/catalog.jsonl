{"id": "catalog.contact-0003", "domain": "catalog.contact", "text": "add Jay Kogan to the Family list", "expect": {"actions": [["AddContactToList"]], "checks": [{"path": "commands[0].contactChange.listName", "contains": "Family"}], "ops": ["ContactList.UpdateListMembers"], "opsContain": ["Family"]}}
{"id": "catalog.contact-0004", "domain": "catalog.contact", "text": "add Jonas Weber jonas@acme.com to my contacts", "expect": {"actions": [["CreateContact"]], "checks": [{"path": "commands[0].contactChange.email", "contains": "jonas@acme.com"}], "ops": ["Contact.Create"], "opsContain": ["jonas@acme.com"]}}
