// Five commands.
{"id": "catalog.chain-0001", "domain": "catalog.chain", "text": "flag the last mail from Jay, archive the GitHub mails, pin the newest Stripe mail, mark the mBank mails as read and remind me to call the bank tomorrow", "expect": {"actions": [["Flag", "Archive", "Pin", "MarkRead", "CreateTask"]], "opsContain": ["Mail.SetFlag", "Mail.Archive", "Local.ChangePinnedStatus", "TaskAction.CreateTask"]}}
