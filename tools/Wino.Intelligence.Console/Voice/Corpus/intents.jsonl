// Kinds of senders (both modes): the device classifies, the planner only passes the intent.
{"id": "intents.senderkind-0001", "domain": "intents.senderkind", "text": "archive the promotions in my inbox", "expect": {"actions": [["Archive"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}, {"path": "commands[0].mail.sender", "empty": true}]}}
{"id": "intents.senderkind-0002", "domain": "intents.senderkind", "text": "show me the automated mails from today", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Service"]}]}}
{"id": "intents.senderkind-0003", "domain": "intents.senderkind", "text": "only show mails from real people this week", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Person"]}]}}
{"id": "intents.senderkind-0004", "domain": "intents.senderkind", "text": "mark all marketing mails as read", "expect": {"actions": [["MarkRead"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}]}}
{"id": "intents.senderkind-0005", "domain": "intents.senderkind", "text": "delete the notification mails older than a month", "expect": {"actions": [["Delete"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Service"]}, {"path": "commands[0].mail.dateRange", "empty": false}]}}
{"id": "intents.senderkind-0006", "domain": "intents.senderkind", "text": "show the newsletter from NuGet", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}, {"path": "commands[0].mail.sender", "contains": "nuget"}]}}
{"id": "intents.senderkind-0007", "domain": "intents.senderkind", "text": "reklam maillerini arşivle", "expect": {"actions": [["Archive"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}]}}
{"id": "intents.senderkind-0008", "domain": "intents.senderkind", "text": "unread mails from people, not the automated stuff", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Person"]}, {"path": "commands[0].mail.readStatus", "in": ["Unread"]}]}}
{"id": "intents.senderkind-0009", "domain": "intents.senderkind", "text": "show me mails from Jay Kogan", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Any"]}]}}
{"id": "intents.senderkind-0010", "domain": "intents.senderkind", "text": "zeig mir die Werbung von gestern", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}]}}
{"id": "intents.senderkind-0011", "domain": "intents.senderkind", "text": "archive the promos", "expectPrivate": {"actions": [["Archive"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter", "Any"]}]}, "expectPersonal": {"actions": [["Archive"]], "checks": [{"path": "commands[0].mail.senderKind", "in": ["Newsletter"]}], "questions": []}}
// Free slots: the device picks the gap across all calendars.
{"id": "intents.slot-0001", "domain": "intents.slot", "text": "find a free hour tomorrow afternoon for a call with Ana", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot.from", "date": "+1"}, {"path": "commands[0].event.slot.windowStart", "contains": "12:00"}, {"path": "commands[0].event.slot.durationMinutes", "equals": 60}]}}
{"id": "intents.slot-0002", "domain": "intents.slot", "text": "move the budget review to my next free slot", "expect": {"actions": [["UpdateEvent"]], "checks": [{"path": "commands[0].change.slot", "empty": false}, {"path": "commands[0].events.title", "contains": "budget"}]}}
{"id": "intents.slot-0003", "domain": "intents.slot", "text": "schedule 30 minutes for gym on Friday when I'm free", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot.from", "weekday": "Friday"}, {"path": "commands[0].event.slot.durationMinutes", "equals": 30}]}}
{"id": "intents.slot-0004", "domain": "intents.slot", "text": "find two hours during work hours tomorrow for planning", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot.withinWorkingHours", "equals": true}, {"path": "commands[0].event.slot.durationMinutes", "equals": 120}]}}
{"id": "intents.slot-0005", "domain": "intents.slot", "text": "put a focus block in the first free spot this week", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot", "empty": false}]}}
{"id": "intents.slot-0006", "domain": "intents.slot", "text": "reschedule the dentist to the latest free time on Friday", "expect": {"actions": [["UpdateEvent"]], "checks": [{"path": "commands[0].change.slot.preference", "in": ["Latest"]}, {"path": "commands[0].change.slot.from", "weekday": "Friday"}]}}
{"id": "intents.slot-0007", "domain": "intents.slot", "text": "yarın öğleden sonra boş bir saate Ahmet ile toplantı koy", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot.from", "date": "+1"}]}}
{"id": "intents.slot-0008", "domain": "intents.slot", "text": "move my dentist appointment to 3 pm on Friday", "expect": {"actions": [["UpdateEvent"]], "checks": [{"path": "commands[0].change.slot", "empty": true}, {"path": "commands[0].change.newStartTime", "contains": "15:00"}]}}
{"id": "intents.slot-0009", "domain": "intents.slot", "text": "lunch with Leo tomorrow at 1", "expect": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.slot", "empty": true}]}}
// Personal: senders, groups, sender kinds and defaults the user taught.
{"id": "intents.learned-0001", "domain": "intents.learned", "text": "what did the package registry send me", "mode": "Personal", "expect": {"actions": [["SearchMail"]], "checks": [{"path": "commands[0].mail.sender", "contains": "nuget.org"}], "questions": []}}
{"id": "intents.learned-0002", "domain": "intents.learned", "text": "mail the team that the release is out", "expectPrivate": {"actions": [["NotActionable"], ["CreateDraft"]]}, "expectPersonal": {"actions": [["CreateDraft"]], "checks": [{"path": "commands[0].draft.to", "count": 2}], "questions": []}}
{"id": "intents.learned-0003", "domain": "intents.learned", "text": "invite the team to a review tomorrow at 3", "expectPrivate": {"actions": [["CreateEvent"], ["NotActionable"]]}, "expectPersonal": {"actions": [["CreateEvent"]], "checks": [{"path": "commands[0].event.attendees", "count": 2}], "questions": []}}
{"id": "intents.learned-0004", "domain": "intents.learned", "text": "show the mails from my insurance", "mode": "Personal", "answers": ["NuGet"], "expect": {"actions": [["SearchMail"]], "questions": ["Sender"]}}
{"id": "intents.learned-0005", "domain": "intents.learned", "text": "write to my family that I'll be late", "mode": "Personal", "answers": ["Jay+Christian"], "expect": {"actions": [["CreateDraft"]], "questions": ["Group"], "checks": [{"path": "commands[0].draft.to", "count": 2}]}}
{"id": "intents.learned-0006", "domain": "intents.learned", "text": "remind me to renew the passport", "mode": "Personal", "expect": {"actions": [["CreateTask"]], "questions": [], "account": "gmail"}}
{"id": "intents.learned-0007", "domain": "intents.learned", "text": "write to Jay Kogan about the invoice", "mode": "Personal", "expect": {"actions": [["CreateDraft"]], "questions": [], "account": "outlook"}}
{"id": "intents.learned-0008", "domain": "intents.learned", "text": "show me flagged mails in my second account", "mode": "Personal", "expect": {"actions": [["SearchMail"]], "questions": []}}
