<Project>
  <!-- WinUI pass 1 touches an empty App.g.cs on every build. It contains no code,
       but its timestamp invalidates XamlPreCompile and the expensive second pass. -->
  <Target Name="WinoPrepareXamlPreCompile" BeforeTargets="XamlPreCompile"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup Condition="Exists('$(IntermediateOutputPath)App.g.cs')">
      <_WinoXamlPlaceholderPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)App.g.cs'))</_WinoXamlPlaceholderPath>
      <_WinoXamlPlaceholderLength>$([System.IO.File]::ReadAllText('$(_WinoXamlPlaceholderPath)').Length)</_WinoXamlPlaceholderLength>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WinoXamlPlaceholderPath)' != '' and '$(_WinoXamlPlaceholderLength)' == '0'">
      <_WinoEmptyXamlPlaceholder Include="@(Compile)"
          Condition="'%(Compile.FullPath)' == '$(_WinoXamlPlaceholderPath)'" />
      <Compile Remove="@(_WinoEmptyXamlPlaceholder)" />
    </ItemGroup>
    <!-- SDK XamlPreCompile uses DebugType=none and PdbFile="", but declares the
         final compiler's PDB as an output. It cannot update that file. -->
    <ItemGroup>
      <_WinoFinalDebugSymbols Include="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
    </ItemGroup>
  </Target>
  <Target Name="WinoRestoreXamlCompileItems" BeforeTargets="MarkupCompilePass2;CoreCompile">
    <ItemGroup>
      <Compile Include="@(_WinoEmptyXamlPlaceholder)" />
      <_WinoEmptyXamlPlaceholder Remove="@(_WinoEmptyXamlPlaceholder)" />
      <_DebugSymbolsIntermediatePath Include="@(_WinoFinalDebugSymbols)" />
      <_WinoFinalDebugSymbols Remove="@(_WinoFinalDebugSymbols)" />
    </ItemGroup>
  </Target>

  <!-- dotnet run must activate the checked-in package, never execute its EXE. -->
  <Target Name="WinoSetRunCommand" AfterTargets="ComputeRunArguments">
    <Error Condition="'$(Configuration)' != 'Debug'" Text="Wino runtime checks require Debug. Release supports compile-only verification." />
    <PropertyGroup>
      <RunCommand>pwsh</RunCommand>
      <RunArguments>-NoProfile -File &quot;$(MSBuildThisFileDirectory)Run-WinoDebug.ps1&quot; &quot;$(MSBuildProjectFullPath)&quot; &quot;$(RuntimeIdentifier)&quot; &quot;$(Platform)&quot; --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
  </Target>
</Project>
