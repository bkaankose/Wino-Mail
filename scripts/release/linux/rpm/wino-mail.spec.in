# Generated by scripts/release/linux/build-rpm.sh. It packages a staged tree (wino_root) and builds nothing.
# The Native AOT executable and the bundled libraries are already stripped; rpmbuild must not strip, split debug
# information or add build-id links, and the bundled libraries must not become Provides of the system.
%global debug_package %{nil}
%global __strip /bin/true
%global __os_install_post %{nil}
%global _build_id_links none

Name:           wino-mail
Version:        @VERSION@
Release:        1
Summary:        @SUMMARY@
License:        GPL-3.0-only AND Apache-2.0 AND BSD-3-Clause AND MIT
URL:            https://www.winomail.app
Packager:       @MAINTAINER@
ExclusiveArch:  x86_64
AutoReqProv:    no

Requires:       gtk4 >= 4.20
Requires:       libadwaita >= 1.8
Requires:       webkitgtk6.0
Requires:       libsecret
Requires:       libcanberra
Requires:       libicu
Requires:       openssl-libs
Requires:       glibc >= 2.38
Requires:       libstdc++
Requires:       libgcc
Requires:       ca-certificates
Requires:       hicolor-icon-theme
Recommends:     gnome-keyring
Recommends:     sound-theme-freedesktop
Recommends:     xdg-desktop-portal
Recommends:     google-noto-color-emoji-fonts
Recommends:     krb5-libs
Recommends:     enchant2
Suggests:       google-noto-sans-cjk-fonts
Suggests:       hunspell-en-US

%description
@DESCRIPTION@

%install
mkdir -p %{buildroot}
cp -a --no-preserve=ownership "%{wino_root}/usr" %{buildroot}/

%files
%defattr(-,root,root,-)
%dir %{_datadir}/licenses/wino-mail
%license %{_datadir}/licenses/wino-mail/*
%{_bindir}/wino-mail
%{_prefix}/lib/wino-mail
%{_datadir}/applications/app.winomail.Mail.desktop
%{_datadir}/icons/hicolor/*/apps/app.winomail.Mail.png
%{_datadir}/metainfo/app.winomail.Mail.metainfo.xml
%{_mandir}/man1/wino-mail.1.gz

%changelog
@CHANGELOG@
