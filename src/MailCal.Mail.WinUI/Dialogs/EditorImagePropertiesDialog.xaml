<ContentDialog
    x:Class="MailCal.Dialogs.EditorImagePropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.Composer_ImageProperties, Mode=OneTime}"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonClick="ApplyClicked"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Apply, Mode=OneTime}"
    Style="{StaticResource MailCalDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBox
            x:Name="AltTextBox"
            AutomationProperties.AutomationId="EditorImageAltTextBox"
            Header="{x:Bind domain:Translator.Composer_ImageAltText, Mode=OneTime}"
            PlaceholderText="{x:Bind domain:Translator.Composer_ImageAltTextPlaceholder, Mode=OneTime}" />
        <TextBox
            x:Name="UrlTextBox"
            AutomationProperties.AutomationId="EditorImageLinkUrlTextBox"
            Header="{x:Bind domain:Translator.Composer_LinkUrl, Mode=OneTime}"
            PlaceholderText="{x:Bind domain:Translator.Composer_LinkUrlPlaceholder, Mode=OneTime}" />
        <CheckBox
            x:Name="OpenInNewWindowCheckBox"
            AutomationProperties.AutomationId="EditorImageOpenInNewWindowCheckBox"
            Content="{x:Bind domain:Translator.Composer_OpenLinkInNewWindow, Mode=OneTime}"
            IsChecked="True" />
    </StackPanel>
</ContentDialog>
