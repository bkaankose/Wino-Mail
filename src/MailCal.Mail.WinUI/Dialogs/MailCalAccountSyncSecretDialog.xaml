<ContentDialog
    x:Class="MailCal.Dialogs.MailCalAccountSyncSecretDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    DefaultButton="Primary"
    PrimaryButtonClick="UnlockClicked"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Style="{StaticResource MailCalDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <TextBlock
            x:Name="DescriptionTextBlock"
            AutomationProperties.AutomationId="SyncSecretDescription"
            TextWrapping="WrapWholeWords" />

        <PasswordBox
            x:Name="SecretBox"
            AutomationProperties.AutomationId="SyncSecretBox"
            KeyDown="SecretBox_KeyDown"
            PasswordChanged="SecretChanged" />

        <PasswordBox
            x:Name="ConfirmBox"
            AutomationProperties.AutomationId="SyncSecretConfirmBox"
            KeyDown="SecretBox_KeyDown"
            PasswordChanged="SecretChanged"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="ErrorTextBlock"
            AutomationProperties.AutomationId="SyncSecretError"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
