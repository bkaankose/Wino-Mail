<ResourceDictionary
    x:Class="MailCal.Mail.WinUI.Styles.Mail.MailListItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MailCal.Controls"
    xmlns:coreControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:enums="using:MailCal.Core.Domain.Enums"
    xmlns:helpers="using:MailCal.Helpers"
    xmlns:mail="using:MailCal.Core.Domain.Entities.Mail"
    xmlns:mailListCore="using:MailCal.Mail.Controls.Core"
    xmlns:primitives="using:MailCal.Mail.Controls.Primitives"
    xmlns:selectors="using:MailCal.Selectors"
    xmlns:viewModelData="using:MailCal.Mail.ViewModels.Data">

    <!--
        Mail row body templates shared by the mail list and the Settings message list preview.
        Only page independent content lives here: the container level *MailRowTemplate wrappers stay
        on MailListPage because they wire page code behind handlers.
    -->

    <DataTemplate x:Key="DetailedMailCategoryTemplate" x:DataType="mail:MailCategory">
        <Border
            Margin="0,0,4,0"
            Padding="6,2"
            Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneTime}"
            CornerRadius="4">
            <TextBlock
                Foreground="{x:Bind helpers:XamlHelpers.GetCategoryTextBrush(TextColorHex, BackgroundColorHex), Mode=OneTime}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Name, Mode=OneTime}"
                TextTrimming="CharacterEllipsis" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CompactMailCategoryTemplate" x:DataType="mail:MailCategory">
        <Ellipse
            Width="8"
            Height="8"
            Margin="0,0,4,0"
            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneTime}" />
    </DataTemplate>

    <!--
        Intelligence metadata shares the category tile shape so a row reads as one strip of tiles.
        The leading mark is what separates it from a category: a per-kind glyph where the tile has
        one, and the neutral intelligence dot where it does not.
    -->

    <!--  Compact rows drop labels the same way categories collapse to a dot there.  -->

    <selectors:MailRowTileTemplateSelector x:Key="DetailedMailRowTileTemplateSelector" CategoryTemplate="{StaticResource DetailedMailCategoryTemplate}" />

    <selectors:MailRowTileTemplateSelector x:Key="CompactMailRowTileTemplateSelector" CategoryTemplate="{StaticResource CompactMailCategoryTemplate}" />

    <DataTemplate x:Key="SubjectThreadChevronTemplate" x:DataType="mailListCore:MailListRow">
        <Grid
            AutomationProperties.AutomationId="MailThreadChevron"
            Background="Transparent"
            PointerPressed="ThreadChevronPointerPressed">
            <coreControls:MailCalFontIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{ThemeResource MailCalIconFontFamily}"
                FontSize="10"
                Icon="{x:Bind helpers:XamlHelpers.GetThreadChevronGlyph(IsExpanded), Mode=OneWay}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CompactSingleMailItemTemplate" x:DataType="viewModelData:MailItemViewModel">
        <Grid
            MinHeight="56"
            Padding="0,4,8,4"
            x:DefaultBindMode="OneWay"
            Background="Transparent">
            <Grid VerticalAlignment="Center" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AccountNicknameIndicatorControl
                        x:Name="LeftAccountNicknameIndicator"
                        Margin="0,0,4,0"
                        x:Load="{x:Bind helpers:XamlHelpers.IsAccountNicknameVisible(AccountNickname, AccountNicknamePosition, enums:AccountNicknamePosition.Left), Mode=OneWay}"
                        AccountColorHex="{x:Bind AccountColorHex, Mode=OneWay}"
                        AccountNickname="{x:Bind AccountNickname, Mode=OneWay}" />
                    <TextBlock
                        x:Name="DraftTagTextBlock"
                        Grid.Column="1"
                        Margin="0,0,4,0"
                        x:Load="{x:Bind IsDraft, Mode=OneWay}"
                        Foreground="{StaticResource DeleteBrush}"
                        Text="{x:Bind helpers:XamlHelpers.GetDraftTagText(), Mode=OneTime}" />
                    <TextBlock
                        Grid.Column="2"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetMailItemSenderFontWeightByReadState(IsRead), Mode=OneWay}"
                        Text="{x:Bind FromName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityConverter(FromName), Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetMailItemSenderFontWeightByReadState(IsRead), Mode=OneWay}"
                        Text="{x:Bind FromAddress, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityReversedConverter(FromName), Mode=OneWay}" />
                    <controls:AccountNicknameIndicatorControl
                        x:Name="RightAccountNicknameIndicator"
                        Grid.Column="3"
                        Margin="0,0,4,0"
                        x:Load="{x:Bind helpers:XamlHelpers.IsAccountNicknameVisible(AccountNickname, AccountNicknamePosition, enums:AccountNicknamePosition.Right), Mode=OneWay}"
                        AccountColorHex="{x:Bind AccountColorHex, Mode=OneWay}"
                        AccountNickname="{x:Bind AccountNickname, Mode=OneWay}" />
                    <!--  The one indicator line of every template. It owns its column so it never overlaps mail text.  -->
                    <StackPanel
                        x:Name="MailIndicatorsPanel"
                        Grid.Column="4"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <ItemsControl
                            x:Name="CategoriesItemsControl"
                            VerticalAlignment="Center"
                            x:Load="{x:Bind HasRowTiles, Mode=OneWay}"
                            IsHitTestVisible="False"
                            ItemTemplateSelector="{StaticResource CompactMailRowTileTemplateSelector}"
                            ItemsSource="{x:Bind RowTiles, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            VerticalAlignment="Center"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ReadReceiptDisplayText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityConverter(ReadReceiptDisplayText), Mode=OneWay}" />
                        <ContentPresenter
                            x:Name="AttachmentSymbolPresenter"
                            VerticalAlignment="Center"
                            x:Load="{x:Bind HasAttachments, Mode=OneWay}"
                            ContentTemplate="{StaticResource AttachmentSymbolControlTemplate}" />
                        <ContentPresenter
                            x:Name="FlaggedSymbolPresenter"
                            VerticalAlignment="Center"
                            x:Load="{x:Bind IsFlagged, Mode=OneWay}"
                            ContentTemplate="{StaticResource FlaggedSymbolControlTemplate}" />
                        <ProgressRing
                            x:Name="BusyProgressRing"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            x:Load="{x:Bind IsBusy, Mode=OneWay}"
                            IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Thread heads show the chevron before the subject; the body keeps the same left edge as single mails.  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="SubjectThreadChevron"
                            Width="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Stretch"
                            ContentTemplate="{StaticResource SubjectThreadChevronTemplate}"
                            Loaded="ThreadChevronLoaded"
                            Unloaded="ThreadChevronUnloaded"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ReadSubjectTextBlock"
                            Grid.Column="1"
                            x:Load="{x:Bind IsRead, Mode=OneWay}"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind helpers:XamlHelpers.GetMailItemSubjectForListing(Subject), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="UnreadSubjectTextBlock"
                            Grid.Column="1"
                            x:Load="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(IsRead), Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemAccentColor}"
                            Text="{x:Bind helpers:XamlHelpers.GetMailItemSubjectForListing(Subject), Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <StackPanel
                        x:Name="HoverMetadataPrimary"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind helpers:XamlHelpers.GetMailItemDisplaySummaryForListing(IsDraft, CreationDate, helpers:XamlHelpers.CurrentMailTimeFormatPreference), Mode=OneWay}" />
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource SystemAccentColor}"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsRead), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

