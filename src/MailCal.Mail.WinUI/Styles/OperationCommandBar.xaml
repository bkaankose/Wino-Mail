<ResourceDictionary
    x:Class="MailCal.Mail.WinUI.Styles.OperationCommandBarResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MailCal.Mail.WinUI.Controls">

    <Style BasedOn="{StaticResource DefaultCommandBarStyle}" TargetType="controls:OperationCommandBar">
        <Setter Property="DefaultLabelPosition" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="IsDynamicOverflowEnabled" Value="True" />
        <Setter Property="OverflowButtonVisibility" Value="Auto" />
    </Style>

    <DataTemplate x:Key="OperationCommandBarMailOperationTemplate" x:DataType="controls:OperationCommandBarMenuOperationItemViewModel">
        <AppBarButton
            MinWidth="40"
            AutomationProperties.AutomationId="XBindToolTip"
            AutomationProperties.Name="{x:Bind ToolTip}"
            IsEnabled="{x:Bind IsEnabled}"
            Label="{x:Bind Label}"
            LabelPosition="{x:Bind LabelPosition}"
            ToolTipService.ToolTip="{x:Bind ToolTip}">
            <AppBarButton.Icon>
                <controls:MailCalFontIcon FontFamily="{ThemeResource MailCalIconFontFamily}" Icon="{x:Bind Icon}" />
            </AppBarButton.Icon>
        </AppBarButton>
    </DataTemplate>

    <DataTemplate x:Key="OperationCommandBarFolderOperationTemplate" x:DataType="controls:OperationCommandBarMenuOperationItemViewModel">
        <AppBarButton
            MinWidth="40"
            AutomationProperties.AutomationId="XBindToolTip2"
            AutomationProperties.Name="{x:Bind ToolTip}"
            IsEnabled="{x:Bind IsEnabled}"
            Label="{x:Bind Label}"
            LabelPosition="{x:Bind LabelPosition}"
            ToolTipService.ToolTip="{x:Bind ToolTip}">
            <AppBarButton.Icon>
                <controls:MailCalFontIcon FontFamily="{ThemeResource MailCalIconFontFamily}" Icon="{x:Bind Icon}" />
            </AppBarButton.Icon>
        </AppBarButton>
    </DataTemplate>


    <DataTemplate x:Key="OperationCommandBarThemeToggleTemplate" x:DataType="controls:OperationCommandBarThemeItemViewModel">
        <AppBarButton
            MinWidth="40"
            AutomationProperties.AutomationId="XBindToolTip4"
            AutomationProperties.Name="{x:Bind ToolTip}"
            LabelPosition="Collapsed"
            ToolTipService.ToolTip="{x:Bind ToolTip}">
            <AppBarButton.Icon>
                <controls:MailCalFontIcon FontFamily="{ThemeResource MailCalIconFontFamily}" Icon="{x:Bind Icon}" />
            </AppBarButton.Icon>
        </AppBarButton>
    </DataTemplate>

    <DataTemplate x:Key="OperationCommandBarSeparatorTemplate">
        <AppBarSeparator />
    </DataTemplate>
</ResourceDictionary>
