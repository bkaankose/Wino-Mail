<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Blossom</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Blossom.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Blossom.jpg</x:String>

    <ImageBrush x:Key="MailCalApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Blossom wallpaper, forced Light. Rose-cast neutrals; amber is kept as warm spring light.
            -->
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush">#EBCEDC</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush">#F8E8EF</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush">#14201420</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#FAE0EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33FAE0EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#40E84393</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66FAE0EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#FDF5F8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#F8E4EC</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#6A4453</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#815A69</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#D3ABBB</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush">#40323A</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush">#58444E</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush">#4A3942</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#592A1720</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#222A1720</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4DE84393</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#592A1720</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#1D1219</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#291A22</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#38242E</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#E2C9D4</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#C8ABB8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#614654</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CalendarDefaultHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarHoverHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarSelectedHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarWorkHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailListHeaderBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailCalIllustrationLineBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailCalIllustrationLineSoftBrush" ResourceKey="SystemColorGrayTextBrush" />
            <StaticResource x:Key="MailCalIllustrationShadowBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailCalIllustrationSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailCalIllustrationWarmBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
