<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Skyline</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Skyline.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Skyline.jpg</x:String>

    <ImageBrush x:Key="MailCalApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Night city wallpaper, forced Dark. Amber stays as the lit windows carrying the warm role.
            -->
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush">#C6D6E4</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush">#E4EDF5</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush">#14141E28</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#D7E7F5</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33D7E7F5</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#400097E6</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66D7E7F5</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F3F8FC</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E2EDF6</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#43566A</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#596C81</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#AABCCE</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="MailCalIllustrationSurfaceBrush">#2A3644</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineBrush">#3C4C5E</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationLineSoftBrush">#33404F</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="MailCalIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#590B1726</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#220B1726</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4D0097E6</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#590B1726</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#091320</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#13202E</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#1B2C3D</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#C3D2E0</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#A5B7C8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#3B4E63</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CalendarDefaultHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarHoverHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarSelectedHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarWorkHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailListHeaderBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailCalIllustrationLineBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailCalIllustrationLineSoftBrush" ResourceKey="SystemColorGrayTextBrush" />
            <StaticResource x:Key="MailCalIllustrationShadowBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailCalIllustrationSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailCalIllustrationWarmBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
