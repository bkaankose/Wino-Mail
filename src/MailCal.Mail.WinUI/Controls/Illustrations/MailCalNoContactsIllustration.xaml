<UserControl
    x:Class="MailCal.Controls.Illustrations.MailCalNoContactsIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--
        "Fanned blank cards." The address book has nothing in it yet.
        
        Two constraints shaped this one. It shares the screen with MailCalNoContactSelectedIllustration
        in the detail pane whenever the list is empty, so it deliberately avoids that control's
        row-of-circles silhouette. And an accent "Add your first contact" button sits directly
        below it, so accent is held back to a single soft tint on the middle card: the button stays
        the loudest accent in the panel.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="128" Height="128">
            <Ellipse
                Canvas.Left="28"
                Canvas.Top="105"
                Width="72"
                Height="10"
                Fill="{ThemeResource MailCalIllustrationShadowBrush}" />

            <!--  The two cards behind, fanned out  -->
            <Rectangle
                Canvas.Left="34"
                Canvas.Top="34"
                Width="60"
                Height="68"
                Fill="{ThemeResource MailCalIllustrationLineSoftBrush}"
                RadiusX="10"
                RadiusY="10">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-13" CenterX="30" CenterY="34" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle
                Canvas.Left="34"
                Canvas.Top="34"
                Width="60"
                Height="68"
                Fill="{ThemeResource MailCalIllustrationAccentBrush}"
                Opacity="0.2"
                RadiusX="10"
                RadiusY="10">
                <Rectangle.RenderTransform>
                    <RotateTransform Angle="11" CenterX="30" CenterY="34" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <!--  Front card, still blank  -->
            <Rectangle
                Canvas.Left="34"
                Canvas.Top="30"
                Width="60"
                Height="68"
                Fill="{ThemeResource MailCalIllustrationSurfaceBrush}"
                RadiusX="10"
                RadiusY="10"
                Stroke="{ThemeResource MailCalIllustrationLineBrush}"
                StrokeThickness="1.5" />
            <Ellipse
                Canvas.Left="53"
                Canvas.Top="41"
                Width="22"
                Height="22"
                Fill="{ThemeResource MailCalIllustrationLineSoftBrush}" />
            <Rectangle
                Canvas.Left="46"
                Canvas.Top="72"
                Width="36"
                Height="6"
                Fill="{ThemeResource MailCalIllustrationLineSoftBrush}"
                RadiusX="3"
                RadiusY="3" />
            <Rectangle
                Canvas.Left="54"
                Canvas.Top="84"
                Width="20"
                Height="5"
                Fill="{ThemeResource MailCalIllustrationLineSoftBrush}"
                RadiusX="2.5"
                RadiusY="2.5" />
        </Canvas>
    </Viewbox>
</UserControl>
