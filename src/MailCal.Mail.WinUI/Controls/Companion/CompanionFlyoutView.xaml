<UserControl
    x:Class="MailCal.Mail.WinUI.Controls.Companion.CompanionFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:companion="using:MailCal.Mail.ViewModels.Companion"
    xmlns:coreControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:helpers="using:MailCal.Helpers"
    x:Name="Root"
    Width="400"
    MinHeight="460"
    MaxHeight="720"
    IsTabStop="True"
    KeyDown="Root_KeyDown">
    <Grid Background="{ThemeResource CompanionFlyoutBackgroundBrush}">
        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionInitializingState"
            Visibility="{x:Bind ViewModel.InitializingVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="42"
                    Height="42"
                    AutomationProperties.AutomationId="CompanionInitializingProgress"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_InitializingTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_InitializingDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionNoAccountsState"
            Visibility="{x:Bind ViewModel.NoAccountsVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <coreControls:MailCalFontIcon
                    FontSize="48"
                    Icon="Person"
                    IsHitTestVisible="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_NoAccountsTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_NoAccountsDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="CompanionLaunchMailCalNoAccountsButton"
                    Command="{x:Bind ViewModel.OpenMailCalCommand}"
                    Content="{x:Bind domain:Translator.Companion_OpenMailCal, Mode=OneTime}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionUnavailableState"
            Visibility="{x:Bind ViewModel.UnavailableVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <coreControls:MailCalFontIcon
                    FontSize="48"
                    Icon="DismissCircle"
                    IsHitTestVisible="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_UnavailableDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="CompanionRetryButton"
                        Click="Retry_Click"
                        Content="{x:Bind domain:Translator.Buttons_TryAgain, Mode=OneTime}" />
                    <Button
                        AutomationProperties.AutomationId="CompanionLaunchMailCalUnavailableButton"
                        Command="{x:Bind ViewModel.OpenMailCalCommand}"
                        Content="{x:Bind domain:Translator.Companion_OpenMailCal, Mode=OneTime}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid AutomationProperties.AutomationId="CompanionReadyState" Visibility="{x:Bind ViewModel.ReadyVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CalendarView
                x:Name="MonthCalendar"
                Margin="8,8,8,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="CompanionMonthCalendar"
                AutomationProperties.Name="{x:Bind domain:Translator.Companion_MonthCalendar, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                IsTodayHighlighted="True"
                SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"
                SelectionMode="Single" />

            <Grid
                Grid.Row="1"
                Padding="16,8,8,6"
                BorderBrush="{ThemeResource CompanionDividerBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="CompanionSelectedDayText"
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.SelectedDateText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Height="32"
                    AutomationProperties.AutomationId="CompanionTodayButton"
                    Command="{x:Bind ViewModel.GoToTodayCommand}"
                    Content="{x:Bind domain:Translator.Today, Mode=OneTime}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Visibility="{x:Bind ViewModel.TodayButtonVisibility, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="CompanionOpenCalendarButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Companion_OpenCalendar, Mode=OneTime}"
                    Command="{x:Bind ViewModel.OpenCalendarCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_OpenCalendar, Mode=OneTime}">
                    <coreControls:MailCalFontIcon FontSize="16" Icon="Calendar" />
                </Button>
                <Button
                    Grid.Column="3"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="CompanionOpenSettingsButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Companion_Settings, Mode=OneTime}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Settings, Mode=OneTime}">
                    <coreControls:MailCalFontIcon FontSize="16" Icon="Settings" />
                </Button>
            </Grid>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Padding="8,0,8,8">
                    <ItemsControl
                        AutomationProperties.AutomationId="CompanionDayEventList"
                        AutomationProperties.Name="{x:Bind ViewModel.SelectedDateText, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.DayEvents}"
                        Visibility="{x:Bind ViewModel.DayEventsVisibility, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="companion:CompanionDayEvent">
                                <Button
                                    Margin="0,1"
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="CompanionDayEventButton"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    Click="DayEvent_Click"
                                    CommandParameter="{x:Bind}"
                                    Style="{ThemeResource SubtleButtonStyle}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ColorHex)}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                            Text="{x:Bind TimeText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                                Text="{x:Bind Location}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(HasLocation)}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Margin="0,16"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="CompanionDayEmptyState"
                        Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                        Text="{x:Bind domain:Translator.Companion_DayEmpty, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.DayEmptyVisibility, Mode=OneWay}" />
                </Grid>
            </ScrollViewer>

            <TextBlock
                Grid.Row="3"
                Margin="16,0,16,8"
                AutomationProperties.AutomationId="CompanionErrorText"
                AutomationProperties.LiveSetting="Assertive"
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />

            <Border
                Grid.Row="4"
                Padding="12,10,12,10"
                Background="{ThemeResource CompanionSubtleBackgroundBrush}"
                BorderBrush="{ThemeResource CompanionDividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel
                        AutomationProperties.AutomationId="CompanionQuickAddForm"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.QuickAddVisibility, Mode=OneWay}">
                        <TextBox
                            x:Name="QuickTitleBox"
                            AutomationProperties.AutomationId="CompanionQuickAddTitle"
                            AutomationProperties.Name="{x:Bind domain:Translator.Companion_QuickAddPlaceholder, Mode=OneTime}"
                            KeyDown="QuickTitleBox_KeyDown"
                            PlaceholderText="{x:Bind domain:Translator.Companion_QuickAddPlaceholder, Mode=OneTime}"
                            Text="{x:Bind ViewModel.QuickTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  One picker per row: side by side they are too narrow for hours, minutes and AM/PM.  -->
                        <Grid
                            ColumnSpacing="8"
                            RowSpacing="6"
                            Visibility="{x:Bind ViewModel.QuickTimesVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                Text="{x:Bind domain:Translator.CalendarEventCompose_Starts, Mode=OneTime}" />
                            <TimePicker
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CompanionQuickAddStart"
                                AutomationProperties.Name="{x:Bind domain:Translator.CalendarEventCompose_StartTime, Mode=OneTime}"
                                ClockIdentifier="{x:Bind ViewModel.ClockIdentifier, Mode=OneWay}"
                                SelectedTime="{x:Bind ViewModel.QuickStart, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                Text="{x:Bind domain:Translator.CalendarEventCompose_Ends, Mode=OneTime}" />
                            <TimePicker
                                Grid.Row="1"
                                Grid.Column="1"
                                MinWidth="0"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CompanionQuickAddEnd"
                                AutomationProperties.Name="{x:Bind domain:Translator.CalendarEventCompose_EndTime, Mode=OneTime}"
                                ClockIdentifier="{x:Bind ViewModel.ClockIdentifier, Mode=OneWay}"
                                SelectedTime="{x:Bind ViewModel.QuickEnd, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
                                MinWidth="0"
                                AutomationProperties.AutomationId="CompanionQuickAddAllDay"
                                Content="{x:Bind domain:Translator.QuickEventDialog_IsAllDay, Mode=OneTime}"
                                IsChecked="{x:Bind ViewModel.QuickIsAllDay, Mode=TwoWay}" />
                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CompanionQuickAddCalendar"
                                AutomationProperties.Name="{x:Bind domain:Translator.Companion_QuickAddCalendar, Mode=OneTime}"
                                ItemsSource="{x:Bind ViewModel.WritableCalendars}"
                                SelectedItem="{x:Bind ViewModel.SelectedQuickCalendar, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="companion:CompanionCalendarOption">
                                        <Grid AutomationProperties.Name="{x:Bind AutomationName}" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse
                                                Width="10"
                                                Height="10"
                                                VerticalAlignment="Center"
                                                Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ColorHex)}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                                    Text="{x:Bind AccountName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button
                                Grid.Column="2"
                                AutomationProperties.AutomationId="CompanionQuickAddButton"
                                Command="{x:Bind ViewModel.CreateQuickEventCommand}"
                                Content="{x:Bind domain:Translator.Companion_QuickAddButton, Mode=OneTime}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>

                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="CompanionQuickAddMoreOptions"
                            Command="{x:Bind ViewModel.OpenEventEditorCommand}"
                            Content="{x:Bind domain:Translator.Companion_MoreOptions, Mode=OneTime}"
                            FontSize="12" />
                    </StackPanel>

                    <TextBlock
                        AutomationProperties.AutomationId="CompanionNoWritableCalendars"
                        Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                        Text="{x:Bind domain:Translator.Companion_NoWritableCalendars, Mode=OneTime}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.NoWritableCalendarsVisibility, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
