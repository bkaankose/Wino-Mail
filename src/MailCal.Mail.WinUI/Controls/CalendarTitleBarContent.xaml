<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MailCal.Mail.WinUI.Controls.CalendarTitleBarContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendarControls="using:MailCal.Calendar.Controls"
    xmlns:coreControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="ControlLoaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="CalendarNavigationButtonStyle"
            BasedOn="{StaticResource DefaultButtonStyle}"
            TargetType="Button">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="32" />

            <Setter Property="Padding" Value="0" />
            <!--<Setter Property="Foreground" Value="{ThemeResource SystemColorControlAccentBrush}" />-->

            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,0,0" Background="Transparent">
        <Grid Background="Transparent" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid VerticalAlignment="Center" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.AutomationId="CalendarTitleBarContentButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Accessibility_PreviousCalendarPeriod, Mode=OneTime}"
                    Click="PreviousDateClicked"
                    Style="{StaticResource CalendarNavigationButtonStyle}">
                    <Viewbox x:Name="PreviousArrow" Width="12">
                        <coreControls:MailCalFontIcon Icon="ArrowLeft" />
                    </Viewbox>
                </Button>

                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="CalendarTitleBarContentButton2"
                    AutomationProperties.Name="{x:Bind domain:Translator.Accessibility_NextCalendarPeriod, Mode=OneTime}"
                    Click="NextDateClicked"
                    Style="{StaticResource CalendarNavigationButtonStyle}">
                    <Viewbox x:Name="NextArrow" Width="12">
                        <coreControls:MailCalFontIcon Icon="ArrowRight" />
                    </Viewbox>
                </Button>
            </Grid>

            <TextBlock
                x:Name="VisibleDateRangeTextBlock"
                Grid.Column="1"
                MaxHeight="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                IsHitTestVisible="False"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center" />
            <calendarControls:MailCalCalendarTypeSelectorControl
                x:Name="CalendarTypeSelector"
                Grid.Column="2"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
