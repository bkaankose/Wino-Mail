<linker>
  <!--
    MimeKit's CryptographyContext.Create falls back to DefaultSecureMimeContext, which needs
    System.Data.SQLite through reflection and cannot work under Native AOT (IL2026). Mail-Cal never
    registers or creates a default context: every S/MIME call passes an explicit
    WindowsSecureMimeContext. Replacing the body with a throw removes the unsafe call from the
    linked app, and a future caller fails loudly instead of silently losing S/MIME.
  -->
  <assembly fullname="MimeKit">
    <type fullname="MimeKit.Cryptography.CryptographyContext">
      <method signature="MimeKit.Cryptography.CryptographyContext Create(System.String)" body="remove" />
    </type>
  </assembly>
</linker>
