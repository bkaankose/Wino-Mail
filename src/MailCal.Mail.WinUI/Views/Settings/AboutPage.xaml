<abstract:AboutPageAbstract
    x:Class="MailCal.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:MailCal.Views.Abstract"
    xmlns:accessibilityControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:MailCal.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:release="using:MailCal.NotificationHost.Contracts"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <StackPanel.ChildrenTransitions>
            <TransitionCollection>
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </TransitionCollection>
        </StackPanel.ChildrenTransitions>
        <Image
            Width="128"
            Height="128"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Source="ms-appx:///Assets/MailCalLogo.png"
            Stretch="Uniform" />
        <TextBlock
            Margin="0,6,0,4"
            HorizontalAlignment="Center"
            Style="{StaticResource SubheaderTextBlockStyle}"
            Text="{x:Bind release:ReleaseIdentity.Current.MailDisplayName, Mode=OneTime}" />

        <TextBlock
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind domain:Translator.SettingsAboutMailCal_AppDescription}" />

        <accessibilityControls:MailCalSettingsCard
            AutomationProperties.AutomationId="AboutPageWhatsNewSettingsCard"
            Command="{x:Bind ViewModel.OpenWhatsNewCommand}"
            Description="{x:Bind domain:Translator.SettingsWhatsNew_Description}"
            Header="{x:Bind domain:Translator.SettingsWhatsNew_Title}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Announcement" />
            </controls:SettingsCard.HeaderIcon>
        </accessibilityControls:MailCalSettingsCard>

        <accessibilityControls:MailCalSettingsCard
            AutomationProperties.AutomationId="AboutPageSettingsCard"
            Command="{x:Bind ViewModel.NavigateCommand}"
            CommandParameter="{x:Bind ViewModel.UpstreamUrl}"
            Description="{x:Bind domain:Translator.SettingsUpstream_Description}"
            Header="{x:Bind domain:Translator.SettingsUpstream_Title}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Globe" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Open" />
            </controls:SettingsCard.ActionIcon>
        </accessibilityControls:MailCalSettingsCard>

        <accessibilityControls:MailCalSettingsCard
            AutomationProperties.AutomationId="AboutPageSettingsCard2"
            Command="{x:Bind ViewModel.NavigateCommand}"
            CommandParameter="{x:Bind ViewModel.GitHubUrl}"
            Description="{x:Bind domain:Translator.SettingsAboutGithub_Description}"
            Header="{x:Bind domain:Translator.SettingsAboutGithub_Title}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="GitHub" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.ActionIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Open" />
            </controls:SettingsCard.ActionIcon>
        </accessibilityControls:MailCalSettingsCard>





        <controls:SettingsExpander
            AutomationProperties.AutomationId="AboutPageSettingsExpander"
            Description="{x:Bind domain:Translator.SettingsDiagnostics_Description}"
            Header="{x:Bind domain:Translator.SettingsDiagnostics_Title}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:MailCalFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Bug" />
            </controls:SettingsExpander.HeaderIcon>

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="AboutPageSettingsCard7"
                    Description="{x:Bind domain:Translator.SettingsEnableLogs_Description}"
                    Header="{x:Bind domain:Translator.SettingsEnableLogs_Title}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            AutomationProperties.AutomationId="AboutPageButton"
                            Command="{x:Bind ViewModel.ShareMailCalLogCommand}"
                            Content="{x:Bind domain:Translator.Buttons_Share}" />
                        <ToggleSwitch AutomationProperties.AutomationId="AboutPageToggleSwitch" IsOn="{x:Bind ViewModel.PreferencesService.IsLoggingEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard AutomationProperties.AutomationId="AboutPageSettingsCard9" Header="{x:Bind release:ReleaseIdentity.Current.MailDisplayName, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <ImageIcon
                    Width="24"
                    Height="24"
                    Source="ms-appx:///Assets/MailCalLogo.png" />
            </controls:SettingsCard.HeaderIcon>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True">
                <Run Text="{x:Bind domain:Translator.SettingsAboutVersion}" /><Run Text="{x:Bind ViewModel.VersionName}" />
            </TextBlock>
        </controls:SettingsCard>
    </StackPanel>
</abstract:AboutPageAbstract>

