<abstract:ContactsPreferenceSettingsPageAbstract
    x:Class="MailCal.Views.Settings.ContactsPreferenceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:MailCal.Mail.WinUI.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:MailCal.Mail.WinUI.Controls"
    xmlns:data="using:MailCal.Mail.ViewModels.Data"
    xmlns:domain="using:MailCal.Core.Domain">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            AutomationProperties.AutomationId="PeopleNewContactsCard"
            Description="{x:Bind domain:Translator.PeopleSettings_NewContacts_Description}"
            Header="{x:Bind domain:Translator.PeopleSettings_NewContacts_Header}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon Icon="Add" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <ComboBox
                    AutomationProperties.AutomationId="PeopleNewContactDestinationBehavior"
                    AutomationProperties.Name="{x:Bind domain:Translator.PeopleSettings_NewContacts_Header, Mode=OneTime}"
                    ItemsSource="{x:Bind ViewModel.DestinationBehaviors}"
                    SelectedItem="{x:Bind ViewModel.SelectedDestinationBehavior, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="data:DestinationBehaviorOption">
                            <TextBlock Text="{x:Bind DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    x:Name="SpecificAddressBookComboBox"
                    x:Load="{x:Bind ViewModel.ShouldShowSpecificDestination, Mode=OneWay}"
                    AutomationProperties.AutomationId="PeopleSpecificAddressBook"
                    ItemsSource="{x:Bind ViewModel.Destinations}"
                    SelectedItem="{x:Bind ViewModel.SelectedDestination, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="data:ContactDestinationPreferenceOption">
                            <TextBlock Text="{x:Bind DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard
            AutomationProperties.AutomationId="PeopleNameDisplayCard"
            Description="{x:Bind domain:Translator.PeopleSettings_NameDisplay_Description}"
            Header="{x:Bind domain:Translator.PeopleSettings_NameDisplay_Header}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon Icon="Person" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                AutomationProperties.AutomationId="PeopleNameDisplay"
                ItemsSource="{x:Bind ViewModel.NameDisplayOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedNameDisplay, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="data:ContactNameDisplayOption">
                        <TextBlock Text="{x:Bind DisplayText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>
        <controls:SettingsCard
            AutomationProperties.AutomationId="PeopleNameSortCard"
            Description="{x:Bind domain:Translator.PeopleSettings_Sort_Description}"
            Header="{x:Bind domain:Translator.PeopleSettings_Sort_Header}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon Icon="ArrowSort" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                AutomationProperties.AutomationId="PeopleNameSort"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="data:ContactSortOption">
                        <TextBlock Text="{x:Bind DisplayText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>
        <controls:SettingsCard
            AutomationProperties.AutomationId="PeopleSuggestedRecipientsCard"
            Description="{x:Bind domain:Translator.PeopleSettings_SuggestedRecipients_Description}"
            Header="{x:Bind domain:Translator.PeopleSettings_SuggestedRecipients_Header}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:MailCalFontIcon Icon="History" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                AutomationProperties.AutomationId="PeopleSuggestedRecipientsClear"
                Command="{x:Bind ViewModel.ClearSuggestedRecipientsCommand}"
                Content="{x:Bind domain:Translator.PeopleSettings_SuggestedRecipients_Clear}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:ContactsPreferenceSettingsPageAbstract>
