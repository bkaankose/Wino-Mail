<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap com desktop">
	
	<!-- Publisher Cache Folders -->
	<Extensions>
		<Extension Category="windows.publisherCacheFolders">
			<PublisherCacheFolders>
				<Folder Name="MailCalShared" />
			</PublisherCacheFolders>
		</Extension>
		<!-- Windows App SDK background task host. The Mail entry's windows.backgroundTasks extension names it. -->
		<Extension Category="windows.activatableClass.inProcessServer">
			<InProcessServer>
				<Path>Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll</Path>
				<ActivatableClass ActivatableClassId="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.Task" ThreadingModel="both" />
			</InProcessServer>
		</Extension>
	</Extensions>
	
  <Identity
    Name="hairokuma.MailCal"
    Publisher="CN=hairokuma"
    Version="2.3.0.0" />

  <mp:PhoneIdentity PhoneProductId="7b7e90e9-cc55-4409-9769-99b4b5ed6e9b" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Mail-Cal</DisplayName>
    <PublisherDisplayName>hairokuma</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$"
      uap10:Parameters="--mailcal-mail">
      <uap:VisualElements
        DisplayName="Mail-Cal"
        Description="MailCal.Mail.WinUI"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\AppEntries\MailAssets\Square150x150Logo.png"
        Square44x44Logo="Assets\AppEntries\MailAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\AppEntries\MailAssets\Wide310x150Logo.png" Square71x71Logo="Assets\AppEntries\MailAssets\SmallTile.png" Square310x310Logo="Assets\AppEntries\MailAssets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\AppEntries\MailAssets\SplashScreen.png" />
      </uap:VisualElements>

		<Extensions>
			<uap5:Extension Category="windows.startupTask">
				<uap5:StartupTask
					TaskId="MailCalStartupId"
					Enabled="true"
					DisplayName="Mail-Cal" />
			</uap5:Extension>

			<!-- Session-start background task: Windows activates the application through this class seconds after
			     logon, ahead of the startup queue that runs the StartupTask above. The permission string lets the
			     app-container background task host activate it. See Activation/SessionStartActivation.cs. -->
			<Extension Category="windows.backgroundTasks" EntryPoint="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.Task">
				<BackgroundTasks>
					<Task Type="systemEvent" />
					<Task Type="general" />
				</BackgroundTasks>
			</Extension>
			<com:Extension Category="windows.comServer">
				<com:ComServer>
					<com:ExeServer Executable="MailCal.Mail.WinUI.exe" Arguments="--mailcal-mail --mailcal-session-start" DisplayName="Mail-Cal startup service"
					               LaunchAndActivationPermission="O:PSG:BUD:(A;;11;;;IU)(A;;11;;;S-1-15-2-1)S:(ML;;NX;;;LW)">
						<com:Class Id="2eb07bbb-80e4-4abf-a3b0-6d73dafbf007" DisplayName="Mail-Cal startup service" />
					</com:ExeServer>
				</com:ComServer>
			</com:Extension>

			<!-- Protocol activation: mailto -->
			<uap:Extension Category="windows.protocol">
				<uap:Protocol Name="mailto" />
			</uap:Extension>

			<!-- Protocol activation: Google oAuth -->
			<uap:Extension Category="windows.protocol">
				<uap:Protocol Name="google.pw.oauth2">
					<uap:DisplayName>Google Auth Protocol</uap:DisplayName>
				</uap:Protocol>
			</uap:Extension>

			<!-- Share target activation -->
			<uap:Extension Category="windows.shareTarget">
				<uap:ShareTarget>
					<uap:SupportedFileTypes>
						<uap:SupportsAnyFileType />
					</uap:SupportedFileTypes>
				</uap:ShareTarget>
			</uap:Extension>

			<!-- File Assosication: EML -->
			<uap:Extension Category="windows.fileTypeAssociation">
				<uap:FileTypeAssociation Name="eml">
					<uap:Logo>EML\eml.png</uap:Logo>
					<uap:SupportedFileTypes>
						<uap:FileType>.eml</uap:FileType>
					</uap:SupportedFileTypes>
				</uap:FileTypeAssociation>
			</uap:Extension>

			<!-- Toast activation: Windows starts the notification host, not the UI executable. -->
			<desktop:Extension Category="windows.toastNotificationActivation">
				<desktop:ToastNotificationActivation ToastActivatorCLSID="b2a5406e-9637-4cc8-bade-960c31f999ff" />
			</desktop:Extension>
			<com:Extension Category="windows.comServer">
				<com:ComServer>
					<com:ExeServer Executable="MailCal.NotificationHost.exe" Arguments="----AppNotificationActivated:" DisplayName="Mail-Cal notification host">
						<com:Class Id="b2a5406e-9637-4cc8-bade-960c31f999ff" DisplayName="Mail-Cal notification host" />
					</com:ExeServer>
				</com:ComServer>
			</com:Extension>
		</Extensions>
    </Application>

    <Application Id="CalendarApp"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$"
      uap10:Parameters="--mailcal-calendar">
      <uap:VisualElements
        DisplayName="Mail-Cal Calendar"
        Description="MailCal.Mail.WinUI.Calendar"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\AppEntries\CalendarAssets\Square150x150Logo.png"
        Square44x44Logo="Assets\AppEntries\CalendarAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\AppEntries\CalendarAssets\Wide310x150Logo.png" Square71x71Logo="Assets\AppEntries\CalendarAssets\SmallTile.png" Square310x310Logo="Assets\AppEntries\CalendarAssets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\AppEntries\CalendarAssets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="webcal">
            <uap:DisplayName>Calendar Protocol</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="webcals">
            <uap:DisplayName>Calendar Protocol (Secure)</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="ics">
            <uap:Logo>Assets\AppEntries\CalendarAssets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.ics</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="ae42f6a9-b0b9-455a-80a2-9cd565658865" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="MailCal.NotificationHost.exe" Arguments="----AppNotificationActivated:" DisplayName="Mail-Cal Calendar notification host">
              <com:Class Id="ae42f6a9-b0b9-455a-80a2-9cd565658865" DisplayName="Mail-Cal Calendar notification host" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
    <Application Id="ContactsApp"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$"
      uap10:Parameters="--mailcal-contacts">
      <uap:VisualElements
        DisplayName="Mail-Cal People"
        Description="MailCal.Mail.WinUI.Contacts"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\AppEntries\PeopleAssets\Square150x150Logo.png"
        Square44x44Logo="Assets\AppEntries\PeopleAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\AppEntries\PeopleAssets\Wide310x150Logo.png" Square71x71Logo="Assets\AppEntries\PeopleAssets\SmallTile.png" Square310x310Logo="Assets\AppEntries\PeopleAssets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\AppEntries\PeopleAssets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="a1cdd0d5-6caa-4bb6-9565-79e730d887ad" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="MailCal.NotificationHost.exe" Arguments="----AppNotificationActivated:" DisplayName="Mail-Cal People notification host">
              <com:Class Id="a1cdd0d5-6caa-4bb6-9565-79e730d887ad" DisplayName="Mail-Cal People notification host" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
    <Application Id="ToDoApp"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$"
      uap10:Parameters="--mailcal-todo">
      <uap:VisualElements
        DisplayName="Mail-Cal To Do"
        Description="MailCal.Mail.WinUI.ToDo"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\AppEntries\ToDoAssets\Square150x150Logo.png"
        Square44x44Logo="Assets\AppEntries\ToDoAssets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\AppEntries\ToDoAssets\Wide310x150Logo.png" Square71x71Logo="Assets\AppEntries\ToDoAssets\SmallTile.png" Square310x310Logo="Assets\AppEntries\ToDoAssets\LargeTile.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\AppEntries\ToDoAssets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="41c27c8b-0682-4050-9438-9ade1e20d0d4" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="MailCal.NotificationHost.exe" Arguments="----AppNotificationActivated:" DisplayName="Mail-Cal To Do notification host">
              <com:Class Id="41c27c8b-0682-4050-9438-9ade1e20d0d4" DisplayName="Mail-Cal To Do notification host" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
