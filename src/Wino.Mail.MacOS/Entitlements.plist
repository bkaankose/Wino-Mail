<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <!-- Loopback listeners are required for the system-browser OAuth callbacks. -->
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <!-- Sparkle's installer service (DMG builds). Entitlements.AppStore.plist leaves this out. -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.winomail.macos-spks</string>
    <string>com.winomail.macos-spki</string>
  </array>
</dict></plist>
