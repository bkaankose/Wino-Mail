<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.winomail.macos</string>
  <key>CFBundleName</key><string>Wino Mail</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <!-- The languages of the Wino translation dictionary (AppLanguage). The app ships no .lproj folders, so this
       list is what macOS and the App Store read as the app's localizations. -->
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array><string>en</string><string>bg</string><string>ca</string><string>cs</string><string>da</string><string>de</string><string>el</string><string>es</string><string>fi</string><string>fr</string><string>gl</string><string>he</string><string>id</string><string>it</string><string>ja</string><string>ko</string><string>lt</string><string>nl</string><string>pl</string><string>pt-BR</string><string>ro</string><string>ru</string><string>sk</string><string>tr</string><string>uk</string><string>vi</string><string>zh-Hans</string></array>
  <key>NSHumanReadableCopyright</key><string>Copyright © Burak Kaan Köse</string>
  <!-- App icon from the Windows Mail entry (Assets/AppEntries/Mail.svg), rendered on Apple's 824/1024 grid. -->
  <key>XSAppIconAssets</key><string>Assets.xcassets/AppIcon.appiconset</string>
  <!-- OS activation (WS8): mail links, Wino deep links (checkout return) and calendar subscriptions. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>com.winomail.macos.mailto</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>CFBundleURLSchemes</key><array><string>mailto</string></array>
    </dict>
    <dict>
      <key>CFBundleURLName</key><string>com.winomail.macos.wino</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>wino</string></array>
    </dict>
    <dict>
      <key>CFBundleURLName</key><string>com.winomail.macos.webcal</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>webcal</string><string>webcals</string></array>
    </dict>
  </array>
  <!-- Calendar invitations, contact cards and saved messages (.eml, read-only reader window) open in Wino as an alternative handler. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>iCalendar Event</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>com.apple.ical.ics</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>vCard</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>public.vcard</string></array>
    </dict>
    <!-- Any other file dropped on the Dock icon becomes an attachment of a new mail (MacActivationCoordinator).
         Rank None: Wino never opens these types by default and is not offered in Open With. -->
    <dict>
      <key>CFBundleTypeName</key><string>Mail Attachment</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>None</string>
      <key>LSItemContentTypes</key><array><string>public.data</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Email Message</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key><array><string>com.apple.mail.email</string><string>public.email-message</string></array>
    </dict>
  </array>
  <!-- Finder › Services: files become attachments of a new mail (AppDelegate.Activation.cs NewMailWithFiles). -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key><dict><key>default</key><string>New Wino Mail with Attachments</string></dict>
      <key>NSMessage</key><string>newMailWithFiles</string>
      <key>NSPortName</key><string>Wino Mail</string>
      <key>NSSendFileTypes</key><array><string>public.data</string></array>
      <key>NSRequiredContext</key><dict/>
    </dict>
  </array>
</dict></plist>
