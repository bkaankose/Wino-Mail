<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks Condition="'$(MailCalTargetPlatform)' == 'Windows'">net10.0;net10.0-windows10.0.26100.0</TargetFrameworks>
		<TargetFramework Condition="'$(MailCalTargetPlatform)' != 'Windows'">net10.0</TargetFramework>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))">
		<DefineConstants>$(DefineConstants);WINRT_EXPOSED</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Serilog" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="EmailValidation" />
		<PackageReference Include="TimePeriodLibrary.NET" />
		<PackageReference Include="Microsoft.Identity.Client" />
		<PackageReference Include="MimeKit" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0-windows'))" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\MailCal.Core.Domain\MailCal.Core.Domain.csproj" />
		<ProjectReference Include="..\MailCal.Core\MailCal.Core.csproj" />
		<ProjectReference Include="..\..\controls\MailCal.Mail.Controls.Core\MailCal.Mail.Controls.Core.csproj" />
		<ProjectReference Include="..\MailCal.Messages\MailCal.Messaging.csproj" />
		<ProjectReference Include="..\MailCal.Services\MailCal.Services.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Helpers\" />
	</ItemGroup>
</Project>
