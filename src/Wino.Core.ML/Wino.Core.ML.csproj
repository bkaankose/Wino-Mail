<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86'">
    <DefineConstants>$(DefineConstants);WINO_ML_UNSUPPORTED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Core.Domain\Wino.Core.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' != 'x86' And '$(RuntimeIdentifier)' != 'win-x86'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' != 'x86' And '$(RuntimeIdentifier)' != 'win-x86'">
    <Content Include="Models\Magika\standard_v3_3\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             TargetPath="Models\Magika\standard_v3_3\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="MagikaContentTypeClassificationModel.Unsupported.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86'">
    <Compile Remove="MagikaContentTypeClassificationModel.Supported.cs" />
    <Compile Remove="OnnxModelSessionManager.cs" />
  </ItemGroup>

</Project>
