<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x86;x64;arm64</Platforms>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Explicit Mac selector survives the SDK clearing RuntimeIdentifier on portable references.
       Android ships without Magika (owner decision, 14 Oct 2026). -->
  <PropertyGroup Condition="'$(Platform)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(WinoTargetRuntimeIdentifier)' == 'osx-x64' Or '$(WinoTargetPlatform)' == 'Android'">
    <DefineConstants>$(DefineConstants);WINO_ML_UNSUPPORTED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wino.Core.Domain\Wino.Core.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' != 'x86' And '$(RuntimeIdentifier)' != 'win-x86' And '$(RuntimeIdentifier)' != 'osx-x64' And '$(WinoTargetRuntimeIdentifier)' != 'osx-x64' And '$(WinoTargetPlatform)' != 'Android'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' != 'x86' And '$(RuntimeIdentifier)' != 'win-x86' And '$(RuntimeIdentifier)' != 'osx-x64' And '$(WinoTargetRuntimeIdentifier)' != 'osx-x64' And '$(WinoTargetPlatform)' != 'Android'">
    <Content Include="Models\Magika\standard_v3_3\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             TargetPath="Models\Magika\standard_v3_3\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="MagikaContentTypeClassificationModel.Unsupported.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'osx-x64' Or '$(WinoTargetRuntimeIdentifier)' == 'osx-x64' Or '$(WinoTargetPlatform)' == 'Android'">
    <Compile Remove="MagikaContentTypeClassificationModel.Supported.cs" />
    <Compile Remove="OnnxModelSessionManager.cs" />
    <Compile Remove="OnnxNativeRuntimeSupport.cs" />
  </ItemGroup>

  <!-- onnxruntime.dll dynamically links the Visual C++ runtime (msvcp140, vcruntime140) and the MSIX declares
       no VCLibs dependency, so the runtime it needs ships next to the application. OnnxNativeRuntimeSupport
       refuses to load ONNX when the copy the loader would pick is missing or older than 14.40, which would
       otherwise crash the process natively. See NativeRuntime/README.md for the source version. -->
  <PropertyGroup Condition="'$(WinoTargetPlatform)' == 'Windows'">
    <WinoNativeRuntimeFolder Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(WinoTargetRuntimeIdentifier)' == 'win-x64'">win-x64</WinoNativeRuntimeFolder>
    <WinoNativeRuntimeFolder Condition="'$(RuntimeIdentifier)' == 'win-arm64' Or '$(WinoTargetRuntimeIdentifier)' == 'win-arm64'">win-arm64</WinoNativeRuntimeFolder>
    <!-- Project references drop the RuntimeIdentifier on portable libraries; Platform still selects the architecture. -->
    <WinoNativeRuntimeFolder Condition="'$(WinoNativeRuntimeFolder)' == '' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'x64'">win-x64</WinoNativeRuntimeFolder>
    <WinoNativeRuntimeFolder Condition="'$(WinoNativeRuntimeFolder)' == '' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</WinoNativeRuntimeFolder>
    <WinoNativeRuntimeFolder Condition="'$(WinoNativeRuntimeFolder)' == '' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'AnyCPU' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">win-x64</WinoNativeRuntimeFolder>
    <WinoNativeRuntimeFolder Condition="'$(WinoNativeRuntimeFolder)' == '' And '$(RuntimeIdentifier)' == '' And '$(Platform)' == 'AnyCPU' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</WinoNativeRuntimeFolder>
  </PropertyGroup>

  <ItemGroup Condition="'$(WinoNativeRuntimeFolder)' != ''">
    <Content Include="NativeRuntime\$(WinoNativeRuntimeFolder)\*.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             TargetPath="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
