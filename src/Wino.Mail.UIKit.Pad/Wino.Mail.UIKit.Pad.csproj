<Project Sdk="Microsoft.NET.Sdk">
  <!-- The iPad shell, mirroring the Mac shell: a three-column split view (sidebar with the mode switcher card, list
       column, reader column), the toolbar row, the pad page registry (pane hosts) and its shell host.
       References Wino.Mail.UIKit, never Wino.Mail.UIKit.Phone. -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <WinoTargetPlatform>iOS</WinoTargetPlatform>
    <RootNamespace>Wino.Mail.UIKit.Pad</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Wino.Mail.UIKit/Wino.Mail.UIKit.csproj" />
  </ItemGroup>
</Project>
