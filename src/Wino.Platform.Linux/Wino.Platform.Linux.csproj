<Project Sdk="Microsoft.NET.Sdk">
  <!-- Linux platform services over freedesktop standards: XDG base directories, the Secret Service (libsecret),
       desktop notifications and xdg-desktop-portal through GTK. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;arm64</Platforms>
    <WinoTargetPlatform>Linux</WinoTargetPlatform>
    <RootNamespace>Wino.Platform.Linux</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" />
    <PackageReference Include="GirCore.Gtk-4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wino.Core.Domain\Wino.Core.Domain.csproj" />
    <ProjectReference Include="..\Wino.SourceGenerators\Wino.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;SelfContained" />
    <ProjectReference Include="..\Wino.Authentication\Wino.Authentication.csproj" />
    <ProjectReference Include="..\Wino.Services\Wino.Services.csproj" />
  </ItemGroup>
</Project>
