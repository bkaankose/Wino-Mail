{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${noItems}",
      "wrap": true,
      "maxLines": 3,
      "isSubtle": true,
      "spacing": "Medium",
      "$when": "${!hasItems}"
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "$data": "${items}",
          "width": "stretch",
          "items": [
            {
              "type": "Image",
              "url": "${avatar}",
              "width": "40px",
              "height": "40px",
              "horizontalAlignment": "Center",
              "style": "person"
            },
            {
              "type": "TextBlock",
              "text": "${firstName}",
              "wrap": false,
              "maxLines": 1,
              "size": "Small",
              "horizontalAlignment": "Center",
              "spacing": "Small"
            }
          ],
          "selectAction": {
            "type": "Action.Execute",
            "verb": "openContact",
            "data": {
              "value": "${id}"
            }
          }
        }
      ],
      "spacing": "Small"
    }
  ]
}
