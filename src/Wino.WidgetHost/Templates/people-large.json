{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${title}",
      "wrap": false,
      "maxLines": 1,
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "${noItems}",
      "wrap": true,
      "maxLines": 3,
      "isSubtle": true,
      "spacing": "Medium",
      "$when": "${!hasItems}"
    },
    {
      "type": "Container",
      "$data": "${items}",
      "separator": true,
      "spacing": "Small",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Image",
                  "url": "${avatar}",
                  "width": "30px",
                  "height": "30px",
                  "style": "person"
                }
              ],
              "verticalContentAlignment": "Center"
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${name}",
                  "wrap": false,
                  "maxLines": 1
                }
              ],
              "verticalContentAlignment": "Center"
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.Execute",
                      "verb": "emailContact",
                      "title": " ",
                      "iconUrl": "${mailIcon}",
                      "data": {
                        "value": "${email}"
                      }
                    }
                  ]
                }
              ],
              "verticalContentAlignment": "Center",
              "$when": "${hasEmail}"
            }
          ]
        }
      ],
      "selectAction": {
        "type": "Action.Execute",
        "verb": "openContact",
        "data": {
          "value": "${id}"
        }
      }
    }
  ]
}
