<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Wino.Providers.Outlook</RootNamespace>
		<Platforms>x86;x64;arm64</Platforms>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Graph" />
		<PackageReference Include="Microsoft.Graph.Core" />
		<PackageReference Include="Microsoft.Identity.Client" />
		<!-- WAM broker: Windows only. Wino.Platform.Windows owns the only usage (WindowsOutlookAuthenticationHost). -->
		<PackageReference Include="Microsoft.Identity.Client.Broker" Condition="'$(WinoTargetPlatform)' == 'Windows'" />
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
		<PackageReference Include="MimeKit" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Wino.Core\Wino.Core.csproj" />
		<ProjectReference Include="..\Wino.SourceGenerators\Wino.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;TrimMode;SelfContained" />
	</ItemGroup>
</Project>
