<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Lavender</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Lavender.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Lavender.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Lavender field wallpaper, forced Light. Violet-cast neutrals; amber stays as low afternoon sun.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#D6CCEC</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#EBE4F8</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14181428</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#E4DAF7</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33E4DAF7</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#406C5CE7</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66E4DAF7</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F6F3FC</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E9E2F8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#514566</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#685B7D</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#B7AAD2</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#3B3547</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#52495F</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#453E53</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#591E1830</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#221E1830</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4D6C5CE7</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#591E1830</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#17131F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#221C2E</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#2E2640</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#CFC6E4</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#B3A8CC</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#4E4463</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
