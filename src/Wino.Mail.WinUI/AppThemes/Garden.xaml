<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Garden</x:String>
    <x:String x:Key="ThemeBackgroundImage">ms-appx:///BackgroundImages/Garden.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource ThemeBackgroundImage}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <!--
        Mail list hover actions. Every theme carries its own copy so a theme can restyle the
        hover affordance on its own; the values are identical for now.
    -->
    <xaml:CornerRadius x:Key="MailRowHoverActionsCornerRadius">8</xaml:CornerRadius>
    <xaml:CornerRadius x:Key="MailRowHoverActionButtonCornerRadius">6</xaml:CornerRadius>
    <Thickness x:Key="MailRowHoverActionsBorderThickness">1</Thickness>
    <Thickness x:Key="MailRowHoverActionsPadding">3</Thickness>
    <x:Double x:Key="MailRowHoverActionsScrimWidth">170</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--  Mail list hover actions  -->
            <SolidColorBrush x:Key="MailRowHoverActionsBackgroundBrush">#F2FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionsBorderBrush">#2E141428</SolidColorBrush>
            <!--
                Feathers the row content into the rail instead of letting the pill chop it. The
                stops stay translucent so the ramp blends over whatever the theme puts behind the
                list rather than painting a block of one flat colour.
            -->
            <LinearGradientBrush x:Key="MailRowHoverActionsScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.0" Color="#00F3F3F7" />
                <GradientStop Offset="0.55" Color="#D9F3F3F7" />
                <GradientStop Offset="1.0" Color="#F5F3F3F7" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPointerOverBrush">#14000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPressedBrush">#24000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBorderBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonForegroundBrush">#1B1B1F</SolidColorBrush>
            <!--  Illustration palette. Garden wallpaper, forced Light. Neutrals lean green to agree with the foliage behind them.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#CBDCC9</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E6F1E4</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14142020</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#dcfad8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#26DCFAD8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#59DCFAD8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#59DCFAD8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSeperatorBrush">#576574</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
        </ResourceDictionary>

        <!--  N/A. Light theme only.  -->
        <ResourceDictionary x:Name="Dark">
            <!--  Mail list hover actions  -->
            <SolidColorBrush x:Key="MailRowHoverActionsBackgroundBrush">#F03E3E4A</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionsBorderBrush">#29FFFFFF</SolidColorBrush>
            <!--
                Feathers the row content into the rail instead of letting the pill chop it. The
                stops stay translucent so the ramp blends over whatever the theme puts behind the
                list rather than painting a block of one flat colour.
            -->
            <LinearGradientBrush x:Key="MailRowHoverActionsScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.0" Color="#00232329" />
                <GradientStop Offset="0.55" Color="#DB232329" />
                <GradientStop Offset="1.0" Color="#F5232329" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPointerOverBrush">#1AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPressedBrush">#2EFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBorderBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonForegroundBrush">#ECECF2</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#384139</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#506050</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#435043</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#dcfad8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#26576574</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#59576574</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#59576574</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
