<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Graphite</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Graphite.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Graphite.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Monochrome wallpaper, forced Dark. No hue anywhere, so the warm role flips to moonlight grey.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#CDD2D8</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E8EBEE</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#6B7B8C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14141618</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#E6E9EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33E6E9EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#406B7B8C</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66E6E9EC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F6F7F9</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E9ECEF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#4A5158</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#61686F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#B0B6BC</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#2F3338</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#434850</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#383D44</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#C9D2DA</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#5916191D</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#2216191D</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4D6B7B8C</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#5916191D</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#101316</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#1A1E22</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#23272C</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#C9CFD6</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#AAB1B9</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#434A52</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
