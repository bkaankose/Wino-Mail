<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Clouds</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Clouds.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Clouds.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Sky wallpaper, forced Light. Neutrals carry a blue cast so the art sits in the photo, not on it.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#C2D4E4</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E2ECF5</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14141E28</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#b2dffc</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#59B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>

            <SolidColorBrush x:Key="CalendarSeperatorBrush">#222f3e</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F2F8FC</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E2EEF6</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#465D6B</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#536976</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#A8BBC8</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#37414C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#4D5E6F</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#424F5C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#b2dffc</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#59B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66B2DFFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>

            <SolidColorBrush x:Key="CalendarSeperatorBrush">#222f3e</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#18232C</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#22313D</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#293B49</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#C2D0D9</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#AABCC8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#425766</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
