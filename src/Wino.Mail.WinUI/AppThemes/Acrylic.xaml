<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Microsoft.UI.Xaml.Media"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Acrylic</x:String>
    <x:String x:Key="Wallpaper" />
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Acrylic.jpg</x:String>

    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <!--  Acrylic Template  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Acrylic is translucent and visually noisy, so the neutrals run one step stronger than base.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#CFCFDA</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E6E6EE</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#1F14141E</SolidColorBrush>
            <!--  Reading Page Date/Name Group Header Background  -->
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#ecf0f1</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#B2FCFCFC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#260078D4</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#D9ECEFF1</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>

            <local:AcrylicBrush
                x:Key="WinoApplicationBackgroundColor"
                FallbackColor="#F9F9F9"
                TintColor="#FCFCFC"
                TintOpacity="0.75" />
            <local:AcrylicBrush
                x:Key="CompanionFlyoutBackgroundBrush"
                FallbackColor="#F9F9F9"
                TintColor="#FCFCFC"
                TintOpacity="0.75" />
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#12000000</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#0C000000</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#404040</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#565656</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#959595</SolidColorBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#43434A</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#5B5B64</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#4C4C55</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#5C000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#2C2C2C</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#662C2C2C</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#33399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#992C2C2C</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>

            <local:AcrylicBrush
                x:Key="WinoApplicationBackgroundColor"
                FallbackColor="#2C2C2C"
                TintColor="#2C2C2C"
                TintOpacity="0.30" />
            <local:AcrylicBrush
                x:Key="CompanionFlyoutBackgroundBrush"
                FallbackColor="#2C2C2C"
                TintColor="#2C2C2C"
                TintOpacity="0.30" />
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#18FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#10FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#D0D0D0</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#B5B5B5</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#5F5F5F</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
