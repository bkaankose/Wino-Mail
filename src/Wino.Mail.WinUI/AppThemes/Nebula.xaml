<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Nebula</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Nebula.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Nebula.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Deep space wallpaper, forced Dark. The warm role flips to periwinkle: there is no warm light in the scene.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#D2CCEA</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E9E5F7</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#8C7AE6</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14181428</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#E3DEF8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33E3DEF8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#408C7AE6</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66E3DEF8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F6F4FD</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E8E4F9</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#4C4470</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#635B86</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#B3ABD4</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#2E2A45</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#443E63</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#383352</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#B7A6FF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#5914102A</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#2214102A</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4D8C7AE6</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#5914102A</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#0E0B1C</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#1A1633</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#241F42</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#CBC4E8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#ADA5D2</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#443E63</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
