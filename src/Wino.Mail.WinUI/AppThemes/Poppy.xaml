<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Poppy</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Poppy.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Poppy.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Meadow wallpaper, forced Light. Neutrals lean sage to agree with the field behind them.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#D6DAC6</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#EDEFE2</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14181C14</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#E9EDDC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33E9EDDC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#40D63031</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66E9EDDC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F8FAF2</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E7EBDA</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#4F5644</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#656C58</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#B3BAA2</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#363A2E</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#4C5242</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#404537</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#591D2016</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#221D2016</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4DD63031</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#591D2016</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#14170F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#1F2318</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#2B3022</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#D2D7C4</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#B6BDA7</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#4E5544</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
