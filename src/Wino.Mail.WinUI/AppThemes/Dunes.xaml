<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Dunes</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Dunes.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Dunes.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Desert wallpaper, forced Light. Neutrals carry a sand cast; amber stays as the sun over the dunes.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#E0CDB5</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#F2E6D6</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F2B33D</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14201814</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#F6E3C8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33F6E3C8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#40E17055</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66F6E3C8</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#FBF4EA</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#F0E4D4</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#5F4C36</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#76624A</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#C6B39A</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#41382E</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#5E5142</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#4D4238</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#59251C10</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#22251C10</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4DE17055</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#59251C10</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#1E1711</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#2B2219</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#392D21</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#DCCBB5</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#C2AD92</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#5C4A36</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
