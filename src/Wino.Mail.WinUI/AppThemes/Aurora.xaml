<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Aurora</x:String>
    <x:String x:Key="Wallpaper">ms-appx:///BackgroundImages/Aurora.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appx:///BackgroundImages/Aurora.jpg</x:String>

    <ImageBrush x:Key="WinoApplicationBackgroundColor" ImageSource="{StaticResource Wallpaper}" />
    <SolidColorBrush x:Key="AppBarBackgroundColor">Transparent</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <!--
                Illustration palette. Polar wallpaper, forced Dark, and its accent is already teal. Amber would collide with the aurora, so the warm role flips to aurora teal.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#C4D6DA</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E3EFF1</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#3FB6B0</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#14142020</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#CFEFEC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#33CFEFEC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4000CEC9</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#66CFEFEC</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#D9FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#F1F8F8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#E0F0EF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#3F5A5C</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#557072</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#A6BFC0</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#2C3A45</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#3F5460</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#364651</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#7FE3DC</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#52000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#590E1B26</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush">#220E1B26</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush">#4D00CEC9</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush">#590E1B26</SolidColorBrush>
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>
            <SolidColorBrush x:Key="WelcomeOverlayBrush">#E61F1F1F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">#0D1620</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#16232F</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#1E303E</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#C2D6DA</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#A3BCC2</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#3E5764</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
