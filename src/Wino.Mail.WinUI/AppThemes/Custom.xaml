<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Custom</x:String>
    <x:String x:Key="ThemeBackgroundImage">ms-appdata:///local/CustomWallpaper.jpg</x:String>

    <ImageBrush
        x:Key="WinoApplicationBackgroundColor"
        ImageSource="{StaticResource ThemeBackgroundImage}"
        Stretch="UniformToFill" />

    <!--  Navigation View Settings  -->
    <xaml:CornerRadius x:Key="NavigationViewContentGridCornerRadius">0,0,0,0</xaml:CornerRadius>
    <xaml:CornerRadius x:Key="OverlayCornerRadius">0,1,0,0</xaml:CornerRadius>
    <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>

    <!--
        Mail list hover actions. Every theme carries its own copy so a theme can restyle the
        hover affordance on its own; the values are identical for now.
    -->
    <xaml:CornerRadius x:Key="MailRowHoverActionsCornerRadius">8</xaml:CornerRadius>
    <xaml:CornerRadius x:Key="MailRowHoverActionButtonCornerRadius">6</xaml:CornerRadius>
    <Thickness x:Key="MailRowHoverActionsBorderThickness">1</Thickness>
    <Thickness x:Key="MailRowHoverActionsPadding">3</Thickness>
    <x:Double x:Key="MailRowHoverActionsScrimWidth">170</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--  Mail list hover actions  -->
            <SolidColorBrush x:Key="MailRowHoverActionsBackgroundBrush">#F2FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionsBorderBrush">#2E141428</SolidColorBrush>
            <!--
                Feathers the row content into the rail instead of letting the pill chop it. The
                stops stay translucent so the ramp blends over whatever the theme puts behind the
                list rather than painting a block of one flat colour.
            -->
            <LinearGradientBrush x:Key="MailRowHoverActionsScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.0" Color="#00F3F3F7" />
                <GradientStop Offset="0.55" Color="#D9F3F3F7" />
                <GradientStop Offset="1.0" Color="#F5F3F3F7" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPointerOverBrush">#14000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPressedBrush">#24000000</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBorderBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonForegroundBrush">#1B1B1F</SolidColorBrush>
            <!--  Illustration palette. User wallpaper behind a translucent overlay, so the backdrop is unknowable. Highest-contrast values in
                 the family: fully opaque surface and the strongest shadow.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#C8C8D2</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E4E4EC</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#EFA92B</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#28141414</SolidColorBrush>
            <!--  Reading Page Date/Name Group Header Background  -->
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#ecf0f1</SolidColorBrush>

            <Color x:Key="MainCustomThemeColor">#D9FFFFFF</Color>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.85" />
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>

            <!--  Wallpaper overlay surfaces  -->
            <SolidColorBrush x:Key="WinoContentZoneBackgroud" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="ReadingPaneBackgroundColorBrush" Color="{StaticResource MainCustomThemeColor}" />

            <SolidColorBrush x:Key="AppBarBackgroundColor" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush" Color="{StaticResource MainCustomThemeColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <!--  Mail list hover actions  -->
            <SolidColorBrush x:Key="MailRowHoverActionsBackgroundBrush">#F03E3E4A</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionsBorderBrush">#29FFFFFF</SolidColorBrush>
            <!--
                Feathers the row content into the rail instead of letting the pill chop it. The
                stops stay translucent so the ramp blends over whatever the theme puts behind the
                list rather than painting a block of one flat colour.
            -->
            <LinearGradientBrush x:Key="MailRowHoverActionsScrimBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0.0" Color="#00232329" />
                <GradientStop Offset="0.55" Color="#DB232329" />
                <GradientStop Offset="1.0" Color="#F5232329" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPointerOverBrush">#1AFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBackgroundPressedBrush">#2EFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonBorderBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailRowHoverActionButtonForegroundBrush">#ECECF2</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#3B3B42</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#5C5C65</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#4A4A53</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#66000000</SolidColorBrush>
            <!--  Reading Page Date/Name Group Header Background  -->
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#1f1f1f</SolidColorBrush>

            <Color x:Key="MainCustomThemeColor">#E61F1F1F</Color>
            <SolidColorBrush x:Key="CalendarDefaultHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.55" />
            <SolidColorBrush x:Key="CalendarHoverHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="CalendarWorkHourBackgroundBrush" Color="{StaticResource MainCustomThemeColor}" Opacity="0.85" />
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>

            <!--  Wallpaper overlay surfaces  -->
            <SolidColorBrush x:Key="WinoContentZoneBackgroud" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="ReadingPaneBackgroundColorBrush" Color="{StaticResource MainCustomThemeColor}" />

            <SolidColorBrush x:Key="AppBarBackgroundColor" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush" Color="{StaticResource MainCustomThemeColor}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MailRowHoverActionsBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailRowHoverActionsBorderBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailRowHoverActionsScrimBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailRowHoverActionButtonBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="MailRowHoverActionButtonBackgroundPointerOverBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="MailRowHoverActionButtonBackgroundPressedBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="MailRowHoverActionButtonBorderBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailRowHoverActionButtonForegroundBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="WinoIllustrationSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="WinoIllustrationLineBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="WinoIllustrationLineSoftBrush" ResourceKey="SystemColorGrayTextBrush" />
            <StaticResource x:Key="WinoIllustrationWarmBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="WinoIllustrationShadowBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailListHeaderBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarDefaultHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarHoverHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarWorkHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarSelectedHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="WinoContentZoneBackgroud" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="ReadingPaneBackgroundColorBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="AppBarBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="WelcomeOverlayBrush" ResourceKey="SystemColorWindowBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
