<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xaml="using:Microsoft.UI.Xaml">

    <x:String x:Key="ThemeName">Custom</x:String>
    <x:String x:Key="Wallpaper">ms-appdata:///local/CustomWallpaper.jpg</x:String>
    <x:String x:Key="PreviewImage">ms-appdata:///local/CustomWallpaper_preview.jpg</x:String>

    <ImageBrush
        x:Key="WinoApplicationBackgroundColor"
        ImageSource="{StaticResource Wallpaper}"
        Stretch="UniformToFill" />

    <!--  Navigation View Settings  -->
    <xaml:CornerRadius x:Key="NavigationViewContentGridCornerRadius">0,0,0,0</xaml:CornerRadius>
    <xaml:CornerRadius x:Key="OverlayCornerRadius">0,1,0,0</xaml:CornerRadius>
    <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--
                Illustration palette. User wallpaper behind a translucent overlay, so the backdrop is unknowable. Highest-contrast values in
                the family: fully opaque surface and the strongest shadow.
            -->
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#C8C8D2</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#E4E4EC</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#EFA92B</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#28141414</SolidColorBrush>
            <!--  Reading Page Date/Name Group Header Background  -->
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#ecf0f1</SolidColorBrush>

            <Color x:Key="MainCustomThemeColor">#D9FFFFFF</Color>
            <SolidColorBrush
                x:Key="CalendarDefaultHourBackgroundBrush"
                Opacity="0.55"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush
                x:Key="CalendarHoverHourBackgroundBrush"
                Opacity="0.7"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush
                x:Key="CalendarWorkHourBackgroundBrush"
                Opacity="0.85"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#4D0078D4</SolidColorBrush>

            <!--  Wallpaper overlay surfaces  -->
            <SolidColorBrush x:Key="WinoContentZoneBackgroud" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="ReadingPaneBackgroundColorBrush" Color="{StaticResource MainCustomThemeColor}" />

            <SolidColorBrush x:Key="AppBarBackgroundColor" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#0B000000</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#08000000</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#4D4D4D</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#606060</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#A8A8A8</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WinoIllustrationSurfaceBrush">#3B3B42</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineBrush">#5C5C65</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationLineSoftBrush">#4A4A53</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationWarmBrush">#F5C05C</SolidColorBrush>
            <SolidColorBrush x:Key="WinoIllustrationShadowBrush">#66000000</SolidColorBrush>
            <!--  Reading Page Date/Name Group Header Background  -->
            <SolidColorBrush x:Key="MailListHeaderBackgroundColor">#1f1f1f</SolidColorBrush>

            <Color x:Key="MainCustomThemeColor">#E61F1F1F</Color>
            <SolidColorBrush
                x:Key="CalendarDefaultHourBackgroundBrush"
                Opacity="0.55"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush
                x:Key="CalendarHoverHourBackgroundBrush"
                Opacity="0.7"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush
                x:Key="CalendarWorkHourBackgroundBrush"
                Opacity="0.85"
                Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="CalendarSelectedHourBackgroundBrush">#66399BFF</SolidColorBrush>

            <!--  Wallpaper overlay surfaces  -->
            <SolidColorBrush x:Key="WinoContentZoneBackgroud" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="ReadingPaneBackgroundColorBrush" Color="{StaticResource MainCustomThemeColor}" />

            <SolidColorBrush x:Key="AppBarBackgroundColor" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush" Color="{StaticResource MainCustomThemeColor}" />
            <SolidColorBrush x:Key="CompanionFlyoutBackgroundBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionCardBackgroundBrush">#10FFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSubtleBackgroundBrush">#0CFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionSecondaryTextBrush">#C8C8C8</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionTertiaryTextBrush">#ADADAD</SolidColorBrush>
            <SolidColorBrush x:Key="CompanionDividerBrush">#515151</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="WinoIllustrationSurfaceBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="WinoIllustrationLineBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="WinoIllustrationLineSoftBrush" ResourceKey="SystemColorGrayTextBrush" />
            <StaticResource x:Key="WinoIllustrationWarmBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="WinoIllustrationShadowBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="MailListHeaderBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarDefaultHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarHoverHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="CalendarWorkHourBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CalendarSelectedHourBackgroundBrush" ResourceKey="SystemColorHighlightBrush" />
            <StaticResource x:Key="WinoContentZoneBackgroud" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="ReadingPaneBackgroundColorBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="AppBarBackgroundColor" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="WelcomeOverlayBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionFlyoutBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionCardBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSubtleBackgroundBrush" ResourceKey="SystemColorWindowBrush" />
            <StaticResource x:Key="CompanionSecondaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionTertiaryTextBrush" ResourceKey="SystemColorWindowTextBrush" />
            <StaticResource x:Key="CompanionDividerBrush" ResourceKey="SystemColorWindowTextBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
