<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wino.Mail.WinUI.Views.AppLockScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AutomationId="AppLockScreenPage"
    Loaded="PageLoaded"
    mc:Ignorable="d">

    <Grid>
        <Border
            Width="360"
            Margin="16"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <Image
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppEntries/MailAssets/StoreLogo.png" />

                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind domain:Translator.AppLock_LockedTitle, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="DescriptionTextBlock"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Grid
                    x:Name="PinPanel"
                    ColumnSpacing="8"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Icon="Dialpad" />
                    <PasswordBox
                        x:Name="PinBox"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="AppLockPinBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.AppLock_PinFieldName, Mode=OneTime}"
                        InputScope="NumericPin"
                        KeyDown="PinBoxKeyDown"
                        MaxLength="12"
                        PasswordChanged="PinChanged"
                        PlaceholderText="{x:Bind domain:Translator.AppLock_PinFieldName, Mode=OneTime}" />
                    <Button
                        x:Name="UnlockButton"
                        Grid.Column="2"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="AppLockUnlockButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.AppLock_Unlock, Mode=OneTime}"
                        Click="UnlockClicked"
                        IsEnabled="False"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.AppLock_Unlock, Mode=OneTime}">
                        <coreControls:WinoFontIcon FontSize="16" Icon="ArrowRight" />
                    </Button>
                </Grid>

                <Button
                    x:Name="HelloButton"
                    Width="72"
                    Height="72"
                    Padding="0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="AppLockHelloButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.AppLock_UseHello, Mode=OneTime}"
                    Click="HelloClicked"
                    CornerRadius="36"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.AppLock_UseHello, Mode=OneTime}"
                    Visibility="Collapsed">
                    <coreControls:WinoFontIcon
                        FontSize="36"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Icon="WindowsHello" />
                </Button>

                <TextBlock
                    x:Name="ErrorTextBlock"
                    AutomationProperties.AutomationId="AppLockError"
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <HyperlinkButton
                    x:Name="SignInOptionsButton"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="AppLockSignInOptionsButton"
                    Content="{x:Bind domain:Translator.AppLock_OpenSignInOptions, Mode=OneTime}"
                    NavigateUri="ms-settings:signinoptions"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
