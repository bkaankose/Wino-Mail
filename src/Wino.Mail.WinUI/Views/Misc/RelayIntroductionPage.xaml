<abstract:RelayIntroductionPageAbstract
    x:Class="Wino.Views.Misc.RelayIntroductionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Two selectable cards. Selection is a border and a check mark, never color alone.  -->
        <Style x:Key="ChoiceCardStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="32,8,32,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Sits under the window's drag region, so it holds nothing interactive.  -->
        <TextBlock
            VerticalAlignment="Bottom"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{x:Bind domain:Translator.RelayIntroduction_Header, Mode=OneTime}" />

        <TextBlock
            Grid.Row="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="{x:Bind domain:Translator.RelayIntroduction_Subtitle, Mode=OneTime}"
            TextWrapping="WrapWholeWords" />

        <Grid
            Grid.Row="2"
            Margin="0,12,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TimerCard"
                AutomationProperties.AutomationId="RelayIntroductionTimerCard"
                AutomationProperties.Name="{x:Bind domain:Translator.RelayIntroduction_TimerTitle, Mode=OneTime}"
                BorderBrush="{x:Bind SelectionBrush(ViewModel.IsTimerSelected), Mode=OneWay}"
                BorderThickness="{x:Bind SelectionThickness(ViewModel.IsTimerSelected), Mode=OneWay}"
                Click="TimerCardClicked"
                Style="{StaticResource ChoiceCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <coreControls:WinoFontIcon
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Icon="Clock" />
                        <coreControls:WinoFontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Icon="Accept"
                            Visibility="{x:Bind ViewModel.IsTimerSelected, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind domain:Translator.RelayIntroduction_TimerTitle, Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.TimerDescription, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Button>

            <Button
                x:Name="RelayCard"
                Grid.Column="1"
                AutomationProperties.AutomationId="RelayIntroductionRelayCard"
                AutomationProperties.Name="{x:Bind domain:Translator.RelayIntroduction_RelayTitle, Mode=OneTime}"
                BorderBrush="{x:Bind SelectionBrush(ViewModel.IsRelaySelected), Mode=OneWay}"
                BorderThickness="{x:Bind SelectionThickness(ViewModel.IsRelaySelected), Mode=OneWay}"
                Click="RelayCardClicked"
                Style="{StaticResource ChoiceCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <coreControls:WinoFontIcon
                            HorizontalAlignment="Left"
                            FontSize="28"
                            Icon="Cloud" />
                        <coreControls:WinoFontIcon
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Icon="Accept"
                            Visibility="{x:Bind ViewModel.IsRelaySelected, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind domain:Translator.RelayIntroduction_RelayTitle, Mode=OneTime}" />
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind domain:Translator.RelayIntroduction_RelayDescription, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </Button>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ErrorText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind domain:Translator.RelayIntroduction_SwitchFailed, Mode=OneTime}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />
            <Button
                Grid.Column="1"
                MinWidth="140"
                AutomationProperties.AutomationId="RelayIntroductionContinueButton"
                Click="ContinueClicked"
                Content="{x:Bind domain:Translator.RelayIntroduction_Continue, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.CanContinue, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</abstract:RelayIntroductionPageAbstract>
