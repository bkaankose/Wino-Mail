<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wino.Mail.WinUI.Views.MigrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">

    <Grid Padding="48,40,48,40" RowSpacing="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <!--  Single illustration shared by every migration state.  -->
            <Viewbox
                Height="148"
                AutomationProperties.AccessibilityView="Raw"
                Stretch="Uniform">
                <Canvas Width="160" Height="160">
                    <Ellipse
                        Width="160"
                        Height="160"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Opacity="0.14" />
                    <Path
                        Data="M80,22 L80,54 M68,34 L80,22 L92,34"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="4" />
                    <Rectangle
                        Canvas.Left="34"
                        Canvas.Top="64"
                        Width="92"
                        Height="58"
                        Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeThickness="3.5" />
                    <Path
                        Data="M38,70 L80,100 L122,70"
                        Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="3.5" />
                </Canvas>
            </Viewbox>

            <StackPanel Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.CurrentDescription, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                x:Name="MigrationRunningPanel"
                AutomationProperties.AutomationId="MigrationRunningPanel"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}">
                <ProgressBar
                    x:Name="MigrationProgressBar"
                    AutomationProperties.AutomationId="MigrationProgressBar"
                    IsIndeterminate="False"
                    Maximum="1"
                    Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StepProgressText, Mode=OneWay}" />
            </StackPanel>

            <InfoBar
                x:Name="MigrationFailurePanel"
                AutomationProperties.AutomationId="MigrationFailurePanel"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="SkipMigrationButton"
                AutomationProperties.AutomationId="SkipMigrationButton"
                Click="OnSkipMigrationClick"
                Content="{x:Bind domain:Translator.Migration_Skip}"
                Visibility="{x:Bind ViewModel.CanSkipMigration, Mode=OneWay}" />
            <Button
                x:Name="StartMigrationButton"
                MinWidth="160"
                AutomationProperties.AutomationId="StartMigrationButton"
                Command="{x:Bind ViewModel.StartCommand}"
                Content="{x:Bind domain:Translator.Migration_Start}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsOptionsVisible, Mode=OneWay}" />
            <Button
                x:Name="RetryMigrationButton"
                MinWidth="160"
                AutomationProperties.AutomationId="RetryMigrationButton"
                Command="{x:Bind ViewModel.RetryCommand}"
                Content="{x:Bind domain:Translator.Migration_Retry}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}" />
            <Button
                x:Name="LaunchWinoButton"
                MinWidth="160"
                AutomationProperties.AutomationId="LaunchWinoButton"
                Click="OnLaunchClick"
                Content="{x:Bind domain:Translator.Migration_Launch}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsSuccessVisible, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
