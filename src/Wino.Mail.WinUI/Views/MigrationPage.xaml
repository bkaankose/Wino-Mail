<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wino.Mail.WinUI.Views.MigrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Wino.Core.Domain.Models.WhatsNew"
    Loaded="OnPageLoaded"
    Unloaded="OnPageUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="MigrationSourceTileStyle" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="MigrationFlowPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeDashCap" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <Style x:Key="MigrationFlowSolidPathStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style x:Key="MigrationStateBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,-8,-8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!--  The one action on this page, sized to lead it.  -->
        <Style
            x:Key="MigrationHeroButtonStyle"
            BasedOn="{StaticResource AccentButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="32,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid x:Name="MigrationRoot" Padding="48,40,48,32">
        <!--  Ambient accent light behind the hero and the feature tour.  -->
        <Grid
            Margin="-48,-40,-48,-32"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False">
            <Rectangle x:Name="AmbientGlowPrimary" Opacity="0.32">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.24,0.22" GradientOrigin="0.24,0.22" RadiusX="0.5" RadiusY="0.62">
                        <GradientStop Offset="0" Color="{ThemeResource SystemAccentColor}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="AmbientGlowSecondary" Opacity="0.2">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.8,0.72" GradientOrigin="0.8,0.72" RadiusX="0.45" RadiusY="0.6">
                        <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorLight2}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <ScrollViewer
            x:Name="MigrationContentScroller"
            AutomationProperties.AutomationId="MigrationContentScroller"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="MigrationContentGrid"
                Padding="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    x:Name="MigrationStatusPanel"
                    Width="440"
                    VerticalAlignment="Center"
                    Spacing="24">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <!--  Illustration: account, mail and calendar data flowing into the new Wino.  -->
                    <Grid
                        x:Name="MigrationIllustration"
                        Width="400"
                        Height="160"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="128" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Border Style="{StaticResource MigrationSourceTileStyle}">
                                <Image Source="/Assets/AppEntries/People.svg" />
                            </Border>
                            <Border Style="{StaticResource MigrationSourceTileStyle}">
                                <Image Source="/Assets/AppEntries/Mail.svg" />
                            </Border>
                            <Border Style="{StaticResource MigrationSourceTileStyle}">
                                <Image Source="/Assets/AppEntries/Calendar.svg" />
                            </Border>
                        </StackPanel>

                        <Canvas
                            Grid.Column="1"
                            Width="184"
                            Height="160"
                            HorizontalAlignment="Center">
                            <Path
                                x:Name="FlowPathTop"
                                Data="M2,28 C92,28 92,80 182,80"
                                StrokeDashArray="1,3"
                                Style="{StaticResource MigrationFlowPathStyle}" />
                            <Path
                                x:Name="FlowPathMiddle"
                                Data="M2,80 L182,80"
                                StrokeDashArray="1,3"
                                Style="{StaticResource MigrationFlowPathStyle}" />
                            <Path
                                x:Name="FlowPathBottom"
                                Data="M2,132 C92,132 92,80 182,80"
                                StrokeDashArray="1,3"
                                Style="{StaticResource MigrationFlowPathStyle}" />

                            <Path
                                x:Name="FlowSolidPathTop"
                                Data="M2,28 C92,28 92,80 182,80"
                                Style="{StaticResource MigrationFlowSolidPathStyle}" />
                            <Path
                                x:Name="FlowSolidPathMiddle"
                                Data="M2,80 L182,80"
                                Style="{StaticResource MigrationFlowSolidPathStyle}" />
                            <Path
                                x:Name="FlowSolidPathBottom"
                                Data="M2,132 C92,132 92,80 182,80"
                                Style="{StaticResource MigrationFlowSolidPathStyle}" />
                        </Canvas>

                        <Grid Grid.Column="2">
                            <Ellipse
                                x:Name="TargetGlow"
                                Width="128"
                                Height="128"
                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0.12" />
                            <Border
                                Width="96"
                                Height="96"
                                Padding="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="24">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TargetFloat" />
                                </Border.RenderTransform>
                                <Grid>
                                    <Image Source="/Assets/AppEntries/Wino.svg" />

                                    <Border x:Name="NewBadge" Style="{StaticResource MigrationStateBadgeStyle}">
                                        <coreControls:WinoFontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Icon="Sparkle" />
                                    </Border>
                                    <Border
                                        x:Name="DoneBadge"
                                        Style="{StaticResource MigrationStateBadgeStyle}"
                                        Visibility="Collapsed">
                                        <coreControls:WinoFontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Icon="Checkmark" />
                                    </Border>
                                    <Border
                                        x:Name="FailedBadge"
                                        Style="{StaticResource MigrationStateBadgeStyle}"
                                        Visibility="Collapsed">
                                        <coreControls:WinoFontIcon
                                            FontSize="16"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Icon="Warning" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Name="MigrationTitleText"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="MigrationTitleText"
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="MigrationDescriptionText"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="MigrationDescriptionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDescription, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        x:Name="MigrationAuthorizationPanel"
                        Padding="20"
                        AutomationProperties.AutomationId="MigrationAuthorizationPanel"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.IsAuthorizationVisible, Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel HorizontalAlignment="Center" Spacing="8">
                                <Image
                                    Width="56"
                                    Height="56"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Source="{x:Bind ViewModel.CurrentAuthorizationAccount.ProviderIconPath, Mode=OneWay}"
                                    Stretch="Uniform" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.CurrentAuthorizationAccount.DisplayName, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.CurrentAuthorizationAccount.Address, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.CurrentAuthorizationAccount.AuthorizationFeaturesText, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <InfoBar
                                x:Name="MigrationAuthorizationError"
                                AutomationProperties.AutomationId="MigrationAuthorizationError"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.IsAuthorizationErrorVisible, Mode=OneWay}"
                                Message="{x:Bind ViewModel.AuthorizationErrorMessage, Mode=OneWay}"
                                Severity="Error"
                                Visibility="{x:Bind ViewModel.IsAuthorizationErrorVisible, Mode=OneWay}" />

                            <Button
                                x:Name="AuthenticateMigrationAccountButton"
                                MinHeight="48"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="AuthenticateMigrationAccountButton"
                                Command="{x:Bind ViewModel.AuthenticateCommand}"
                                Content="{x:Bind domain:Translator.Migration_Authenticate, Mode=OneTime}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="SkipMigrationAccountAuthenticationButton"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="SkipMigrationAccountAuthenticationButton"
                                Command="{x:Bind ViewModel.SkipAuthenticationCommand}"
                                Content="{x:Bind domain:Translator.Migration_SkipAccountAuthentication, Mode=OneTime}"
                                Style="{StaticResource TransparentActionButtonStyle}" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsAuthorizing, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsAuthorizing, Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.AuthorizationProgressText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel
                        x:Name="MigrationRunningPanel"
                        AutomationProperties.AutomationId="MigrationRunningPanel"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}">
                        <ProgressBar
                            x:Name="MigrationProgressBar"
                            AutomationProperties.AutomationId="MigrationProgressBar"
                            IsIndeterminate="False"
                            Maximum="1"
                            Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StepProgressText, Mode=OneWay}" />
                    </StackPanel>

                    <InfoBar
                        x:Name="MigrationFailurePanel"
                        AutomationProperties.AutomationId="MigrationFailurePanel"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}" />

                    <StackPanel
                        x:Name="MigrationActionsPanel"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Spacing="12">
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <Button
                                x:Name="SkipMigrationButton"
                                MinHeight="48"
                                Padding="20,0"
                                AutomationProperties.AutomationId="SkipMigrationButton"
                                Click="OnSkipMigrationClick"
                                Content="{x:Bind domain:Translator.Migration_Skip}"
                                Visibility="{x:Bind ViewModel.CanSkipMigration, Mode=OneWay}" />
                            <Button
                                x:Name="StartMigrationButton"
                                AutomationProperties.AutomationId="StartMigrationButton"
                                AutomationProperties.Name="{x:Bind domain:Translator.Migration_Start}"
                                Command="{x:Bind ViewModel.StartCommand}"
                                Style="{StaticResource MigrationHeroButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsOptionsVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind domain:Translator.Migration_Start}" />
                                    <coreControls:WinoFontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Icon="ArrowRight" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="RetryMigrationButton"
                                AutomationProperties.AutomationId="RetryMigrationButton"
                                AutomationProperties.Name="{x:Bind domain:Translator.Migration_Retry}"
                                Command="{x:Bind ViewModel.RetryCommand}"
                                Style="{StaticResource MigrationHeroButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <coreControls:WinoFontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Icon="ArrowClockwise" />
                                    <TextBlock Text="{x:Bind domain:Translator.Migration_Retry}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="LaunchWinoButton"
                                AutomationProperties.AutomationId="LaunchWinoButton"
                                AutomationProperties.Name="{x:Bind domain:Translator.Migration_Launch}"
                                Click="OnLaunchClick"
                                Style="{StaticResource MigrationHeroButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsSuccessVisible, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{x:Bind domain:Translator.Migration_Launch}" />
                                    <coreControls:WinoFontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Icon="ArrowRight" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock
                            x:Name="MigrationOneTimeNote"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="MigrationOneTimeNote"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.Migration_OneTimeNote, Mode=OneTime}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.IsOptionsVisible, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  What's New features, shown in the What's New card format while the user waits.  -->
                <StackPanel
                    x:Name="MigrationFeatureTourPanel"
                    Grid.Column="1"
                    Width="420"
                    Margin="48,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="MigrationFeatureTourPanel"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsFeatureTourVisible, Mode=OneWay}">
                    <StackPanel.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="48" FromVerticalOffset="0" />
                        </TransitionCollection>
                    </StackPanel.Transitions>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <FlipView
                            x:Name="MigrationFeatureFlipView"
                            Height="372"
                            AutomationProperties.AutomationId="MigrationFeatureFlipView"
                            AutomationProperties.HelpText="{x:Bind domain:Translator.WelcomeWindow_UpdateCarouselAutomationHelpText, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.Migration_FeatureTourHeader, Mode=OneTime}"
                            Background="Transparent"
                            CornerRadius="7"
                            ItemsSource="{x:Bind ViewModel.Features, Mode=OneWay}"
                            SelectionChanged="OnFeatureFlipViewSelectionChanged">
                            <FlipView.ItemTemplate>
                                <DataTemplate x:DataType="models:WhatsNewFeature">
                                    <Grid AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneTime}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="224" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!--  Illustrations are 1120x600 PNGs, the same slot ratio as the What's New window.  -->
                                        <Border
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                            <Image
                                                AutomationProperties.AccessibilityView="Raw"
                                                Source="{x:Bind ImageUri, Mode=OneTime}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <ScrollViewer
                                            Grid.Row="1"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto">
                                            <StackPanel Padding="20,16,20,20" Spacing="8">
                                                <TextBlock
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    Text="{x:Bind Title, Mode=OneTime}"
                                                    TextWrapping="WrapWholeWords" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                    Text="{x:Bind Description, Mode=OneTime}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </DataTemplate>
                            </FlipView.ItemTemplate>
                        </FlipView>
                    </Border>

                    <PipsPager
                        x:Name="MigrationFeaturePager"
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="MigrationFeaturePager"
                        AutomationProperties.Name="{x:Bind domain:Translator.WelcomeWindow_UpdateCarouselPagerAutomationName, Mode=OneTime}"
                        NumberOfPages="{x:Bind ViewModel.Features.Count, Mode=OneWay}"
                        SelectedIndexChanged="OnFeaturePagerSelectedIndexChanged"
                        SelectedPageIndex="0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <!--  Side by side when both columns fit; otherwise the tour moves under the status.  -->
            <VisualStateGroup x:Name="MigrationLayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1040" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MigrationFeatureTourPanel.(Grid.Column)" Value="0" />
                        <Setter Target="MigrationFeatureTourPanel.(Grid.Row)" Value="1" />
                        <Setter Target="MigrationFeatureTourPanel.Margin" Value="0,32,0,0" />
                        <Setter Target="MigrationFeatureTourPanel.Width" Value="440" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="MigrationIllustrationStates">
                <!--  Before the user starts: a slow, quiet version of the moving flow.  -->
                <VisualState x:Name="Idle">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsIllustrationIdle, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <Storyboard>
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathTop"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:1.4" />
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathMiddle"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:1.4" />
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathBottom"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:1.4" />
                        <DoubleAnimation
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="TargetFloat"
                            Storyboard.TargetProperty="Y"
                            From="0"
                            To="-6"
                            Duration="0:0:2.4">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="TargetGlow"
                            Storyboard.TargetProperty="Opacity"
                            From="0.1"
                            To="0.2"
                            Duration="0:0:2.4" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Moving">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FlowPathTop.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="FlowPathMiddle.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="FlowPathBottom.Stroke" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathTop"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:0.4" />
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathMiddle"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:0.4" />
                        <DoubleAnimation
                            EnableDependentAnimation="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="FlowPathBottom"
                            Storyboard.TargetProperty="StrokeDashOffset"
                            From="0"
                            To="-4"
                            Duration="0:0:0.4" />
                        <DoubleAnimation
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="TargetGlow"
                            Storyboard.TargetProperty="Opacity"
                            From="0.08"
                            To="0.24"
                            Duration="0:0:1.2" />
                        <DoubleAnimation
                            AutoReverse="True"
                            RepeatBehavior="Forever"
                            Storyboard.TargetName="TargetFloat"
                            Storyboard.TargetProperty="Y"
                            From="0"
                            To="-4"
                            Duration="0:0:1.2">
                            <DoubleAnimation.EasingFunction>
                                <SineEase EasingMode="EaseInOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Done">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsSuccessVisible, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FlowSolidPathTop.Opacity" Value="1" />
                        <Setter Target="FlowSolidPathMiddle.Opacity" Value="1" />
                        <Setter Target="FlowSolidPathBottom.Opacity" Value="1" />
                        <Setter Target="NewBadge.Visibility" Value="Collapsed" />
                        <Setter Target="DoneBadge.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Failed">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ViewModel.IsFailureVisible, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NewBadge.Visibility" Value="Collapsed" />
                        <Setter Target="FailedBadge.Visibility" Value="Visible" />
                        <Setter Target="TargetGlow.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
