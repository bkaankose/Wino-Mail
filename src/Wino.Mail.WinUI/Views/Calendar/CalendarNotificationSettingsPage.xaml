<abstract:CalendarNotificationSettingsPageAbstract
    x:Class="Wino.Mail.WinUI.Views.Calendar.CalendarNotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

        <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard

                AutomationProperties.AutomationId="CalendarNotificationSettingsPageSettingsCard" Description="{x:Bind domain:Translator.CalendarSettings_DefaultReminder_Description, Mode=OneTime}" Header="{x:Bind domain:Translator.CalendarSettings_DefaultReminder_Header, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox

                    AutomationProperties.AutomationId="CalendarNotificationSettingsPageComboBox" ItemsSource="{x:Bind ViewModel.ReminderOptions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedDefaultReminderIndex, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard

                AutomationProperties.AutomationId="CalendarNotificationSettingsPageSettingsCard2" Description="{x:Bind domain:Translator.CalendarSettings_DefaultSnoozeDuration_Description}" Header="{x:Bind domain:Translator.CalendarSettings_DefaultSnoozeDuration_Header}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE823;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox

                    AutomationProperties.AutomationId="CalendarNotificationSettingsPageComboBox2" ItemsSource="{x:Bind ViewModel.SnoozeOptions, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedDefaultSnoozeIndex, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                AutomationProperties.AutomationId="CalendarNotificationSoundSettingsCard"
                Description="{x:Bind domain:Translator.NotificationSound_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.NotificationSound_Title, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ComboBox
                        AutomationProperties.AutomationId="CalendarNotificationSoundComboBox"
                        ItemsSource="{x:Bind ViewModel.AvailableNotificationSounds, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedNotificationSoundIndex, Mode=TwoWay}" />
                    <Button
                        AutomationProperties.AutomationId="CalendarNotificationSoundPlayButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}"
                        Click="PlayNotificationSoundButton_Click"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                    </Button>
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
</abstract:CalendarNotificationSettingsPageAbstract>
