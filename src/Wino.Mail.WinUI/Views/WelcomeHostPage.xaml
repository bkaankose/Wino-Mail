<abstract:WelcomeHostPageAbstract
    x:Class="Wino.Mail.WinUI.Views.WelcomeHostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Common.Data"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelData="using:Wino.Mail.ViewModels.Data"
    xmlns:winuiControls="using:Microsoft.UI.Xaml.Controls"
    xmlns:winuiHelpers="using:Wino.Mail.WinUI.Helpers"
    mc:Ignorable="d">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Wizard step indicator bar. Account setup carries its own header, so the bar steps aside for it.  -->
        <Border
            x:Name="BreadcrumbHost"
            Padding="24,20"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <winuiControls:BreadcrumbBar
                x:Name="Breadcrumb"
                HorizontalAlignment="Center"
                ItemClicked="BreadItemClicked"
                ItemsSource="{x:Bind PageHistory, Mode=OneWay}">
                <winuiControls:BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="data:BreadcrumbNavigationItemViewModel">
                        <!--
                            TODO: This crashes.
                            AutomationProperties.Name="{x:Bind winuiHelpers:XamlHelpers.GetBreadcrumbStepAutomationName(StepNumber, Title), Mode=OneWay}"
                        -->
                        <winuiControls:BreadcrumbBarItem>
                            <winuiControls:BreadcrumbBarItem.ContentTemplate>
                                <DataTemplate x:DataType="data:BreadcrumbNavigationItemViewModel">
                                    <TextBlock
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        FontWeight="{x:Bind winuiHelpers:XamlHelpers.GetFontWeightBySyncState(IsActive), Mode=OneWay}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind Title, Mode=OneWay}" />
                                </DataTemplate>
                            </winuiControls:BreadcrumbBarItem.ContentTemplate>
                        </winuiControls:BreadcrumbBarItem>
                    </DataTemplate>
                </winuiControls:BreadcrumbBar.ItemTemplate>
            </winuiControls:BreadcrumbBar>
        </Border>

        <!--  Wizard pages size to their content; the host scrolls them when they are taller than the window.  -->
        <ScrollViewer
            x:Name="WizardScrollViewer"
            Grid.Row="1"
            AutomationProperties.AutomationId="WelcomeWizardScrollViewer"
            HorizontalScrollBarVisibility="Disabled"
            SizeChanged="WizardScrollViewerSizeChanged"
            VerticalScrollBarVisibility="Auto">
            <Frame x:Name="WizardFrame" Navigated="WizardFrameNavigated" />
        </ScrollViewer>
    </Grid>
</abstract:WelcomeHostPageAbstract>
