<abstract:AccountSetupPageAbstract
    x:Class="Wino.Views.AccountSetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:accounts="using:Wino.Core.Domain.Models.Accounts"
    xmlns:connectivity="using:Wino.Core.Domain.Models.Connectivity"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:local="using:Wino.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Wino.Mail.Controls.Primitives"
    xmlns:selectors="using:Wino.Selectors"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="AccountSetupStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="AccountSetupStrokeBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="AccountSetupStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Icons in this page and its templates set WinoIconFontFamily as a StaticResource: in the welcome window neither
                the implicit WinoFontIcon style nor a ThemeResource lookup reached them, and the glyphs fell back to Segoe.
            -->
            <Style
                x:Key="AccountSetupCaptionStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style
                x:Key="AccountSetupErrorStyle"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <!--  The identity strip's capability line: one wrapping line of caption items separated by " · ".  -->
            <ItemsPanelTemplate x:Key="AccountSetupKnownPanelTemplate">
                <primitives:WinoWrapPanel HorizontalSpacing="6" VerticalSpacing="2" />
            </ItemsPanelTemplate>

            <DataTemplate x:Key="AccountSetupKnownChipTemplate" x:DataType="local:AccountSetupKnownChip">
                <StackPanel
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock
                        Margin="0,0,2,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="·"
                        Visibility="{x:Bind HasSeparator}" />
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource WinoIconFontFamily}"
                        FontSize="16"
                        Icon="{x:Bind Glyph}"
                        Visibility="{x:Bind HasGlyph}" />
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource WinoIconFontFamily}"
                        FontSize="14"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Icon="{x:Bind Glyph}"
                        Visibility="{x:Bind HasSuccessGlyph}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Text}"
                        Visibility="{x:Bind IsStrong}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Text}"
                        ToolTipService.ToolTip="{x:Bind ToolTip}"
                        Visibility="{x:Bind IsPlain}" />
                </StackPanel>
            </DataTemplate>

            <!--  One row of a step's list: the label, then "(recommended)" or "(most secure)" as a secondary caption.  -->
            <DataTemplate x:Key="AccountSetupChoiceTemplate" x:DataType="data:AccountSetupChoice">
                <ItemContainer HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind AutomationName}">
                    <Border
                        MinHeight="40"
                        Padding="12,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccountSetupStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Label}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Caption}"
                                Visibility="{x:Bind HasCaption}" />
                        </StackPanel>
                    </Border>
                </ItemContainer>
            </DataTemplate>

            <!--
                One app on the review step as a settings card: the app's icon and name with what the account offers under
                it, then where its data lives and the switch. A server address, a note or an error sits under the card.
            -->
            <DataTemplate x:Key="AccountSetupAppRowTemplate" x:DataType="data:AccountSetupAppRow">
                <StackPanel Spacing="4">
                    <toolkit:SettingsCard Header="{x:Bind Title}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <ImageIcon Source="{x:Bind local:AccountSetupPage.GetAppIcon(Kind)}" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.Resources>
                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">30</x:Double>
                        </toolkit:SettingsCard.Resources>
                        <toolkit:SettingsCard.Description>
                            <TextBlock
                                Style="{StaticResource AccountSetupCaptionStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                Visibility="{x:Bind HasStatus, Mode=OneWay}" />
                        </toolkit:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox
                                Width="230"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind local:AccountSetupPage.GetSourceName(Kind, Title)}"
                                ItemsSource="{x:Bind Options}"
                                SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}"
                                Visibility="{x:Bind IsSourceVisible, Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="data:AccountSetupSourceOption">
                                        <TextBlock
                                            Text="{x:Bind Label}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!--  Mail has no switch; the empty slot keeps its drop-down in line with the others.  -->
                            <Grid Width="40" VerticalAlignment="Center">
                                <ToggleSwitch
                                    MinWidth="0"
                                    AutomationProperties.Name="{x:Bind local:AccountSetupPage.GetUseAppName(Title)}"
                                    IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    Visibility="{x:Bind IsSwitchVisible}" />
                            </Grid>
                        </StackPanel>
                    </toolkit:SettingsCard>
                    <TextBox
                        AutomationProperties.HelpText="{x:Bind domain:Translator.AccountSetup_ServerAddressDescription}"
                        AutomationProperties.Name="{x:Bind domain:Translator.AccountSetup_ServerAddressHeader}"
                        InputScope="Url"
                        IsSpellCheckEnabled="False"
                        KeyDown="StepTextBoxKeyDown"
                        PlaceholderText="{x:Bind domain:Translator.AccountSetup_ServerAddressPlaceholder}"
                        Text="{x:Bind ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind IsServerEntryShown, Mode=OneWay}" />
                    <TextBlock
                        Margin="4,0"
                        Style="{StaticResource AccountSetupCaptionStyle}"
                        Text="{x:Bind Note, Mode=OneWay}"
                        Visibility="{x:Bind IsNoteShown, Mode=OneWay}" />
                    <TextBlock
                        Margin="4,0"
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource AccountSetupErrorStyle}"
                        Text="{x:Bind Error, Mode=OneWay}"
                        Visibility="{x:Bind HasError, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>

            <!--  One line of the result: the app and where its data lives.  -->
            <DataTemplate x:Key="AccountSetupResultRowTemplate" x:DataType="data:AccountSetupResultRow">
                <Grid
                    Padding="0,4"
                    AutomationProperties.Name="{x:Bind AutomationName}"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource WinoIconFontFamily}"
                        FontSize="16"
                        Icon="{x:Bind Glyph}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Detail}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </DataTemplate>

            <!--  ============ Address: the email, or a local account's name with its colour  ============  -->
            <DataTemplate x:Key="AddressStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="16">
                    <!--  The providers Wino connects to. They are not buttons: the typed domain lights its provider.  -->
                    <ItemsControl
                        HorizontalAlignment="Center"
                        AutomationProperties.AutomationId="AccountSetupProviderShelf"
                        AutomationProperties.Name="{x:Bind domain:Translator.AccountSetup_Shelf_Header}"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.ProviderShelfItems, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsProviderShelfVisible, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:AccountSetupProviderShelfItem">
                                <Grid
                                    Height="36"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    Opacity="{x:Bind helpers:XamlHelpers.GetShelfItemOpacity(IsDimmed)}"
                                    ToolTipService.ToolTip="{x:Bind Title}">
                                    <Grid Width="36" Visibility="{x:Bind HasGlyph}">
                                        <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Ellipse
                                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                            StrokeThickness="2"
                                            Visibility="{x:Bind IsMatched}" />
                                        <coreControls:WinoFontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource WinoIconFontFamily}"
                                            FontSize="18"
                                            Icon="{x:Bind Glyph}" />
                                    </Grid>
                                    <Border
                                        Padding="12,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="{x:Bind helpers:XamlHelpers.GetShelfItemBorderThickness(IsMatched)}"
                                        CornerRadius="18"
                                        Visibility="{x:Bind HasLabel}">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Label}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsEmailFieldVisible, Mode=OneWay}">
                        <TextBlock Text="{x:Bind domain:Translator.AccountSetup_EmailHeader}" />
                        <!--  A recognised address shows its provider's mark inside the field.  -->
                        <Grid>
                            <TextBox
                                Padding="{x:Bind local:AccountSetupPage.GetEmailPadding(ViewModel.HasMatchedProvider), Mode=OneWay}"
                                AutomationProperties.AutomationId="AccountSetupEmailAddress"
                                AutomationProperties.Name="{x:Bind domain:Translator.AccountSetup_EmailHeader}"
                                InputScope="EmailSmtpAddress"
                                IsSpellCheckEnabled="False"
                                KeyDown="StepTextBoxKeyDown"
                                Loaded="FocusTargetLoaded"
                                PlaceholderText="{x:Bind domain:Translator.AccountSetup_EmailPlaceholder}"
                                Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <coreControls:WinoFontIcon
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{StaticResource WinoIconFontFamily}"
                                FontSize="16"
                                Icon="{x:Bind ViewModel.MatchedProviderGlyph, Mode=OneWay}"
                                IsHitTestVisible="False"
                                Visibility="{x:Bind ViewModel.HasMatchedProvider, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource AccountSetupCaptionStyle}"
                            Text="{x:Bind ViewModel.ProviderShelfCaption, Mode=OneWay}"
                            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.HasIdentityError), Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.LiveSetting="Assertive"
                            Style="{StaticResource AccountSetupErrorStyle}"
                            Text="{x:Bind ViewModel.IdentityError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasIdentityError, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLocalOnlyMode, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.AutomationId="AccountSetupAccountName"
                                Header="{x:Bind domain:Translator.AccountSetup_AccountNameHeader}"
                                KeyDown="StepTextBoxKeyDown"
                                Loaded="FocusTargetLoaded"
                                PlaceholderText="{x:Bind domain:Translator.AccountSetup_AccountNamePlaceholder}"
                                Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="AccountSetupAccountColor"
                                AutomationProperties.HelpText="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Description}"
                                AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}"
                                ToolTipService.ToolTip="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}">
                                <Grid>
                                    <coreControls:WinoFontIcon
                                        FontFamily="{StaticResource WinoIconFontFamily}"
                                        FontSize="16"
                                        Icon="PaintBrush"
                                        Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsColorSelected), Mode=OneWay}" />
                                    <Ellipse
                                        Width="16"
                                        Height="16"
                                        Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="8">
                                            <GridView
                                                Width="150"
                                                AutomationProperties.AutomationId="AccountSetupColorGridView"
                                                AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}"
                                                ItemTemplate="{StaticResource AccountColorTemplate}"
                                                ItemsSource="{x:Bind ViewModel.AvailableColors, Mode=OneWay}"
                                                SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                AutomationProperties.AutomationId="AccountSetupClearColor"
                                                Command="{x:Bind ViewModel.SelectColorCommand}"
                                                Content="{x:Bind domain:Translator.ProviderSelection_ClearColor}"
                                                Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Assertive"
                            Style="{StaticResource AccountSetupErrorStyle}"
                            Text="{x:Bind ViewModel.AccountNameError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasAccountNameError, Mode=OneWay}" />
                    </StackPanel>

                </StackPanel>
            </DataTemplate>

            <!--  ============ Discovery ============  -->
            <DataTemplate x:Key="DiscoveryStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource AccountSetupCaptionStyle}"
                        Text="{x:Bind ViewModel.DiscoverySlowText}"
                        Visibility="{x:Bind ViewModel.IsResolveSlow, Mode=OneWay}" />

                    <InfoBar
                        Title="{x:Bind ViewModel.NotFoundTitle, Mode=OneWay}"
                        AutomationProperties.AutomationId="AccountSetupNotFoundInfoBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsNotFoundVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.NotFoundMessage, Mode=OneWay}"
                        Severity="Warning">
                        <InfoBar.Content>
                            <primitives:WinoWrapPanel
                                Margin="0,0,0,12"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupNotFoundSetUpManually"
                                    Command="{x:Bind ViewModel.OpenAdvancedSetupCommand}"
                                    Content="{x:Bind ViewModel.NotFoundManualText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupNotFoundRetry"
                                    Command="{x:Bind ViewModel.ResolveAgainCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_Retry}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="AccountSetupNotFoundChooseProvider"
                                    Click="ChangeProviderClick"
                                    Content="{x:Bind domain:Translator.AccountSetup_ChooseProvider}"
                                    Visibility="{x:Bind ViewModel.IsChooseProviderVisible, Mode=OneWay}" />
                            </primitives:WinoWrapPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
            </DataTemplate>

            <!--
                ============ Review: every app in one place ============
                The IMAP route arrives here signed in; Gmail, Outlook and Exchange sign in from the footer.
            -->
            <DataTemplate x:Key="ReviewStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="12">
                    <InfoBar
                        AutomationProperties.AutomationId="AccountSetupSignedInInfoBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsReviewSignedInVisible, Mode=OneWay}"
                        Message="{x:Bind domain:Translator.AccountSetup_Review_SignedIn}"
                        Severity="Success" />

                    <InfoBar
                        Title="{x:Bind domain:Translator.POP3Setup_LimitationsTitle}"
                        AutomationProperties.AutomationId="AccountSetupPop3Notice"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsPop3NoticeVisible, Mode=OneWay}"
                        Message="{x:Bind domain:Translator.POP3Setup_LimitationsMessage}"
                        Severity="Informational" />

                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.AutomationId="AccountSetupReviewAccountName"
                                Header="{x:Bind domain:Translator.AccountSetup_AccountNameHeader}"
                                KeyDown="StepTextBoxKeyDown"
                                PlaceholderText="{x:Bind domain:Translator.AccountSetup_AccountNamePlaceholder}"
                                Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="AccountSetupReviewAccountColor"
                                AutomationProperties.HelpText="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Description}"
                                AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}"
                                ToolTipService.ToolTip="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}">
                                <Grid>
                                    <coreControls:WinoFontIcon
                                        FontFamily="{StaticResource WinoIconFontFamily}"
                                        FontSize="16"
                                        Icon="PaintBrush"
                                        Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsColorSelected), Mode=OneWay}" />
                                    <Ellipse
                                        Width="16"
                                        Height="16"
                                        Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="8">
                                            <GridView
                                                Width="150"
                                                AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title}"
                                                ItemTemplate="{StaticResource AccountColorTemplate}"
                                                ItemsSource="{x:Bind ViewModel.AvailableColors, Mode=OneWay}"
                                                SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                                            <HyperlinkButton
                                                HorizontalAlignment="Center"
                                                Command="{x:Bind ViewModel.SelectColorCommand}"
                                                Content="{x:Bind domain:Translator.ProviderSelection_ClearColor}"
                                                Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock
                            AutomationProperties.LiveSetting="Assertive"
                            Style="{StaticResource AccountSetupErrorStyle}"
                            Text="{x:Bind ViewModel.AccountNameError, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasAccountNameError, Mode=OneWay}" />
                    </StackPanel>

                    <ItemsControl
                        AutomationProperties.AutomationId="AccountSetupAppRows"
                        IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsReviewStatusVisible), Mode=OneWay}"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource AccountSetupAppRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.AppRows, Mode=OneWay}"
                        Loaded="FocusTargetLoaded">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <CheckBox
                        AutomationProperties.AutomationId="AccountSetupDavUseMailSignIn"
                        Content="{x:Bind domain:Translator.AccountSetup_UseMailSignIn}"
                        IsChecked="{x:Bind ViewModel.UseMailSignInForDav, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsUseMailSignInForDavVisible, Mode=OneWay}" />

                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsReviewDavSignInVisible, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.AccountSetup_Review_DavSignInDescription}" />
                        <TextBox
                            AutomationProperties.AutomationId="AccountSetupDavUserName"
                            Header="{x:Bind domain:Translator.AccountSetup_DavUserNameHeader}"
                            IsSpellCheckEnabled="False"
                            Text="{x:Bind ViewModel.DavUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox
                            AutomationProperties.AutomationId="AccountSetupDavPassword"
                            Header="{x:Bind domain:Translator.AccountSetup_DavPasswordHeader}"
                            KeyDown="StepTextBoxKeyDown"
                            Password="{x:Bind ViewModel.DavPassword, Mode=TwoWay}" />
                    </StackPanel>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="AccountSetupServerDetails"
                        Header="{x:Bind domain:Translator.AccountSetup_Review_ServerDetails}"
                        Visibility="{x:Bind ViewModel.IsServerDetailsVisible, Mode=OneWay}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.AccountSetup_Check_Incoming}" />
                                <TextBlock
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ServerDetailsIncoming, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource AccountSetupCaptionStyle}"
                                    Text="{x:Bind domain:Translator.AccountSetup_Check_Outgoing}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ServerDetailsOutgoing, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource AccountSetupCaptionStyle}"
                                    Text="{x:Bind domain:Translator.ProviderSelection_SourceCalDav}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ServerDetailsCalDav, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource AccountSetupCaptionStyle}"
                                    Text="{x:Bind domain:Translator.ProviderSelection_SourceCardDav}" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.ServerDetailsCardDav, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="AccountSetupEditServers"
                                Command="{x:Bind ViewModel.OpenAdvancedSetupCommand}"
                                Content="{x:Bind domain:Translator.AccountSetup_Review_EditServers}" />
                        </StackPanel>
                    </Expander>

                    <TextBlock
                        AutomationProperties.AutomationId="AccountSetupReviewError"
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource AccountSetupErrorStyle}"
                        Text="{x:Bind ViewModel.FeaturesError, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasFeaturesError, Mode=OneWay}" />

                    <TextBlock
                        AutomationProperties.AutomationId="AccountSetupReviewCaption"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource AccountSetupCaptionStyle}"
                        Text="{x:Bind ViewModel.ReviewCaption, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasReviewCaption, Mode=OneWay}" />

                    <!--  Checking an entered server, or waiting for the provider's sign-in page.  -->
                    <Grid
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AccountSetupReviewStatus"
                        AutomationProperties.LiveSetting="Polite"
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.IsReviewStatusVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsReviewStatusVisible, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.ReviewStatusText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>

                    <InfoBar
                        Title="{x:Bind ViewModel.FailureTitle, Mode=OneWay}"
                        AutomationProperties.AutomationId="AccountSetupReviewFailureInfoBar"
                        CloseButtonCommand="{x:Bind ViewModel.HideFailureCommand}"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsFailureOpen, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                        Severity="{x:Bind helpers:XamlHelpers.InfoBarSeverityConverter(ViewModel.FailureSeverity), Mode=OneWay}">
                        <InfoBar.Content>
                            <primitives:WinoWrapPanel
                                Margin="0,0,0,12"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.RetryCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_Retry}"
                                    Visibility="{x:Bind ViewModel.IsRetryVisible, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupReviewFailureChangeProvider"
                                    Click="ChangeProviderClick"
                                    Content="{x:Bind domain:Translator.AccountSetup_ChangeProvider}"
                                    Visibility="{x:Bind ViewModel.IsChangeProviderVisible, Mode=OneWay}" />
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenAdvancedSetupCommand}" Content="{x:Bind domain:Translator.AccountSetup_AdvancedSetup}" />
                                <HyperlinkButton
                                    Command="{x:Bind ViewModel.ShowFailureDetailsCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_ShowDetails}"
                                    Visibility="{x:Bind ViewModel.HasFailureDetails, Mode=OneWay}" />
                            </primitives:WinoWrapPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
            </DataTemplate>

            <!--  ============ Sign-in method (IMAP with more than one option) ============  -->
            <DataTemplate x:Key="SignInMethodStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="8">
                    <ItemsView
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="AccountSetupSignInMethodChoices"
                        AutomationProperties.Name="{x:Bind ViewModel.StepTitle}"
                        ItemTemplate="{StaticResource AccountSetupChoiceTemplate}"
                        ItemsSource="{x:Bind ViewModel.StepChoices}"
                        Loaded="ChoicesLoaded"
                        PreviewKeyDown="ChoicesPreviewKeyDown"
                        SelectionChanged="ChoicesSelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsView.Layout>
                    </ItemsView>
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource AccountSetupCaptionStyle}"
                        Text="{x:Bind ViewModel.StepCaption, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStepCaption, Mode=OneWay}" />
                </StackPanel>
            </DataTemplate>

            <!--
                Sign in and the mail checks. IMAP signs in here and goes on to the review; an Exchange account that
                uses a password signs in here after its review. Gmail and Outlook never show this step.
            -->
            <DataTemplate x:Key="SignInStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="12">
                    <CheckBox
                        AutomationProperties.AutomationId="AccountSetupIssuerConfirmation"
                        IsChecked="{x:Bind ViewModel.IsIssuerConfirmed, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsIssuerConfirmationVisible, Mode=OneWay}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.IssuerConfirmationText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.ImapSetup_OAuthConfirmIssuerDescription}" />
                        </StackPanel>
                    </CheckBox>
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AccountSetupBrowserSignIn"
                        AutomationProperties.Name="{x:Bind ViewModel.BrowserSignInButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SignInWithBrowserCommand}"
                        Loaded="FocusTargetLoaded"
                        Style="{StaticResource SocialSignInButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsBrowserSignInButtonVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <coreControls:WinoFontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource WinoIconFontFamily}"
                                FontSize="16"
                                Icon="{x:Bind local:AccountSetupPage.GetBrowserSignInMark(ViewModel.RouteSpecialImapProvider), Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.BrowserSignInButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsPasswordPanelVisible, Mode=OneWay}">
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsSetupHintCaptionVisible, Mode=OneWay}">
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind ViewModel.SignInCaption, Mode=OneWay}" />
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="AccountSetupPasswordHelp"
                                Command="{x:Bind ViewModel.OpenHelpLinkCommand}"
                                CommandParameter="{x:Bind ViewModel.HelpUrl, Mode=OneWay}"
                                Content="{x:Bind ViewModel.HelpLinkText, Mode=OneWay}"
                                FontSize="12"
                                Visibility="{x:Bind ViewModel.IsHelpLinkVisible, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsRegionVisible, Mode=OneWay}">
                            <ComboBox
                                MinWidth="200"
                                AutomationProperties.AutomationId="AccountSetupRegion"
                                Header="{x:Bind domain:Translator.ProviderSelection_RegionHeader}"
                                ItemsSource="{x:Bind ViewModel.Regions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedRegion, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="connectivity:KnownImapProviderRegion">
                                        <TextBlock Text="{x:Bind DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind ViewModel.RegionDescription, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsLoginAddressVisible, Mode=OneWay}">
                            <TextBox
                                AutomationProperties.AutomationId="AccountSetupLoginAddress"
                                Header="{x:Bind ViewModel.LoginAddressHeader, Mode=OneWay}"
                                InputScope="EmailSmtpAddress"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.LoginAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind ViewModel.LoginAddressDescription, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsImapUserNameVisible, Mode=OneWay}">
                            <TextBox
                                AutomationProperties.AutomationId="AccountSetupImapUserName"
                                Header="{x:Bind domain:Translator.AccountSetup_UserNameHeader}"
                                IsSpellCheckEnabled="False"
                                KeyDown="StepTextBoxKeyDown"
                                PlaceholderText="{x:Bind ViewModel.ImapUserNamePlaceholder, Mode=OneWay}"
                                Text="{x:Bind ViewModel.ImapUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.AccountSetup_UserNameDescription}" />
                        </StackPanel>

                        <PasswordBox
                            AutomationProperties.AutomationId="AccountSetupPassword"
                            Header="{x:Bind ViewModel.PasswordHeader, Mode=OneWay}"
                            IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsConnectionStatusBusy), Mode=OneWay}"
                            KeyDown="StepTextBoxKeyDown"
                            Loaded="FocusTargetLoaded"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="AccountSetupShowImapUserName"
                            Command="{x:Bind ViewModel.ShowImapUserNameCommand}"
                            Content="{x:Bind domain:Translator.AccountSetup_UseDifferentUserName}"
                            FontSize="12"
                            Visibility="{x:Bind ViewModel.IsImapUserNameLinkVisible, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Exchange without modern auth: the sign-in name when it is not the address, then the password.  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsExchangePasswordVisible, Mode=OneWay}">
                        <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind ViewModel.ExchangePasswordCaption, Mode=OneWay}" />
                        <StackPanel Spacing="4">
                            <TextBox
                                AutomationProperties.AutomationId="AccountSetupExchangeUserName"
                                Header="{x:Bind domain:Translator.ExchangeSetup_UserNameHeader}"
                                IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsConnectionStatusBusy), Mode=OneWay}"
                                IsSpellCheckEnabled="False"
                                KeyDown="StepTextBoxKeyDown"
                                PlaceholderText="{x:Bind ViewModel.ExchangeUserNamePlaceholder, Mode=OneWay}"
                                Text="{x:Bind ViewModel.ExchangeUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.ExchangeSetup_UserNameDescription}" />
                        </StackPanel>
                        <PasswordBox
                            AutomationProperties.AutomationId="AccountSetupExchangePassword"
                            Header="{x:Bind domain:Translator.ProviderSelection_PasswordHeader_Account}"
                            IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsConnectionStatusBusy), Mode=OneWay}"
                            KeyDown="StepTextBoxKeyDown"
                            Loaded="FocusTargetLoaded"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  IMAP mail: the sender name, under the password or the browser button.  -->
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsSendAsVisible, Mode=OneWay}">
                        <TextBox
                            AutomationProperties.AutomationId="AccountSetupSendAs"
                            Header="{x:Bind domain:Translator.AccountSetup_SendAsHeader}"
                            KeyDown="StepTextBoxKeyDown"
                            Text="{x:Bind ViewModel.SenderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind domain:Translator.AccountSetup_SendAsDescription}" />
                    </StackPanel>

                    <!--  One status line: waiting or checking, then signed in or all connections work.  -->
                    <Grid
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AccountSetupConnectionStatus"
                        AutomationProperties.LiveSetting="Polite"
                        ColumnSpacing="8"
                        Visibility="{x:Bind ViewModel.IsConnectionStatusVisible, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsConnectionStatusBusy, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsConnectionStatusBusy, Mode=OneWay}" />
                            <coreControls:WinoFontIcon
                                FontFamily="{StaticResource WinoIconFontFamily}"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Icon="CheckmarkCircle"
                                Visibility="{x:Bind ViewModel.IsConnectionStatusConnected, Mode=OneWay}" />
                        </Grid>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AccountSetupConnectionStatusText"
                            Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>

                    <InfoBar
                        Title="{x:Bind ViewModel.FailureTitle, Mode=OneWay}"
                        AutomationProperties.AutomationId="AccountSetupFailureInfoBar"
                        CloseButtonCommand="{x:Bind ViewModel.HideFailureCommand}"
                        IsClosable="True"
                        IsOpen="{x:Bind ViewModel.IsFailureOpen, Mode=OneWay}"
                        Message="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                        Severity="{x:Bind helpers:XamlHelpers.InfoBarSeverityConverter(ViewModel.FailureSeverity), Mode=OneWay}">
                        <InfoBar.Content>
                            <primitives:WinoWrapPanel
                                Margin="0,0,0,12"
                                HorizontalSpacing="8"
                                VerticalSpacing="8">
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupFailureRetry"
                                    Command="{x:Bind ViewModel.RetryCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_Retry}"
                                    Visibility="{x:Bind ViewModel.IsRetryVisible, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupFailureUseAnotherOption"
                                    Command="{x:Bind ViewModel.UseAnotherOptionCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_UseAnotherOption}"
                                    Visibility="{x:Bind ViewModel.IsUseAnotherOptionVisible, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupFailureChangeProvider"
                                    Click="ChangeProviderClick"
                                    Content="{x:Bind domain:Translator.AccountSetup_ChangeProvider}"
                                    Visibility="{x:Bind ViewModel.IsChangeProviderVisible, Mode=OneWay}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="AccountSetupFailureAdvanced"
                                    Command="{x:Bind ViewModel.OpenAdvancedSetupCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_AdvancedSetup}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="AccountSetupFailureDetails"
                                    Command="{x:Bind ViewModel.ShowFailureDetailsCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_ShowDetails}"
                                    Visibility="{x:Bind ViewModel.HasFailureDetails, Mode=OneWay}" />
                            </primitives:WinoWrapPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
            </DataTemplate>

            <!--  ============ Adding, Added, Failed ============  -->
            <DataTemplate x:Key="ProgressStepTemplate" x:DataType="local:AccountSetupStepContent">
                <StackPanel Spacing="12">
                    <ItemsControl
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AccountSetupSteps"
                        AutomationProperties.LiveSetting="Polite"
                        ItemsSource="{x:Bind ViewModel.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="accounts:AccountSetupStepModel">
                                <Grid
                                    Padding="0,6"
                                    AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <coreControls:WinoFontIcon
                                            FontFamily="{StaticResource WinoIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                            Icon="Circle"
                                            Visibility="{x:Bind IsPending, Mode=OneWay}" />
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind IsInProgress, Mode=OneWay}"
                                            Visibility="{x:Bind IsInProgress, Mode=OneWay}" />
                                        <coreControls:WinoFontIcon
                                            FontFamily="{StaticResource WinoIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Icon="Checkmark"
                                            Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                                        <coreControls:WinoFontIcon
                                            FontFamily="{StaticResource WinoIconFontFamily}"
                                            FontSize="16"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Icon="DismissCircle"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="WrapWholeWords" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <InfoBar
                        AutomationProperties.AutomationId="AccountSetupAddedInfoBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsAddedVisible, Mode=OneWay}"
                        Message="{x:Bind ViewModel.AddedMessage, Mode=OneWay}"
                        Severity="Success" />

                    <ItemsControl
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="AccountSetupResultRows"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource AccountSetupResultRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.ResultRows, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsAddedVisible, Mode=OneWay}" />

                    <InfoBar
                        AutomationProperties.AutomationId="AccountSetupSetupFailedInfoBar"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsSetupFailedVisible, Mode=OneWay}"
                        Message="{x:Bind domain:Translator.AccountSetup_FailureMessage}"
                        Severity="Error">
                        <InfoBar.Content>
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupSetupFailedTryAgain"
                                    Command="{x:Bind ViewModel.TryAgainCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_TryAgainButton}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.AutomationId="AccountSetupSetupFailedGoBack"
                                    Command="{x:Bind ViewModel.GoBackFromFailureCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_GoBackButton}" />
                                <HyperlinkButton
                                    AutomationProperties.AutomationId="AccountSetupSetupFailedDetails"
                                    Command="{x:Bind ViewModel.ShowSetupFailureDetailsCommand}"
                                    Content="{x:Bind domain:Translator.AccountSetup_ShowDetails}"
                                    Visibility="{x:Bind ViewModel.HasSetupFailureDetails, Mode=OneWay}" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                </StackPanel>
            </DataTemplate>

            <selectors:AccountSetupStepTemplateSelector
                x:Key="AccountSetupStepTemplateSelector"
                AddressTemplate="{StaticResource AddressStepTemplate}"
                DiscoveryTemplate="{StaticResource DiscoveryStepTemplate}"
                ProgressTemplate="{StaticResource ProgressStepTemplate}"
                ReviewTemplate="{StaticResource ReviewStepTemplate}"
                SignInMethodTemplate="{StaticResource SignInMethodStepTemplate}"
                SignInTemplate="{StaticResource SignInStepTemplate}" />
        </ResourceDictionary>
    </Page.Resources>

    <!--
        One column directly on the window: the step's title, the account, the step, then Back and the primary button.
        The welcome window centres the column; Settings starts it at the top left. The Settings frame does not scroll,
        so the page carries its own scroller; in the wizard the host scrolls and this one is as tall as its content.
    -->
    <ScrollViewer
        AutomationProperties.AutomationId="AccountSetupScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="SetupRoot" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopSpacerRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                x:Name="SetupPanel"
                Grid.Row="1"
                MaxWidth="440"
                AutomationProperties.AutomationId="AccountSetupPanel"
                Spacing="20">

                <!--  ============ Title ============  -->
                <StackPanel x:Name="StepHeader" Spacing="6">
                    <Image
                        x:Name="StepLogo"
                        Width="64"
                        Height="64"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="StepTitleText"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.HasStepTitle, Mode=OneWay}" />
                    <TextBlock
                        x:Name="StepSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.StepSubtitle, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.HasStepSubtitle, Mode=OneWay}" />
                </StackPanel>

                <!--  ============ The account so far: one pill, with Change beside it ============  -->
                <Grid
                    x:Name="KnownRow"
                    ColumnSpacing="4"
                    Visibility="{x:Bind ViewModel.IsKnownCardVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        x:Name="KnownCard"
                        Padding="6,6,16,6"
                        AutomationProperties.AutomationId="AccountSetupKnownCard"
                        AutomationProperties.HelpText="{x:Bind ViewModel.RouteEvidenceText, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="{x:Bind ViewModel.KnownText, Mode=OneWay}"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource AccountSetupStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid
                                Width="32"
                                Height="32"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw">
                                <Ellipse Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                <Ellipse Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}" Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                <coreControls:WinoFontIcon
                                    x:Name="KnownProviderIcon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource WinoIconFontFamily}"
                                    FontSize="16" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="KnownIdentityText"
                                    MaxWidth="260"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <ItemsControl
                                    x:Name="KnownItems"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource AccountSetupKnownChipTemplate}"
                                    ItemsPanel="{StaticResource AccountSetupKnownPanelTemplate}" />
                            </StackPanel>
                            <ProgressRing
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="AccountSetupDiscoveryProgress"
                                AutomationProperties.HelpText="{x:Bind ViewModel.DiscoveryHelpText, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.DiscoveryText, Mode=OneWay}"
                                IsActive="{x:Bind ViewModel.IsResolvingVisible, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsResolvingVisible, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <!--  Change opens a menu; "Change provider" then opens the picker attached to this button.  -->
                    <Button
                        x:Name="ChangeButton"
                        Grid.Column="1"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="AccountSetupChange"
                        Background="Transparent"
                        BorderThickness="0"
                        Content="{x:Bind domain:Translator.AccountSetup_Change}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{x:Bind ViewModel.IsChangeAddressVisible, Mode=OneWay}">
                        <FlyoutBase.AttachedFlyout>
                            <Flyout x:Name="ProviderFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="8">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.AccountSetup_ProviderPicker_Title}" />
                                    <TextBlock Style="{StaticResource AccountSetupCaptionStyle}" Text="{x:Bind ViewModel.ProviderPickerCaption, Mode=OneWay}" />
                                    <ListView
                                        Margin="-4,0"
                                        AutomationProperties.AutomationId="AccountSetupProviderChoices"
                                        AutomationProperties.Name="{x:Bind domain:Translator.AccountSetup_ProviderPicker_Title}"
                                        IsItemClickEnabled="True"
                                        ItemClick="ProviderChoiceClick"
                                        ItemsSource="{x:Bind ViewModel.ProviderChoices}"
                                        SelectedItem="{x:Bind ViewModel.CurrentProviderChoice, Mode=OneWay}"
                                        SelectionMode="Single">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="data:AccountSetupProviderChoice">
                                                <Grid
                                                    MinHeight="36"
                                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                                    ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <coreControls:WinoFontIcon
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource WinoIconFontFamily}"
                                                        FontSize="16"
                                                        Icon="{x:Bind Glyph}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BodyTextBlockStyle}"
                                                        Text="{x:Bind Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind Description}"
                                                        Visibility="{x:Bind HasDescription}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="AccountSetupChangeAddress"
                                    AutomationProperties.Name="{x:Bind ViewModel.ChangeAddressAutomationName, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ChangeAddressCommand}"
                                    Text="{x:Bind domain:Translator.AccountSetup_ChangeAddress}" />
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="AccountSetupChangeProvider"
                                    AutomationProperties.Name="{x:Bind ViewModel.ChangeProviderAutomationName, Mode=OneWay}"
                                    Click="ChangeProviderMenuClick"
                                    Text="{x:Bind domain:Translator.AccountSetup_ChangeProvider}"
                                    Visibility="{x:Bind ViewModel.IsChangeProviderVisible, Mode=OneWay}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--  ============ The step ============  -->
                <ContentControl
                    x:Name="StepHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="AccountSetupStep"
                    ContentTemplateSelector="{StaticResource AccountSetupStepTemplateSelector}"
                    IsTabStop="False" />

                <!--  ============ Back and the primary button ============  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        MinWidth="72"
                        AutomationProperties.AutomationId="AccountSetupBack"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Content="{x:Bind domain:Translator.AccountSetup_Back}"
                        Visibility="{x:Bind ViewModel.IsBackVisible, Mode=OneWay}" />

                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="AccountSetupNativeSignIn"
                        AutomationProperties.Name="{x:Bind ViewModel.NativeSignInButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SignInWithProviderCommand}"
                        Style="{StaticResource SocialSignInButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsFooterSocialSignInVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <coreControls:WinoFontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource WinoIconFontFamily}"
                                FontSize="16"
                                Icon="{x:Bind helpers:XamlHelpers.GetProviderIcon(ViewModel.RouteProviderType, ViewModel.RouteSpecialImapProvider), Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.NativeSignInButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        MinWidth="128"
                        AutomationProperties.AutomationId="AccountSetupCancelDiscovery"
                        Command="{x:Bind ViewModel.CancelDiscoveryToAdvancedCommand}"
                        Content="{x:Bind domain:Translator.AccountSetup_SetUpManually}"
                        Visibility="{x:Bind ViewModel.IsResolvingVisible, Mode=OneWay}" />

                    <Button
                        Grid.Column="2"
                        MinWidth="128"
                        AutomationProperties.AutomationId="AccountSetupPrimary"
                        Command="{x:Bind ViewModel.PrimaryCommand}"
                        Content="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsPrimaryVisible, Mode=OneWay}" />
                </Grid>

                <!--  ============ Advanced setup and Local account setup ============  -->
                <StackPanel
                    x:Name="SetupLinks"
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.IsFooterVisible, Mode=OneWay}">
                    <HyperlinkButton
                        AutomationProperties.AutomationId="AccountSetupAdvancedSetup"
                        Command="{x:Bind ViewModel.OpenAdvancedSetupCommand}"
                        Content="{x:Bind domain:Translator.AccountSetup_AdvancedSetup}" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <HyperlinkButton
                            AutomationProperties.AutomationId="AccountSetupLocalAccountSetup"
                            Command="{x:Bind ViewModel.StartLocalOnlyCommand}"
                            Content="{x:Bind domain:Translator.AccountSetup_LocalAccountSetup}" />
                        <Button
                            Width="28"
                            Height="28"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AccountSetupLocalAccountInfo"
                            AutomationProperties.HelpText="{x:Bind domain:Translator.AccountSetup_LocalAccountInfo}"
                            AutomationProperties.Name="{x:Bind domain:Translator.AccountSetup_LocalAccountSetup}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.AccountSetup_LocalAccountInfo}">
                            <coreControls:WinoFontIcon
                                FontFamily="{StaticResource WinoIconFontFamily}"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Icon="Info" />
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <TextBlock
                                        MaxWidth="280"
                                        Text="{x:Bind domain:Translator.AccountSetup_LocalAccountInfo}"
                                        TextWrapping="WrapWholeWords" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</abstract:AccountSetupPageAbstract>
