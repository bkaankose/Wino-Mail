<viewsAbstract:AccountHubPageAbstract
    x:Class="Wino.Mail.WinUI.Views.Account.AccountHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accessibilityControls="using:Wino.Mail.WinUI.Controls"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:accountSettings="using:Wino.Mail.ViewModels.AccountSettings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewsAbstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:winuiHelpers="using:Wino.Mail.WinUI.Helpers"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <!--
        The account hub: who the account is, the four apps it can provide (each a switch and a way into its
        page), then sign-in, troubleshooting and removal. Every change applies at once.
    -->
    <StackPanel Spacing="4">
        <InfoBar
            AutomationProperties.AutomationId="AccountHubAttentionInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.NeedsAttention, Mode=OneWay}"
            Message="{x:Bind domain:Translator.AccountHub_AttentionMessage, Mode=OneTime}"
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.AutomationId="AccountHubFixSignInButton"
                    Command="{x:Bind ViewModel.OpenSignInCommand}"
                    Content="{x:Bind domain:Translator.AccountHub_FixSignIn, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Identity  -->
        <Grid Margin="2,4,2,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <accountIcon:WinoAccountIcon
                VerticalAlignment="Center"
                Account="{x:Bind winuiHelpers:XamlHelpers.GetAccountIconInfo(ViewModel.Account), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureTitle, Mode=OneTime}"
                IconSize="64" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    AutomationProperties.AutomationId="AccountHubName"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    AutomationProperties.AutomationId="AccountHubAddress"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.HeaderDescription, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <HyperlinkButton
                    Margin="-12,0,0,0"
                    AutomationProperties.AutomationId="AccountHubEditIdentityButton"
                    Command="{x:Bind ViewModel.ToggleIdentityEditorCommand}"
                    Content="{x:Bind domain:Translator.AccountHub_EditIdentity, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">
                <StackPanel
                    AutomationProperties.AutomationId="AccountHubSyncStatus"
                    Orientation="Horizontal"
                    Spacing="10">
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource WinoIconFontFamily}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Icon="Sync" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SyncStatusTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SyncStatusDetail, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    AutomationProperties.AutomationId="AccountHubSignInStatus"
                    Orientation="Horizontal"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.IsSignInStatusVisible, Mode=OneWay}">
                    <coreControls:WinoFontIcon
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource WinoIconFontFamily}"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Icon="LockClosed" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SignInStatusTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SignInStatusDetail, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Name, picture and color, opened from the header  -->
        <StackPanel
            Margin="0,0,0,8"
            Spacing="4"
            Visibility="{x:Bind ViewModel.IsIdentityEditorOpen, Mode=OneWay}">
            <controls:SettingsCard
                AutomationProperties.AutomationId="AccountHubNameCard"
                Description="{x:Bind domain:Translator.AccountHub_NameDescription, Mode=OneTime}"
                Header="{x:Bind domain:Translator.AccountHub_NameHeader, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Person" />
                </controls:SettingsCard.HeaderIcon>
                <TextBox
                    Width="250"
                    AutomationProperties.AutomationId="AccountHubNameTextBox"
                    AutomationProperties.Name="{x:Bind domain:Translator.AccountHub_NameHeader, Mode=OneTime}"
                    PlaceholderText="{x:Bind domain:Translator.AccountSettingsDialog_AccountNamePlaceholder, Mode=OneTime}"
                    Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                AutomationProperties.AutomationId="AccountHubPictureCard"
                Description="{x:Bind ViewModel.ProfilePictureDescription, Mode=OneWay}"
                Header="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureTitle, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Person" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureBusy, Mode=OneTime}"
                        IsActive="{x:Bind ViewModel.IsProfilePictureBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsProfilePictureBusy, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="AccountHubPictureChangeButton"
                        Command="{x:Bind ViewModel.ChangeProfilePictureCommand}"
                        Content="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureChange, Mode=OneTime}" />
                    <Button
                        AutomationProperties.AutomationId="AccountHubPictureRemoveButton"
                        Command="{x:Bind ViewModel.RemoveProfilePictureCommand}"
                        Content="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureRemove, Mode=OneTime}" />
                    <Button
                        AutomationProperties.AutomationId="AccountHubPictureRefreshButton"
                        Command="{x:Bind ViewModel.RefreshProfilePictureCommand}"
                        Content="{x:Bind domain:Translator.AccountDetailsPage_ProfilePictureRefresh, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.CanRefreshProfilePicture, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="AccountHubColorCard"
                ContentAlignment="Vertical"
                Description="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Color" />
                </controls:SettingsCard.HeaderIcon>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <GridView
                        AutomationProperties.AutomationId="AccountHubColorGridView"
                        AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}"
                        ItemTemplate="{StaticResource AccountColorTemplate}"
                        ItemsSource="{x:Bind ViewModel.AvailableColors}"
                        SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                    <Button
                        Grid.Row="1"
                        MinWidth="100"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="AccountHubColorResetButton"
                        Command="{x:Bind ViewModel.ResetColorCommand}"
                        Content="{x:Bind domain:Translator.Buttons_Reset, Mode=OneTime}" />
                </Grid>
            </controls:SettingsCard>
        </StackPanel>

        <!--  Apps  -->
        <StackPanel Margin="1,8,0,6" Spacing="2">
            <TextBlock
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.AccountHub_AppsHeader, Mode=OneTime}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind domain:Translator.AccountHub_AppsDescription, Mode=OneTime}" />
        </StackPanel>

        <ItemsControl AutomationProperties.AutomationId="AccountHubAppList" ItemsSource="{x:Bind ViewModel.Apps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="accountSettings:AccountAppItemViewModel">
                    <accessibilityControls:WinoSettingsCard
                        Margin="0,0,0,4"
                        AutomationInvoked="AppRowClicked"
                        AutomationProperties.AutomationId="{x:Bind winuiHelpers:XamlHelpers.GetAccountAppAutomationId(App)}"
                        AutomationProperties.Name="{x:Bind OpenAutomationName}"
                        Click="AppRowClicked"
                        Description="{x:Bind Summary, Mode=OneWay}"
                        Header="{x:Bind Title}"
                        IsClickEnabled="True"
                        Tag="{x:Bind}"
                        Visibility="{x:Bind IsOffered, Mode=OneWay}">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="{x:Bind Icon}" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                AutomationProperties.Name="{x:Bind domain:Translator.ExchangeSetup_Checking, Mode=OneTime}"
                                IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.HelpText="{x:Bind ToggleHint, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind UseTitle}"
                                IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                IsOn="{x:Bind IsOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent=""
                                ToolTipService.ToolTip="{x:Bind UseTitle}" />
                        </StackPanel>
                    </accessibilityControls:WinoSettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Account  -->
        <TextBlock
            AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.AccountHub_AccountHeader, Mode=OneTime}" />

        <accessibilityControls:WinoSettingsCard
            AutomationProperties.AutomationId="AccountHubSignInCard"
            Command="{x:Bind ViewModel.OpenSignInCommand}"
            Description="{x:Bind ViewModel.SignInRowDescription, Mode=OneWay}"
            Header="{x:Bind domain:Translator.AccountHub_SignInAndServersTitle, Mode=OneTime}"
            IsClickEnabled="True"
            Visibility="{x:Bind ViewModel.IsSignInRowVisible, Mode=OneWay}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Key" />
            </controls:SettingsCard.HeaderIcon>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.SignInStatusTitle, Mode=OneWay}" />
        </accessibilityControls:WinoSettingsCard>

        <accessibilityControls:WinoSettingsCard
            AutomationProperties.AutomationId="AccountHubTroubleshootingCard"
            Command="{x:Bind ViewModel.OpenTroubleshootingCommand}"
            Description="{x:Bind domain:Translator.AccountHub_TroubleshootingDescription, Mode=OneTime}"
            Header="{x:Bind domain:Translator.AccountHub_TroubleshootingTitle, Mode=OneTime}"
            IsClickEnabled="True"
            Visibility="{x:Bind ViewModel.IsTroubleshootingVisible, Mode=OneWay}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Wrench" />
            </controls:SettingsCard.HeaderIcon>
        </accessibilityControls:WinoSettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="AccountHubRemoveCard"
            Description="{x:Bind ViewModel.RemoveDescription, Mode=OneWay}"
            Header="{x:Bind domain:Translator.AccountHub_RemoveTitle, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Delete" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                MinWidth="100"
                AutomationProperties.AutomationId="AccountHubRemoveButton"
                AutomationProperties.Name="{x:Bind domain:Translator.AccountHub_RemoveTitle, Mode=OneTime}"
                Background="{ThemeResource DeleteBrush}"
                Command="{x:Bind ViewModel.RemoveAccountCommand}"
                Content="{x:Bind domain:Translator.Buttons_Remove, Mode=OneTime}"
                Foreground="{ThemeResource DeleteButtonForegroundBrush}">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="White" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="ButtonForeground" ResourceKey="SystemColorWindowColorBrush" />
                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                                <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>
        </controls:SettingsCard>
    </StackPanel>
</viewsAbstract:AccountHubPageAbstract>
