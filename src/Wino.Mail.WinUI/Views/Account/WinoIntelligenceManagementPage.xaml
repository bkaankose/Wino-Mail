                        <TextBlock
                            Margin="16,4,16,8"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.HeadlineLanguageDescription, Mode=OneWay}"
                            Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityConverter(ViewModel.HeadlineLanguageDescription), Mode=OneWay}" />

                        <InfoBar
                            Margin="0,4,0,8"
                            AutomationProperties.AutomationId="WinoIntelligenceHeadlineLanguageInfoBar"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.IsHeadlineLanguageMismatchVisible, Mode=OneWay}"
                            Severity="Informational">
                            <InfoBar.Content>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.HeadlineLanguageMismatchMessage, Mode=OneWay}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <CheckBox
                                            AutomationProperties.AutomationId="WinoIntelligenceHeadlineLanguageDontAskAgainCheckBox"
                                            Content="{x:Bind domain:Translator.Intelligence_DontAskAgain, Mode=OneTime}"
                                            IsChecked="{x:Bind ViewModel.DontAskHeadlineLanguageAgain, Mode=TwoWay}" />
                                        <Button
                                            AutomationProperties.AutomationId="WinoIntelligenceHeadlineLanguageDismissButton"
                                            Command="{x:Bind ViewModel.DismissHeadlineLanguageCommand}"
                                            Content="{x:Bind domain:Translator.Buttons_No, Mode=OneTime}" />
                                        <Button
                                            AutomationProperties.AutomationId="WinoIntelligenceHeadlineLanguageTranslateButton"
                                            Command="{x:Bind ViewModel.TranslateHeadlinesCommand}"
                                            Content="{x:Bind domain:Translator.Buttons_Yes, Mode=OneTime}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
