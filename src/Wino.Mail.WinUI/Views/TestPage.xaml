<?xml version="1.0" encoding="utf-8" ?>
<abstract:TestPageAbstract
    x:Class="Wino.Mail.WinUI.Views.TestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wino.Mail.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock
                HorizontalAlignment="Center"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Subject, Mode=OneWay}" />
            <TextBlock HorizontalTextAlignment="Center" Text="{x:Bind ViewModel.Preview, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</abstract:TestPageAbstract>
