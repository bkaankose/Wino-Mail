<abstract:RemoteContentRulesPageAbstract
    x:Class="Wino.Views.Settings.RemoteContentRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="RemoteContentRuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  The policy is always named in text; the dot only repeats it.  -->
        <DataTemplate x:Key="PolicyOptionTemplate" x:DataType="data:RemoteContentPolicyOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{x:Bind helpers:XamlHelpers.GetRemoteContentPolicyBrush(Policy)}"
                    Visibility="{x:Bind helpers:XamlHelpers.NotNullToVisibility(Policy)}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind Title}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PolicyLegendTemplate" x:DataType="data:RemoteContentPolicyOption">
            <Grid Margin="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Width="8"
                    Height="8"
                    Margin="0,6,0,0"
                    VerticalAlignment="Top"
                    Fill="{x:Bind helpers:XamlHelpers.GetRemoteContentPolicyBrush(Policy)}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="WrapWholeWords">
                    <Run FontWeight="SemiBold" Text="{x:Bind Title}" />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Legend}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RemoteContentRuleTemplate" x:DataType="data:RemoteContentRuleViewModel">
            <ItemContainer HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                <Border Padding="12,8" Style="{StaticResource RemoteContentRuleCardStyle}">
                    <Grid AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            DisplayName="{x:Bind DisplayName, Mode=OneWay}"
                            Initials="{x:Bind Initials, Mode=OneWay}"
                            Visibility="{x:Bind IsAddress, Mode=OneWay}" />
                        <Border
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="16"
                            Visibility="{x:Bind IsDomain, Mode=OneWay}">
                            <coreControls:WinoFontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{ThemeResource WinoIconFontFamily}"
                                FontSize="16"
                                Icon="Globe" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind DisplayName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind DetailText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind HasDetailText, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind AddedText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border
                            Grid.Column="2"
                            Padding="8,1,8,2"
                            VerticalAlignment="Center"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind KindText, Mode=OneWay}" />
                        </Border>

                        <ComboBox
                            Grid.Column="3"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind PolicyAutomationName, Mode=OneWay}"
                            ItemTemplate="{StaticResource PolicyOptionTemplate}"
                            ItemsSource="{x:Bind PolicyOptions}"
                            SelectedItem="{x:Bind SelectedPolicyOption, Mode=TwoWay}" />

                        <Button
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind DeleteAutomationName, Mode=OneWay}"
                            Command="{x:Bind RemoveCommand}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind DeleteAutomationName, Mode=OneWay}">
                            <coreControls:WinoFontIcon
                                FontFamily="{ThemeResource WinoIconFontFamily}"
                                FontSize="16"
                                Icon="Delete" />
                        </Button>
                    </Grid>
                </Border>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Spacing="8">
        <!--  New rule  -->
        <Border Padding="16" Style="{StaticResource RemoteContentRuleCardStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="RemoteContentRulesPatternTextBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_PatternPlaceholder, Mode=OneTime}"
                        IsSpellCheckEnabled="False"
                        KeyDown="NewPatternKeyDown"
                        PlaceholderText="{x:Bind domain:Translator.RemoteContentRules_PatternPlaceholder, Mode=OneTime}"
                        Text="{x:Bind ViewModel.NewPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="160"
                        AutomationProperties.AutomationId="RemoteContentRulesNewPolicyComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_ColumnPolicy, Mode=OneTime}"
                        ItemTemplate="{StaticResource PolicyOptionTemplate}"
                        ItemsSource="{x:Bind ViewModel.PolicyOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.NewPolicyOption, Mode=TwoWay}" />
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="RemoteContentRulesAddButton"
                        Command="{x:Bind ViewModel.AddRuleCommand}"
                        Content="{x:Bind domain:Translator.RemoteContentRules_AddRule, Mode=OneTime}"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
                <ItemsControl
                    AutomationProperties.AutomationId="RemoteContentRulesLegend"
                    IsTabStop="False"
                    ItemTemplate="{StaticResource PolicyLegendTemplate}"
                    ItemsSource="{x:Bind ViewModel.PolicyOptions, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <InfoBar
            AutomationProperties.AutomationId="RemoteContentRulesSpoofingInfoBar"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind domain:Translator.RemoteContentRules_SpoofingInfo, Mode=OneTime}"
            Severity="Informational" />

        <!--  Filter  -->
        <Grid
            Margin="0,8,0,0"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" MaxWidth="320" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
            <ComboBox
                Grid.Column="1"
                MinWidth="150"
                AutomationProperties.AutomationId="RemoteContentRulesPolicyFilterComboBox"
                AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_AllPolicies, Mode=OneTime}"
                ItemTemplate="{StaticResource PolicyOptionTemplate}"
                ItemsSource="{x:Bind ViewModel.PolicyFilterOptions, Mode=OneTime}"
                SelectedItem="{x:Bind ViewModel.SelectedPolicyFilterOption, Mode=TwoWay}" />
            <TextBox
                Grid.Column="3"
                AutomationProperties.AutomationId="RemoteContentRulesSearchTextBox"
                AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_SearchPlaceholder, Mode=OneTime}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{x:Bind domain:Translator.RemoteContentRules_SearchPlaceholder, Mode=OneTime}"
                Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <ItemsView
            AutomationProperties.AutomationId="RemoteContentRulesList"
            AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_Title, Mode=OneTime}"
            IsItemInvokedEnabled="False"
            ItemTemplate="{StaticResource RemoteContentRuleTemplate}"
            ItemsSource="{x:Bind ViewModel.Rules, Mode=OneTime}"
            SelectionMode="None">
            <ItemsView.Layout>
                <StackLayout Spacing="4" />
            </ItemsView.Layout>
        </ItemsView>

        <TextBlock
            Margin="0,8"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.RemoteContentRules_NoMatches, Mode=OneTime}"
            Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}" />

        <!--  Empty state  -->
        <Border
            Padding="24"
            AutomationProperties.AutomationId="RemoteContentRulesEmptyState"
            Style="{StaticResource RemoteContentRuleCardStyle}"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <Viewbox
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center">
                    <coreControls:WinoFontIcon
                        FontFamily="{ThemeResource WinoIconFontFamily}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Icon="Shield" />
                </Viewbox>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.RemoteContentRules_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind domain:Translator.RemoteContentRules_EmptyDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!--  Footer  -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.ShowingText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsShowingSubset, Mode=OneWay}" />
            <HyperlinkButton
                Grid.Column="1"
                AutomationProperties.AutomationId="RemoteContentRulesShowAllButton"
                Command="{x:Bind ViewModel.ShowAllCommand}"
                Content="{x:Bind domain:Translator.RemoteContentRules_ShowAll, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.IsShowingSubset, Mode=OneWay}" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind domain:Translator.RemoteContentRules_Footer, Mode=OneTime}"
                TextWrapping="WrapWholeWords" />
        </Grid>
    </StackPanel>
</abstract:RemoteContentRulesPageAbstract>
