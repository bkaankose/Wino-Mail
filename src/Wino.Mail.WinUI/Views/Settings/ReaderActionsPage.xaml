<abstract:ReaderActionsPageAbstract
    x:Class="Wino.Views.Settings.ReaderActionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ReaderActionTemplate" x:DataType="data:ReaderCommandLayoutItemViewModel">
            <Grid
                Width="124"
                Height="96"
                Padding="4,0,4,8"
                AutomationProperties.Name="{x:Bind Title}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind Title}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.AutomationId="ReaderActionVisibilityCheckBox"
                    AutomationProperties.Name="{x:Bind VisibilityAutomationName}"
                    IsChecked="{x:Bind IsVisible, Mode=TwoWay}" />

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="{x:Bind helpers:XamlHelpers.GetHiddenItemOpacity(IsVisible), Mode=OneWay}"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Viewbox Width="20" Height="20">
                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="{x:Bind Icon}" />
                    </Viewbox>
                    <Viewbox
                        Width="20"
                        Height="20"
                        Visibility="{x:Bind HasSecondIcon}">
                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="{x:Bind SecondIcon}" />
                    </Viewbox>
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    MaxLines="2"
                    Opacity="{x:Bind helpers:XamlHelpers.GetHiddenItemOpacity(IsVisible), Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <TextBlock
            Margin="1,0,0,4"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind domain:Translator.ReaderActions_PreviewHeader, Mode=OneTime}" />

        <!--  Mirrors the reader header in MailRenderingPage, filled with sample data.  -->
        <Border
            Padding="8"
            Background="{ThemeResource ReadingPaneBackgroundColorBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="5,0"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.PreviewSubject, Mode=OneTime}"
                    TextWrapping="Wrap" />

                <coreControls:OperationCommandBar
                    x:Name="PreviewCommandBar"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="ReaderActionsPreviewCommandBar"
                    DefaultLabelPosition="Right"
                    IsEditorThemeToggleVisible="True"
                    IsPopOutButtonVisible="True"
                    IsReaderViewToggleVisible="True"
                    MenuItems="{x:Bind ViewModel.PreviewMenuItems, Mode=OneWay}"
                    ShowActionLabels="{x:Bind ViewModel.ShowActionLabels, Mode=OneWay}">
                    <coreControls:OperationCommandBar.Content>
                        <Grid Padding="0,5" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                Width="36"
                                Height="36"
                                AutomationProperties.AccessibilityView="Raw"
                                DisplayName="{x:Bind ViewModel.PreviewSenderName, Mode=OneTime}"
                                IsTabStop="False" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.PreviewSenderDisplay, Mode=OneTime}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PreviewDate, Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </coreControls:OperationCommandBar.Content>
                </coreControls:OperationCommandBar>
            </Grid>
        </Border>

        <TextBlock
            Margin="1,20,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind domain:Translator.ReaderActions_ArrangeHeader, Mode=OneTime}" />

        <TextBlock
            Margin="1,0,0,8"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind domain:Translator.ReaderActions_ArrangeDescription, Mode=OneTime}"
            TextWrapping="WrapWholeWords" />

        <GridView
            x:Name="ActionsGridView"
            AllowDrop="True"
            AutomationProperties.AutomationId="ReaderActionsGridView"
            AutomationProperties.Name="{x:Bind domain:Translator.ReaderActions_ArrangeHeader, Mode=OneTime}"
            CanDragItems="True"
            CanReorderItems="True"
            IsItemClickEnabled="False"
            ItemTemplate="{StaticResource ReaderActionTemplate}"
            ItemsSource="{x:Bind ViewModel.Items}"
            PreviewKeyDown="ActionsGridView_PreviewKeyDown"
            SelectionMode="None">
            <GridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>

        <controls:SettingsCard
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="ReaderActionsLabelsCard"
            Description="{x:Bind domain:Translator.SettingsMailRendering_ActionLabels_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsMailRendering_ActionLabels_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ToggleLeft" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="ReaderActionsLabelsToggle" IsOn="{x:Bind ViewModel.ShowActionLabels, Mode=TwoWay}" />
        </controls:SettingsCard>

        <Grid Margin="0,16,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind domain:Translator.ReaderActions_UnsavedChanges, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}" />

            <HyperlinkButton
                Grid.Column="1"
                AutomationProperties.AutomationId="ReaderActionsResetButton"
                Command="{x:Bind ViewModel.ResetToDefaultCommand}"
                Content="{x:Bind domain:Translator.ReaderActions_ResetToDefault, Mode=OneTime}" />

            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="ReaderActionsDiscardButton"
                Command="{x:Bind ViewModel.DiscardCommand}"
                Content="{x:Bind domain:Translator.Buttons_Discard, Mode=OneTime}" />

            <Button
                Grid.Column="3"
                MinWidth="96"
                AutomationProperties.AutomationId="ReaderActionsApplyButton"
                Command="{x:Bind ViewModel.ApplyCommand}"
                Content="{x:Bind domain:Translator.Buttons_Apply, Mode=OneTime}"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</abstract:ReaderActionsPageAbstract>
