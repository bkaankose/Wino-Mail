<abstract:IntelligenceBriefingPageAbstract
    x:Class="Wino.Views.Settings.IntelligenceBriefingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelData="using:Wino.Core.ViewModels.Data"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="BriefingMailboxTemplate" x:DataType="viewModelData:WinoIntelligenceMailboxItemViewModel">
            <controls:SettingsCard
                AutomationProperties.Name="{x:Bind Address}"
                Description="{x:Bind BriefingDescription, Mode=OneWay}"
                Header="{x:Bind Address}">
                <controls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">28</x:Double>
                </controls:SettingsCard.Resources>
                <controls:SettingsCard.HeaderIcon>
                    <accountIcon:WinoAccountIcon Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account, ProviderType, SpecialProvider)}" IconSize="28" />
                </controls:SettingsCard.HeaderIcon>
                <Grid>
                    <ToggleSwitch
                        AutomationProperties.AutomationId="{x:Bind ToggleAutomationId}"
                        AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Briefing_ToggleName, Mode=OneTime}"
                        IsEnabled="{x:Bind CanChangeDailyBriefing, Mode=OneWay}"
                        IsOn="{x:Bind IsInDailyBriefing, Mode=OneWay}"
                        OffContent="{x:Bind domain:Translator.WinoIntelligence_Briefing_NotIncluded, Mode=OneTime}"
                        OnContent="{x:Bind domain:Translator.WinoIntelligence_Briefing_Included, Mode=OneTime}"
                        Tag="{x:Bind}"
                        Toggled="BriefingToggle_Toggled"
                        Visibility="{x:Bind IsEnabled, Mode=OneWay}" />
                    <HyperlinkButton
                        AutomationProperties.AutomationId="{x:Bind ManageAutomationId}"
                        Command="{x:Bind OpenMailClassificationCommand}"
                        Content="{x:Bind domain:Translator.WinoIntelligence_Briefing_TurnOn, Mode=OneTime}"
                        Visibility="{x:Bind IsClassificationOff, Mode=OneWay}" />
                </Grid>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            AutomationProperties.AutomationId="WinoIntelligenceBriefingOpenCard"
            Description="{x:Bind domain:Translator.WinoIntelligence_Briefing_OpenDescription, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Briefing_OpenTitle, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="DailyBriefing" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                AutomationProperties.AutomationId="WinoIntelligenceBriefingOpenButton"
                AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Briefing_OpenTitle, Mode=OneTime}"
                Command="{x:Bind ViewModel.OpenDailyBriefingCommand}"
                Content="{x:Bind domain:Translator.Buttons_Open, Mode=OneTime}" />
        </controls:SettingsCard>

        <TextBlock
            Margin="1,20,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WinoIntelligence_Briefing_AccountsTitle, Mode=OneTime}" />

        <ItemsControl
            AutomationProperties.AutomationId="WinoIntelligenceBriefingAccountList"
            ItemTemplate="{StaticResource BriefingMailboxTemplate}"
            ItemsSource="{x:Bind ViewModel.IntelligenceMailboxes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource SettingsCardSpacing}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <InfoBar
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="WinoIntelligenceBriefingInfo"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind ViewModel.BriefingInfoText, Mode=OneWay}"
            Severity="Informational" />
    </StackPanel>
</abstract:IntelligenceBriefingPageAbstract>
