<abstract:ApplicationThemeGalleryPageAbstract
    x:Class="Wino.Views.Settings.ApplicationThemeGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:local="using:Wino.Views.Settings"
    xmlns:themes="using:Wino.Core.Domain.Models.Personalization"
    x:Name="Root"
    Title="{x:Bind domain:Translator.ApplicationThemeGallery_Title, Mode=OneTime}">

    <StackPanel Spacing="16">
        <InfoBar
            AutomationProperties.AutomationId="ApplicationThemeGalleryStorageError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStorageError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button AutomationProperties.AutomationId="ApplicationThemeGalleryRetryButton" Command="{x:Bind ViewModel.LoadThemesCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            AutomationProperties.AutomationId="ApplicationThemeGalleryApplyError"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsApplyError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button AutomationProperties.AutomationId="ApplicationThemeGalleryRetryApplyButton" Command="{x:Bind ViewModel.RetryApplyCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel x:Name="ThemeLoadingState" x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" Spacing="8">
            <ProgressRing IsActive="True" />
            <TextBlock Text="{x:Bind domain:Translator.ApplicationThemeGallery_Loading, Mode=OneTime}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_CurrentTheme, Mode=OneTime}" />
            <ContentControl Content="{x:Bind ViewModel.CurrentTheme, Mode=OneWay}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="themes:AppThemeBase">
                        <Border
                            Padding="8"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            ContextRequested="ThemeCardContextRequested"
                            Loaded="ThemeCardLoaded">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentEditMenuItem" Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}" CommandParameter="{x:Bind}" Text="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                    <MenuFlyoutItem AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentRemoveMenuItem" Command="{Binding ElementName=Root, Path=ViewModel.RemoveThemeCommand}" CommandParameter="{x:Bind}" Text="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Height="48" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                                    <Image Source="{x:Bind BackgroundPreviewImage}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ThemeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CompatibilityTitle, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentEditButton"
                                    VerticalAlignment="Center"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>

        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideThemeFilterCommands">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ThemeFilter.(Grid.ColumnSpan)" Value="1" />
                            <Setter Target="CreateThemeButton.(Grid.Row)" Value="0" />
                            <Setter Target="CreateThemeButton.(Grid.Column)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <controls:Segmented
                x:Name="ThemeFilter"
                Grid.ColumnSpan="2"
                AutomationProperties.AutomationId="ApplicationThemeGalleryFilter"
                SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}">
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_All, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Dark, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Light, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Both, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Custom, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Online, Mode=OneTime}" />
            </controls:Segmented>
            <Button
                x:Name="CreateThemeButton"
                Grid.Row="1"
                AutomationProperties.AutomationId="ApplicationThemeGalleryCreateButton"
                Command="{x:Bind ViewModel.CreateThemeCommand}"
                Content="{x:Bind domain:Translator.ApplicationThemeGallery_Create, Mode=OneTime}" />
        </Grid>

        <GridView
            x:Name="ThemeLocalGallery"
            x:Load="{x:Bind ViewModel.IsLocalGalleryVisible, Mode=OneWay}"
            AutomationProperties.AutomationId="ApplicationThemeGalleryGrid"
            IsItemClickEnabled="True"
            ItemClick="ThemeGridItemClick"
            SelectionMode="None"
            ItemsSource="{x:Bind ViewModel.FilteredThemes}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="themes:AppThemeBase">
                    <Border Width="175" AutomationProperties.Name="{x:Bind ThemeName}" CornerRadius="6" ContextRequested="ThemeCardContextRequested" Loaded="ThemeCardLoaded">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryEditMenuItem"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryRemoveMenuItem"
                                    Command="{Binding ElementName=Root, Path=ViewModel.RemoveThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="125" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border AutomationProperties.AutomationId="ApplicationThemeGalleryThemeButton">
                                <Image Width="175" Height="125" Source="{x:Bind BackgroundPreviewImage}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Row="1" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="4">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ThemeName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CompatibilityTitle, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                <Button
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryEditButton"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="ThemeEmptyState" x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" HorizontalAlignment="Center" Spacing="8">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_Empty, Mode=OneTime}" />
            <Button AutomationProperties.AutomationId="ApplicationThemeGalleryEmptyCreateButton" Command="{x:Bind ViewModel.CreateThemeCommand}" Content="{x:Bind domain:Translator.ApplicationThemeGallery_Create, Mode=OneTime}" />
        </StackPanel>

        <StackPanel
            x:Name="ThemeOnlineState"
            x:Load="{x:Bind ViewModel.IsOnline, Mode=OneWay}"
            AutomationProperties.AutomationId="ApplicationThemeGalleryOnlineState"
            HorizontalAlignment="Center"
            Spacing="6">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_ComingSoon, Mode=OneTime}" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_OnlineDescription, Mode=OneTime}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</abstract:ApplicationThemeGalleryPageAbstract>
