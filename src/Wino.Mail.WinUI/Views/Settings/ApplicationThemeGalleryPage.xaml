<abstract:ApplicationThemeGalleryPageAbstract
    x:Class="Wino.Views.Settings.ApplicationThemeGalleryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:local="using:Wino.Views.Settings"
    xmlns:themes="using:Wino.Core.Domain.Models.Personalization"
    x:Name="Root"
    Title="{x:Bind domain:Translator.ApplicationThemeGallery_Title, Mode=OneTime}">

    <StackPanel Spacing="16">
        <InfoBar
            AutomationProperties.AutomationId="ApplicationThemeGalleryStorageError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStorageError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button AutomationProperties.AutomationId="ApplicationThemeGalleryRetryButton" Command="{x:Bind ViewModel.LoadThemesCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            AutomationProperties.AutomationId="ApplicationThemeGalleryApplyError"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsApplyError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button AutomationProperties.AutomationId="ApplicationThemeGalleryRetryApplyButton" Command="{x:Bind ViewModel.RetryApplyCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel x:Name="ThemeLoadingState" x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" Spacing="8">
            <ProgressRing IsActive="True" />
            <TextBlock Text="{x:Bind domain:Translator.ApplicationThemeGallery_Loading, Mode=OneTime}" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_CurrentTheme, Mode=OneTime}" />
            <ContentControl Content="{x:Bind ViewModel.CurrentTheme, Mode=OneWay}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="themes:AppThemeBase">
                        <Border Width="175" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="6" ContextRequested="ThemeCardContextRequested">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentEditMenuItem" Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}" CommandParameter="{x:Bind}" Text="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}" />
                                    <MenuFlyoutItem AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentRemoveMenuItem" Command="{Binding ElementName=Root, Path=ViewModel.RemoveThemeCommand}" CommandParameter="{x:Bind}" Text="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions><RowDefinition Height="125" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind BackgroundPreviewImage}" Stretch="UniformToFill" />
                                    <Border Width="20" Height="20" Margin="0,12,12,0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{x:Bind AccentColor}" CornerRadius="4" />
                                </Grid>
                                <StackPanel Grid.Row="1" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="4">
                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ThemeName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CompatibilityTitle, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                    <Button
                                        AutomationProperties.AutomationId="ApplicationThemeGalleryCurrentEditButton"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                        CommandParameter="{x:Bind}"
                                        Content="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <controls:Segmented AutomationProperties.AutomationId="ApplicationThemeGalleryFilter" SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}">
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_All, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Dark, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Light, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Both, Mode=OneTime}" />
                <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Custom, Mode=OneTime}" />
            </controls:Segmented>
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="ApplicationThemeGalleryCreateButton"
                Command="{x:Bind ViewModel.CreateThemeCommand}"
                Content="{x:Bind domain:Translator.ApplicationThemeGallery_Create, Mode=OneTime}" />
        </Grid>

        <GridView
            AutomationProperties.AutomationId="ApplicationThemeGalleryGrid"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.FilteredThemes}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="themes:AppThemeBase">
                    <Border Width="175" CornerRadius="6" ContextRequested="ThemeCardContextRequested">
                        <Border.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryEditMenuItem"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}" />
                                <MenuFlyoutItem
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryRemoveMenuItem"
                                    Command="{Binding ElementName=Root, Path=ViewModel.RemoveThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Text="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}" />
                            </MenuFlyout>
                        </Border.ContextFlyout>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="125" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button
                                AutomationProperties.AutomationId="ApplicationThemeGalleryThemeButton"
                                AutomationProperties.Name="{x:Bind ThemeName}"
                                Padding="0"
                                Command="{Binding ElementName=Root, Path=ViewModel.ApplyThemeCommand}"
                                CommandParameter="{x:Bind}">
                                <Image Width="175" Height="125" Source="{x:Bind BackgroundPreviewImage}" Stretch="UniformToFill" />
                            </Button>
                            <StackPanel Grid.Row="1" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="4">
                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind ThemeName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind CompatibilityTitle, Mode=OneTime}" Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                                <Button
                                    AutomationProperties.AutomationId="ApplicationThemeGalleryEditButton"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditThemeCommand}"
                                    CommandParameter="{x:Bind}"
                                    Content="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}"
                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsCustomTheme), Mode=OneTime}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="ThemeEmptyState" x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" HorizontalAlignment="Center" Spacing="8">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.ApplicationThemeGallery_Empty, Mode=OneTime}" />
            <Button AutomationProperties.AutomationId="ApplicationThemeGalleryEmptyCreateButton" Command="{x:Bind ViewModel.CreateThemeCommand}" Content="{x:Bind domain:Translator.ApplicationThemeGallery_Create, Mode=OneTime}" />
        </StackPanel>

        <controls:SettingsCard
            AutomationProperties.AutomationId="ApplicationThemeGalleryOnlineCard"
            Description="{x:Bind domain:Translator.ApplicationThemeGallery_OnlineDescription, Mode=OneTime}"
            Header="{x:Bind domain:Translator.ApplicationThemeGallery_OnlineTitle, Mode=OneTime}"
            IsEnabled="False">
            <TextBlock Text="{x:Bind domain:Translator.ApplicationThemeGallery_ComingSoon, Mode=OneTime}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:ApplicationThemeGalleryPageAbstract>
