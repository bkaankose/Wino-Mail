<abstract:ContactsPreferenceSettingsPageAbstract
    x:Class="Wino.Views.Settings.ContactsPreferenceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard AutomationProperties.AutomationId="PeopleNewContactsCard" Header="{x:Bind domain:Translator.PeopleSettings_NewContacts_Header}" Description="{x:Bind domain:Translator.PeopleSettings_NewContacts_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE710;" /></controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <ComboBox AutomationProperties.AutomationId="PeopleNewContactDestinationBehavior" ItemsSource="{x:Bind ViewModel.DestinationBehaviors}" SelectedItem="{x:Bind ViewModel.SelectedDestinationBehavior, Mode=TwoWay}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="data:DestinationBehaviorOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox x:Name="SpecificAddressBookComboBox" x:Load="{x:Bind ViewModel.ShouldShowSpecificDestination, Mode=OneWay}" AutomationProperties.AutomationId="PeopleSpecificAddressBook" ItemsSource="{x:Bind ViewModel.Destinations}" SelectedItem="{x:Bind ViewModel.SelectedDestination, Mode=TwoWay}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="data:ContactDestinationPreferenceOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="PeopleNameDisplayCard" Header="{x:Bind domain:Translator.PeopleSettings_NameDisplay_Header}" Description="{x:Bind domain:Translator.PeopleSettings_NameDisplay_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></controls:SettingsCard.HeaderIcon>
            <ComboBox AutomationProperties.AutomationId="PeopleNameDisplay" ItemsSource="{x:Bind ViewModel.NameDisplayOptions}" SelectedItem="{x:Bind ViewModel.SelectedNameDisplay, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="data:ContactNameDisplayOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="PeopleNameSortCard" Header="{x:Bind domain:Translator.PeopleSettings_Sort_Header}" Description="{x:Bind domain:Translator.PeopleSettings_Sort_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8CB;" /></controls:SettingsCard.HeaderIcon>
            <ComboBox AutomationProperties.AutomationId="PeopleNameSort" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="data:ContactSortOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>
    </StackPanel>
</abstract:ContactsPreferenceSettingsPageAbstract>
