<abstract:ContactsPageAbstract
    x:Class="Wino.Views.Settings.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:entities="using:Wino.Core.Domain.Entities.Shared"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:listview="using:Wino.Mail.WinUI.Controls.ListView"
    xmlns:mailControls="using:Wino.Mail.Controls.ContactPicture"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkitExt="using:CommunityToolkit.WinUI"
    xmlns:viewModels="using:Wino.Mail.ViewModels.Data"
    x:Name="root"
    mc:Ignorable="d">

    <Page.Resources>
        <CollectionViewSource x:Key="ContactCollectionViewSource" IsSourceGrouped="True" />
        <coreControls:ContactCardMenuFlyout x:Key="ContactCardContextFlyout" />

        <!--  Contact row. The star is always present so hover does not shift the layout.  -->
        <DataTemplate x:Key="ContactTemplate" x:DataType="viewModels:AccountContactViewModel">
            <Grid
                Padding="8,6"
                ColumnSpacing="12"
                ContextRequested="ContactCardContextRequested"
                ToolTipService.ToolTip="{x:Bind SecondaryValue, Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <mailControls:WinoContactPicture
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    ContactPicture="{x:Bind helpers:XamlHelpers.GetContactPicture(SenderContact, FromName, FromAddress), Mode=OneWay}"
                    IsFaviconEnabled="{x:Bind helpers:XamlHelpers.GetFaviconEnabled(), Mode=OneTime}"
                    IsGravatarEnabled="{x:Bind helpers:XamlHelpers.GetGravatarEnabled(), Mode=OneTime}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Name, Mode=OneTime, TargetNullValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SecondaryValue, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SourceLabel, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ContactsPageFavoriteToggle"
                    Click="ToggleFavorite_Click"
                    CommandParameter="{x:Bind}"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind helpers:XamlHelpers.GetFavoriteTooltip(IsFavorite), Mode=OneWay}">
                    <FontIcon
                        FontSize="15"
                        Foreground="{x:Bind helpers:XamlHelpers.GetFavoriteBrush(IsFavorite), Mode=OneWay}"
                        Glyph="{x:Bind helpers:XamlHelpers.GetFavoriteGlyph(IsFavorite), Mode=OneWay}" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  A read-only field row in the detail pane.  -->
        <DataTemplate x:Key="DetailEmailTemplate" x:DataType="entities:ContactEmailAddress">
            <Grid Padding="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE715;" />
                <StackPanel Grid.Column="1">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Address, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Label, Mode=OneTime}"
                        Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(Label), Mode=OneTime}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DetailPhoneTemplate" x:DataType="entities:ContactPhoneNumber">
            <Grid Padding="0,3" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE717;" />
                <StackPanel Grid.Column="1">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Number, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Kind, Mode=OneTime}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListChipTemplate" x:DataType="entities:ContactList">
            <Border
                Padding="9,3"
                Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                CornerRadius="11">
                <TextBlock
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Name, Mode=OneTime}" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="348" />
        </Grid.ColumnDefinitions>

        <!--  ============ CONTACT LIST ============  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <listview:WinoListView
                x:Name="ContactsListView"
                Grid.Row="0"
                Padding="6,4"
                toolkitExt:ListViewExtensions.ItemContainerStretchDirection="Horizontal"
                CanDragItems="True"
                ContextRequested="ContactsListView_ContextRequested"
                DragItemsCompleted="ContactsListView_DragItemsCompleted"
                DragItemsStarting="ContactsListView_DragItemsStarting"
                IsMultiSelectCheckBoxEnabled="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay}"
                ItemTemplate="{StaticResource ContactTemplate}"
                LoadMoreCommand="{x:Bind ViewModel.LoadMoreContactsCommand}"
                SelectedItem="{x:Bind ViewModel.SelectedContact, Mode=TwoWay}"
                SelectionChanged="ContactsListView_SelectionChanged"
                SelectionMode="Extended">
                <listview:WinoListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </listview:WinoListView.ItemContainerStyle>
                <listview:WinoListView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderContainerStyle>
                            <Style TargetType="ListViewHeaderItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GroupStyle.HeaderContainerStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="viewModels:ContactGroup">
                                <Border
                                    MinHeight="36"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Key, Mode=OneTime}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </listview:WinoListView.GroupStyle>
                <listview:WinoListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ContentThemeTransition />
                    </TransitionCollection>
                </listview:WinoListView.ItemContainerTransitions>
            </listview:WinoListView>

            <ProgressRing
                Grid.Row="1"
                Width="22"
                Height="22"
                Margin="0,6,0,10"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />

            <Grid
                x:Name="LoadingGrid"
                Grid.Row="0"
                x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <ProgressRing
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="True" />
            </Grid>

            <StackPanel
                x:Name="IsEmptyPanel"
                Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                Spacing="10">
                <FontIcon
                    FontSize="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE716;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind domain:Translator.ContactsPage_NoContacts, Mode=OneTime}" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="ContactsPageAddFirstContact"
                    Command="{x:Bind ViewModel.AddContactCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock Text="{x:Bind domain:Translator.ContactsPage_AddFirstContact, Mode=OneTime}" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ============ DETAIL ============  -->
        <Grid
            x:Name="DetailPane"
            Grid.Column="1"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">

            <TextBlock
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind domain:Translator.ContactsPage_NoContactSelected, Mode=OneTime}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsDetailVisible), Mode=OneWay}" />

            <ScrollViewer
                x:Name="DetailScroller"
                Padding="18,18,18,24"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.IsDetailVisible), Mode=OneWay}">
                <StackPanel Spacing="14">
                    <Grid>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="ContactDetailFavorite"
                            Click="ToggleFavorite_Click"
                            CommandParameter="{x:Bind ViewModel.SelectedContact, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind helpers:XamlHelpers.GetFavoriteTooltip(ViewModel.SelectedContact.IsFavorite), Mode=OneWay}">
                            <FontIcon
                                FontSize="17"
                                Foreground="{x:Bind helpers:XamlHelpers.GetFavoriteBrush(ViewModel.SelectedContact.IsFavorite), Mode=OneWay}"
                                Glyph="{x:Bind helpers:XamlHelpers.GetFavoriteGlyph(ViewModel.SelectedContact.IsFavorite), Mode=OneWay}" />
                        </Button>

                        <StackPanel
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Spacing="8">
                            <mailControls:WinoContactPicture
                                Width="88"
                                Height="88"
                                HorizontalAlignment="Center"
                                ContactPicture="{x:Bind helpers:XamlHelpers.GetContactPicture(ViewModel.SelectedContact.SenderContact, ViewModel.SelectedContact.FromName, ViewModel.SelectedContact.FromAddress), Mode=OneWay}"
                                IsFaviconEnabled="{x:Bind helpers:XamlHelpers.GetFaviconEnabled(), Mode=OneTime}"
                                IsGravatarEnabled="{x:Bind helpers:XamlHelpers.GetGravatarEnabled(), Mode=OneTime}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedContact.Name, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedContact.JobTitleOrCompany, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.SelectedContact.JobTitleOrCompany), Mode=OneWay}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedContact.SourceLabel, Mode=OneWay}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            AutomationProperties.AutomationId="ContactDetailSendMail"
                            Command="{x:Bind ViewModel.ComposeToContactCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedContact, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE715;" />
                                <TextBlock Text="{x:Bind domain:Translator.ContactAction_SendMail, Mode=OneTime}" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ContactDetailEdit"
                            Command="{x:Bind ViewModel.EditContactCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedContact, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.SelectedContact.IsEditable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.ContactAction_Edit, Mode=OneTime}">
                            <FontIcon FontSize="14" Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ContactDetailRemoveFromList"
                            Command="{x:Bind ViewModel.RemoveFromCurrentListCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedContact, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.ContactAction_RemoveFromList, Mode=OneTime}"
                            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.SelectedFilter.IsList), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="ContactDetailDelete"
                            Command="{x:Bind ViewModel.DeleteContactCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedContact, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.SelectedContact.IsEditable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.ContactAction_Delete, Mode=OneTime}">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>

                    <!--  Email  -->
                    <Border
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.SelectedContact.SourceContact.EmailAddresses.Count), Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind domain:Translator.ContactDetail_Email, Mode=OneTime}" />
                            <ItemsControl ItemTemplate="{StaticResource DetailEmailTemplate}" ItemsSource="{x:Bind ViewModel.SelectedContact.SourceContact.EmailAddresses, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Phone  -->
                    <Border
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.SelectedContact.SourceContact.PhoneNumbers.Count), Mode=OneWay}">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind domain:Translator.ContactDetail_Phone, Mode=OneTime}" />
                            <ItemsControl ItemTemplate="{StaticResource DetailPhoneTemplate}" ItemsSource="{x:Bind ViewModel.SelectedContact.SourceContact.PhoneNumbers, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Personal  -->
                    <Border
                        x:Name="DetailPersonalCard"
                        Padding="14,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind domain:Translator.ContactDetail_Personal, Mode=OneTime}" />

                            <StackPanel Visibility="{x:Bind helpers:XamlHelpers.BirthdayVisibility(ViewModel.SelectedContact.SourceContact.BirthdayYear, ViewModel.SelectedContact.SourceContact.BirthdayMonth, ViewModel.SelectedContact.SourceContact.BirthdayDay), Mode=OneWay}">
                                <TextBlock Text="{x:Bind helpers:XamlHelpers.FormatBirthday(ViewModel.SelectedContact.SourceContact.BirthdayYear, ViewModel.SelectedContact.SourceContact.BirthdayMonth, ViewModel.SelectedContact.SourceContact.BirthdayDay), Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.ContactDetail_Birthday, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.SelectedContact.SourceContact.Website), Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedContact.SourceContact.Website, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.ContactDetail_Website, Mode=OneTime}" />
                            </StackPanel>

                            <StackPanel Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.SelectedContact.SourceContact.Notes), Mode=OneWay}">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.SelectedContact.SourceContact.Notes, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.ContactDetail_Notes, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                </VisualState>

                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DetailColumn.Width" Value="0" />
                        <Setter Target="DetailPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</abstract:ContactsPageAbstract>
