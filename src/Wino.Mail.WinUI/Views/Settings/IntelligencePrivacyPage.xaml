<abstract:IntelligencePrivacyPageAbstract
    x:Class="Wino.Views.Settings.IntelligencePrivacyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <InfoBar
            AutomationProperties.AutomationId="WinoIntelligenceConsentErrorInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasConsentError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ConsentErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasConsentError, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.AutomationId="WinoIntelligenceConsentDeletionPendingInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsConsentDeletionPending, Mode=OneWay}"
            Message="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentDeletionPending, Mode=OneTime}"
            Severity="Warning"
            Visibility="{x:Bind ViewModel.IsConsentDeletionPending, Mode=OneWay}" />
        <InfoBar
            AutomationProperties.AutomationId="WinoIntelligenceConsentDeletionFailedInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsConsentDeletionFailed, Mode=OneWay}"
            Message="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentDeletionFailed, Mode=OneTime}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.IsConsentDeletionFailed, Mode=OneWay}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="WinoIntelligenceProviderAccessCard"
            Description="{x:Bind domain:Translator.WinoIntelligence_ProviderAccess_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Privacy_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Shield" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsConsentBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsConsentBusy, Mode=OneWay}" />
                <ToggleSwitch
                    x:Name="IntelligenceConsentToggle"
                    AutomationProperties.AutomationId="WinoIntelligenceConsentToggle"
                    AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Privacy_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsConsentBusy), Mode=OneWay}"
                    IsOn="{x:Bind ViewModel.IsConsentGranted, Mode=OneWay}"
                    OffContent="{x:Bind domain:Translator.WinoAccount_NotAllowed, Mode=OneTime}"
                    OnContent="{x:Bind domain:Translator.WinoAccount_Allowed, Mode=OneTime}"
                    Toggled="IntelligenceConsentToggle_Toggled" />
            </StackPanel>
        </controls:SettingsCard>

        <TextBlock
            Margin="1,20,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WinoIntelligence_Sends_Header, Mode=OneTime}" />

        <controls:SettingsCard
            x:Name="AssistantSendsCard"
            x:Load="{x:Bind ViewModel.IsVoiceControlAvailable, Mode=OneTime}"
            AutomationProperties.AutomationId="WinoIntelligenceSendsAssistantCard"
            Header="{x:Bind domain:Translator.WinoIntelligence_Voice_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <ImageIcon Source="ms-appx:///Assets/StoreLogo.png" />
            </controls:SettingsCard.HeaderIcon>
            <controls:SettingsCard.Description>
                <TextBlock Text="{x:Bind domain:Translator.WinoIntelligence_Sends_Assistant, Mode=OneTime}" TextWrapping="WrapWholeWords" />
            </controls:SettingsCard.Description>
        </controls:SettingsCard>
        <controls:SettingsCard
            AutomationProperties.AutomationId="WinoIntelligenceSendsClassificationCard"
            Description="{x:Bind domain:Translator.WinoIntelligence_Sends_Classification, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Sends_ClassificationTitle, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Tag" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>
        <controls:SettingsCard
            AutomationProperties.AutomationId="WinoIntelligenceSendsToolsCard"
            Description="{x:Bind domain:Translator.WinoIntelligence_Sends_Tools, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Languages_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Translate" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <TextBlock
            Margin="1,20,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WinoIntelligence_Stored_Header, Mode=OneTime}" />

        <coreControls:WinoSettingsCard
            x:Name="StoredMemoryCard"
            x:Load="{x:Bind ViewModel.IsVoiceControlAvailable, Mode=OneTime}"
            AutomationProperties.AutomationId="WinoIntelligenceStoredMemoryCard"
            Command="{x:Bind ViewModel.OpenVoiceBrainCommand}"
            Description="{x:Bind domain:Translator.WinoIntelligence_Stored_Memory, Mode=OneTime}"
            Header="{x:Bind domain:Translator.VoiceBrain_Title, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Lightbulb" />
            </controls:SettingsCard.HeaderIcon>
        </coreControls:WinoSettingsCard>
        <coreControls:WinoSettingsCard
            AutomationProperties.AutomationId="WinoIntelligenceStoredResultsCard"
            Command="{x:Bind ViewModel.OpenMailClassificationCommand}"
            Description="{x:Bind domain:Translator.WinoIntelligence_Stored_Results, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Stored_ResultsTitle, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Tag" />
            </controls:SettingsCard.HeaderIcon>
        </coreControls:WinoSettingsCard>

        <TextBlock
            Margin="1,20,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WinoIntelligence_Policy_Header, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="WinoIntelligencePolicyCard"
            Description="{x:Bind ViewModel.ConsentAcceptedText, Mode=OneWay}"
            Header="{x:Bind domain:Translator.WinoIntelligence_Policy_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Document" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                AutomationProperties.AutomationId="WinoIntelligencePolicyReviewButton"
                AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Policy_Title, Mode=OneTime}"
                Command="{x:Bind ViewModel.OpenConsentPolicyCommand}"
                Content="{x:Bind domain:Translator.WinoIntelligence_Policy_Review, Mode=OneTime}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:IntelligencePrivacyPageAbstract>
