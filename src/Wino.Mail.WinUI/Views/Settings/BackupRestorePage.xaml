<abstract:BackupRestorePageAbstract
    x:Class="Wino.Views.Settings.BackupRestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            AutomationProperties.AutomationId="BackupRestoreLocalDataCard"
            Description="{x:Bind domain:Translator.WinoAccount_Management_LocalDataSectionDescription}"
            Header="{x:Bind domain:Translator.WinoAccount_Management_LocalDataSectionTitle}">
            <controls:SettingsCard.HeaderIcon>
                <SymbolIcon Symbol="Sync" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    AutomationProperties.AutomationId="BackupRestoreImportButton"
                    Command="{x:Bind ViewModel.ImportLocalDataCommand}"
                    Content="{x:Bind domain:Translator.WinoAccount_Management_LocalDataImportAction}" />
                <Button
                    AutomationProperties.AutomationId="BackupRestoreExportButton"
                    Command="{x:Bind ViewModel.ExportLocalDataCommand}"
                    Content="{x:Bind domain:Translator.WinoAccount_Management_LocalDataExportAction}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_Management_LocalDataSectionTitle}"
                    IsActive="{x:Bind ViewModel.IsDataTransferInProgress, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsDataTransferInProgress, Mode=OneWay}" />
            </StackPanel>
        </controls:SettingsCard>
    </StackPanel>
</abstract:BackupRestorePageAbstract>
