<abstract:ToDoPreferenceSettingsPageAbstract
    x:Class="Wino.Views.Settings.ToDoPreferenceSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard AutomationProperties.AutomationId="ToDoNewTasksCard" Header="{x:Bind domain:Translator.ToDoSettings_NewTasks_Header}" Description="{x:Bind domain:Translator.ToDoSettings_NewTasks_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE710;" /></controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <ComboBox AutomationProperties.AutomationId="ToDoNewTaskDestinationBehavior" ItemsSource="{x:Bind ViewModel.DestinationBehaviors}" SelectedItem="{x:Bind ViewModel.SelectedDestinationBehavior, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:DestinationBehaviorOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <ComboBox x:Name="SpecificCreationListComboBox" x:Load="{x:Bind ViewModel.ShouldShowSpecificCreationList, Mode=OneWay}" AutomationProperties.AutomationId="ToDoSpecificCreationList" ItemsSource="{x:Bind ViewModel.TaskLists}" SelectedItem="{x:Bind ViewModel.SelectedCreationList, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:TaskListPreferenceOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="ToDoStartViewCard" Header="{x:Bind domain:Translator.ToDoSettings_StartView_Header}" Description="{x:Bind domain:Translator.ToDoSettings_StartView_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE80F;" /></controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <ComboBox AutomationProperties.AutomationId="ToDoStartView" ItemsSource="{x:Bind ViewModel.StartViews}" SelectedItem="{x:Bind ViewModel.SelectedStartView, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:ToDoStartViewOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <ComboBox x:Name="SpecificStartListComboBox" x:Load="{x:Bind ViewModel.ShouldShowSpecificStartList, Mode=OneWay}" AutomationProperties.AutomationId="ToDoSpecificStartList" ItemsSource="{x:Bind ViewModel.TaskLists}" SelectedItem="{x:Bind ViewModel.SelectedStartList, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:TaskListPreferenceOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="ToDoCompletedTasksCard" Header="{x:Bind domain:Translator.ToDoSettings_Completed_Header}" Description="{x:Bind domain:Translator.ToDoSettings_Completed_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE73E;" /></controls:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <ComboBox AutomationProperties.AutomationId="ToDoCompletedTaskTreatment" ItemsSource="{x:Bind ViewModel.CompletedTaskTreatments}" SelectedItem="{x:Bind ViewModel.SelectedCompletedTaskTreatment, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:CompletedTaskTreatmentOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                <ComboBox x:Name="CompletedTaskHideDelayComboBox" x:Load="{x:Bind ViewModel.ShouldShowHideDelay, Mode=OneWay}" AutomationProperties.AutomationId="ToDoCompletedTaskHideDelay" ItemsSource="{x:Bind ViewModel.CompletedTaskHideDelays}" SelectedItem="{x:Bind ViewModel.SelectedCompletedTaskHideDelay, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="data:CompletedTaskHideDelayOption"><TextBlock Text="{x:Bind DisplayText}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            </StackPanel>
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="ToDoCompletionSoundCard" Header="{x:Bind domain:Translator.ToDoSettings_Sound_Header}" Description="{x:Bind domain:Translator.ToDoSettings_Sound_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE995;" /></controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="ToDoCompletionSound" IsOn="{x:Bind ViewModel.IsTaskCompletionSoundEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
        <controls:SettingsCard AutomationProperties.AutomationId="ToDoDeleteConfirmationCard" Header="{x:Bind domain:Translator.ToDoSettings_DeleteConfirmation_Header}" Description="{x:Bind domain:Translator.ToDoSettings_DeleteConfirmation_Description}">
            <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="ToDoDeleteConfirmation" IsOn="{x:Bind ViewModel.IsTaskDeleteConfirmationEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:ToDoPreferenceSettingsPageAbstract>
