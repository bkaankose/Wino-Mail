<abstract:ApplicationThemeEditorPageAbstract
    x:Class="Wino.Views.Settings.ApplicationThemeEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:data="using:Wino.Core.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:local="using:Wino.Views.Settings"
    x:Name="Root"
    Title="{x:Bind ViewModel.PageTitle, Mode=OneWay}">

    <Grid x:Name="EditorLayout" ColumnSpacing="24" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="EditorPreviewColumn" Width="0" /></Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideEditorLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EditorPreviewColumn.Width" Value="*" />
                        <Setter Target="PreviewPanel.(Grid.Row)" Value="0" />
                        <Setter Target="PreviewPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="16">
            <InfoBar
                AutomationProperties.AutomationId="ApplicationThemeEditorError"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorNameCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_Name, Mode=OneTime}" Description="{x:Bind domain:Translator.ApplicationThemeEditor_NameDescription, Mode=OneTime}">
                <TextBox
                    Width="220"
                    AutomationProperties.AutomationId="ApplicationThemeEditorNameTextBox"
                    Text="{x:Bind ViewModel.ThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </controls:SettingsCard>

            <controls:SettingsExpander AutomationProperties.AutomationId="ApplicationThemeEditorWallpaperExpander" Header="{x:Bind domain:Translator.ApplicationThemeEditor_Wallpaper, Mode=OneTime}" Description="{x:Bind domain:Translator.ApplicationThemeEditor_WallpaperDescription, Mode=OneTime}" IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorWallpaperImageCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_WallpaperImage, Mode=OneTime}">
                        <Button AutomationProperties.AutomationId="ApplicationThemeEditorBrowseWallpaperButton" Command="{x:Bind ViewModel.ChooseWallpaperCommand}" Content="{x:Bind domain:Translator.Buttons_Browse, Mode=OneTime}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorWallpaperFitCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_WallpaperFit, Mode=OneTime}">
                        <controls:Segmented AutomationProperties.AutomationId="ApplicationThemeEditorWallpaperFit" SelectedIndex="{x:Bind ViewModel.WallpaperFitIndex, Mode=TwoWay}">
                            <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeEditor_Fill, Mode=OneTime}" />
                            <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeEditor_Fit, Mode=OneTime}" />
                        </controls:Segmented>
                    </controls:SettingsCard>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorFocalPointCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_FocalPoint, Mode=OneTime}" IsEnabled="{x:Bind ViewModel.IsFocalSelectorEnabled, Mode=OneWay}">
                        <Grid Width="120" Height="120" RowSpacing="4" ColumnSpacing="4">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" AutomationProperties.AutomationId="ThemeFocalTopLeft" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalTopLeft, Mode=OneTime}" Click="FocalPointClicked" Tag="TopLeft" />
                            <Button Grid.Row="0" Grid.Column="1" AutomationProperties.AutomationId="ThemeFocalTop" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalTop, Mode=OneTime}" Click="FocalPointClicked" Tag="Top" />
                            <Button Grid.Row="0" Grid.Column="2" AutomationProperties.AutomationId="ThemeFocalTopRight" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalTopRight, Mode=OneTime}" Click="FocalPointClicked" Tag="TopRight" />
                            <Button Grid.Row="1" Grid.Column="0" AutomationProperties.AutomationId="ThemeFocalLeft" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalLeft, Mode=OneTime}" Click="FocalPointClicked" Tag="Left" />
                            <Button Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="ThemeFocalCenter" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalCenter, Mode=OneTime}" Click="FocalPointClicked" Tag="Center" />
                            <Button Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="ThemeFocalRight" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalRight, Mode=OneTime}" Click="FocalPointClicked" Tag="Right" />
                            <Button Grid.Row="2" Grid.Column="0" AutomationProperties.AutomationId="ThemeFocalBottomLeft" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalBottomLeft, Mode=OneTime}" Click="FocalPointClicked" Tag="BottomLeft" />
                            <Button Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="ThemeFocalBottom" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalBottom, Mode=OneTime}" Click="FocalPointClicked" Tag="Bottom" />
                            <Button Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="ThemeFocalBottomRight" AutomationProperties.Name="{x:Bind domain:Translator.ApplicationThemeEditor_FocalBottomRight, Mode=OneTime}" Click="FocalPointClicked" Tag="BottomRight" />
                        </Grid>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander AutomationProperties.AutomationId="ApplicationThemeEditorAccentExpander" Header="{x:Bind domain:Translator.ApplicationThemeEditor_Accent, Mode=OneTime}" IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorSystemAccentCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_UseSystemAccent, Mode=OneTime}">
                        <ToggleSwitch AutomationProperties.AutomationId="ApplicationThemeEditorSystemAccentToggle" IsOn="{x:Bind ViewModel.UseSystemAccent, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorCustomAccentCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_CustomAccent, Mode=OneTime}" IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.UseSystemAccent), Mode=OneWay}">
                        <TextBox
                            Width="130"
                            AutomationProperties.AutomationId="ApplicationThemeEditorAccentTextBox"
                            Header="#RRGGBB"
                            Text="{x:Bind ViewModel.AccentColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <controls:SettingsExpander AutomationProperties.AutomationId="ApplicationThemeEditorPaletteExpander" Header="{x:Bind domain:Translator.ApplicationThemeEditor_Palette, Mode=OneTime}" IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorModeCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_Mode, Mode=OneTime}">
                        <controls:Segmented AutomationProperties.AutomationId="ApplicationThemeEditorPaletteMode" SelectedIndex="{x:Bind ViewModel.PaletteModeIndex, Mode=TwoWay}">
                            <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Light, Mode=OneTime}" />
                            <controls:SegmentedItem Content="{x:Bind domain:Translator.ApplicationThemeGallery_Dark, Mode=OneTime}" />
                        </controls:Segmented>
                    </controls:SettingsCard>
                    <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorBaseSurfaceCard" Header="{x:Bind domain:Translator.ApplicationThemeEditor_BaseSurface, Mode=OneTime}" Description="{x:Bind domain:Translator.ApplicationThemeEditor_AlphaHint, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="130" AutomationProperties.AutomationId="ApplicationThemeEditorBaseSurfaceTextBox" Text="{x:Bind ViewModel.BaseSurfaceColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button AutomationProperties.AutomationId="ApplicationThemeEditorResetBaseButton" Command="{x:Bind ViewModel.ResetBaseSurfaceCommand}" Content="{x:Bind domain:Translator.Buttons_Reset, Mode=OneTime}" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AdvancedColorOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:ThemePaletteColorOptionViewModel">
                                <controls:SettingsCard AutomationProperties.AutomationId="ApplicationThemeEditorAdvancedColorCard" Margin="0,0,0,2" Header="{x:Bind Label}" Description="{x:Bind Group}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox Width="130" AutomationProperties.AutomationId="ApplicationThemeEditorAdvancedColorTextBox" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            AutomationProperties.AutomationId="ApplicationThemeEditorResetAdvancedColorButton"
                                            Command="{Binding ElementName=Root, Path=ViewModel.ResetColorCommand}"
                                            CommandParameter="{x:Bind}"
                                            Content="{x:Bind domain:Translator.Buttons_Reset, Mode=OneTime}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="ApplicationThemeEditorCancelButton" Command="{x:Bind ViewModel.CancelCommand}" Content="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}" />
                <Button AutomationProperties.AutomationId="ApplicationThemeEditorSaveButton" Command="{x:Bind ViewModel.SaveCommand}" Content="{x:Bind domain:Translator.Buttons_Save, Mode=OneTime}" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="PreviewPanel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="220" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.ApplicationThemeEditor_Preview, Mode=OneTime}" />
            <Border Grid.Row="1" Background="{ThemeResource WinoApplicationBackgroundColor}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Grid Padding="12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <Border Background="{ThemeResource NavigationViewContentBackground}" CornerRadius="4" />
                    <StackPanel Grid.Column="1" Background="{ThemeResource WinoContentZoneBackgroud}" Padding="8" Spacing="6">
                        <Border Height="22" Background="{ThemeResource MailListHeaderBackgroundColor}" CornerRadius="4" />
                        <Border Height="34" Background="{ThemeResource CalendarDefaultHourBackgroundBrush}" CornerRadius="4" />
                        <Border Height="34" Background="{ThemeResource CalendarWorkHourBackgroundBrush}" CornerRadius="4" />
                        <Border Height="34" Background="{ThemeResource CalendarSelectedHourBackgroundBrush}" CornerRadius="4" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{ThemeResource ReadingPaneBackgroundColorBrush}" CornerRadius="4">
                        <StackPanel Padding="12" Spacing="8"><TextBlock FontWeight="SemiBold" Text="Wino Mail" /><TextBlock Text="{x:Bind domain:Translator.ApplicationThemeEditor_PreviewBody, Mode=OneTime}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Image Grid.Row="2" Height="150" Source="{x:Bind local:ApplicationThemeEditorPage.GetWallpaperPreviewSource(ViewModel.WallpaperPreviewPath), Mode=OneWay}" Stretch="UniformToFill" />
        </Grid>
    </Grid>
</abstract:ApplicationThemeEditorPageAbstract>
