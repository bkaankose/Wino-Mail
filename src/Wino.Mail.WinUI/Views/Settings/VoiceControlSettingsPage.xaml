<abstract:VoiceControlSettingsPageAbstract
    x:Class="Wino.Views.Settings.VoiceControlSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:hotKey="using:Wino.Mail.Controls.HotKeyInput"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wino.Core.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="PositionSpotStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

        <StackPanel
            AutomationProperties.AutomationId="VoiceControlSettingsAvailablePanel"
            Spacing="{StaticResource SettingsCardSpacing}"
            Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
            <controls:SettingsCard
                AutomationProperties.AutomationId="VoiceControlSettingsEnableCard"
                Description="{x:Bind domain:Translator.VoiceControlSettings_Enable_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceControlSettings_Enable_Title, Mode=OneTime}">
                <controls:SettingsCard.HeaderIcon>
                    <ImageIcon Source="ms-appx:///Assets/StoreLogo.png" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="VoiceControlSettingsEnableToggle"
                    AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Enable_Title, Mode=OneTime}"
                    IsOn="{x:Bind ViewModel.IsVoiceControlEnabled, Mode=TwoWay}"
                    Toggled="VoiceControlEnabled_Toggled" />
            </controls:SettingsCard>

            <TextBlock
                Margin="1,20,0,4"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="{x:Bind domain:Translator.VoiceControlSettings_HowYouAsk_Header, Mode=OneTime}" />

            <controls:SettingsExpander
                x:Name="ShortcutsExpander"
                AutomationProperties.AutomationId="VoiceControlSettingsShortcutsCard"
                Description="{x:Bind domain:Translator.VoiceControlSettings_Shortcuts_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceControlSettings_Shortcuts_Title, Mode=OneTime}"
                IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Keyboard" />
                </controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="VoiceControlSettingsHotKeyCard"
                        Description="{x:Bind domain:Translator.VoiceControlSettings_HotKey_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.VoiceControlSettings_HotKey_Title, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <hotKey:WinoHotKeyInput
                                x:Name="HotKeyInput"
                                MinWidth="240"
                                AutomationProperties.AutomationId="VoiceControlSettingsHotKeyInput"
                                AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_HotKey_KeyCombination, Mode=OneTime}"
                                CaptureCanceled="HotKeyInput_CaptureCanceled"
                                CaptureStarted="HotKeyInput_CaptureStarted"
                                HotKeyCommitted="HotKeyInput_HotKeyCommitted"
                                ListeningPrompt="{x:Bind domain:Translator.CompanionSettings_HotKey_Listening, Mode=OneTime}"
                                NormalPrompt="{x:Bind domain:Translator.KeyboardShortcuts_PressKeysHere, Mode=OneTime}" />
                            <ToggleSwitch
                                x:Name="HotKeyEnabledToggle"
                                MinWidth="0"
                                AutomationProperties.AutomationId="VoiceControlSettingsHotKeyToggle"
                                AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_HotKey_Title, Mode=OneTime}"
                                Toggled="HotKeyEnabled_Toggled" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="VoiceControlSettingsTextHotKeyCard"
                        Description="{x:Bind domain:Translator.VoiceControlSettings_TextHotKey_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.VoiceControlSettings_TextHotKey_Title, Mode=OneTime}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <hotKey:WinoHotKeyInput
                                x:Name="TextHotKeyInput"
                                MinWidth="240"
                                AutomationProperties.AutomationId="VoiceControlSettingsTextHotKeyInput"
                                AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_TextHotKey_KeyCombination, Mode=OneTime}"
                                CaptureCanceled="TextHotKeyInput_CaptureCanceled"
                                CaptureStarted="TextHotKeyInput_CaptureStarted"
                                HotKeyCommitted="TextHotKeyInput_HotKeyCommitted"
                                ListeningPrompt="{x:Bind domain:Translator.CompanionSettings_HotKey_Listening, Mode=OneTime}"
                                NormalPrompt="{x:Bind domain:Translator.KeyboardShortcuts_PressKeysHere, Mode=OneTime}" />
                            <ToggleSwitch
                                x:Name="TextHotKeyEnabledToggle"
                                MinWidth="0"
                                AutomationProperties.AutomationId="VoiceControlSettingsTextHotKeyToggle"
                                AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_TextHotKey_Title, Mode=OneTime}"
                                Toggled="TextHotKeyEnabled_Toggled" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <InfoBar
                x:Name="HotKeyErrorInfoBar"
                AutomationProperties.AutomationId="VoiceControlSettingsHotKeyError"
                IsClosable="False"
                IsOpen="False"
                Severity="Error" />

            <controls:SettingsCard
                AutomationProperties.AutomationId="VoiceControlSettingsMicrophoneCard"
                Description="{x:Bind domain:Translator.VoiceControlSettings_Microphone_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceControlSettings_Microphone_Title, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.IsVoiceControlEnabled, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Microphone" />
                </controls:SettingsCard.HeaderIcon>
                <Grid
                    MinWidth="320"
                    ColumnSpacing="8"
                    RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ToggleButton
                        Grid.Column="1"
                        AutomationProperties.AutomationId="VoiceControlSettingsMicrophoneTest"
                        Content="{x:Bind domain:Translator.VoiceControlSettings_Microphone_Test, Mode=OneTime}"
                        IsChecked="{x:Bind ViewModel.IsTestingMicrophone, Mode=TwoWay}" />
                    <ComboBox
                        MaxWidth="300"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="VoiceControlSettingsMicrophoneComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Microphone_Title, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MicrophoneOption">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ProgressBar
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        AutomationProperties.AutomationId="VoiceControlSettingsMicrophoneLevel"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Microphone_Level, Mode=OneTime}"
                        Maximum="1"
                        Minimum="0"
                        Visibility="{x:Bind ViewModel.IsTestingMicrophone, Mode=OneWay}"
                        Value="{x:Bind ViewModel.MicrophoneLevel, Mode=OneWay}" />
                </Grid>
            </controls:SettingsCard>

            <InfoBar
                AutomationProperties.AutomationId="VoiceControlSettingsMicrophoneProblem"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMicrophoneProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.MicrophoneProblemMessage, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <HyperlinkButton
                        AutomationProperties.AutomationId="VoiceControlSettingsOpenPrivacySettings"
                        Content="{x:Bind domain:Translator.VoiceControlSettings_Microphone_OpenPrivacySettings, Mode=OneTime}"
                        NavigateUri="ms-settings:privacy-microphone"
                        Visibility="{x:Bind ViewModel.IsMicrophoneAccessDenied, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:SettingsCard
                AutomationProperties.AutomationId="VoiceControlSettingsPositionCard"
                Description="{x:Bind domain:Translator.VoiceControlSettings_Position_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceControlSettings_Position_Title, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.IsVoiceControlEnabled, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Desktop" />
                </controls:SettingsCard.HeaderIcon>
                <Grid
                    Width="240"
                    Height="150"
                    AutomationProperties.AutomationId="VoiceControlSettingsPositionPicker"
                    AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_Title, Mode=OneTime}">
                    <Border
                        Background="{ThemeResource WinoIllustrationLineSoftBrush}"
                        BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                        BorderThickness="2"
                        CornerRadius="6" />
                    <Border
                        Height="14"
                        Margin="2"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="0,0,4,4">
                        <Image
                            Width="8"
                            Height="8"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            Source="ms-appx:///Wino.Mail.Controls.WinUI/Assets/WinoLogo.png" />
                    </Border>

                    <ToggleButton
                        x:Name="TopLeftSpot"
                        Margin="8,8,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="VoiceControlSettingsPositionTopLeft"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_TopLeft, Mode=OneTime}"
                        Click="PositionSpot_Click"
                        Style="{StaticResource PositionSpotStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.VoiceControlSettings_Position_TopLeft, Mode=OneTime}" />
                    <ToggleButton
                        x:Name="TopRightSpot"
                        Margin="0,8,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="VoiceControlSettingsPositionTopRight"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_TopRight, Mode=OneTime}"
                        Click="PositionSpot_Click"
                        Style="{StaticResource PositionSpotStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.VoiceControlSettings_Position_TopRight, Mode=OneTime}" />
                    <ToggleButton
                        x:Name="CenterSpot"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="VoiceControlSettingsPositionCenter"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_Center, Mode=OneTime}"
                        Click="PositionSpot_Click"
                        Style="{StaticResource PositionSpotStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.VoiceControlSettings_Position_Center, Mode=OneTime}" />
                    <ToggleButton
                        x:Name="BottomLeftSpot"
                        Margin="8,0,0,22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="VoiceControlSettingsPositionBottomLeft"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_BottomLeft, Mode=OneTime}"
                        Click="PositionSpot_Click"
                        Style="{StaticResource PositionSpotStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.VoiceControlSettings_Position_BottomLeft, Mode=OneTime}" />
                    <ToggleButton
                        x:Name="BottomRightSpot"
                        Margin="0,0,8,22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="VoiceControlSettingsPositionBottomRight"
                        AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_Position_BottomRight, Mode=OneTime}"
                        Click="PositionSpot_Click"
                        Style="{StaticResource PositionSpotStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.VoiceControlSettings_Position_BottomRight, Mode=OneTime}" />
                </Grid>
            </controls:SettingsCard>

            <TextBlock
                Margin="1,20,0,4"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="{x:Bind domain:Translator.VoiceControlSettings_HowWinoAnswers_Header, Mode=OneTime}" />

            <coreControls:WinoSettingsCard
                AutomationProperties.AutomationId="VoiceControlSettingsRemembersCard"
                Command="{x:Bind ViewModel.OpenVoiceBrainCommand}"
                Description="{x:Bind domain:Translator.VoiceBrain_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceBrain_Title, Mode=OneTime}"
                IsClickEnabled="True">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Lightbulb" />
                </controls:SettingsCard.HeaderIcon>
            </coreControls:WinoSettingsCard>

            <controls:SettingsCard
                AutomationProperties.AutomationId="VoiceControlSettingsAutoConfirmCard"
                Description="{x:Bind domain:Translator.VoiceControlSettings_AutoConfirm_Description, Mode=OneTime}"
                Header="{x:Bind domain:Translator.VoiceControlSettings_AutoConfirm_Title, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.IsVoiceControlEnabled, Mode=OneWay}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Shield" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    AutomationProperties.AutomationId="VoiceControlSettingsAutoConfirmToggle"
                    AutomationProperties.Name="{x:Bind domain:Translator.VoiceControlSettings_AutoConfirm_Title, Mode=OneTime}"
                    IsOn="{x:Bind ViewModel.IsAutoConfirmEnabled, Mode=TwoWay}" />
            </controls:SettingsCard>
        </StackPanel>
    </StackPanel>
</abstract:VoiceControlSettingsPageAbstract>
