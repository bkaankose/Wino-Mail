<abstract:AppPreferencesPageAbstract
    x:Class="Wino.Views.Settings.AppPreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:enums="using:Wino.Core.Domain.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:translations="using:Wino.Core.Domain.Models.Translations"
    mc:Ignorable="d">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            AutomationProperties.AutomationId="AppPreferencesPageSettingsCard"
            Description="{x:Bind domain:Translator.SettingsLanguage_Description}"
            Header="{x:Bind domain:Translator.SettingsLanguage_Title}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Translate" />
            </controls:SettingsCard.HeaderIcon>
            <ComboBox
                AutomationProperties.AutomationId="AppPreferencesLanguageComboBox"
                ItemsSource="{x:Bind ViewModel.AvailableLanguages, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="translations:AppLanguageModel">
                        <TextBlock Text="{x:Bind DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="AppPreferencesPageSettingsCard2"
            Description="{x:Bind domain:Translator.SettingsAppPreferences_LaunchAtSignIn_Description}"
            Header="{x:Bind domain:Translator.SettingsAppPreferences_LaunchAtSignIn_Title}">
            <ToggleButton
                x:Name="StartupEnabledToggleButton"
                AutomationProperties.AutomationId="StartupEnabledToggleButton"
                Command="{x:Bind ViewModel.ToggleStartupBehaviorCommand}"
                Content="{x:Bind domain:Translator.SettingsAppPreferences_StartupBehavior_Disable}"
                IsChecked="{x:Bind ViewModel.IsStartupBehaviorEnabled, Mode=OneWay}" />
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Power" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="AppPreferencesPageSettingsCard6"
            Description="{x:Bind domain:Translator.SettingsAppPreferences_CloseBehavior_Description}"
            Header="{x:Bind domain:Translator.SettingsAppPreferences_CloseBehavior_Title}">
            <ComboBox
                AutomationProperties.AutomationId="AppPreferencesCloseBehaviorComboBox"
                ItemsSource="{x:Bind ViewModel.CloseBehaviorModes, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedCloseBehaviorMode, Mode=TwoWay}" />
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Desktop" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="AppPreferencesPageSettingsCard7"
            Description="{x:Bind domain:Translator.SettingsAppPreferences_StoreUpdateNotifications_Description}"
            Header="{x:Bind domain:Translator.SettingsAppPreferences_StoreUpdateNotifications_Title}">
            <ToggleSwitch AutomationProperties.AutomationId="AppPreferencesStoreUpdateNotificationsToggleSwitch" IsOn="{x:Bind ViewModel.PreferencesService.IsStoreUpdateNotificationsEnabled, Mode=TwoWay}" />
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ArrowDownload" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="AppPreferencesPageSettingsCard8"
            Description="{x:Bind domain:Translator.SettingsAppPreferences_DisableAppModeTaskbarIconSwitch_Description}"
            Header="{x:Bind domain:Translator.SettingsAppPreferences_DisableAppModeTaskbarIconSwitch_Title}">
            <ToggleSwitch AutomationProperties.AutomationId="AppPreferencesDisableAppModeTaskbarIconSwitchToggleSwitch" IsOn="{x:Bind ViewModel.PreferencesService.IsAppModeTaskbarIconSwitchDisabled, Mode=TwoWay}" />
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Pin" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsExpander
            x:Name="StartMenuEntriesSettings"
            x:Load="{x:Bind ViewModel.HasStartMenuIntegration}"
            AutomationProperties.AutomationId="StartMenuEntriesSettings"
            Description="{x:Bind domain:Translator.SettingsStartMenu_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsStartMenu_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Desktop" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard Header="{x:Bind domain:Translator.SettingsStartMenu_Calendar, Mode=OneTime}">
                    <ToggleSwitch
                        x:Name="CalendarStartMenuToggle"
                        AutomationProperties.AutomationId="CalendarStartMenuToggle"
                        IsEnabled="{x:Bind ViewModel.CanChangeStartMenuEntries, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsCalendarStartMenuEntryEnabled, Mode=OneWay}"
                        OffContent="{x:Bind domain:Translator.SettingsStartMenu_Hidden, Mode=OneTime}"
                        OnContent="{x:Bind domain:Translator.SettingsStartMenu_Shown, Mode=OneTime}"
                        Toggled="StartMenuEntryToggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{x:Bind domain:Translator.SettingsStartMenu_Contacts, Mode=OneTime}">
                    <ToggleSwitch
                        x:Name="ContactsStartMenuToggle"
                        AutomationProperties.AutomationId="ContactsStartMenuToggle"
                        IsEnabled="{x:Bind ViewModel.CanChangeStartMenuEntries, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsContactsStartMenuEntryEnabled, Mode=OneWay}"
                        OffContent="{x:Bind domain:Translator.SettingsStartMenu_Hidden, Mode=OneTime}"
                        OnContent="{x:Bind domain:Translator.SettingsStartMenu_Shown, Mode=OneTime}"
                        Toggled="StartMenuEntryToggled" />
                </controls:SettingsCard>
                <controls:SettingsCard Header="{x:Bind domain:Translator.SettingsStartMenu_Tasks, Mode=OneTime}">
                    <ToggleSwitch
                        x:Name="TasksStartMenuToggle"
                        AutomationProperties.AutomationId="TasksStartMenuToggle"
                        IsEnabled="{x:Bind ViewModel.CanChangeStartMenuEntries, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.IsTasksStartMenuEntryEnabled, Mode=OneWay}"
                        OffContent="{x:Bind domain:Translator.SettingsStartMenu_Hidden, Mode=OneTime}"
                        OnContent="{x:Bind domain:Translator.SettingsStartMenu_Shown, Mode=OneTime}"
                        Toggled="StartMenuEntryToggled" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>
    </StackPanel>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="StartupBehaviorStates">
            <VisualState x:Name="StartupEnabled" />
            <VisualState x:Name="StartupDisabled">
                <VisualState.Setters>
                    <Setter Target="StartupEnabledToggleButton.Content" Value="{x:Bind domain:Translator.SettingsAppPreferences_StartupBehavior_Enable}" />
                </VisualState.Setters>
                <VisualState.StateTriggers>
                    <StateTrigger IsActive="{x:Bind ViewModel.IsStartupBehaviorDisabled, Mode=OneWay}" />
                </VisualState.StateTriggers>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
</abstract:AppPreferencesPageAbstract>

