<abstract:MailFiltersPageAbstract
    x:Class="Wino.Views.Settings.MailFiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Wino.Mail.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <StackPanel MaxWidth="900" Spacing="{StaticResource SettingsCardSpacing}">
            <controls:SettingsCard
                AutomationProperties.AutomationId="MailFiltersNewFilterCard"
                Click="NewFilterClicked"
                Description="{x:Bind domain:Translator.MailFilters_NewFilterDescription, Mode=OneTime}"
                Header="{x:Bind domain:Translator.MailFilters_NewFilter, Mode=OneTime}"
                IsClickEnabled="True">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="Add" />
                </controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>

            <InfoBar
                x:Name="GmailProviderFiltersUnavailableInfoBar"
                Title="{x:Bind domain:Translator.MailFilters_ProviderFeatureTitle, Mode=OneTime}"
                x:Load="{x:Bind ViewModel.IsGmailAccount, Mode=OneWay}"
                AutomationProperties.AutomationId="MailFiltersGmailProviderUnavailableInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind domain:Translator.MailFilters_GmailProviderUnavailableDescription, Mode=OneTime}"
                Severity="Informational" />

            <InfoBar
                x:Name="ProviderFiltersConnectInfoBar"
                Title="{x:Bind domain:Translator.MailFilters_ProviderFeatureTitle, Mode=OneTime}"
                x:Load="{x:Bind ViewModel.IsProviderFiltersConnectVisible, Mode=OneWay}"
                AutomationProperties.AutomationId="MailFiltersProviderConnectInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind domain:Translator.MailFilters_ProviderFeatureConnectDescription, Mode=OneTime}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="MailFiltersProviderConnectButton"
                        Click="ConnectProviderFiltersClicked"
                        Content="{x:Bind domain:Translator.MailFilters_ProviderFeatureConnect, Mode=OneTime}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Button
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="MailFiltersRefreshButton"
                Click="RefreshClicked"
                Visibility="{x:Bind ViewModel.IsProviderFiltersConnectedVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <coreControls:WinoFontIcon Icon="ArrowClockwise" />
                    <TextBlock Text="{x:Bind domain:Translator.MailFilters_Refresh, Mode=OneTime}" />
                </StackPanel>
            </Button>

            <StackPanel
                x:Name="EmptyFiltersPanel"
                Margin="24,48"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <coreControls:WinoFontIcon
                    HorizontalAlignment="Center"
                    FontSize="36"
                    Icon="Filter" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.MailFilters_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.MailFilters_EmptyDescription, Mode=OneTime}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Filters, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MailFilterListItemViewModel">
                        <controls:SettingsCard
                            Margin="0,0,0,8"
                            AutomationProperties.AutomationId="MailFilterItemCard"
                            Description="{x:Bind Summary}"
                            Header="{x:Bind Filter.Name}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ManagementText}" />
                                    <TextBlock Text="{x:Bind StatusText}" />
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="{x:Bind StatusText}"
                                        Visibility="{x:Bind HasWarning, Mode=OneTime}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="MailFiltersPageToggleSwitch"
                                        AutomationProperties.Name="{x:Bind domain:Translator.MailFilterEditor_Enabled, Mode=OneTime}"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneTime}"
                                        IsOn="{x:Bind Filter.IsEnabled, Mode=OneTime}"
                                        Tag="{x:Bind}"
                                        Toggled="EnabledToggled" />
                                    <Button
                                        AutomationProperties.AutomationId="MailFiltersPageButton"
                                        AutomationProperties.Name="{x:Bind domain:Translator.MailFilters_MoveUp, Mode=OneTime}"
                                        Click="MoveUpClicked"
                                        IsEnabled="{x:Bind CanReorder, Mode=OneTime}"
                                        Tag="{x:Bind}">
                                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="ChevronUp" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="MailFiltersPageButton2"
                                        AutomationProperties.Name="{x:Bind domain:Translator.MailFilters_MoveDown, Mode=OneTime}"
                                        Click="MoveDownClicked"
                                        IsEnabled="{x:Bind CanReorder, Mode=OneTime}"
                                        Tag="{x:Bind}">
                                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="ChevronDown" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="MailFiltersPageButton3"
                                        AutomationProperties.Name="{x:Bind domain:Translator.MailFilters_Edit, Mode=OneTime}"
                                        Click="EditClicked"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneTime}"
                                        Tag="{x:Bind}">
                                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Edit" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="MailFiltersPageButton4"
                                        AutomationProperties.Name="{x:Bind domain:Translator.MailFilters_Duplicate, Mode=OneTime}"
                                        Click="DuplicateClicked"
                                        Tag="{x:Bind}">
                                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Copy" />
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="MailFiltersPageButton5"
                                        AutomationProperties.Name="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}"
                                        Click="DeleteClicked"
                                        Tag="{x:Bind}">
                                        <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Delete" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ProgressRing
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</abstract:MailFiltersPageAbstract>
