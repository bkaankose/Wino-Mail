<abstract:WinoAccountConsentPageAbstract
    x:Class="Wino.Views.Settings.WinoAccountConsentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelData="using:Wino.Core.ViewModels.Data"
    x:Name="Root"
    Title="{x:Bind domain:Translator.WinoAccount_ConsentPageTitle, Mode=OneTime}"
    Unloaded="Root_Unloaded"
    mc:Ignorable="d">

    <Grid Padding="0,16,24,40" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            AutomationProperties.AutomationId="WinoConsentErrorInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <controls:SettingsCard
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="WinoTransportConsentCard"
            Description="{x:Bind domain:Translator.WinoAccount_TransportConsentDescription, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WinoAccount_TransportConsentTitle, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE774;" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsTransportBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsTransportBusy, Mode=OneWay}" />
                <CheckBox
                    x:Name="TransportConsentCheckBox"
                    AutomationProperties.AutomationId="WinoTransportConsentCheckBox"
                    Click="TransportConsentCheckBox_Click"
                    Content="{x:Bind domain:Translator.WinoAccount_Allowed, Mode=OneTime}"
                    IsChecked="{x:Bind ViewModel.IsTransportConsentGranted, Mode=OneWay}"
                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsTransportBusy), Mode=OneWay}" />
            </StackPanel>
        </controls:SettingsCard>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="{x:Bind domain:Translator.WinoAccount_ProcessConsentTitle, Mode=OneTime}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsBulkBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBulkBusy, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="WinoEnableAllProcessConsentButton"
                    Click="EnableAllProcessConsentButton_Click"
                    Content="{x:Bind domain:Translator.WinoAccount_EnableAll, Mode=OneTime}"
                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsBulkBusy), Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="WinoDisableAllProcessConsentButton"
                    Click="DisableAllProcessConsentButton_Click"
                    Content="{x:Bind domain:Translator.WinoAccount_DisableAll, Mode=OneTime}"
                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsBulkBusy), Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_MailboxColumn, Mode=OneTime}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_ProviderColumn, Mode=OneTime}" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_ProcessConsentColumn, Mode=OneTime}" />
                </Grid>
                <ListView
                    Grid.Row="1"
                    AutomationProperties.AutomationId="WinoProcessConsentMailboxList"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Mailboxes, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModelData:WinoConsentMailboxItemViewModel">
                            <Grid Padding="12,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Address}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="{x:Bind HasError, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ProviderName}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        Width="18"
                                        Height="18"
                                        IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                        Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                    <CheckBox
                                        AutomationProperties.AutomationId="{x:Bind AutomationId}"
                                        Click="ProcessConsentCheckBox_Click"
                                        Content="{x:Bind domain:Translator.WinoAccount_Allowed, Mode=OneTime}"
                                        IsChecked="{x:Bind IsProcessConsentGranted, Mode=OneWay}"
                                        IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(IsBusy), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <ContentDialog
            x:Name="ConsentPolicyDialog"
            AutomationProperties.AutomationId="WinoConsentPolicyDialog"
            CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
            DefaultButton="Primary"
            PrimaryButtonClick="ConsentPolicyDialog_PrimaryButtonClick"
            PrimaryButtonText="{x:Bind domain:Translator.Intelligence_AcceptPrivacyPolicyButton, Mode=OneTime}">
            <Grid Width="720" Height="560" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ConsentPolicyNotice" TextWrapping="WrapWholeWords" />
                <WebView2 x:Name="ConsentPolicyWebView" Grid.Row="1" AutomationProperties.AutomationId="WinoConsentPolicyWebView" />
                <CheckBox
                    x:Name="ConsentPolicyAcknowledgementCheckBox"
                    Grid.Row="2"
                    AutomationProperties.AutomationId="WinoConsentPolicyAcknowledgementCheckBox"
                    Checked="ConsentPolicyAcknowledgementCheckBox_Changed"
                    Content="{x:Bind domain:Translator.Intelligence_PrivacyPolicyAcknowledgement, Mode=OneTime}"
                    Unchecked="ConsentPolicyAcknowledgementCheckBox_Changed" />
                <TextBlock
                    x:Name="ConsentPolicyErrorText"
                    Grid.Row="3"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />
            </Grid>
        </ContentDialog>

        <ContentDialog
            x:Name="ConsentRevokeDialog"
            AutomationProperties.AutomationId="WinoConsentRevokeDialog"
            CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
            DefaultButton="Primary"
            PrimaryButtonText="{x:Bind domain:Translator.WinoAccount_DisableConsent, Mode=OneTime}">
            <TextBlock x:Name="ConsentRevokeMessage" TextWrapping="WrapWholeWords" />
        </ContentDialog>
    </Grid>
</abstract:WinoAccountConsentPageAbstract>
