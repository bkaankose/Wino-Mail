<abstract:WinoIntelligencePageAbstract
    x:Class="Wino.Views.Settings.WinoIntelligencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:illustrations="using:Wino.Controls.Illustrations"
    xmlns:intelligence="using:Wino.Core.Domain.Models.Intelligence"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Wino.Core.Domain.Models.Ai"
    x:Name="Root"
    Title="{x:Bind domain:Translator.WinoIntelligence_SettingsTitle, Mode=OneTime}"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="IntelligencePerkTemplate" x:DataType="intelligence:IntelligencePerk">
            <controls:SettingsCard Description="{x:Bind Description}" Header="{x:Bind Title}">
                <controls:SettingsCard.HeaderIcon>
                    <coreControls:WinoFontIcon Icon="{x:Bind Icon}" />
                </controls:SettingsCard.HeaderIcon>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind TrailingText}"
                    TextAlignment="Right" />
            </controls:SettingsCard>
        </DataTemplate>

        <DataTemplate x:Key="IntelligenceUsageItemTemplate" x:DataType="intelligence:IntelligenceUsageItem">
            <controls:SettingsCard Header="{x:Bind DisplayName}">
                <StackPanel Width="200" Spacing="6">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Value}" />
                    <ProgressBar
                        AutomationProperties.AutomationId="{x:Bind Bucket}"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        Maximum="100"
                        ShowError="{x:Bind IsExhausted}"
                        Value="{x:Bind Percentage}" />
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>

        <Style x:Key="IntelligenceBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="1000"
                Padding="0,16,24,40"
                HorizontalAlignment="Stretch"
                Spacing="4">
                <StackPanel
                    Margin="0,0,0,8"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoIntelligence_Updating, Mode=OneTime}" />
                </StackPanel>
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligencePurchaseStatus"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasPurchaseStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.PurchaseStatusMessage, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.HasPurchaseStatus, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="WinoIntelligencePurchaseStatusRefreshButton"
                            Command="{x:Bind ViewModel.RefreshPurchasesCommand}"
                            Content="{x:Bind domain:Translator.WinoAccount_Management_RefreshPurchases, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligenceCachedRefreshInfoBar"
                    IsClosable="True"
                    IsOpen="{x:Bind ViewModel.HasIntelligenceRefreshError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.IntelligenceRefreshError, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.HasIntelligenceRefreshError, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="WinoIntelligenceRetryCachedRefreshButton"
                            Command="{x:Bind ViewModel.RetryIntelligenceRefreshCommand}"
                            Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligenceSubscriptionEndedInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsAiPackEnded, Mode=OneWay}"
                    Message="{x:Bind ViewModel.SubscriptionEndedText, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind helpers:XamlHelpers.TextToVisibility(ViewModel.SubscriptionEndedText), Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligenceConsentErrorInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasConsentError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ConsentErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.HasConsentError, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligenceConsentDeletionPendingInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsConsentDeletionPending, Mode=OneWay}"
                    Message="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentDeletionPending, Mode=OneTime}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.IsConsentDeletionPending, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.AutomationId="WinoIntelligenceConsentDeletionFailedInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsConsentDeletionFailed, Mode=OneWay}"
                    Message="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentDeletionFailed, Mode=OneTime}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.IsConsentDeletionFailed, Mode=OneWay}" />

                <!--  Without access the page explains the subscription; the hero holds the one primary action.  -->
                <StackPanel
                    x:Name="OfferPanel"
                    x:Load="{x:Bind ViewModel.HasNoIntelligenceAccess, Mode=OneWay}"
                    Spacing="4">
                    <Border
                        Padding="24,20"
                        AutomationProperties.AutomationId="WinoIntelligenceHero"
                        Background="{ThemeResource WinoIntelligenceBrandSurfaceBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <illustrations:WinoIntelligencePromotionIllustration
                                Width="96"
                                Height="96"
                                VerticalAlignment="Center" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.WinoIntelligence_Hero_Title, Mode=OneTime}" />
                                <TextBlock
                                    MaxWidth="640"
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind domain:Translator.WinoIntelligence_Hero_Description, Mode=OneTime}"
                                    TextWrapping="WrapWholeWords" />
                                <StackPanel
                                    x:Name="SignedOutHeroActions"
                                    Margin="0,12,0,0"
                                    x:Load="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="WinoIntelligenceSignInButton"
                                        Command="{x:Bind ViewModel.GetWinoIntelligenceCommand}"
                                        Content="{x:Bind domain:Translator.WinoIntelligence_GetButton, Mode=OneTime}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        AutomationProperties.AutomationId="WinoIntelligenceCreateAccountButton"
                                        Command="{x:Bind ViewModel.RegisterCommand}"
                                        Content="{x:Bind domain:Translator.Buttons_CreateAccount, Mode=OneTime}" />
                                </StackPanel>
                                <!--  Stripe Checkout states the price in the customer's own currency; the app does not repeat it.  -->
                                <StackPanel
                                    x:Name="SignedInHeroActions"
                                    Margin="0,12,0,0"
                                    x:Load="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="WinoIntelligenceSubscribeButton"
                                        Command="{x:Bind ViewModel.PurchaseAddOnCommand}"
                                        CommandParameter="{x:Bind ViewModel.AiPackAddOn}"
                                        Content="{x:Bind ViewModel.HeroSubscribeButtonText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <HyperlinkButton
                                        AutomationProperties.AutomationId="WinoIntelligenceLearnMoreButton"
                                        Content="{x:Bind domain:Translator.Buttons_LearnMore, Mode=OneTime}"
                                        NavigateUri="https://www.winomail.app/intelligence" />
                                </StackPanel>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.AiPackAddOn.ErrorText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind ViewModel.AiPackAddOn.ShowErrorState, Mode=OneWay}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ViewModel.IntelligenceHeroTermsText, Mode=OneWay}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:SettingsExpander
                        AutomationProperties.AutomationId="WinoIntelligenceIncludedExpander"
                        Description="{x:Bind domain:Translator.WinoIntelligence_Included_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_Included_Title, Mode=OneTime}"
                        IsExpanded="True"
                        ItemTemplate="{StaticResource IntelligencePerkTemplate}"
                        ItemsSource="{x:Bind ViewModel.OfferPerks}">
                        <controls:SettingsExpander.HeaderIcon>
                            <coreControls:WinoFontIcon Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" Icon="WinoIntelligence" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.ItemsHeader>
                            <controls:SettingsCard
                                AutomationProperties.AutomationId="WinoIntelligenceAssistantPerkCard"
                                AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Perk_Voice_Title, Mode=OneTime}"
                                Background="{ThemeResource WinoIntelligenceBrandSurfaceBrush}"
                                CornerRadius="0">
                                <controls:SettingsCard.Resources>
                                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">40</x:Double>
                                </controls:SettingsCard.Resources>
                                <controls:SettingsCard.HeaderIcon>
                                    <ImageIcon Source="ms-appx:///Assets/StoreLogo.png" />
                                </controls:SettingsCard.HeaderIcon>
                                <controls:SettingsCard.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoIntelligence_Perk_Voice_Title, Mode=OneTime}" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Style="{StaticResource IntelligenceBadgeStyle}">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoIntelligence_NewBadge, Mode=OneTime}" />
                                        </Border>
                                    </StackPanel>
                                </controls:SettingsCard.Header>
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind domain:Translator.WinoIntelligence_Perk_Voice_Description, Mode=OneTime}" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{x:Bind domain:Translator.WinoIntelligence_Perk_Voice_Allowance, Mode=OneTime}" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                                <Button AutomationProperties.AutomationId="WinoIntelligenceSeeItInActionButton" Command="{x:Bind ViewModel.SeeAssistantInActionCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <coreControls:WinoFontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}"
                                            Icon="Play" />
                                        <TextBlock Text="{x:Bind domain:Translator.WinoIntelligence_SeeItInAction, Mode=OneTime}" />
                                    </StackPanel>
                                </Button>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.ItemsHeader>
                    </controls:SettingsExpander>

                    <TextBlock
                        Margin="1,20,0,4"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoIntelligence_Locked_Caption, Mode=OneTime}" />
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="WinoIntelligenceLockedMailClassificationCard"
                        Description="{x:Bind domain:Translator.WinoIntelligence_MailClassification_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_MailClassification_Title, Mode=OneTime}"
                        IsEnabled="False">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="Mail" />
                        </controls:SettingsCard.HeaderIcon>
                        <coreControls:WinoFontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorDisabledBrush}"
                            Icon="LockClosed" />
                    </controls:SettingsCard>
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="WinoIntelligenceLockedLanguagesCard"
                        Description="{x:Bind domain:Translator.WinoIntelligence_Languages_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_Languages_Title, Mode=OneTime}"
                        IsEnabled="False">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="Translate" />
                        </controls:SettingsCard.HeaderIcon>
                        <coreControls:WinoFontIcon
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorDisabledBrush}"
                            Icon="LockClosed" />
                    </controls:SettingsCard>
                </StackPanel>

                <StackPanel
                    x:Name="SubscribedPanel"
                    x:Load="{x:Bind ViewModel.HasIntelligenceAccess, Mode=OneWay}"
                    Spacing="4">
                    <controls:SettingsExpander
                        Margin="0,0,0,4"
                        AutomationProperties.AutomationId="WinoIntelligenceStatusExpander"
                        AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_SettingsTitle, Mode=OneTime}"
                        Background="{ThemeResource WinoIntelligenceBrandSurfaceBrush}"
                        ItemTemplate="{StaticResource IntelligenceUsageItemTemplate}"
                        ItemsSource="{x:Bind ViewModel.IntelligenceUsageItems}">
                        <controls:SettingsExpander.Header>
                            <Grid Margin="0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="44"
                                    Height="44"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <coreControls:WinoFontIcon
                                        Width="22"
                                        Height="22"
                                        Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}"
                                        Icon="WinoIntelligence" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.WinoIntelligence_SettingsTitle, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SubscriptionRenewalLine, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </controls:SettingsExpander.Header>
                        <Grid>
                            <Border
                                AutomationProperties.AutomationId="WinoIntelligenceActiveBadge"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                Style="{StaticResource IntelligenceBadgeStyle}"
                                Visibility="{x:Bind ViewModel.IsWithinLimits, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.WinoAccount_Management_ActiveShort, Mode=OneTime}" />
                            </Border>
                            <Border
                                AutomationProperties.AutomationId="WinoIntelligenceLimitReachedBadge"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Style="{StaticResource IntelligenceBadgeStyle}"
                                Visibility="{x:Bind ViewModel.IsLimitReached, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.WinoIntelligence_Status_LimitReached, Mode=OneTime}" />
                            </Border>
                        </Grid>
                        <controls:SettingsExpander.ItemsHeader>
                            <StackPanel>
                                <InfoBar
                                    AutomationProperties.AutomationId="WinoIntelligenceQuotaExhaustedInfoBar"
                                    CornerRadius="0"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.HasExhaustedBuckets, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.ExhaustedBucketsText, Mode=OneWay}"
                                    Severity="Informational"
                                    Visibility="{x:Bind ViewModel.HasExhaustedBuckets, Mode=OneWay}" />
                                <controls:SettingsCard
                                    AutomationProperties.AutomationId="WinoIntelligencePlanActionsCard"
                                    CornerRadius="0"
                                    Header="{x:Bind domain:Translator.WinoAccount_Management_SubscriptionLabel, Mode=OneTime}">
                                    <controls:SettingsCard.HeaderIcon>
                                        <coreControls:WinoFontIcon Icon="Payment" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton
                                            x:Name="ManageSubscriptionButton"
                                            x:Load="{x:Bind ViewModel.CanManageSubscription, Mode=OneWay}"
                                            AutomationProperties.AutomationId="WinoIntelligenceManageSubscriptionButton"
                                            Command="{x:Bind ViewModel.ManageSubscriptionCommand}"
                                            Content="{x:Bind domain:Translator.WinoIntelligence_ManageSubscription, Mode=OneTime}" />
                                        <Button
                                            AutomationProperties.AutomationId="WinoIntelligenceRefreshButton"
                                            Command="{x:Bind ViewModel.RefreshPurchasesCommand}"
                                            Content="{x:Bind domain:Translator.Buttons_Refresh, Mode=OneTime}" />
                                    </StackPanel>
                                </controls:SettingsCard>
                            </StackPanel>
                        </controls:SettingsExpander.ItemsHeader>
                        <controls:SettingsExpander.ItemsFooter>
                            <controls:SettingsCard
                                AutomationProperties.AutomationId="WinoIntelligenceUsageUnavailableCard"
                                CornerRadius="0"
                                Description="{x:Bind domain:Translator.WinoAccount_Management_IntelligenceUsageUnavailable, Mode=OneTime}"
                                Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsIntelligenceUsageAvailable), Mode=OneWay}" />
                        </controls:SettingsExpander.ItemsFooter>
                    </controls:SettingsExpander>

                    <coreControls:WinoSettingsCard
                        x:Name="VoiceCommandsCard"
                        x:Load="{x:Bind ViewModel.ShowVoiceCommandsCard, Mode=OneWay}"
                        AutomationProperties.AutomationId="WinoIntelligenceVoiceCommandsCard"
                        AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_Voice_Title, Mode=OneTime}"
                        Background="{ThemeResource WinoIntelligenceBrandSurfaceBrush}"
                        Command="{x:Bind ViewModel.OpenVoiceControlCommand}"
                        Description="{x:Bind ViewModel.AssistantHomeDescription, Mode=OneWay}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.Resources>
                            <x:Double x:Key="SettingsCardHeaderIconMaxSize">40</x:Double>
                        </controls:SettingsCard.Resources>
                        <controls:SettingsCard.HeaderIcon>
                            <ImageIcon Source="ms-appx:///Assets/StoreLogo.png" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Header>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoIntelligence_Voice_Title, Mode=OneTime}" />
                        </controls:SettingsCard.Header>
                    </coreControls:WinoSettingsCard>

                    <coreControls:WinoSettingsCard
                        AutomationProperties.AutomationId="WinoIntelligenceDailyBriefingCard"
                        Command="{x:Bind ViewModel.OpenDailyBriefingSettingsCommand}"
                        Description="{x:Bind ViewModel.BriefingHomeDescription, Mode=OneWay}"
                        Header="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="DailyBriefing" />
                        </controls:SettingsCard.HeaderIcon>
                    </coreControls:WinoSettingsCard>

                    <coreControls:WinoSettingsCard
                        AutomationProperties.AutomationId="WinoIntelligenceMailClassificationCard"
                        Command="{x:Bind ViewModel.OpenMailClassificationCommand}"
                        Description="{x:Bind ViewModel.MailClassificationHomeDescription, Mode=OneWay}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_MailClassification_Title, Mode=OneTime}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="Tag" />
                        </controls:SettingsCard.HeaderIcon>
                    </coreControls:WinoSettingsCard>

                    <controls:SettingsExpander
                        AutomationProperties.AutomationId="WinoIntelligenceLanguagesExpander"
                        Description="{x:Bind domain:Translator.WinoIntelligence_Languages_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_Languages_Title, Mode=OneTime}">
                        <controls:SettingsExpander.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="Translate" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                AutomationProperties.AutomationId="WinoIntelligenceAiTranslationLanguageCard"
                                Description="{x:Bind domain:Translator.SettingsAppPreferences_AiDefaultTranslationLanguage_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.SettingsAppPreferences_AiDefaultTranslationLanguage_Title, Mode=OneTime}">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.AutomationId="WinoIntelligenceAiTranslationLanguageComboBox"
                                    AutomationProperties.Name="{x:Bind domain:Translator.SettingsAppPreferences_AiDefaultTranslationLanguage_Title, Mode=OneTime}"
                                    ItemsSource="{x:Bind ViewModel.AvailableAiLanguages}"
                                    SelectedItem="{x:Bind ViewModel.SelectedDefaultTranslationLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AiTranslateLanguageOption">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="WinoIntelligenceAiSummarizeLanguageCard"
                                Description="{x:Bind domain:Translator.SettingsAppPreferences_AiSummarizeLanguage_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.SettingsAppPreferences_AiSummarizeLanguage_Title, Mode=OneTime}">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.AutomationId="WinoIntelligenceAiSummarizeLanguageComboBox"
                                    AutomationProperties.Name="{x:Bind domain:Translator.SettingsAppPreferences_AiSummarizeLanguage_Title, Mode=OneTime}"
                                    ItemsSource="{x:Bind ViewModel.AvailableAiLanguages}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSummarizeLanguage, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AiTranslateLanguageOption">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <TextBlock
                        Margin="1,20,0,4"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoIntelligence_DataAndPlan_Header, Mode=OneTime}" />

                    <coreControls:WinoSettingsCard
                        AutomationProperties.AutomationId="WinoIntelligencePrivacyDataCard"
                        Command="{x:Bind ViewModel.OpenPrivacyDataCommand}"
                        Description="{x:Bind domain:Translator.WinoIntelligence_PrivacyData_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_PrivacyData_Title, Mode=OneTime}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon Icon="Shield" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ConsentShortText, Mode=OneWay}" />
                    </coreControls:WinoSettingsCard>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</abstract:WinoIntelligencePageAbstract>
