<abstract:UnreadBadgeSettingsPageAbstract
    x:Class="Wino.Views.Settings.UnreadBadgeSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mailViewModels="using:Wino.Mail.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <controls:SettingsCard
            AutomationProperties.AutomationId="UnreadBadgeSettingsPageTaskbarTotalCard"
            Description="{x:Bind domain:Translator.UnreadBadges_TaskbarTotal_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.UnreadBadges_TaskbarTotal_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA8F;" />
            </controls:SettingsCard.HeaderIcon>
            <TextBlock
                AutomationProperties.AutomationId="UnreadBadgeSettingsPageTaskbarTotalText"
                FontSize="28"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.TaskbarUnreadCount, Mode=OneWay}" />
        </controls:SettingsCard>

        <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind domain:Translator.UnreadBadges_Accounts_Title, Mode=OneTime}" />
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.UnreadBadges_Accounts_Description, Mode=OneTime}"
            TextWrapping="Wrap" />

        <ItemsControl AutomationProperties.AutomationId="UnreadBadgeSettingsPageAccountList" ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="mailViewModels:TaskbarBadgeAccountViewModel">
                    <controls:SettingsCard
                        Margin="0,0,0,4"
                        AutomationProperties.AutomationId="UnreadBadgeSettingsPageSettingsCard"
                        Description="{x:Bind CountSourceDescription}"
                        Header="{x:Bind AccountName}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE77B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind UnreadCount}" />
                            <ToggleSwitch
                                AutomationProperties.AutomationId="UnreadBadgeAccountContributionToggle"
                                AutomationProperties.Name="{x:Bind domain:Translator.UnreadBadges_Account_Contribute, Mode=OneTime}"
                                IsOn="{x:Bind ContributesToTaskbar, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <Button
                                AutomationProperties.AutomationId="UnreadBadgeAccountConfigureButton"
                                Command="{Binding ElementName=PageRoot, Path=ViewModel.ConfigureAccountCommand}"
                                CommandParameter="{x:Bind}"
                                Content="{x:Bind domain:Translator.UnreadBadges_Account_Configure, Mode=OneTime}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind domain:Translator.UnreadBadges_LaunchBehaviour_Title, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="UnreadBadgeSettingsPageLaunchCard"
            Description="{x:Bind domain:Translator.UnreadBadges_Launch_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.UnreadBadges_Launch_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch AutomationProperties.AutomationId="UnreadBadgeSettingsPageLaunchToggle" IsOn="{x:Bind ViewModel.IsLaunchNavigationEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:UnreadBadgeSettingsPageAbstract>
