                                                Canvas.Top="75"
                                                Width="68"
                                                Height="6"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.28"
                                                RadiusX="3"
                                                RadiusY="3" />
                                            <Rectangle
                                                Canvas.Left="156"
                                                Canvas.Top="89"
                                                Width="46"
                                                Height="6"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.28"
                                                RadiusX="3"
                                                RadiusY="3" />
                                            <Rectangle
                                                Canvas.Left="156"
                                                Canvas.Top="107"
                                                Width="34"
                                                Height="14"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.8"
                                                RadiusX="7"
                                                RadiusY="7" />

                                            <Path
                                                Data="M96,62 C112,40 128,40 144,62"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeDashArray="1,3"
                                                StrokeThickness="2" />
                                            <Path
                                                Data="M138,56 L145,62 L138,68"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="2" />
                                            <Ellipse
                                                Canvas.Left="101"
                                                Canvas.Top="81"
                                                Width="38"
                                                Height="38"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Path
                                                Data="M112,100 L118,106 L128,94"
                                                Stroke="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="2.4" />
                                        </Canvas>
                                    </Viewbox>

                                    <!--  Add-ons follow you: one entitlement covering several machines.  -->
                                    <Viewbox
                                        x:Name="EntitlementsIllustration"
                                        x:Load="{x:Bind ViewModel.IsEntitlementsBenefitSelected, Mode=OneWay}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="Uniform">
                                        <Canvas Width="240" Height="170">
                                            <Path
                                                Data="M43,92 V72 H120 V56 M120,72 H197 V92"
