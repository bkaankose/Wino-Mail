                                                RadiusX="9"
                                                RadiusY="9"
                                                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                StrokeThickness="1.5" />
                                            <Rectangle
                                                Canvas.Left="16"
                                                Canvas.Top="46"
                                                Width="52"
                                                Height="7"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.5"
                                                RadiusX="3.5"
