                                                RadiusY="10"
                                                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                StrokeThickness="1.5" />
                                            <Rectangle
                                                Canvas.Left="50"
                                                Canvas.Top="42"
                                                Width="66"
                                                Height="8"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.45"
                                                RadiusX="4"
                                                RadiusY="4" />
                                            <Rectangle
                                                Canvas.Left="50"
                                                Canvas.Top="62"
                                                Width="140"
                                                Height="7"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.25"
                                                RadiusX="3.5"
                                                RadiusY="3.5" />
                                            <Rectangle
                                                Canvas.Left="50"
                                                Canvas.Top="78"
                                                Width="140"
                                                Height="7"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.25"
                                                RadiusX="3.5"
                                                RadiusY="3.5" />
                                            <Rectangle
                                                Canvas.Left="50"
                                                Canvas.Top="94"
                                                Width="96"
                                                Height="7"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.25"
                                                RadiusX="3.5"
                                                RadiusY="3.5" />
                                            <Rectangle
                                                Canvas.Left="44"
                                                Canvas.Top="112"
                                                Width="152"
                                                Height="26"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.15"
                                                RadiusX="7"
                                                RadiusY="7" />
                                            <Rectangle
                                                Canvas.Left="56"
                                                Canvas.Top="121"
                                                Width="104"
                                                Height="8"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.7"
                                                RadiusX="4"
                                                RadiusY="4" />
                                            <Path
                                                Data="M183.3,16 L188.5,32 L204.5,37.2 L188.5,42.4 L183.3,58.4 L178.1,42.4 L162.1,37.2 L178.1,32 Z"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Path
                                                Data="M206.9,44 L209.6,52 L217.6,54.7 L209.6,57.4 L206.9,65.4 L204.2,57.4 L196.2,54.7 L204.2,52 Z"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.65" />
                                        </Canvas>
                                    </Viewbox>

                                    <!--  Unlimited Accounts: the mailbox list that stops running out.  -->
                                    <Viewbox
                                        x:Name="UnlimitedAccountsIllustration"
                                        x:Load="{x:Bind ViewModel.IsUnlimitedAccountsBenefitSelected, Mode=OneWay}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="Uniform">
                                        <Canvas Width="240" Height="170">
                                            <Rectangle
                                                Canvas.Left="26"
                                                Canvas.Top="30"
                                                Width="128"
                                                Height="34"
                                                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
