                                                Width="58"
                                                Height="48"
                                                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                RadiusX="7"
                                                RadiusY="7"
                                                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                StrokeThickness="1.5" />

                                            <Path
                                                Data="M120,22 L152,36 V56 C152,73 139.2,86.4 120,94 C100.8,86.4 88,73 88,56 V36 Z"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.16"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="1.8" />
                                            <Path
                                                Data="M108,55.5 L116,63.5 L133,46.5"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="2.6" />

                                            <Path
                                                Data="M35,112 L40,117 L50,107 M112,112 L117,117 L127,107 M189,112 L194,117 L204,107"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeLineJoin="Round"
                                                StrokeThickness="2" />
                                        </Canvas>
                                    </Viewbox>

                                    <!--  Wino Intelligence: a message the AI has already worked on.  -->
                                    <Viewbox
                                        x:Name="IntelligenceIllustration"
                                        x:Load="{x:Bind ViewModel.IsIntelligenceBenefitSelected, Mode=OneWay}"
                                        AutomationProperties.AccessibilityView="Raw"
                                        Stretch="Uniform">
                                        <Canvas Width="240" Height="170">
                                            <Rectangle
                                                Canvas.Left="34"
                                                Canvas.Top="22"
                                                Width="172"
                                                Height="126"
                                                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
