                                            <Ellipse
                                                Canvas.Left="50"
                                                Canvas.Top="79"
                                                Width="20"
                                                Height="20"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.4" />
                                            <Rectangle
                                                Canvas.Left="78"
