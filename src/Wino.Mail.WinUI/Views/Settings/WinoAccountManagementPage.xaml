<abstract:WinoAccountManagementPageAbstract
    x:Class="Wino.Views.Settings.WinoAccountManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelData="using:Wino.Core.ViewModels.Data"
    x:Name="Root"
    Title="{x:Bind domain:Translator.WinoAccount_SettingsSection_Title, Mode=OneTime}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Non-Intelligence product mark. Intelligence branding comes from the shared dictionary.  -->
        <LinearGradientBrush x:Key="UnlimitedAccountsMarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FBBF24" />
            <GradientStop Offset="1" Color="#D97706" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WinoIntelligencePromoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#062A65" />
            <GradientStop Offset="0.4" Color="#075FCC" />
            <GradientStop Offset="0.75" Color="#168FEA" />
            <GradientStop Offset="1" Color="#71CBFF" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PromoForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PromoSecondaryForegroundBrush" Color="#DCD8F5" />
        <SolidColorBrush x:Key="PromoChipBackgroundBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PromoChipBorderBrush" Color="#40FFFFFF" />

        <x:String x:Key="BenefitCheckPathData">M4.4,10.6 L8.2,14.4 L15.6,7 L14.2,5.6 L8.2,11.6 L5.8,9.2 Z</x:String>

        <!--
            One offer in the signed-out grid. Every glyph is filled path data on the same
            20x20 grid, rendered at one size in one container, which is what makes the four
            tile icons read as a set.
        -->
        <DataTemplate x:Key="BenefitTileTemplate" x:DataType="viewModelData:WinoAccountBenefitItemViewModel">
            <ItemContainer
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.HelpText="{x:Bind Caption}"
                AutomationProperties.Name="{x:Bind Title}">
                <Grid Padding="16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="36"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <PathIcon
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{x:Bind helpers:XamlHelpers.GetGeometryFromPathMarkup(GlyphPathData)}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            UseLayoutRounding="True">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />

                            <!--  Free and paid badges differ only in tint, and a brush cannot be picked by binding.  -->
                            <Border
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{x:Bind IsFreeBadge}">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind BadgeText}" />
                            </Border>
                            <Border
                                Padding="8,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsFreeBadge)}">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind BadgeText}" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Caption}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </ItemContainer>
        </DataTemplate>

        <!--  One line of what the selected offer includes.  -->
        <DataTemplate x:Key="BenefitPointTemplate" x:DataType="x:String">
            <Grid Margin="0,0,0,9" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <PathIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Top"
                    Data="{StaticResource BenefitCheckPathData}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>

        <!--  One indexed mailbox held on Wino's servers.  -->
        <DataTemplate x:Key="IntelligenceMailboxTemplate" x:DataType="viewModelData:WinoIntelligenceMailboxItemViewModel">
            <controls:SettingsCard
                AutomationProperties.AutomationId="{x:Bind ManageAutomationId}"
                Command="{x:Bind ManageCommand}"
                CommandParameter="{x:Bind}"
                Description="{x:Bind IntelligenceSummary}"
                Header="{x:Bind Address}"
                IsActionIconVisible="{x:Bind CanManage, Mode=OneWay}"
                IsClickEnabled="{x:Bind CanManage, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ManageUnavailableTooltip}">
                <controls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">28</x:Double>
                </controls:SettingsCard.Resources>
                <controls:SettingsCard.HeaderIcon>
                    <accountIcon:WinoAccountIcon
                        VerticalAlignment="Center"
                        Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account, ProviderType, SpecialProvider)}"
                        IconSize="28" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind IsDeleting, Mode=OneWay}"
                        Visibility="{x:Bind IsDeleting, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}"
                        Command="{x:Bind DeleteCommand}"
                        CommandParameter="{x:Bind}"
                        Content="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}"
                        Visibility="{x:Bind HasServerIntelligence, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="1000"
                Padding="0,16,24,40"
                HorizontalAlignment="Stretch"
                Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoIntelligence_Updating, Mode=OneTime}" />
                </StackPanel>
                <InfoBar AutomationProperties.AutomationId="WinoAccountCachedRefreshInfoBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasIntelligenceRefreshError, Mode=OneWay}" Message="{x:Bind ViewModel.IntelligenceRefreshError, Mode=OneWay}" Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button AutomationProperties.AutomationId="WinoAccountRetryCachedRefreshButton" Command="{x:Bind ViewModel.RetryIntelligenceRefreshCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  ═══════════════  SIGNED OUT  ═══════════════  -->
                <StackPanel
                    x:Name="SignedOutPanel"
                    HorizontalAlignment="Stretch"
                    x:Load="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}"
                    Spacing="4">

                    <Border
                        Padding="24,40,24,32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <!--  The product mark stands on its own. Direct2D drops the SVG's drop shadows, which is expected.  -->
                            <Image
                                Width="96"
                                Height="96"
                                HorizontalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Source="ms-appx:///Assets/AppEntries/Mail.svg"
                                Stretch="Uniform" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind domain:Translator.WinoAccount_Management_SignedOutTitle, Mode=OneTime}" />
                            <TextBlock
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind domain:Translator.WinoAccount_Management_SignedOutDescription, Mode=OneTime}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    AutomationProperties.AutomationId="WinoAccountSignInButton"
                                    Command="{x:Bind ViewModel.SignInCommand}"
                                    Content="{x:Bind domain:Translator.Buttons_SignIn, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.AutomationId="WinoAccountRegisterButton"
                                    Command="{x:Bind ViewModel.RegisterCommand}"
                                    Content="{x:Bind domain:Translator.Buttons_CreateAccount, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,22,0,4"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitsSectionHeader, Mode=OneTime}" />

                    <!--  The offers. Selecting one loads its detail panel underneath.  -->
                    <ItemsView
                        x:Name="BenefitsItemsView"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="WinoAccountBenefitsItemsView"
                        AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_Management_BenefitsSectionHeader, Mode=OneTime}"
                        ItemTemplate="{StaticResource BenefitTileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Benefits, Mode=OneWay}"
                        Loaded="BenefitsItemsViewLoaded"
                        SelectionChanged="BenefitSelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="2"
                                MinColumnSpacing="4"
                                MinItemWidth="240"
                                MinRowSpacing="4"
                                Orientation="Horizontal" />
                        </ItemsView.Layout>
                    </ItemsView>

                    <!--  Detail for the selected offer.  -->
