<abstract:WinoAccountManagementPageAbstract
    x:Class="Wino.Views.Settings.WinoAccountManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModelData="using:Wino.Core.ViewModels.Data"
    x:Name="Root"
    Title="{x:Bind domain:Translator.WinoAccount_SettingsSection_Title, Mode=OneTime}"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Non-Intelligence product mark. Intelligence branding comes from the shared dictionary.  -->
        <LinearGradientBrush x:Key="UnlimitedAccountsMarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FBBF24" />
            <GradientStop Offset="1" Color="#D97706" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WinoIntelligencePromoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#062A65" />
            <GradientStop Offset="0.4" Color="#075FCC" />
            <GradientStop Offset="0.75" Color="#168FEA" />
            <GradientStop Offset="1" Color="#71CBFF" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PromoForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PromoSecondaryForegroundBrush" Color="#DCD8F5" />
        <SolidColorBrush x:Key="PromoChipBackgroundBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PromoChipBorderBrush" Color="#40FFFFFF" />

        <!--  One indexed mailbox held on Wino's servers.  -->
        <DataTemplate x:Key="IntelligenceMailboxTemplate" x:DataType="viewModelData:WinoIntelligenceMailboxItemViewModel">
            <controls:SettingsCard
                AutomationProperties.AutomationId="{x:Bind ManageAutomationId}"
                Command="{x:Bind ManageCommand}"
                CommandParameter="{x:Bind}"
                Description="{x:Bind IntelligenceSummary}"
                Header="{x:Bind Address}"
                IsActionIconVisible="{x:Bind CanManage, Mode=OneWay}"
                IsClickEnabled="{x:Bind CanManage, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ManageUnavailableTooltip}">
                <controls:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardHeaderIconMaxSize">28</x:Double>
                </controls:SettingsCard.Resources>
                <controls:SettingsCard.HeaderIcon>
                    <accountIcon:WinoAccountIcon
                        VerticalAlignment="Center"
                        Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account, ProviderType, SpecialProvider)}"
                        IconSize="28" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind IsDeleting, Mode=OneWay}"
                        Visibility="{x:Bind IsDeleting, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}"
                        Command="{x:Bind DeleteCommand}"
                        CommandParameter="{x:Bind}"
                        Content="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}"
                        Visibility="{x:Bind HasServerIntelligence, Mode=OneWay}" />
                </StackPanel>
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                MaxWidth="1000"
                Padding="0,16,24,40"
                HorizontalAlignment="Stretch"
                Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsIntelligenceRefreshing, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoIntelligence_Updating, Mode=OneTime}" />
                </StackPanel>
                <InfoBar AutomationProperties.AutomationId="WinoAccountCachedRefreshInfoBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasIntelligenceRefreshError, Mode=OneWay}" Message="{x:Bind ViewModel.IntelligenceRefreshError, Mode=OneWay}" Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button AutomationProperties.AutomationId="WinoAccountRetryCachedRefreshButton" Command="{x:Bind ViewModel.RetryIntelligenceRefreshCommand}" Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--  ═══════════════  SIGNED OUT  ═══════════════  -->
                <StackPanel
                    x:Name="SignedOutPanel"
                    HorizontalAlignment="Stretch"
                    x:Load="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}"
                    Spacing="4">

                    <Border
                        Padding="24,40,24,32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="14">
                            <Border
                                Width="76"
                                Height="76"
                                HorizontalAlignment="Center"
                                Background="{StaticResource WinoIntelligencePromoBrush}"
                                CornerRadius="20">
                                <Image
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="ms-appx:///Assets/WinoLogo.png"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind domain:Translator.WinoAccount_Management_SignedOutTitle, Mode=OneTime}" />
                            <TextBlock
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind domain:Translator.WinoAccount_Management_SignedOutDescription, Mode=OneTime}"
                                TextAlignment="Center"
                                TextWrapping="WrapWholeWords" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    AutomationProperties.AutomationId="WinoAccountSignInButton"
                                    Command="{x:Bind ViewModel.SignInCommand}"
                                    Content="{x:Bind domain:Translator.Buttons_SignIn, Mode=OneTime}"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    AutomationProperties.AutomationId="WinoAccountRegisterButton"
                                    Command="{x:Bind ViewModel.RegisterCommand}"
                                    Content="{x:Bind domain:Translator.Buttons_CreateAccount, Mode=OneTime}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Margin="0,22,0,4"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitsSectionHeader, Mode=OneTime}" />

                    <Grid ColumnSpacing="4" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Preference sync  -->
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="22"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitSyncTitle, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitSyncDescription, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Mail account transfer  -->
                        <Border
                            Grid.Column="1"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Top"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="22"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Glyph="&#xE715;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitAccountsTitle, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitAccountsDescription, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Wino Intelligence  -->
                        <Border
                            Grid.Row="1"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PathIcon
                                    VerticalAlignment="Top"
                                    Data="M 8.5,1.5 L 10.2,6.8 L 15.5,8.5 L 10.2,10.2 L 8.5,15.5 L 6.8,10.2 L 1.5,8.5 L 6.8,6.8 Z M 15.5,10.5 L 16.6,13.9 L 20,15 L 16.6,16.1 L 15.5,19.5 L 14.4,16.1 L 11,15 L 14.4,13.9 Z"
                                    Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        ToolTipService.ToolTip="{x:Bind domain:Translator.WinoAccount_Management_AddOnBadge, Mode=OneTime}">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAddOn_AI_PACK_Name, Mode=OneTime}" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoAccount_Management_AddOnBadge, Mode=OneTime}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.WinoAccount_Management_BenefitIntelligenceDescription, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Unlimited Accounts  -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PathIcon
                                    VerticalAlignment="Top"
                                    Data="M 4.5,6.5 A 3,3 0 1,1 10.5,6.5 A 3,3 0 1,1 4.5,6.5 Z M 2,16.5 C 2.4,13.7 4.6,12 7.5,12 C 10.4,12 12.6,13.7 13,16.5 Z M 12.5,7.8 A 2.3,2.3 0 1,1 17.1,7.8 A 2.3,2.3 0 1,1 12.5,7.8 Z M 11.8,16.5 C 12,14.2 13.3,12.9 15,12.9 C 16.7,12.9 17.9,14 18.3,16.5 Z"
                                    Foreground="{StaticResource UnlimitedAccountsMarkBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAddOn_UNLIMITED_ACCOUNTS_Name, Mode=OneTime}" />
                                        <Border
                                            Padding="8,1"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoAccount_Management_AddOnBadge, Mode=OneTime}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.UnlimitedAccountsBenefitDescription, Mode=OneWay}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!--  ═══════════════  SIGNED IN  ═══════════════  -->
                <StackPanel
                    x:Name="SignedInPanel"
                    x:Load="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                    Spacing="4">

                    <!--  Account header  -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PersonPicture
                                Width="64"
                                Height="64"
                                VerticalAlignment="Center"
                                Background="{StaticResource WinoIntelligencePromoBrush}"
                                DisplayName="{x:Bind ViewModel.AccountEmail, Mode=OneWay}" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.AccountEmail, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.WinoAccount_Management_HeroSubtitle, Mode=OneTime}" />
                                <StackPanel
                                    Margin="0,8,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="WinoAccountChangePasswordButton"
                                        Command="{x:Bind ViewModel.ChangePasswordCommand}"
                                        Content="{x:Bind domain:Translator.WinoAccount_ChangePassword_Title, Mode=OneTime}" />
                                    <Button
                                        AutomationProperties.AutomationId="WinoAccountSignOutButton"
                                        Command="{x:Bind ViewModel.SignOutCommand}"
                                        Content="{x:Bind domain:Translator.WinoAccount_Management_SignOutTitle, Mode=OneTime}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon
                                        VerticalAlignment="Center"
                                        Data="M 8.5,1.5 L 10.2,6.8 L 15.5,8.5 L 10.2,10.2 L 8.5,15.5 L 6.8,10.2 L 1.5,8.5 L 6.8,6.8 Z M 15.5,10.5 L 16.6,13.9 L 20,15 L 16.6,16.1 L 15.5,19.5 L 14.4,16.1 L 11,15 L 14.4,13.9 Z"
                                        Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAddOn_AI_PACK_Name, Mode=OneTime}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.IntelligenceStatusShortText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="18"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE715;" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_Management_StatMailAccounts, Mode=OneTime}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.AccountUsageText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressRing
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  ─── Wino add-ons ───  -->
                    <Grid Margin="0,22,0,4">
                        <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{x:Bind domain:Translator.WinoAccount_Management_AddOnsSectionHeader, Mode=OneTime}" />
                        <HyperlinkButton
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="WinoAccountManagementRefreshPurchasesButton"
                            Command="{x:Bind ViewModel.RefreshPurchasesCommand}"
                            Content="{x:Bind domain:Translator.WinoAccount_Management_RefreshPurchases, Mode=OneTime}" />
                    </Grid>

                    <!--  Wino Intelligence product card  -->
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="WinoAccountOpenIntelligenceCard"
                        Command="{x:Bind ViewModel.OpenIntelligenceManagementCommand}"
                        Description="{x:Bind ViewModel.AiPackSubtitleText, Mode=OneWay}"
                        Header="{x:Bind domain:Translator.WinoIntelligence_SettingsTitle, Mode=OneTime}"
                        IsClickEnabled="True">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="{StaticResource WinoIntelligenceBrandSparklePathData}" Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <controls:SettingsExpander
                        AutomationProperties.AutomationId="WinoAccountIntelligenceExpander"
                        Description="{x:Bind ViewModel.AiPackSubtitleText, Mode=OneWay}"
                        Header="{x:Bind domain:Translator.WinoAddOn_AI_PACK_Name, Mode=OneTime}"
                        IsExpanded="False"
                        Visibility="Collapsed">
                        <controls:SettingsExpander.HeaderIcon>
                            <PathIcon Data="{StaticResource WinoIntelligenceBrandSparklePathData}" Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" />
                        </controls:SettingsExpander.HeaderIcon>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                CornerRadius="10"
                                Visibility="{x:Bind ViewModel.AiPackAddOn.IsPurchased, Mode=OneWay}">
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.WinoAccount_Management_ActiveShort, Mode=OneTime}" />
                            </Border>
                            <ProgressRing
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.AiPackAddOn.IsLoading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AiPackAddOn.IsLoading, Mode=OneWay}" />
                        </StackPanel>

                        <controls:SettingsExpander.Items>

                            <!--  Not purchased: what the subscription actually grants  -->
                            <controls:SettingsCard
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoAccountIntelligencePurchaseCard"
                                ContentAlignment="Vertical"
                                Visibility="{x:Bind ViewModel.AiPackAddOn.IsNotPurchased, Mode=OneWay}">
                                <Border
                                    Padding="20"
                                    Background="{StaticResource WinoIntelligencePromoBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    Foreground="{StaticResource PromoForegroundBrush}"
                                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                                    Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackPromoTitle, Mode=OneTime}" />
                                                <TextBlock
                                                    MaxWidth="480"
                                                    HorizontalAlignment="Left"
                                                    Foreground="{StaticResource PromoSecondaryForegroundBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackPromoDescription, Mode=OneTime}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>

                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Border
                                                    Padding="11,5"
                                                    Background="{StaticResource PromoChipBackgroundBrush}"
                                                    BorderBrush="{StaticResource PromoChipBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        Foreground="{StaticResource PromoForegroundBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackFeatureTranslate, Mode=OneTime}" />
                                                </Border>
                                                <Border
                                                    Padding="11,5"
                                                    Background="{StaticResource PromoChipBackgroundBrush}"
                                                    BorderBrush="{StaticResource PromoChipBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        Foreground="{StaticResource PromoForegroundBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackFeatureRewrite, Mode=OneTime}" />
                                                </Border>
                                                <Border
                                                    Padding="11,5"
                                                    Background="{StaticResource PromoChipBackgroundBrush}"
                                                    BorderBrush="{StaticResource PromoChipBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        Foreground="{StaticResource PromoForegroundBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackFeatureSummarize, Mode=OneTime}" />
                                                </Border>
                                                <Border
                                                    Padding="11,5"
                                                    Background="{StaticResource PromoChipBackgroundBrush}"
                                                    BorderBrush="{StaticResource PromoChipBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        Foreground="{StaticResource PromoForegroundBrush}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackFeatureSearch, Mode=OneTime}" />
                                                </Border>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            MinWidth="190"
                                            VerticalAlignment="Center"
                                            Spacing="10">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{StaticResource PromoForegroundBrush}"
                                                Style="{StaticResource TitleTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackPromoPrice, Mode=OneTime}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="WinoAccountAddOnPurchaseButton"
                                                Command="{x:Bind ViewModel.PurchaseAddOnCommand}"
                                                CommandParameter="{x:Bind ViewModel.AiPackAddOn}"
                                                Content="{x:Bind domain:Translator.WinoAccount_Management_AiPackGetButton, Mode=OneTime}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.AiPackAddOn.ErrorText, Mode=OneWay}"
                                                TextAlignment="Right"
                                                TextWrapping="WrapWholeWords"
                                                Visibility="{x:Bind ViewModel.AiPackAddOn.ShowErrorState, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </controls:SettingsCard>

                            <!--  Purchased: billing facts and current usage  -->
                            <controls:SettingsCard
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoAccountIntelligenceUsageCard"
                                ContentAlignment="Vertical"
                                Visibility="{x:Bind ViewModel.AiPackAddOn.IsPurchased, Mode=OneWay}">
                                <StackPanel Spacing="20">
                                    <Grid ColumnSpacing="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoAccount_Management_RecurringBilling, Mode=OneTime}" />
                                            <TextBlock Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackPromoPrice, Mode=OneTime}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackBillingPeriodLabel, Mode=OneTime}" />
                                            <TextBlock Text="{x:Bind ViewModel.AiPackBillingPeriodText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        </StackPanel>

                                    </Grid>

                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="{x:Bind domain:Translator.WinoAccount_Management_AiPackRequestsUsed, Mode=OneTime}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.IntelligenceUsageSummary, Mode=OneWay}" />
                                        </Grid>
                                        <ProgressBar
                                            AutomationProperties.AutomationId="WinoAccountIntelligenceUsageProgressBar"
                                            Maximum="100"
                                            Visibility="{x:Bind ViewModel.IsIntelligenceUsageAvailable, Mode=OneWay}"
                                            Value="{x:Bind ViewModel.IntelligenceUsagePercentage, Mode=OneWay}" />
                                        <Grid>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.AiPackRenewalOrCancellationText, Mode=OneWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind ViewModel.IntelligenceResetText, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard>

                            <!--  Purchased: server-held mailbox intelligence  -->
                            <controls:SettingsCard
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="WinoAccountIntelligenceMailboxesCard"
                                ContentAlignment="Vertical"
                                Visibility="{x:Bind ViewModel.HasIntelligenceAccess, Mode=OneWay}">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.WinoAccount_Management_IndexedMailboxesTitle, Mode=OneTime}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind ViewModel.IntelligenceStorageSummary, Mode=OneWay}" />
                                    </Grid>
                                    <ItemsControl ItemTemplate="{StaticResource IntelligenceMailboxTemplate}" ItemsSource="{x:Bind ViewModel.IntelligenceMailboxes, Mode=OneWay}" />
                                    <InfoBar
                                        AutomationProperties.AutomationId="WinoAccountIntelligenceErrorInfoBar"
                                        IsClosable="False"
                                        IsOpen="{x:Bind ViewModel.HasIntelligenceDataError, Mode=OneWay}"
                                        Message="{x:Bind ViewModel.IntelligenceDataError, Mode=OneWay}"
                                        Severity="Warning" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="WinoAccountConsentManagementCard"
                                Description="{x:Bind domain:Translator.WinoAccount_ConsentNavigationDescription, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.WinoAccount_ConsentNavigationTitle, Mode=OneTime}">
                                <controls:SettingsCard.HeaderIcon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </controls:SettingsCard.HeaderIcon>
                                <Button
                                    AutomationProperties.AutomationId="WinoAccountOpenConsentManagementButton"
                                    Command="{x:Bind ViewModel.OpenIntelligenceManagementCommand}"
                                    Content="{x:Bind domain:Translator.Buttons_Manage, Mode=OneTime}" />
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!--  Unlimited Accounts is intentionally compact; ownership is the only state users need here.  -->
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="WinoAccountUnlimitedAccountsCard"
                        Description="{x:Bind ViewModel.UnlimitedAccountsSubtitleText, Mode=OneWay}"
                        Header="{x:Bind domain:Translator.WinoAddOn_UNLIMITED_ACCOUNTS_Name, Mode=OneTime}">
                        <controls:SettingsCard.HeaderIcon>
                            <PathIcon Data="M 4.5,6.5 A 3,3 0 1,1 10.5,6.5 A 3,3 0 1,1 4.5,6.5 Z M 2,16.5 C 2.4,13.7 4.6,12 7.5,12 C 10.4,12 12.6,13.7 13,16.5 Z M 12.5,7.8 A 2.3,2.3 0 1,1 17.1,7.8 A 2.3,2.3 0 1,1 12.5,7.8 Z M 11.8,16.5 C 12,14.2 13.3,12.9 15,12.9 C 16.7,12.9 17.9,14 18.3,16.5 Z" Foreground="{StaticResource UnlimitedAccountsMarkBrush}" />
                        </controls:SettingsCard.HeaderIcon>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.UnlimitedAccountsAddOn.IsLoading, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.UnlimitedAccountsAddOn.IsLoading, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="WinoAccountUnlimitedAccountsPurchaseButton"
                                Command="{x:Bind ViewModel.PurchaseAddOnCommand}"
                                CommandParameter="{x:Bind ViewModel.UnlimitedAccountsAddOn}"
                                Content="{x:Bind domain:Translator.Buttons_Purchase, Mode=OneTime}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.UnlimitedAccountsAddOn.ShowPurchaseState, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="WinoAccountUnlimitedAccountsPurchasedButton"
                                Content="{x:Bind domain:Translator.Purchased, Mode=OneTime}"
                                IsEnabled="False"
                                Visibility="{x:Bind ViewModel.UnlimitedAccountsAddOn.IsPurchased, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!--  ─── Sync and backup ───  -->
                    <TextBlock
                        Margin="0,22,0,4"
                        Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoAccount_Management_SyncSectionHeader, Mode=OneTime}" />

                    <controls:SettingsCard
                        AutomationProperties.AutomationId="WinoAccountSyncDataCard"
                        Description="{x:Bind domain:Translator.WinoAccount_Management_SyncPreferencesDescription, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.WinoAccount_Management_SyncRowTitle, Mode=OneTime}">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                Glyph="&#xE895;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                AutomationProperties.AutomationId="WinoAccountExportButton"
                                Command="{x:Bind ViewModel.ExportSettingsCommand}"
                                Content="{x:Bind domain:Translator.Buttons_Export, Mode=OneTime}" />
                            <Button
                                AutomationProperties.AutomationId="WinoAccountImportButton"
                                Command="{x:Bind ViewModel.ImportSettingsCommand}"
                                Content="{x:Bind domain:Translator.Buttons_Import, Mode=OneTime}" />
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</abstract:WinoAccountManagementPageAbstract>
