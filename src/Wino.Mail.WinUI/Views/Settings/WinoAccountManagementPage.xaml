                                                RadiusY="7"
                                                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                StrokeThickness="1.5" />
                                            <Rectangle
                                                Canvas.Left="91"
                                                Canvas.Top="92"
                                                Width="58"
                                                Height="48"
                                                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                RadiusX="7"
                                                RadiusY="7"
                                                Stroke="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                StrokeThickness="1.5" />
                                            <Rectangle
                                                Canvas.Left="168"
