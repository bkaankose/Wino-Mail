                                                Height="6"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.28"
                                                RadiusX="3"
                                                RadiusY="3" />
                                            <Rectangle
                                                Canvas.Left="16"
                                                Canvas.Top="75"
                                                Width="68"
                                                Height="6"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.28"
                                                RadiusX="3"
                                                RadiusY="3" />
                                            <Rectangle
                                                Canvas.Left="16"
                                                Canvas.Top="89"
                                                Width="46"
                                                Height="6"
                                                Fill="{ThemeResource TextFillColorTertiaryBrush}"
                                                Opacity="0.28"
                                                RadiusX="3"
                                                RadiusY="3" />
                                            <Rectangle
                                                Canvas.Left="16"
                                                Canvas.Top="107"
                                                Width="34"
                                                Height="14"
                                                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                Opacity="0.8"
                                                RadiusX="7"
                                                RadiusY="7" />

                                            <Rectangle
                                                Canvas.Left="146"
                                                Canvas.Top="34"
                                                Width="88"
                                                Height="98"
                                                Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                RadiusX="9"
                                                RadiusY="9"
                                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                                StrokeThickness="1.5" />
                                            <Rectangle
                                                Canvas.Left="156"
