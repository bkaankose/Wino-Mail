<abstract:NotificationSettingsPageAbstract
    x:Class="Wino.Views.Settings.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:appControls="using:Wino.Controls"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wino.Core.ViewModels.Data"
    x:Name="PageRoot"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">

        <!--
            Snooze state. The one bespoke surface on the page: snooze is a thing people do daily,
            so it sits above the settings rather than inside an expander.
        -->
        <Border
            Margin="0,0,0,12"
            Padding="24"
            AutomationProperties.AutomationId="NotificationSettingsHeroCard"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.NotificationSettings_Hero_Title, Mode=OneTime}" />
                        <TextBlock
                            MaxWidth="560"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="NotificationSettingsHeroStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.SnoozeSummaryText, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="NotificationSettingsSnoozeStateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.SnoozeStateText, Mode=OneWay}" />

                        <ToggleSplitButton
                            AutomationProperties.AutomationId="NotificationSettingsSnoozeSplitButton"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_SnoozeAll, Mode=OneTime}"
                            IsChecked="{x:Bind ViewModel.IsSnoozed, Mode=OneWay}"
                            IsCheckedChanged="SnoozeToggle_IsCheckedChanged"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSettings_SnoozeAll, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <coreControls:WinoFontIcon FontSize="14" Icon="AlertOff" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSnoozePresetText, Mode=OneWay}" />
                            </StackPanel>
                            <ToggleSplitButton.Flyout>
                                <contextFlyout:WinoContextFlyout Placement="Bottom">
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetThirtyMinutes"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="ThirtyMinutes"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_ThirtyMinutes, Mode=OneTime}" />
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetOneHour"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="OneHour"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_OneHour, Mode=OneTime}" />
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetTwoHours"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="TwoHours"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_TwoHours, Mode=OneTime}" />
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetRestOfDay"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="RestOfDay"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_RestOfDay, Mode=OneTime}" />
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetUntilTomorrowMorning"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="UntilTomorrowMorning"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_UntilTomorrowMorning, Mode=OneTime}" />
                                    <contextFlyout:WinoContextFlyoutItem
                                        AutomationId="NotificationSettingsSnoozePresetUntilTurnedBackOn"
                                        Click="SnoozePreset_Click"
                                        CommandParameter="UntilTurnedBackOn"
                                        Text="{x:Bind domain:Translator.NotificationSnooze_UntilTurnedBackOn, Mode=OneTime}" />
                                </contextFlyout:WinoContextFlyout>
                            </ToggleSplitButton.Flyout>
                        </ToggleSplitButton>
                    </StackPanel>
                </Grid>

                <!--  Windows exposes that Do not disturb is on, but never when it ends.  -->
                <InfoBar
                    x:Name="SystemQuietTimeInfoBar"
                    AutomationProperties.AutomationId="NotificationSettingsSystemQuietTimeInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsSystemQuietTimeActive, Mode=OneWay}"
                    Message="{x:Bind domain:Translator.NotificationSettings_SystemQuietTime, Mode=OneTime}"
                    Severity="Informational" />
            </StackPanel>
        </Border>

        <!--  Quiet hours  -->
        <controls:SettingsExpander
            AutomationProperties.AutomationId="NotificationSettingsQuietHoursExpander"
            Description="{x:Bind ViewModel.QuietHoursSummary, Mode=OneWay}"
            Header="{x:Bind domain:Translator.NotificationSettings_QuietHours_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Clock" />
            </controls:SettingsExpander.HeaderIcon>

            <ToggleSwitch
                AutomationProperties.AutomationId="NotificationSettingsQuietHoursToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_QuietHours_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.AreQuietHoursEnabled, Mode=TwoWay}"
                Toggled="QuietHoursChanged" />

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsQuietHoursWindowCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_QuietHours_From_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_QuietHours_From_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind ViewModel.PreferencesService.AreQuietHoursEnabled, Mode=OneWay}">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TimePicker
                            AutomationProperties.AutomationId="NotificationSettingsQuietHoursStartPicker"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_QuietHours_From_Title, Mode=OneTime}"
                            SelectedTimeChanged="QuietHoursTimeChanged"
                            Time="{x:Bind ViewModel.PreferencesService.QuietHoursStart, Mode=TwoWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind domain:Translator.NotificationSettings_QuietHours_To, Mode=OneTime}" />
                        <TimePicker
                            AutomationProperties.AutomationId="NotificationSettingsQuietHoursEndPicker"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_QuietHours_To, Mode=OneTime}"
                            SelectedTimeChanged="QuietHoursTimeChanged"
                            Time="{x:Bind ViewModel.PreferencesService.QuietHoursEnd, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsQuietHoursDaysCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_QuietHours_Days_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_QuietHours_Days_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind ViewModel.PreferencesService.AreQuietHoursEnabled, Mode=OneWay}">
                    <ItemsControl AutomationProperties.AutomationId="NotificationSettingsQuietHoursDayToggles" ItemsSource="{x:Bind ViewModel.QuietHoursDayToggles, Mode=OneTime}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:QuietHoursDayViewModel">
                                <ToggleButton
                                    MinWidth="44"
                                    AutomationProperties.AutomationId="NotificationSettingsPageToggleButton"
                                    AutomationProperties.Name="{x:Bind DisplayText}"
                                    Content="{x:Bind DisplayText}"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsPresentingCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_QuietHours_Presenting_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_QuietHours_Presenting_Title, Mode=OneTime}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="NotificationSettingsPresentingToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_QuietHours_Presenting_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.SnoozeWhilePresenting, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  New mail  -->
        <controls:SettingsExpander
            AutomationProperties.AutomationId="NotificationSettingsMailExpander"
            Description="{x:Bind ViewModel.MailSummary, Mode=OneWay}"
            Header="{x:Bind domain:Translator.NotificationSettings_Mail_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Mail" />
            </controls:SettingsExpander.HeaderIcon>

            <ToggleSwitch
                AutomationProperties.AutomationId="NotificationSettingsMailToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_Mail_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.AreNewMailNotificationsEnabled, Mode=TwoWay}"
                Toggled="SectionToggled" />

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsMailScopeCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Mail_Scope_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Mail_Scope_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsMailScopeComboBox"
                        ItemsSource="{x:Bind ViewModel.ScopeOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedMailScope, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MailNotificationScopeOption">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsMailContentCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Mail_Content_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Mail_Content_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsMailContentComboBox"
                        ItemsSource="{x:Bind ViewModel.ContentOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedMailContent, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MailNotificationContentOption">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsMailFirstActionCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Mail_FirstAction_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Mail_FirstAction_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsMailFirstActionComboBox"
                        ItemsSource="{x:Bind ViewModel.MailActionOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedFirstAction, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MailNotificationActionOption">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsMailSecondActionCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Mail_SecondAction_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Mail_SecondAction_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsMailSecondActionComboBox"
                        ItemsSource="{x:Bind ViewModel.MailActionOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedSecondAction, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:MailNotificationActionOption">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsMailSoundCard"
                    Description="{x:Bind domain:Translator.NotificationSound_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSound_Title, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            AutomationProperties.AutomationId="NotificationSettingsMailSoundComboBox"
                            ItemsSource="{x:Bind ViewModel.SoundOptions, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedMailSound, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:NotificationSoundOption">
                                    <TextBlock Text="{x:Bind DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            AutomationProperties.AutomationId="NotificationSettingsMailSoundPlayButton"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}"
                            Click="PlayMailNotificationSoundButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}">
                            <coreControls:WinoFontIcon FontSize="14" Icon="Play" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  Calendar reminders  -->
        <controls:SettingsExpander
            AutomationProperties.AutomationId="NotificationSettingsCalendarExpander"
            Description="{x:Bind ViewModel.CalendarSummary, Mode=OneWay}"
            Header="{x:Bind domain:Translator.NotificationSettings_Calendar_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Calendar" />
            </controls:SettingsExpander.HeaderIcon>

            <ToggleSwitch
                AutomationProperties.AutomationId="NotificationSettingsCalendarToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_Calendar_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.AreCalendarRemindersEnabled, Mode=TwoWay}"
                Toggled="SectionToggled" />

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsCalendarReminderCard"
                    Description="{x:Bind domain:Translator.CalendarSettings_DefaultReminder_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.CalendarSettings_DefaultReminder_Header, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsCalendarReminderComboBox"
                        ItemsSource="{x:Bind ViewModel.ReminderOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedReminderIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsCalendarSnoozeCard"
                    Description="{x:Bind domain:Translator.CalendarSettings_DefaultSnoozeDuration_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.CalendarSettings_DefaultSnoozeDuration_Header, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsCalendarSnoozeComboBox"
                        ItemsSource="{x:Bind ViewModel.CalendarSnoozeOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedCalendarSnoozeIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsCalendarSoundCard"
                    Description="{x:Bind domain:Translator.NotificationSound_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSound_Title, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            AutomationProperties.AutomationId="NotificationSettingsCalendarSoundComboBox"
                            ItemsSource="{x:Bind ViewModel.SoundOptions, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedCalendarSound, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:NotificationSoundOption">
                                    <TextBlock Text="{x:Bind DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            AutomationProperties.AutomationId="NotificationSettingsCalendarSoundPlayButton"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}"
                            Click="PlayCalendarNotificationSoundButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}">
                            <coreControls:WinoFontIcon FontSize="14" Icon="Play" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  To-do reminders  -->
        <controls:SettingsExpander
            AutomationProperties.AutomationId="NotificationSettingsTasksExpander"
            Description="{x:Bind ViewModel.TaskSummary, Mode=OneWay}"
            Header="{x:Bind domain:Translator.NotificationSettings_Tasks_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TaskList" />
            </controls:SettingsExpander.HeaderIcon>

            <ToggleSwitch
                AutomationProperties.AutomationId="NotificationSettingsTasksToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.NotificationSettings_Tasks_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.AreTaskRemindersEnabled, Mode=TwoWay}"
                Toggled="SectionToggled" />

            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsTaskTimingCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Tasks_Timing_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Tasks_Timing_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsTaskTimingComboBox"
                        ItemsSource="{x:Bind ViewModel.TaskReminderTimingOptions, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.SelectedTaskReminderTiming, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TaskReminderTimingOption">
                                <TextBlock Text="{x:Bind DisplayText}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsTaskSnoozeCard"
                    Description="{x:Bind domain:Translator.NotificationSettings_Tasks_Snooze_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSettings_Tasks_Snooze_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="NotificationSettingsTaskSnoozeComboBox"
                        ItemsSource="{x:Bind ViewModel.TaskSnoozeOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedTaskSnoozeIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="NotificationSettingsTaskSoundCard"
                    Description="{x:Bind domain:Translator.NotificationSound_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.NotificationSound_Title, Mode=OneTime}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox
                            AutomationProperties.AutomationId="NotificationSettingsTaskSoundComboBox"
                            ItemsSource="{x:Bind ViewModel.SoundOptions, Mode=OneTime}"
                            SelectedItem="{x:Bind ViewModel.SelectedTaskSound, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:NotificationSoundOption">
                                    <TextBlock Text="{x:Bind DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button
                            AutomationProperties.AutomationId="NotificationSettingsTaskSoundPlayButton"
                            AutomationProperties.Name="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}"
                            Click="PlayTaskNotificationSoundButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}">
                            <coreControls:WinoFontIcon FontSize="14" Icon="Play" />
                        </Button>
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  Per-account overrides  -->
        <TextBlock
            Margin="2,16,0,0"
            AutomationProperties.AutomationId="NotificationSettingsAccountsHeader"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="{x:Bind domain:Translator.NotificationSettings_Accounts_Title, Mode=OneTime}" />
        <TextBlock
            Margin="2,0,0,4"
            AutomationProperties.AutomationId="NotificationSettingsAccountsDescription"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.NotificationSettings_Accounts_Description, Mode=OneTime}" />

        <ItemsControl AutomationProperties.AutomationId="NotificationSettingsAccountsList" ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection />
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:AccountNotificationSettingsViewModel">
                    <controls:SettingsExpander Margin="0,0,0,4" AutomationProperties.AutomationId="NotificationSettingsPageSettingsExpander">
                        <controls:SettingsExpander.Header>
                            <appControls:AccountIdentityRowControl Account="{x:Bind Account}" Description="{x:Bind AccountAddress}" />
                        </controls:SettingsExpander.Header>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                            <ToggleSwitch AutomationProperties.AutomationId="NotificationSettingsPageToggleSwitch" IsOn="{x:Bind AreNotificationsEnabled, Mode=TwoWay}" />
                        </StackPanel>

                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard"
                                Description="{x:Bind domain:Translator.NotificationSettings_Account_Source_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Account_Source_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreNotificationsEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <RadioButton
                                        AutomationProperties.AutomationId="NotificationSettingsPageRadioButton"
                                        Content="{x:Bind domain:Translator.NotificationSettings_Account_UseDefaults, Mode=OneTime}"
                                        GroupName="{x:Bind AccountAddress}"
                                        IsChecked="{x:Bind IsFollowingDefaults, Mode=TwoWay}" />
                                    <RadioButton
                                        AutomationProperties.AutomationId="NotificationSettingsPageRadioButton2"
                                        Content="{x:Bind domain:Translator.NotificationSettings_Account_Customise, Mode=OneTime}"
                                        GroupName="{x:Bind AccountAddress}"
                                        IsChecked="{x:Bind HasCustomNotificationSettings, Mode=TwoWay}" />
                                </StackPanel>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard2"
                                Description="{x:Bind domain:Translator.NotificationSettings_Account_NewMail_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Account_NewMail_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreOverrideFieldsEnabled, Mode=OneWay}">
                                <ToggleSwitch AutomationProperties.AutomationId="NotificationSettingsPageToggleSwitch2" IsOn="{x:Bind IsNewMailNotificationEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard3"
                                Description="{x:Bind domain:Translator.NotificationSettings_Mail_Scope_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Mail_Scope_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreOverrideFieldsEnabled, Mode=OneWay}">
                                <ComboBox
                                    AutomationProperties.AutomationId="NotificationSettingsPageComboBox"
                                    ItemsSource="{x:Bind ScopeOptions}"
                                    SelectedItem="{x:Bind SelectedScope, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:MailNotificationScopeOption">
                                            <TextBlock Text="{x:Bind DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard4"
                                Description="{x:Bind domain:Translator.NotificationSettings_Mail_Content_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Mail_Content_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreOverrideFieldsEnabled, Mode=OneWay}">
                                <ComboBox
                                    AutomationProperties.AutomationId="NotificationSettingsPageComboBox2"
                                    ItemsSource="{x:Bind ContentOptions}"
                                    SelectedItem="{x:Bind SelectedContent, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:MailNotificationContentOption">
                                            <TextBlock Text="{x:Bind DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard5"
                                Description="{x:Bind domain:Translator.NotificationSettings_Account_Sound_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSound_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreOverrideFieldsEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ComboBox
                                        AutomationProperties.AutomationId="NotificationSettingsPageComboBox3"
                                        ItemsSource="{x:Bind SoundOptions}"
                                        SelectedItem="{x:Bind SelectedSound, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:NotificationSoundOption">
                                                <TextBlock Text="{x:Bind DisplayText}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button
                                        AutomationProperties.AutomationId="NotificationSettingsPageButton"
                                        AutomationProperties.Name="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}"
                                        Click="PlayAccountNotificationSoundButton_Click"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind domain:Translator.NotificationSound_Play, Mode=OneTime}">
                                        <coreControls:WinoFontIcon FontSize="14" Icon="Play" />
                                    </Button>
                                </StackPanel>
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard6"
                                Description="{x:Bind domain:Translator.NotificationSettings_Account_Calendar_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Account_Calendar_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreOverrideFieldsEnabled, Mode=OneWay}">
                                <ToggleSwitch AutomationProperties.AutomationId="NotificationSettingsPageToggleSwitch3" IsOn="{x:Bind AreCalendarRemindersEnabled, Mode=TwoWay}" />
                            </controls:SettingsCard>

                            <controls:SettingsCard
                                AutomationProperties.AutomationId="NotificationSettingsPageSettingsCard7"
                                Description="{x:Bind domain:Translator.NotificationSettings_Account_QuietHours_Description, Mode=OneTime}"
                                Header="{x:Bind domain:Translator.NotificationSettings_Account_QuietHours_Title, Mode=OneTime}"
                                IsEnabled="{x:Bind AreNotificationsEnabled, Mode=OneWay}">
                                <ComboBox
                                    AutomationProperties.AutomationId="NotificationSettingsPageComboBox4"
                                    ItemsSource="{x:Bind QuietHoursOptions}"
                                    SelectedItem="{x:Bind SelectedQuietHoursStance, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:AccountQuietHoursStanceOption">
                                            <TextBlock Text="{x:Bind DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <controls:SettingsCard
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="NotificationSettingsResetCard"
            Description="{x:Bind domain:Translator.NotificationSettings_Reset_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.NotificationSettings_Reset_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ArrowReset" />
            </controls:SettingsCard.HeaderIcon>
            <Button
                AutomationProperties.AutomationId="NotificationSettingsResetButton"
                Click="ResetButton_Click"
                Content="{x:Bind domain:Translator.NotificationSettings_Reset_Title, Mode=OneTime}" />
        </controls:SettingsCard>
    </StackPanel>
</abstract:NotificationSettingsPageAbstract>
