<abstract:WidgetsLiveTilesSettingsPageAbstract
    x:Class="Wino.Views.Settings.WidgetsLiveTilesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <Border
            Margin="0,0,0,12"
            Padding="24"
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsAboutCard"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind domain:Translator.WidgetsLiveTilesSettings_About_Title, Mode=OneTime}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WidgetsLiveTilesSettings_About_Description, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Image
                        Width="40"
                        Height="40"
                        Source="ms-appx:///Assets/AppEntries/MailAssets/Square44x44Logo.png" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="ms-appx:///Assets/AppEntries/CalendarAssets/Square44x44Logo.png" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="ms-appx:///Assets/AppEntries/ToDoAssets/Square44x44Logo.png" />
                    <Image
                        Width="40"
                        Height="40"
                        Source="ms-appx:///Assets/AppEntries/PeopleAssets/Square44x44Logo.png" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WidgetsLiveTilesSettings_WidgetsSection, Mode=OneTime}" />

        <InfoBar
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsWidgetsUnsupportedInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsWidgetsUnsupported, Mode=OneTime}"
            Message="{x:Bind domain:Translator.WidgetsLiveTilesSettings_WidgetsUnsupported, Mode=OneTime}"
            Severity="Informational"
            Visibility="{x:Bind ViewModel.IsWidgetsUnsupported, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsWidgetsCard"
            Description="{x:Bind domain:Translator.WidgetsLiveTilesSettings_Widgets_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WidgetsLiveTilesSettings_Widgets_Title, Mode=OneTime}"
            IsEnabled="{x:Bind ViewModel.IsWidgetsSupported, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Board" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="WidgetsLiveTilesSettingsWidgetsToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.WidgetsLiveTilesSettings_Widgets_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.IsWinoWidgetsEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>

        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WidgetsLiveTilesSettings_LiveTilesSection, Mode=OneTime}" />

        <InfoBar
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsLiveTilesUnsupportedInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsLiveTilesUnsupported, Mode=OneTime}"
            Message="{x:Bind domain:Translator.WidgetsLiveTilesSettings_LiveTilesUnsupported, Mode=OneTime}"
            Severity="Informational"
            Visibility="{x:Bind ViewModel.IsLiveTilesUnsupported, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsLiveTilesCard"
            Description="{x:Bind domain:Translator.WidgetsLiveTilesSettings_LiveTiles_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WidgetsLiveTilesSettings_LiveTiles_Title, Mode=OneTime}"
            IsEnabled="{x:Bind ViewModel.IsLiveTilesSupported, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Grid" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="WidgetsLiveTilesSettingsLiveTilesToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.WidgetsLiveTilesSettings_LiveTiles_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.IsLiveTilesEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsTileContentCard"
            Description="{x:Bind domain:Translator.WidgetsLiveTilesSettings_TileContent_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WidgetsLiveTilesSettings_TileContent_Title, Mode=OneTime}"
            IsEnabled="{x:Bind ViewModel.CanChooseLiveTileModes, Mode=OneWay}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Companion" />
            </controls:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox
                    MinWidth="0"
                    AutomationProperties.AutomationId="WidgetsLiveTilesSettingsTileMailCheckBox"
                    Content="{x:Bind domain:Translator.AccountCapability_Mail, Mode=OneTime}"
                    IsChecked="{x:Bind ViewModel.ShowMailOnLiveTiles, Mode=TwoWay}" />
                <CheckBox
                    MinWidth="0"
                    AutomationProperties.AutomationId="WidgetsLiveTilesSettingsTileCalendarCheckBox"
                    Content="{x:Bind domain:Translator.AccountCapability_Calendar, Mode=OneTime}"
                    IsChecked="{x:Bind ViewModel.ShowCalendarOnLiveTiles, Mode=TwoWay}" />
                <CheckBox
                    MinWidth="0"
                    AutomationProperties.AutomationId="WidgetsLiveTilesSettingsTileTasksCheckBox"
                    Content="{x:Bind domain:Translator.AccountCapability_ToDo, Mode=OneTime}"
                    IsChecked="{x:Bind ViewModel.ShowTasksOnLiveTiles, Mode=TwoWay}" />
            </StackPanel>
        </controls:SettingsCard>

        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.WidgetsLiveTilesSettings_PrivacySection, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsShowDetailsCard"
            Description="{x:Bind domain:Translator.WidgetsLiveTilesSettings_ShowDetails_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WidgetsLiveTilesSettings_ShowDetails_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Eye" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="WidgetsLiveTilesSettingsShowDetailsToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.WidgetsLiveTilesSettings_ShowDetails_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.ShowDetails, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="WidgetsLiveTilesSettingsHiddenAccountsCard"
            Command="{x:Bind ViewModel.OpenNotificationSettingsCommand}"
            Description="{x:Bind domain:Translator.WidgetsLiveTilesSettings_HiddenAccounts_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.WidgetsLiveTilesSettings_HiddenAccounts_Title, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="AlertOff" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>
    </StackPanel>
</abstract:WidgetsLiveTilesSettingsPageAbstract>
