<viewsAbstract:ReadComposePanePageAbstract
    x:Class="Wino.Mail.WinUI.Views.Settings.ReadComposePanePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:translations="using:Wino.Core.Domain.Models.Translations"
    xmlns:viewsAbstract="using:Wino.Mail.WinUI.Views.Abstract"
    mc:Ignorable="d">
    <StackPanel Spacing="3">

        <!--  Reading  -->
        <TextBlock
            Margin="0,0,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.SettingsRendering_ReadingHeader, Mode=OneTime}" />

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingReaderFontExpander"
            Description="{x:Bind domain:Translator.SettingsRendering_ReaderFont_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_ReaderFont_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TextFont" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="RenderingReaderFontFamilyCard" Header="{x:Bind domain:Translator.SettingsFontFamily_Title, Mode=OneTime}">
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.AutomationId="RenderingReaderFontFamilyComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsFontFamily_Title, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                        SelectedItem="{x:Bind ViewModel.CurrentReaderFont, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="{x:Bind}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard AutomationProperties.AutomationId="RenderingReaderFontSizeCard" Header="{x:Bind domain:Translator.SettingsFontSize_Title, Mode=OneTime}">
                    <NumberBox
                        AutomationProperties.AutomationId="RenderingReaderFontSizeNumberBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsFontSize_Title, Mode=OneTime}"
                        LargeChange="4"
                        Maximum="72"
                        Minimum="8"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.CurrentReaderFontSize, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="RenderingReaderFontPreviewCard"
                    ContentAlignment="Vertical"
                    Header="{x:Bind domain:Translator.SettingsFontPreview_Title, Mode=OneTime}">
                    <TextBlock
                        FontFamily="{x:Bind ViewModel.CurrentReaderFont, Mode=OneWay}"
                        FontSize="{x:Bind ViewModel.CurrentReaderFontSize, Mode=OneWay}"
                        Text="{x:Bind domain:Translator.SettingsRendering_FontPreviewText, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingDarkModeExpander"
            Description="{x:Bind domain:Translator.SettingsReaderDarkMode_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsReaderDarkMode_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="DarkEditor" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingMessageColorsCard"
                    Description="{x:Bind domain:Translator.SettingsReaderMessageColors_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsReaderMessageColors_Title, Mode=OneTime}">
                    <ComboBox
                        AutomationProperties.AutomationId="RenderingMessageColorsComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsReaderMessageColors_Title, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.ReaderContentThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedReaderContentThemeIndex, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="RenderingDarkModeMethodCard"
                    ContentAlignment="Vertical"
                    Description="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Title, Mode=OneTime}">
                    <RadioButtons AutomationProperties.AutomationId="RenderingDarkModeMethodRadioButtons" SelectedIndex="{x:Bind ViewModel.SelectedReaderDarkModeMethodIndex, Mode=TwoWay}">
                        <RadioButton AutomationProperties.AutomationId="RenderingDarkModeAdaptiveRadio" Content="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Adaptive, Mode=OneTime}" />
                        <RadioButton AutomationProperties.AutomationId="RenderingDarkModeInvertedRadio" Content="{x:Bind domain:Translator.SettingsReaderDarkModeMethod_Inverted, Mode=OneTime}" />
                    </RadioButtons>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingFoldingExpander"
            Description="{x:Bind domain:Translator.SettingsRendering_Folding_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_Folding_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TextQuote" />
            </controls:SettingsExpander.HeaderIcon>
            <ToggleSwitch
                x:Name="FoldingToggle"
                AutomationProperties.AutomationId="RenderingFoldingToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_Folding_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsReaderFoldingEnabled, Mode=TwoWay}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingConversationFoldingCard"
                    Description="{x:Bind domain:Translator.SettingsRendering_ConversationFolding_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsRendering_ConversationFolding_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind FoldingToggle.IsOn, Mode=OneWay}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="RenderingConversationFoldingToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_ConversationFolding_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.IsConversationFoldingEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            AutomationProperties.AutomationId="RenderingLinkifyCard"
            Description="{x:Bind domain:Translator.SettingsRendering_Linkify_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_Linkify_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Link" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="RenderingLinkifyToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_Linkify_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.RenderPlaintextLinks, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!--  Smart content  -->
        <TextBlock
            Margin="0,16,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.SettingsRendering_SmartContentHeader, Mode=OneTime}" />

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingActionCardsExpander"
            Description="{x:Bind domain:Translator.SettingsRendering_ActionCards_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_ActionCards_Title, Mode=OneTime}"
            IsExpanded="True">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Ticket" />
            </controls:SettingsExpander.HeaderIcon>
            <ToggleSwitch
                x:Name="ActionCardsToggle"
                AutomationProperties.AutomationId="RenderingActionCardsToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_ActionCards_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsActionCardsEnabled, Mode=TwoWay}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingActionCardConfirmationCard"
                    Description="{x:Bind domain:Translator.SettingsRendering_ActionCardConfirmation_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsRendering_ActionCardConfirmation_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind ActionCardsToggle.IsOn, Mode=OneWay}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="RenderingActionCardConfirmationToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_ActionCardConfirmation_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.IsActionCardConfirmationEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            AutomationProperties.AutomationId="RenderingDatesCard"
            Description="{x:Bind domain:Translator.SettingsRendering_Dates_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_Dates_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Calendar" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="RenderingDatesToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_Dates_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsDateDetectionEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!--  Writing  -->
        <TextBlock
            Margin="0,16,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.SettingsRendering_WritingHeader, Mode=OneTime}" />

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingComposerFontExpander"
            Description="{x:Bind domain:Translator.SettingsRendering_ComposerFont_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_ComposerFont_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TextFont" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="RenderingComposerFontFamilyCard" Header="{x:Bind domain:Translator.SettingsFontFamily_Title, Mode=OneTime}">
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.AutomationId="RenderingComposerFontFamilyComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsFontFamily_Title, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.AvailableFonts}"
                        SelectedItem="{x:Bind ViewModel.CurrentComposerFont, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock FontFamily="{x:Bind}" Text="{x:Bind}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard AutomationProperties.AutomationId="RenderingComposerFontSizeCard" Header="{x:Bind domain:Translator.SettingsFontSize_Title, Mode=OneTime}">
                    <NumberBox
                        AutomationProperties.AutomationId="RenderingComposerFontSizeNumberBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsFontSize_Title, Mode=OneTime}"
                        LargeChange="4"
                        Maximum="72"
                        Minimum="8"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.CurrentComposerFontSize, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="RenderingComposerFontPreviewCard"
                    ContentAlignment="Vertical"
                    Header="{x:Bind domain:Translator.SettingsFontPreview_Title, Mode=OneTime}">
                    <TextBlock
                        FontFamily="{x:Bind ViewModel.CurrentComposerFont, Mode=OneWay}"
                        FontSize="{x:Bind ViewModel.CurrentComposerFontSize, Mode=OneWay}"
                        Text="{x:Bind domain:Translator.SettingsRendering_ComposerFontPreviewText, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingSpellCheckExpander"
            Description="{x:Bind domain:Translator.SettingsComposerSpellCheck_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsComposerSpellCheck_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="TextProofingTools" />
            </controls:SettingsExpander.HeaderIcon>
            <ToggleSwitch
                x:Name="SpellCheckToggle"
                AutomationProperties.AutomationId="RenderingSpellCheckToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerSpellCheck_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsComposerSpellCheckEnabled, Mode=TwoWay}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingAutoCorrectCard"
                    Description="{x:Bind domain:Translator.SettingsComposerAutoCorrect_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsComposerAutoCorrect_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind SpellCheckToggle.IsOn, Mode=OneWay}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="RenderingAutoCorrectToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerAutoCorrect_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.IsComposerAutoCorrectEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingSpellCheckLanguageCard"
                    Header="{x:Bind domain:Translator.SettingsComposerSpellCheckLanguage_Title, Mode=OneTime}"
                    IsEnabled="{x:Bind SpellCheckToggle.IsOn, Mode=OneWay}">
                    <ComboBox
                        AutomationProperties.AutomationId="RenderingSpellCheckLanguageComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerSpellCheckLanguage_Title, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.AvailableSpellCheckLanguages}"
                        SelectedItem="{x:Bind ViewModel.CurrentSpellCheckLanguage, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="translations:AppLanguageModel">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingMentionsExpander"
            Description="{x:Bind domain:Translator.SettingsComposerMentions_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsComposerMentions_Title, Mode=OneTime}"
            IsExpanded="True">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="PersonTag" />
            </controls:SettingsExpander.HeaderIcon>
            <ToggleSwitch
                x:Name="MentionsToggle"
                AutomationProperties.AutomationId="RenderingMentionsToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerMentions_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsComposerMentionSuggestionEnabled, Mode=TwoWay}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingMentionRecipientCard"
                    Description="{x:Bind domain:Translator.SettingsComposerMentions_AddTo_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsComposerMentions_AddTo, Mode=OneTime}"
                    IsEnabled="{x:Bind MentionsToggle.IsOn, Mode=OneWay}">
                    <ComboBox
                        AutomationProperties.AutomationId="RenderingMentionRecipientComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerMentions_AddTo, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.MentionRecipientOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedMentionRecipientIndex, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="RenderingMentionFormatCard"
                    Description="{x:Bind domain:Translator.SettingsComposerMentions_Format_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.SettingsComposerMentions_Format, Mode=OneTime}"
                    IsEnabled="{x:Bind MentionsToggle.IsOn, Mode=OneWay}">
                    <ComboBox
                        AutomationProperties.AutomationId="RenderingMentionFormatComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsComposerMentions_Format, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.MentionFormatOptions}"
                        SelectedIndex="{x:Bind ViewModel.SelectedMentionFormatIndex, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <controls:SettingsCard
            AutomationProperties.AutomationId="RenderingPasteFormattingCard"
            Description="{x:Bind domain:Translator.SettingsRendering_PasteFormatting_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_PasteFormatting_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ClipboardPaste" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="RenderingPasteFormattingToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_PasteFormatting_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsComposerPasteFormattingEnabled, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="RenderingDraftChecksExpander"
            Description="{x:Bind domain:Translator.SettingsRendering_DraftChecks_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsRendering_DraftChecks_Title, Mode=OneTime}"
            IsExpanded="True">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Send" />
            </controls:SettingsExpander.HeaderIcon>
            <ToggleSwitch
                x:Name="DraftChecksToggle"
                AutomationProperties.AutomationId="RenderingDraftChecksToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.SettingsRendering_DraftChecks_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.IsDraftCheckEnabled, Mode=TwoWay}" />
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    HorizontalContentAlignment="Left"
                    AutomationProperties.AutomationId="RenderingDraftChecksOptionsCard"
                    ContentAlignment="Left"
                    IsEnabled="{x:Bind DraftChecksToggle.IsOn, Mode=OneWay}">
                    <StackPanel Spacing="2">
                        <CheckBox
                            AutomationProperties.AutomationId="RenderingDraftCheckImagesCheckBox"
                            Content="{x:Bind domain:Translator.SettingsRendering_DraftCheckImages, Mode=OneTime}"
                            IsChecked="{x:Bind ViewModel.PreferencesService.IsDraftImageDescriptionCheckEnabled, Mode=TwoWay}" />
                        <CheckBox
                            AutomationProperties.AutomationId="RenderingDraftCheckReadableTextCheckBox"
                            Content="{x:Bind domain:Translator.SettingsRendering_DraftCheckReadableText, Mode=OneTime}"
                            IsChecked="{x:Bind ViewModel.PreferencesService.IsDraftReadableTextCheckEnabled, Mode=TwoWay}" />
                        <CheckBox
                            AutomationProperties.AutomationId="RenderingDraftCheckSizeCheckBox"
                            Content="{x:Bind domain:Translator.SettingsRendering_DraftCheckSize, Mode=OneTime}"
                            IsChecked="{x:Bind ViewModel.PreferencesService.IsDraftMessageSizeCheckEnabled, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  Related  -->
        <TextBlock
            Margin="0,16,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.SettingsRendering_RelatedHeader, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="RenderingRelatedPrivacyCard"
            Command="{x:Bind ViewModel.OpenPrivacySettingsCommand}"
            Description="{x:Bind domain:Translator.SettingsRendering_RelatedPrivacy_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_Title, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="Shield" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="RenderingRelatedReaderActionsCard"
            Command="{x:Bind ViewModel.OpenReaderActionsCommand}"
            Description="{x:Bind domain:Translator.SettingsRendering_RelatedReaderActions_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.ReaderActions_Title, Mode=OneTime}"
            IsClickEnabled="True">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon Icon="ReOrderDotsVertical" />
            </controls:SettingsCard.HeaderIcon>
        </controls:SettingsCard>
    </StackPanel>
</viewsAbstract:ReadComposePanePageAbstract>
