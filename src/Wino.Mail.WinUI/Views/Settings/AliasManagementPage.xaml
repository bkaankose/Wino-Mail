<abstract:AliasManagementPageAbstract
    x:Class="Wino.Views.Settings.AliasManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x509="using:System.Security.Cryptography.X509Certificates"
    x:Name="root"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Status is never colour alone: every badge carries its own glyph and label.  -->
        <Style x:Key="AliasBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,1,10,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="AliasRowTemplate" x:DataType="data:AliasManagementItem">
            <controls:SettingsExpander
                AutomationProperties.AutomationId="{x:Bind RowAutomationId}"
                AutomationProperties.Name="{x:Bind RowAutomationName}"
                Description="{x:Bind DescriptionText}"
                IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon>
                    <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Mail" />
                </controls:SettingsExpander.HeaderIcon>

                <controls:SettingsExpander.Header>
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind AliasAddress}"
                            TextTrimming="CharacterEllipsis" />

                        <Border
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorAttentionBrush}"
                            Style="{StaticResource AliasBadgeStyle}"
                            Visibility="{x:Bind IsPrimary}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Icon="Star" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind domain:Translator.AccountAlias_PrimaryBadge, Mode=OneTime}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorSuccessBrush}"
                            Style="{StaticResource AliasBadgeStyle}"
                            Visibility="{x:Bind IsCapabilityConfirmed}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Icon="Checkmark" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource AliasBadgeStyle}"
                            Visibility="{x:Bind IsCapabilityUnknown}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Icon="QuestionCircle" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource AliasBadgeStyle}"
                            Visibility="{x:Bind IsCapabilityDenied}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Icon="Dismiss" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </controls:SettingsExpander.Header>

                <!--
                    Primary and delete are rare, consequential commands, so they carry labels in the row's
                    own command flyout instead of sitting on the canvas as bare icons.
                -->
                <Button
                    AutomationProperties.AutomationId="{x:Bind MoreActionsAutomationId}"
                    AutomationProperties.Name="{x:Bind RowAutomationName}"
                    Style="{ThemeResource TransparentActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.AccountAlias_MoreActions, Mode=OneTime}">
                    <coreControls:WinoFontIcon
                        FontFamily="{ThemeResource WinoIconFontFamily}"
                        FontSize="14"
                        Icon="More" />
                    <Button.Flyout>
                        <contextFlyout:WinoContextFlyout Placement="BottomEdgeAlignedRight">
                            <contextFlyout:WinoContextFlyoutItem
                                AutomationId="AliasManagementSetPrimary"
                                Click="SetAliasPrimary_Click"
                                CommandParameter="{x:Bind Alias}"
                                IconGlyph="&#xE734;"
                                IsEnabled="{x:Bind CanSetPrimary}"
                                Text="{x:Bind domain:Translator.AccountAlias_SetPrimaryAction, Mode=OneTime}" />
                            <contextFlyout:WinoContextFlyoutItem
                                AutomationId="AliasManagementCopyAddress"
                                Click="CopyAliasAddress_Click"
                                CommandParameter="{x:Bind Alias}"
                                Text="{x:Bind domain:Translator.AccountAlias_CopyAddressAction, Mode=OneTime}" />
                            <contextFlyout:WinoContextFlyoutSeparator />
                            <contextFlyout:WinoContextFlyoutItem
                                AutomationId="AliasManagementDeleteAlias"
                                Click="DeleteAlias_Click"
                                CommandParameter="{x:Bind Alias}"
                                IconGlyph="&#xEEA6;"
                                IsDestructive="True"
                                IsEnabled="{x:Bind CanDelete}"
                                Text="{x:Bind domain:Translator.AccountAlias_DeleteAction, Mode=OneTime}" />
                        </contextFlyout:WinoContextFlyout>
                    </Button.Flyout>
                </Button>

                <controls:SettingsExpander.Items>
                    <!--  Only the two states that need one: what the status means for sending from here.  -->
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AliasManagementStatusDetailCard"
                        ContentAlignment="Left"
                        Visibility="{x:Bind HasStatusDetail}">
                        <TextBlock
                            MaxWidth="560"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind StatusDetailText}"
                            TextWrapping="Wrap" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AliasManagementEncryptionCard"
                        Description="{x:Bind domain:Translator.AccountAlias_Encryption_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.AccountAlias_Encryption_Title, Mode=OneTime}">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="LockClosed" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            AutomationProperties.AutomationId="{x:Bind EncryptionAutomationId}"
                            AutomationProperties.Name="{x:Bind domain:Translator.AccountAlias_Encryption_Title, Mode=OneTime}"
                            IsOn="{x:Bind IsSmimeEncryptionEnabled}"
                            Tag="{x:Bind}"
                            Toggled="SmimeToggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AliasManagementSigningCertificateCard"
                        Description="{x:Bind CertificateDescriptionText}"
                        Header="{x:Bind domain:Translator.SettingsSignatureAndEncryption_SigningCertificate, Mode=OneTime}"
                        IsEnabled="{x:Bind IsSmimeEncryptionEnabled}">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Certificate" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox
                            MinWidth="240"
                            AutomationProperties.AutomationId="{x:Bind SigningCertificateAutomationId}"
                            AutomationProperties.Name="{x:Bind domain:Translator.SettingsSignatureAndEncryption_SigningCertificate, Mode=OneTime}"
                            DropDownClosed="SigningCertificateDropDownClosed"
                            ItemsSource="{x:Bind Certificates}"
                            PlaceholderText="{x:Bind domain:Translator.SettingsSignatureAndEncryption_SigningCertificatePlaceholder, Mode=OneTime}"
                            SelectedItem="{x:Bind SelectedSigningCertificate, Mode=TwoWay}"
                            Tag="{x:Bind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x509:X509Certificate2">
                                    <TextBlock Text="{x:Bind Subject}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>

                    <!--  Read-only: the reply-to address is set where the alias itself is created.  -->
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="AliasManagementReplyToCard"
                        Description="{x:Bind domain:Translator.AccountAlias_ReplyTo_Description, Mode=OneTime}"
                        Header="{x:Bind domain:Translator.AccountAlias_ReplyTo_Title, Mode=OneTime}">
                        <controls:SettingsCard.HeaderIcon>
                            <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Reply" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ReplyToText}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            MaxWidth="1000"
            Padding="24,16,24,40"
            HorizontalAlignment="Stretch">

            <!--  Where aliases come from. Non-blocking, and dismissible once it has been read.  -->
            <InfoBar
                Title="{x:Bind domain:Translator.AccountAlias_Info_Title, Mode=OneTime}"
                AutomationProperties.AutomationId="AliasManagementInfoBar"
                IsClosable="True"
                IsOpen="True"
                Message="{x:Bind domain:Translator.AccountAlias_Info_Message, Mode=OneTime}"
                Severity="Informational" />

            <!--  A failed synchronization belongs next to the list it could not change, with its way back.  -->
            <InfoBar
                Title="{x:Bind domain:Translator.AccountAlias_SyncErrorTitle, Mode=OneTime}"
                Margin="0,8,0,0"
                AutomationProperties.AutomationId="AliasManagementSyncErrorInfoBar"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasSynchronizationError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SynchronizationError, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.AutomationId="AliasManagementSyncRetryButton"
                        Command="{x:Bind ViewModel.SyncAliasesCommand}"
                        Content="{x:Bind domain:Translator.Buttons_Retry, Mode=OneTime}"
                        IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsSynchronizing), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--  The count states what the list holds, so the commands do not have to.  -->
            <Grid Margin="0,16,0,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="AliasManagementSummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.AliasSummary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="AliasManagementSyncButton"
                    Command="{x:Bind ViewModel.SyncAliasesCommand}"
                    IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsSynchronizing), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanSynchronizeAliases, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Icon="Sync" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.Buttons_SyncAliases, Mode=OneTime}" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="AliasManagementAddButton"
                    Command="{x:Bind ViewModel.AddNewAliasCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="14"
                            Icon="Add" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.Buttons_AddNewAlias, Mode=OneTime}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Long work says what it is doing, next to the list it will replace.  -->
            <StackPanel
                Margin="0,0,0,12"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.AccountAlias_Loading, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Margin="0,0,0,12"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsSynchronizing, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsSynchronizing, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.AccountAlias_Synchronizing, Mode=OneTime}" />
            </StackPanel>

            <ItemsRepeater
                AutomationProperties.AutomationId="AliasManagementList"
                ItemTemplate="{StaticResource AliasRowTemplate}"
                ItemsSource="{x:Bind ViewModel.AliasItems, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!--  The absence is explained, and both ways out of it stay reachable.  -->
            <Border
                Padding="24"
                AutomationProperties.AutomationId="AliasManagementEmptyState"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.IsEmptyStateVisible, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <coreControls:WinoFontIcon
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Icon="Mail" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind domain:Translator.AccountAlias_Empty_Title, Mode=OneTime}" />
                    <TextBlock
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind domain:Translator.AccountAlias_Empty_Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="AliasManagementEmptySyncButton"
                            Command="{x:Bind ViewModel.SyncAliasesCommand}"
                            Content="{x:Bind domain:Translator.Buttons_SyncAliases, Mode=OneTime}"
                            IsEnabled="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(ViewModel.IsSynchronizing), Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanSynchronizeAliases, Mode=OneWay}" />
                        <Button
                            AutomationProperties.AutomationId="AliasManagementEmptyAddButton"
                            Command="{x:Bind ViewModel.AddNewAliasCommand}"
                            Content="{x:Bind domain:Translator.Buttons_AddNewAlias, Mode=OneTime}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</abstract:AliasManagementPageAbstract>
