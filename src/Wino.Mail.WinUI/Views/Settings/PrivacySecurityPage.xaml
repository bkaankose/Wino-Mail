<abstract:PrivacySecurityPageAbstract
    x:Class="Wino.Views.Settings.PrivacySecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ModeLoadsItemTemplate" x:DataType="x:String">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <coreControls:WinoFontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    FontFamily="{ThemeResource WinoIconFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Icon="Checkmark" />
                <TextBlock
                    Grid.Column="1"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ModeBlocksItemTemplate" x:DataType="x:String">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <coreControls:WinoFontIcon
                    Margin="0,3,0,0"
                    VerticalAlignment="Top"
                    FontFamily="{ThemeResource WinoIconFontFamily}"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Icon="Dismiss" />
                <TextBlock
                    Grid.Column="1"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{x:Bind}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RemoteContentModeTemplate" x:DataType="data:RemoteContentModeOption">
            <ItemContainer AutomationProperties.HelpText="{x:Bind Tagline}" AutomationProperties.Name="{x:Bind Title}">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind Title}"
                                TextWrapping="WrapWholeWords" />
                            <Border
                                Grid.Column="1"
                                Padding="8,1,8,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                Visibility="{x:Bind IsRecommended}">
                                <TextBlock
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind RecommendedText}" />
                            </Border>
                        </Grid>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind Tagline}"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind LoadsHeader}" />
                        <ItemsControl
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ModeLoadsItemTemplate}"
                            ItemsSource="{x:Bind Loads}" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind BlocksHeader}" />
                        <ItemsControl
                            IsTabStop="False"
                            ItemTemplate="{StaticResource ModeBlocksItemTemplate}"
                            ItemsSource="{x:Bind Blocks}" />

                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Note}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Spacing="{StaticResource SettingsCardSpacing}">
        <!--  Summary of the current protection  -->
        <Grid
            Padding="16,12"
            AutomationProperties.AutomationId="PrivacySecurityHero"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="14"
            CornerRadius="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <coreControls:WinoFontIcon
                VerticalAlignment="Center"
                FontFamily="{ThemeResource WinoIconFontFamily}"
                FontSize="24"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Icon="Shield" />
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="2">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.HeroTitle, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.HeroDescription, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>

        <!--  Remote content  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_RemoteContentHeader, Mode=OneTime}" />

        <ItemsView
            x:Name="ModePicker"
            AutomationProperties.AutomationId="PrivacySecurityModePicker"
            AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_RemoteContentHeader, Mode=OneTime}"
            ItemTemplate="{StaticResource RemoteContentModeTemplate}"
            ItemsSource="{x:Bind ViewModel.ModeOptions, Mode=OneTime}"
            Loaded="ModePicker_Loaded"
            SelectionChanged="ModePicker_SelectionChanged"
            SelectionMode="Single">
            <ItemsView.Layout>
                <coreControls:EqualHeightGridLayout
                    ColumnSpacing="8"
                    MinItemWidth="240"
                    RowSpacing="8" />
            </ItemsView.Layout>
        </ItemsView>

        <InfoBar
            Margin="0,4,0,0"
            AutomationProperties.AutomationId="PrivacySecurityJunkInfoBar"
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind domain:Translator.PrivacySecurity_JunkInfo, Mode=OneTime}"
            Severity="Informational" />

        <!--  Exceptions  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_ExceptionsHeader, Mode=OneTime}" />

        <controls:SettingsExpander
            AutomationProperties.AutomationId="PrivacySecuritySenderRulesExpander"
            Description="{x:Bind domain:Translator.PrivacySecurity_SenderRules_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_SenderRules_Title, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="People" />
            </controls:SettingsExpander.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.RuleCountText, Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="PrivacySecurityManageRulesButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.RemoteContentRules_Title, Mode=OneTime}"
                    Command="{x:Bind ViewModel.OpenSenderRulesCommand}"
                    Content="{x:Bind domain:Translator.PrivacySecurity_SenderRules_Manage, Mode=OneTime}" />
            </StackPanel>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="PrivacySecurityContactsCard"
                    Description="{x:Bind domain:Translator.PrivacySecurity_Contacts_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.PrivacySecurity_Contacts_Title, Mode=OneTime}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="PrivacySecurityContactsToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_Contacts_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.LoadRemoteContentFromContacts, Mode=TwoWay}" />
                </controls:SettingsCard>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="PrivacySecurityRecipientsCard"
                    Description="{x:Bind domain:Translator.PrivacySecurity_Recipients_Description, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.PrivacySecurity_Recipients_Title, Mode=OneTime}">
                    <ToggleSwitch
                        AutomationProperties.AutomationId="PrivacySecurityRecipientsToggle"
                        AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_Recipients_Title, Mode=OneTime}"
                        IsOn="{x:Bind ViewModel.PreferencesService.LoadRemoteContentFromRecipients, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  Links  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_LinksHeader, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="PrivacySecurityStripLinksCard"
            Description="{x:Bind domain:Translator.PrivacySecurity_StripLinks_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_StripLinks_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="LinkDismiss" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="PrivacySecurityStripLinksToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_StripLinks_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.StripLinkTrackingParameters, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="PrivacySecurityConfirmLinksCard"
            Description="{x:Bind domain:Translator.PrivacySecurity_ConfirmLinks_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_ConfirmLinks_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Link" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="PrivacySecurityConfirmLinksToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_ConfirmLinks_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.ConfirmBeforeOpeningLinks, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            AutomationProperties.AutomationId="PrivacySecurityLinkBrowserSettingsExpander"
            Description="{x:Bind domain:Translator.SettingsLinkBrowser_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.SettingsLinkBrowser_Title, Mode=OneTime}"
            Visibility="{x:Bind ViewModel.IsLinkBrowserSupported, Mode=OneTime}">
            <controls:SettingsExpander.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Globe" />
            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.ItemsHeader>
                <InfoBar
                    AutomationProperties.AutomationId="PrivacySecurityLinkBrowserCustomisedAccountsInfoBar"
                    BorderThickness="0"
                    CornerRadius="0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasCustomisedLinkBrowserAccounts, Mode=OneWay}"
                    Message="{x:Bind ViewModel.CustomisedLinkBrowserAccountsText, Mode=OneWay}"
                    Severity="Informational" />
            </controls:SettingsExpander.ItemsHeader>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="PrivacySecurityLinkBrowserScopeCard"
                    Description="{x:Bind ViewModel.LinkBrowserScopeDescription, Mode=OneWay}"
                    Header="{x:Bind domain:Translator.SettingsActionScope_Title, Mode=OneTime}"
                    Visibility="{x:Bind ViewModel.IsLinkBrowserScopeAvailable, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            AutomationProperties.AutomationId="PrivacySecurityLinkBrowserUseAllAccountsButton"
                            Command="{x:Bind ViewModel.UseAllAccountsLinkBrowserCommand}"
                            Content="{x:Bind domain:Translator.SettingsLinkBrowser_UseAllAccounts, Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.CanUseAllAccountsLinkBrowser, Mode=OneWay}" />
                        <ComboBox
                            Width="220"
                            AutomationProperties.AutomationId="PrivacySecurityLinkBrowserScopeComboBox"
                            AutomationProperties.Name="{x:Bind domain:Translator.SettingsActionScope_Title, Mode=OneTime}"
                            ItemsSource="{x:Bind ViewModel.LinkBrowserScopeOptions, Mode=OneWay}"
                            SelectedIndex="{x:Bind ViewModel.SelectedLinkBrowserScopeIndex, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>
                <controls:SettingsCard
                    AutomationProperties.AutomationId="PrivacySecurityLinkBrowserCard"
                    Description="{x:Bind ViewModel.LinkBrowserDescription, Mode=OneWay}"
                    Header="{x:Bind domain:Translator.SettingsLinkBrowser_Browser, Mode=OneTime}">
                    <ComboBox
                        MinWidth="220"
                        MaxWidth="360"
                        AutomationProperties.AutomationId="PrivacySecurityLinkBrowserComboBox"
                        AutomationProperties.Name="{x:Bind domain:Translator.SettingsLinkBrowser_Browser, Mode=OneTime}"
                        ItemsSource="{x:Bind ViewModel.LinkBrowserOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedLinkBrowserIndex, Mode=TwoWay}" />
                </controls:SettingsCard>
            </controls:SettingsExpander.Items>
        </controls:SettingsExpander>

        <!--  Senders  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_SendersHeader, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="PrivacySecurityShowSenderAddressCard"
            Description="{x:Bind domain:Translator.PrivacySecurity_ShowSenderAddress_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_ShowSenderAddress_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Person" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="PrivacySecurityShowSenderAddressToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_ShowSenderAddress_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.AlwaysShowSenderAddress, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!--  Attachments  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_AttachmentsHeader, Mode=OneTime}" />

        <controls:SettingsCard
            AutomationProperties.AutomationId="PrivacySecurityPlatformSecurityCard"
            Description="{x:Bind domain:Translator.PrivacySecurity_PlatformSecurity_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_PlatformSecurity_Title, Mode=OneTime}"
            Visibility="{x:Bind ViewModel.IsAttachmentSecurityCheckAvailable, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Shield" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="PrivacySecurityPlatformSecurityToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_PlatformSecurity_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.CheckAttachmentsWithPlatformSecurity, Mode=TwoWay}" />
        </controls:SettingsCard>

        <controls:SettingsCard
            AutomationProperties.AutomationId="PrivacySecurityExecutableWarningCard"
            Description="{x:Bind domain:Translator.PrivacySecurity_ExecutableWarning_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_ExecutableWarning_Title, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Attachment" />
            </controls:SettingsCard.HeaderIcon>
            <ToggleSwitch
                AutomationProperties.AutomationId="PrivacySecurityExecutableWarningToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.PrivacySecurity_ExecutableWarning_Title, Mode=OneTime}"
                IsOn="{x:Bind ViewModel.PreferencesService.WarnBeforeOpeningExecutableAttachments, Mode=TwoWay}" />
        </controls:SettingsCard>

        <!--  Related settings  -->
        <TextBlock
            Margin="0,12,0,4"
            Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
            Text="{x:Bind domain:Translator.PrivacySecurity_RelatedHeader, Mode=OneTime}" />

        <coreControls:WinoSettingsCard
            AutomationProperties.AutomationId="PrivacySecurityRelatedNotificationsCard"
            Command="{x:Bind ViewModel.OpenNotificationSettingsCommand}"
            Description="{x:Bind domain:Translator.PrivacySecurity_RelatedNotifications_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_RelatedNotifications_Title, Mode=OneTime}"
            IsClickEnabled="True"
            Visibility="{x:Bind ViewModel.IsNotificationsLinkAvailable, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Alert" />
            </controls:SettingsCard.HeaderIcon>
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.NotificationContentText, Mode=OneWay}" />
        </coreControls:WinoSettingsCard>

        <coreControls:WinoSettingsCard
            AutomationProperties.AutomationId="PrivacySecurityRelatedSignaturesCard"
            Command="{x:Bind ViewModel.OpenSignatureAndEncryptionCommand}"
            Description="{x:Bind domain:Translator.PrivacySecurity_RelatedSignatures_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_RelatedSignatures_Title, Mode=OneTime}"
            IsClickEnabled="True"
            Visibility="{x:Bind ViewModel.IsSignaturesLinkAvailable, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Certificate" />
            </controls:SettingsCard.HeaderIcon>
        </coreControls:WinoSettingsCard>

        <coreControls:WinoSettingsCard
            AutomationProperties.AutomationId="PrivacySecurityRelatedIntelligenceCard"
            Command="{x:Bind ViewModel.OpenWinoIntelligencePrivacyCommand}"
            Description="{x:Bind domain:Translator.PrivacySecurity_RelatedIntelligence_Description, Mode=OneTime}"
            Header="{x:Bind domain:Translator.PrivacySecurity_RelatedIntelligence_Title, Mode=OneTime}"
            IsClickEnabled="True"
            Visibility="{x:Bind ViewModel.IsIntelligenceLinkAvailable, Mode=OneTime}">
            <controls:SettingsCard.HeaderIcon>
                <coreControls:WinoFontIcon FontFamily="{ThemeResource WinoIconFontFamily}" Icon="Sparkle" />
            </controls:SettingsCard.HeaderIcon>
        </coreControls:WinoSettingsCard>
    </StackPanel>
</abstract:PrivacySecurityPageAbstract>
