<abstract:KeyboardShortcutsPageAbstract
    x:Class="Wino.Views.Settings.KeyboardShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Core.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    Title="{x:Bind domain:Translator.Settings_KeyboardShortcuts_Title, Mode=OneTime}"
    mc:Ignorable="d">

    <!--  Main Content  -->
    <Grid Grid.Row="0">
        <!--  Shortcuts List  -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                AutomationProperties.AutomationId="KeyboardShortcutsAdd"
                Command="{x:Bind ViewModel.StartAddingShortcutCommand}"
                Content="{x:Bind domain:Translator.KeyboardShortcuts_Add, Mode=OneTime}" />
            <Button
                AutomationProperties.AutomationId="KeyboardShortcutsReset"
                Command="{x:Bind ViewModel.ResetToDefaultsCommand}"
                Content="{x:Bind domain:Translator.KeyboardShortcuts_ResetToDefaults, Mode=OneTime}"
                Style="{ThemeResource AccentButtonStyle}" />
        </StackPanel>

        <ProgressRing
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="KeyboardShortcutsLoading"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Title="{x:Bind domain:Translator.GeneralTitle_Error, Mode=OneTime}"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="KeyboardShortcutsError"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="KeyboardShortcutsEmpty"
            Text="{x:Bind domain:Translator.KeyboardShortcuts_Empty, Mode=OneTime}"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.IsEmpty), Mode=OneWay}" />

        <ListView
            Grid.Row="1"
            AutomationProperties.AutomationId="KeyboardShortcutsList"
            ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:KeyboardShortcutViewModel">
                    <Border
                        Margin="0,4"
                        Padding="16,12"
                        helpers:Accessibility.ContainerName="{x:Bind helpers:XamlHelpers.GetShortcutAutomationName(ActionDisplayName, DisplayName, ModeDisplayName), Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Margin="0,0,0,4"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ActionDisplayName}" />
                                <TextBlock
                                    Opacity="0.8"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DisplayName}" />
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{x:Bind ModeDisplayName}" />

                            <ToggleSwitch
                                Grid.Column="2"
                                Margin="8,0"
                                AutomationProperties.AutomationId="KeyboardShortcutEnabled"
                                AutomationProperties.Name="{x:Bind helpers:XamlHelpers.FormatAutomationName(domain:Translator.Accessibility_ShortcutEnabled, ActionDisplayName), Mode=OneWay}"
                                IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                OffContent="{x:Bind domain:Translator.CalendarSettings_Toggle_Off, Mode=OneTime}"
                                OnContent="{x:Bind domain:Translator.CalendarSettings_Toggle_On, Mode=OneTime}"
                                Tag="{x:Bind}"
                                Toggled="ShortcutEnabled_Toggled" />

                            <Button
                                Grid.Column="3"
                                Margin="4,0"
                                AutomationProperties.AutomationId="KeyboardShortcutEdit"
                                AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetItemActionAutomationName(domain:Translator.Buttons_Edit, ActionDisplayName), Mode=OneWay}"
                                Click="EditShortcut_Click"
                                CommandParameter="{x:Bind}"
                                Content="&#xE70F;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{ThemeResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind domain:Translator.Buttons_Edit, Mode=OneTime}" />

                            <Button
                                Grid.Column="4"
                                Margin="4,0"
                                AutomationProperties.AutomationId="KeyboardShortcutDelete"
                                AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetItemActionAutomationName(domain:Translator.Buttons_Delete, ActionDisplayName), Mode=OneWay}"
                                Click="DeleteShortcut_Click"
                                CommandParameter="{x:Bind}"
                                Content="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                Style="{ThemeResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</abstract:KeyboardShortcutsPageAbstract>
