                ItemsSource="{x:Bind ViewModel.MailSpacingOptions, Mode=OneTime}"
                SelectedIndex="{x:Bind ViewModel.SelectedMailSpacingIndex, Mode=TwoWay}" />
        </controls:SettingsCard>

