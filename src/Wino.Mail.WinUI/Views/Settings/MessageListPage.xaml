            </controls:SettingsExpander.HeaderIcon>
            <controls:SettingsExpander.Items>
                <controls:SettingsCard AutomationProperties.AutomationId="MessageListPageSettingsCard3" Header="{x:Bind domain:Translator.SettingsEnableHoverActions_Title}">
                    <controls:SettingsCard.Content>
                        <ToggleSwitch
