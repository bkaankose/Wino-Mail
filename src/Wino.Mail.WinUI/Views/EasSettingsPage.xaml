<abstract:EasSettingsPageAbstract
    x:Class="Wino.Views.EasSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:domain="using:Wino.Core.Domain">
    <ScrollViewer>
        <StackPanel
            MaxWidth="440"
            Margin="24"
            HorizontalAlignment="Center"
            Spacing="16">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Exchange ActiveSync" />
            <TextBlock Text="{x:Bind domain:Translator.EAS_Description, Mode=OneTime}" TextWrapping="Wrap" />
            <TextBox
                AutomationProperties.AutomationId="EasEmail"
                Header="{x:Bind domain:Translator.ProviderSelection_EmailHeader, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.IsCreateMode, Mode=OneWay}"
                Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                AutomationProperties.AutomationId="EasSenderName"
                Header="{x:Bind domain:Translator.ProviderSelection_DisplayNameHeader, Mode=OneTime}"
                IsEnabled="{x:Bind ViewModel.IsCreateMode, Mode=OneWay}"
                Text="{x:Bind ViewModel.SenderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                AutomationProperties.AutomationId="EasEndpoint"
                Header="{x:Bind domain:Translator.EAS_ServerUrl, Mode=OneTime}"
                PlaceholderText="https://mail.example.com/Microsoft-Server-ActiveSync"
                Text="{x:Bind ViewModel.Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox
                AutomationProperties.AutomationId="EasUsername"
                Header="{x:Bind domain:Translator.EAS_Username, Mode=OneTime}"
                Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <PasswordBox
                AutomationProperties.AutomationId="EasPassword"
                Header="{x:Bind domain:Translator.ProviderSelection_PasswordHeader_Account, Mode=OneTime}"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
            <TextBlock
                AutomationProperties.AutomationId="EasError"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ProgressRing IsActive="{x:Bind ViewModel.SaveCommand.IsRunning, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="EasSave"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="{x:Bind domain:Translator.ProviderSelection_ContinueButton, Mode=OneTime}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</abstract:EasSettingsPageAbstract>
