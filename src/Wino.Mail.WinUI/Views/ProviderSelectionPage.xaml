<abstract:ProviderSelectionPageAbstract
    x:Class="Wino.Views.ProviderSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:accounts="using:Wino.Core.Domain.Models.Accounts"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:interfaces="using:Wino.Core.Domain.Interfaces"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winoControls="using:Wino.Controls"
    x:Name="root"
    mc:Ignorable="d">

    <!--
        Header, content, then the buttons directly beneath the content. Top alignment keeps the grid at its
        content height, so the buttons follow the content instead of the bottom of the window.
    -->
    <Grid
        MaxWidth="880"
        Margin="0,12"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Grid
            x:Name="ProviderStepPanel"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsProviderStepVisible, Mode=OneWay}">
            <!--  Popular providers: one tile each, plus the door into the catalog. Hugs its content.  -->
            <Border
                Padding="12"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsFeaturedListVisible, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_ProviderSectionTitle, Mode=OneTime}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.ProviderSelection_ProviderSectionDescription, Mode=OneTime}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!--  Tiles and the catalog entry share one column with no gap, so they read as one list  -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ItemsView
                            x:Name="FeaturedProvidersView"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ProviderSelectionFeaturedProviders"
                            ItemsSource="{x:Bind ViewModel.FeaturedProviders, Mode=OneWay}"
                            SelectionChanged="ProviderSelectionChanged"
                            SelectionMode="Single">
                            <ItemsView.ItemTemplate>
                                <DataTemplate x:DataType="interfaces:IProviderDetail">
                                    <ItemContainer
                                        Padding="12,10"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.HelpText="{x:Bind Description}"
                                        AutomationProperties.Name="{x:Bind Name}">
                                        <Grid Padding="16" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <coreControls:WinoFontIcon
                                                VerticalAlignment="Center"
                                                FontSize="32"
                                                Icon="{x:Bind helpers:XamlHelpers.GetProviderIcon(Type, SpecialImapProvider)}" />

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Description}"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Grid>
                                    </ItemContainer>
                                </DataTemplate>
                            </ItemsView.ItemTemplate>
                        </ItemsView>

                        <!--  Same metrics as a tile: 16px inset, 32px icon, 12px gap, no chrome until hovered  -->
                        <Button
                            Grid.Row="1"
                            Padding="16"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ProviderSelectionMoreProviders"
                            AutomationProperties.HelpText="{x:Bind domain:Translator.ProviderSelection_MoreProviders_Description, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_MoreProviders_Title, Mode=OneTime}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.ShowCatalogCommand}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Icon="ProviderCatalog" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_MoreProviders_Title, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind domain:Translator.ProviderSelection_MoreProviders_Description, Mode=OneTime}"
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <coreControls:WinoFontIcon
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Icon="ArrowRight" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!--  Catalog: hugs its content; the provider list is capped and scrolls inside  -->
            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsCatalogVisible, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Catalog_SectionTitle, Mode=OneTime}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind domain:Translator.ProviderSelection_Catalog_SectionDescription, Mode=OneTime}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Grid>

                    <!--
                        "This": your own server, pinned first so a manual setup is never buried under the brands.
                        A one-item ItemsView so it shows the same accent selection border as every provider, and
                        it starts selected when the catalog opens.
                    -->
                    <ItemsView
                        x:Name="CustomServerView"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="ProviderSelectionCustomServer"
                        ItemsSource="{x:Bind ViewModel.CustomServerProviders, Mode=OneWay}"
                        SelectionChanged="ProviderSelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="interfaces:IProviderDetail">
                                <ItemContainer
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="{x:Bind Description}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                    <Grid Padding="16,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <coreControls:WinoFontIcon
                                            VerticalAlignment="Center"
                                            FontSize="32"
                                            Icon="{x:Bind helpers:XamlHelpers.GetProviderIcon(Type, SpecialImapProvider)}" />

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Grid>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>

                    <!--  "or that": a divider with the choice spelled out, then the searchable brand list  -->
                    <Grid
                        Grid.Row="2"
                        Margin="0,4"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.ProviderSelection_Catalog_KnownProvidersHeader, Mode=OneTime}" />
                        <Rectangle
                            Grid.Column="2"
                            Height="1"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="CatalogSearchBox"
                            AutomationProperties.AutomationId="ProviderSelectionCatalogSearch"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_Catalog_SearchPlaceholder, Mode=OneTime}"
                            PlaceholderText="{x:Bind domain:Translator.ProviderSelection_Catalog_SearchPlaceholder, Mode=OneTime}"
                            Text="{x:Bind ViewModel.CatalogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ProviderSelectionCatalogResultCount"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.CatalogResultCountText, Mode=OneWay}" />
                    </Grid>

                    <!--  Star row: capped by MaxHeight and scrolls inside  -->
                    <ItemsView
                        x:Name="CatalogProvidersView"
                        Grid.Row="4"
                        MaxHeight="400"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="ProviderSelectionCatalogProviders"
                        ItemsSource="{x:Bind ViewModel.FilteredCatalogProviders, Mode=OneWay}"
                        SelectionChanged="ProviderSelectionChanged"
                        SelectionMode="Single">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="2"
                                MinColumnSpacing="8"
                                MinItemWidth="300"
                                MinRowSpacing="6" />
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="interfaces:IProviderDetail">
                                <ItemContainer
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="{x:Bind Description}"
                                    AutomationProperties.Name="{x:Bind Name}">
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <coreControls:WinoFontIcon
                                            VerticalAlignment="Center"
                                            FontSize="28"
                                            Icon="{x:Bind helpers:XamlHelpers.GetProviderIcon(Type, SpecialImapProvider)}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>

                    <TextBlock
                        Grid.Row="5"
                        AutomationProperties.AutomationId="ProviderSelectionCatalogNoResults"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CatalogNoResultsText, Mode=OneWay}"
                        TextWrapping="WrapWholeWords"
                        Visibility="{x:Bind ViewModel.IsCatalogEmpty, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Identity and capability steps can be taller than the window, so they scroll on their own  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsProviderStepVisible), Mode=OneWay}">
            <StackPanel Spacing="20">
                <!--  Chosen provider, kept in view on every step after the provider step  -->
                <Border
                    x:Name="AccountSummaryPanel"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsAccountSummaryVisible, Mode=OneWay}">
                    <Grid
                        AutomationProperties.AutomationId="ProviderSelectionAccountSummary"
                        AutomationProperties.Name="{x:Bind ViewModel.SelectedProviderName, Mode=OneWay}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}" CornerRadius="2" />

                        <coreControls:WinoFontIcon
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="28"
                            Icon="{x:Bind helpers:XamlHelpers.GetProviderIcon(ViewModel.SelectedProvider.Type, ViewModel.SelectedProvider.SpecialImapProvider), Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedProviderName, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedProviderSummaryDetail, Mode=OneWay}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Padding="12,8"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ProviderSelectionAccountColor"
                            AutomationProperties.HelpText="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Description, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}"
                            ToolTipService.ToolTip="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}">
                            <Grid>
                                <coreControls:WinoFontIcon
                                    FontSize="16"
                                    Icon="PaintBrush"
                                    Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsColorSelected), Mode=OneWay}" />
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                            </Grid>
                            <Button.Flyout>
                                <Flyout x:Name="AccountColorFlyout" Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="8">
                                        <GridView
                                            x:Name="AccountColorGridView"
                                            Width="150"
                                            AutomationProperties.AutomationId="AccountColorGridView"
                                            AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}"
                                            ItemTemplate="{StaticResource AccountColorTemplate}"
                                            ItemsSource="{x:Bind ViewModel.AvailableColors, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                                        <HyperlinkButton
                                            HorizontalAlignment="Center"
                                            AutomationProperties.AutomationId="ProviderSelectionClearColor"
                                            Command="{x:Bind ViewModel.ClearColorCommand}"
                                            Content="{x:Bind domain:Translator.ProviderSelection_ClearColor, Mode=OneTime}"
                                            Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>

                <!--  Account identity step  -->
                <Border
                    x:Name="IdentityStepPanel"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsIdentityStepVisible, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBox
                            AutomationProperties.AutomationId="ProviderSelectionAccountName"
                            Header="{x:Bind domain:Translator.ProviderSelection_AccountNameHeader, Mode=OneTime}"
                            PlaceholderText="{x:Bind domain:Translator.ProviderSelection_AccountNamePlaceholder, Mode=OneTime}"
                            Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.ProviderSelection_AccountNameDescription, Mode=OneTime}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsCapabilityStepVisible, Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <StackPanel Margin="0,0,0,12" Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_CapabilitySectionTitle, Mode=OneTime}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind domain:Translator.ProviderSelection_CapabilityIntroDescription, Mode=OneTime}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <!--  The same picker edits an existing IMAP account's capabilities in its server settings.  -->
                        <winoControls:AccountCapabilityPicker
                            AutomationProperties.AutomationId="ProviderSelectionCapabilityPicker"
                            Selection="{x:Bind ViewModel.Capabilities}"
                            ShowMailOptions="True">
                            <winoControls:AccountCapabilityPicker.MailOptionsContent>
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind domain:Translator.ProviderSelection_MailRangeHeader, Mode=OneTime}" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind domain:Translator.ProviderSelection_MailRangeDescription, Mode=OneTime}"
                                                TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            MinWidth="160"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationRange"
                                            AutomationProperties.Name="{x:Bind domain:Translator.AccountCreation_InitialSynchronization_Title, Mode=OneTime}"
                                            ItemsSource="{x:Bind ViewModel.InitialSynchronizationRanges, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedInitialSynchronizationRange, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="accounts:InitialSynchronizationRangeOption">
                                                    <TextBlock Text="{x:Bind DisplayText}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <InfoBar
                                        Title="{x:Bind domain:Translator.GeneralTitle_Warning, Mode=OneTime}"
                                        AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationWarning"
                                        IsClosable="False"
                                        IsOpen="{x:Bind ViewModel.IsInitialSynchronizationWarningVisible, Mode=OneWay}"
                                        Message="{x:Bind domain:Translator.AccountCreation_InitialSynchronization_EverythingWarning, Mode=OneTime}"
                                        Severity="Warning" />
                                </StackPanel>
                            </winoControls:AccountCapabilityPicker.MailOptionsContent>
                        </winoControls:AccountCapabilityPicker>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <InfoBar
                            AutomationProperties.AutomationId="ProviderSelectionCalendarOnlyHint"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind domain:Translator.ProviderSelection_CalendarOnlyServerHint, Mode=OneTime}"
                            Severity="Informational"
                            Visibility="{x:Bind ViewModel.IsCalendarOnlyServerHintVisible, Mode=OneWay}" />

                        <InfoBar
                            AutomationProperties.AutomationId="ProviderSelectionLocalOnlyHint"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind domain:Translator.ProviderSelection_LocalOnlyHint, Mode=OneTime}"
                            Severity="Informational"
                            Visibility="{x:Bind ViewModel.IsLocalOnlyHintVisible, Mode=OneWay}" />

                        <InfoBar
                            AutomationProperties.AutomationId="ProviderSelectionCardDavDiscoveryHint"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{x:Bind ViewModel.DavContactAvailabilityMessage, Mode=OneWay}"
                            Severity="Informational"
                            Visibility="{x:Bind ViewModel.IsCardDavDiscoveryHintVisible, Mode=OneWay}" />

                        <TextBlock
                            Margin="2,0"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.ProviderSelection_CapabilityValidationMessage, Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.IsCapabilitySelectionMissing, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                AutomationProperties.AutomationId="ProviderSelectionBackButton"
                Command="{x:Bind ViewModel.GoBackCommand}"
                Content="{x:Bind domain:Translator.Buttons_Back, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                MinWidth="140"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ProviderSelectionContinueButton"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Content="{x:Bind ViewModel.ContinueButtonText, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</abstract:ProviderSelectionPageAbstract>
