<abstract:ProviderSelectionPageAbstract
    x:Class="Wino.Views.ProviderSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Mail.WinUI.Views.Abstract"
    xmlns:accounts="using:Wino.Core.Domain.Models.Accounts"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:interfaces="using:Wino.Core.Domain.Interfaces"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardHeaderIconMaxSize">36</x:Double>
    </Page.Resources>

    <StackPanel
        MaxWidth="880"
        Margin="0,12"
        HorizontalAlignment="Stretch"
        Spacing="20">

        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}"
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <Border
            x:Name="ProviderStepPanel"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="{x:Bind ViewModel.IsProviderStepVisible, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        AutomationProperties.AutomationId="ProviderSelectionAccountName"
                        Header="{x:Bind domain:Translator.ProviderSelection_AccountNameHeader, Mode=OneTime}"
                        PlaceholderText="{x:Bind domain:Translator.ProviderSelection_AccountNamePlaceholder, Mode=OneTime}"
                        Text="{x:Bind ViewModel.AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="1"
                        Padding="12,8"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ProviderSelectionAccountColor"
                        AutomationProperties.HelpText="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Description, Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}">
                        <Grid>
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE771;"
                                Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(ViewModel.IsColorSelected), Mode=OneWay}" />
                            <Ellipse
                                Width="16"
                                Height="16"
                                Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="AccountColorFlyout" Placement="TopEdgeAlignedLeft">
                                <StackPanel Spacing="8">
                                    <GridView
                                        x:Name="AccountColorGridView"
                                        Width="150"
                                        AutomationProperties.AutomationId="AccountColorGridView"
                                        AutomationProperties.Name="{x:Bind domain:Translator.AccountDetailsPage_ColorPicker_Title, Mode=OneTime}"
                                        ItemTemplate="{StaticResource AccountColorTemplate}"
                                        ItemsSource="{x:Bind ViewModel.AvailableColors, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}" />
                                    <HyperlinkButton
                                        HorizontalAlignment="Center"
                                        AutomationProperties.AutomationId="ProviderSelectionClearColor"
                                        Command="{x:Bind ViewModel.ClearColorCommand}"
                                        Content="{x:Bind domain:Translator.ProviderSelection_ClearColor, Mode=OneTime}"
                                        Visibility="{x:Bind ViewModel.IsColorSelected, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_ProviderSectionTitle, Mode=OneTime}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind domain:Translator.ProviderSelection_ProviderSectionDescription, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <ItemsView
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Providers, Mode=OneWay}"
                    SelectionChanged="ProviderSelectionChanged"
                    SelectionMode="Single">
                    <ItemsView.ItemTemplate>
                        <DataTemplate x:DataType="interfaces:IProviderDetail">
                            <ItemContainer
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.HelpText="{x:Bind Description}"
                                AutomationProperties.Name="{x:Bind Name}">
                                <Grid Padding="16" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Image
                                        Width="32"
                                        Height="32"
                                        Source="{x:Bind ProviderImage}" />

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Description}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </ItemContainer>
                        </DataTemplate>
                    </ItemsView.ItemTemplate>
                </ItemsView>
            </StackPanel>
        </Border>

        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.IsCapabilityStepVisible, Mode=OneWay}">
            <Border
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.SelectedColor.Hex), Mode=OneWay}" CornerRadius="2" />

                    <Image
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Source="{x:Bind helpers:XamlHelpers.StringToBitmapImage(ViewModel.SelectedProviderImage), Mode=OneWay}" />

                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SelectedProviderName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.AccountName, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="4">
                <StackPanel Margin="0,0,0,12" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_CapabilitySectionTitle, Mode=OneTime}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind domain:Translator.ProviderSelection_CapabilityIntroDescription, Mode=OneTime}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <controls:SettingsExpander
                    AutomationProperties.AutomationId="ProviderSelectionMailExpander"
                    Description="{x:Bind domain:Translator.ProviderSelection_MailStepDescription, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.ProviderSelection_UseForMail, Mode=OneTime}"
                    IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon
                            Width="36"
                            Height="36"
                            Source="ms-appx:///Assets/AppEntries/Mail.svg" />
                    </controls:SettingsExpander.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.AutomationId="ProviderSelectionMailMode"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_UseForMail, Mode=OneTime}"
                            SelectedIndex="{x:Bind ViewModel.MailModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                        </ComboBox>
                        <FontIcon
                            AutomationProperties.HelpText="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            FontSize="14"
                            Glyph="&#xE946;">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.MailProviderChoiceDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.MailOffConsequenceText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </FontIcon>
                    </StackPanel>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard
                            AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationRangeCard"
                            Description="{x:Bind domain:Translator.ProviderSelection_MailRangeDescription, Mode=OneTime}"
                            Header="{x:Bind domain:Translator.ProviderSelection_MailRangeHeader, Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.IsMailSynchronizationRangeVisible, Mode=OneWay}">
                            <ComboBox
                                MinWidth="160"
                                AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationRange"
                                AutomationProperties.Name="{x:Bind domain:Translator.AccountCreation_InitialSynchronization_Title, Mode=OneTime}"
                                ItemsSource="{x:Bind ViewModel.InitialSynchronizationRanges, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedInitialSynchronizationRange, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="accounts:InitialSynchronizationRangeOption">
                                        <TextBlock Text="{x:Bind DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationWarningCard"
                            ContentAlignment="Vertical"
                            Visibility="{x:Bind ViewModel.IsInitialSynchronizationWarningVisible, Mode=OneWay}">
                            <InfoBar
                                Title="{x:Bind domain:Translator.GeneralTitle_Warning, Mode=OneTime}"
                                AutomationProperties.AutomationId="ProviderSelectionMailSynchronizationWarning"
                                IsClosable="False"
                                IsOpen="True"
                                Message="{x:Bind domain:Translator.AccountCreation_InitialSynchronization_EverythingWarning, Mode=OneTime}"
                                Severity="Warning" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="ProviderSelectionCalendarCard"
                    Description="{x:Bind domain:Translator.ProviderSelection_CalendarStepDescription, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.ProviderSelection_UseForCalendar, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon
                            Width="36"
                            Height="36"
                            Source="ms-appx:///Assets/AppEntries/Calendar.svg" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.AutomationId="ProviderSelectionCalendarMode"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_UseForCalendar, Mode=OneTime}"
                            SelectedIndex="{x:Bind ViewModel.CalendarModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" Visibility="{x:Bind ViewModel.IsCalendarProviderModeAvailable, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                        </ComboBox>
                        <FontIcon
                            AutomationProperties.HelpText="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            FontSize="14"
                            Glyph="&#xE946;">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.CalendarProviderChoiceDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind domain:Translator.ProviderSelection_Why_CalendarLocal, Mode=OneTime}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.CalendarOffConsequenceText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </FontIcon>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="ProviderSelectionContactsCard"
                    Description="{x:Bind domain:Translator.ProviderSelection_ContactsStepDescription, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.ProviderSelection_UseForContacts, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon
                            Width="36"
                            Height="36"
                            Source="ms-appx:///Assets/AppEntries/People.svg" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.AutomationId="ProviderSelectionContactMode"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_UseForContacts, Mode=OneTime}"
                            SelectedIndex="{x:Bind ViewModel.ContactModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" Visibility="{x:Bind ViewModel.IsContactProviderModeAvailable, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                        </ComboBox>
                        <FontIcon
                            AutomationProperties.HelpText="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            FontSize="14"
                            Glyph="&#xE946;">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContactProviderChoiceDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind domain:Translator.ProviderSelection_Why_ContactsLocal, Mode=OneTime}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.ContactOffConsequenceText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </FontIcon>
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    AutomationProperties.AutomationId="ProviderSelectionTasksCard"
                    Description="{x:Bind domain:Translator.ProviderSelection_TasksStepDescription, Mode=OneTime}"
                    Header="{x:Bind domain:Translator.ProviderSelection_UseForTasks, Mode=OneTime}">
                    <controls:SettingsCard.HeaderIcon>
                        <ImageIcon
                            Width="36"
                            Height="36"
                            Source="ms-appx:///Assets/AppEntries/ToDo.svg" />
                    </controls:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox
                            MinWidth="120"
                            AutomationProperties.AutomationId="ProviderSelectionTaskMode"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_UseForTasks, Mode=OneTime}"
                            SelectedIndex="{x:Bind ViewModel.TaskModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" Visibility="{x:Bind ViewModel.IsTaskProviderModeAvailable, Mode=OneWay}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                            <ComboBoxItem Content="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                        </ComboBox>
                        <FontIcon
                            AutomationProperties.HelpText="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind domain:Translator.ProviderSelection_OptionsHelpLabel, Mode=OneTime}"
                            FontSize="14"
                            Glyph="&#xE946;">
                            <ToolTipService.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_Yes, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.TaskProviderChoiceDescription, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_ThisPC, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind domain:Translator.ProviderSelection_Why_TasksLocal, Mode=OneTime}" TextWrapping="WrapWholeWords" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind domain:Translator.ProviderSelection_Option_No, Mode=OneTime}" />
                                        <TextBlock Text="{x:Bind ViewModel.TaskOffConsequenceText, Mode=OneWay}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </ToolTip>
                            </ToolTipService.ToolTip>
                        </FontIcon>
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <StackPanel Spacing="12">
                <InfoBar
                    AutomationProperties.AutomationId="ProviderSelectionCalendarOnlyHint"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind domain:Translator.ProviderSelection_CalendarOnlyServerHint, Mode=OneTime}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsCalendarOnlyServerHintVisible, Mode=OneWay}" />

                <InfoBar
                    AutomationProperties.AutomationId="ProviderSelectionCardDavDiscoveryHint"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.DavContactAvailabilityMessage, Mode=OneWay}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsCardDavDiscoveryHintVisible, Mode=OneWay}" />

                <InfoBar
                    AutomationProperties.AutomationId="ProviderSelectionTasksProviderUnavailableHint"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind domain:Translator.ProviderSelection_TaskProviderUnavailable, Mode=OneTime}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsTaskProviderUnavailableHintVisible, Mode=OneWay}" />

                <TextBlock
                    Margin="2,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.ProviderSelection_CapabilityValidationMessage, Mode=OneTime}"
                    Visibility="{x:Bind ViewModel.IsCapabilitySelectionMissing, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                AutomationProperties.AutomationId="ProviderSelectionBackButton"
                Command="{x:Bind ViewModel.GoBackCommand}"
                Content="{x:Bind domain:Translator.Buttons_Back, Mode=OneTime}"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />

            <Button
                Grid.Column="1"
                MinWidth="140"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ProviderSelectionContinueButton"
                Command="{x:Bind ViewModel.ContinueCommand}"
                Content="{x:Bind ViewModel.ContinueButtonText, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </StackPanel>
</abstract:ProviderSelectionPageAbstract>
