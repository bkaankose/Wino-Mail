<viewsAbstract:IdlePageAbstract
    x:Class="Wino.Mail.WinUI.Views.Mail.IdlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewsAbstract="using:Wino.Mail.WinUI.Views.Abstract"
    mc:Ignorable="d">

    <Grid>
        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsMailEmptyStateVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.MailEmptyStateTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.MailEmptyStateMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    AutomationProperties.AutomationId="IdlePageButton"
                    Command="{x:Bind ViewModel.AddAccountCommand}"
                    Content="{x:Bind ViewModel.AddAccountText, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}" />
                <Button
                    AutomationProperties.AutomationId="IdlePageButton2"
                    Command="{x:Bind ViewModel.ManageAccountsCommand}"
                    Content="{x:Bind ViewModel.ManageAccountsText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="MailAccountIdlePanel"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsAccountStateVisible, Mode=OneWay}">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="MailAccountIdleTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.AccountStateTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.AccountStateMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="MailAccountIdleSignInButton"
                Command="{x:Bind ViewModel.SignInCommand}"
                Content="{x:Bind ViewModel.SignInText, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.IsSignInVisible, Mode=OneWay}" />
        </StackPanel>
    </Grid>

</viewsAbstract:IdlePageAbstract>
