<abstract:MailRenderingPageAbstract
    x:Class="Wino.Views.Mail.MailRenderingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstract="using:Wino.Views.Abstract"
    xmlns:controls="using:Wino.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:customcontrols="using:Wino.Mail.WinUI.Controls.CustomControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:editor="using:Wino.Editor"
    xmlns:entities="using:Wino.Core.Domain.Entities.Shared"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:intelligenceControls="using:Wino.Mail.Controls.IntelligenceHeader"
    xmlns:mailControls="using:Wino.Mail.Controls.ContactPicture"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:shimmer="using:Wino.Mail.Controls.Shimmer"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewModelData="using:Wino.Mail.ViewModels.Data"
    x:Name="root"
    AutomationProperties.AutomationId="MailRenderingPageRoot"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeInvoked" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <DataTemplate x:Key="InternetAddressTemplate" x:DataType="viewModelData:AccountContactViewModel">
            <HyperlinkButton
                Margin="0"
                Padding="4,2"
                AutomationProperties.AutomationId="XBindDisplayName"
                AutomationProperties.Name="{x:Bind DisplayName}"
                Click="InternetAddressClicked"
                Content="{x:Bind ShortNameOrYou}"
                ToolTipService.ToolTip="{x:Bind DisplayName}">
                <HyperlinkButton.ContextFlyout>
                    <Flyout Placement="Bottom">
                        <Grid ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <mailControls:WinoContactPicture
                                Grid.RowSpan="2"
                                Width="36"
                                Height="36"
                                ContactPicture="{x:Bind helpers:XamlHelpers.GetContactPicture(SenderContact, FromName, FromAddress), Mode=OneWay}"
                                IsFaviconEnabled="{x:Bind helpers:XamlHelpers.GetFaviconEnabled(), Mode=OneTime}"
                                IsGravatarEnabled="{x:Bind helpers:XamlHelpers.GetGravatarEnabled(), Mode=OneTime}" />

                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" />

                            <HyperlinkButton
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="0"
                                AutomationProperties.AutomationId="XBindAddress"
                                AutomationProperties.Name="{x:Bind Address}"
                                Click="CopyAddress_Click"
                                CommandParameter="{x:Bind Address}"
                                Content="{x:Bind Address}" />
                        </Grid>
                    </Flyout>
                </HyperlinkButton.ContextFlyout>
            </HyperlinkButton>
        </DataTemplate>

        <!--  Attachment Template  -->
        <!--  Margin -8 0 is used to remove the padding from the ListViewItem  -->
        <DataTemplate x:Key="FileAttachmentTemplate" x:DataType="viewModelData:MailAttachmentViewModel">
            <Grid Height="51">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    Height="50"
                    Margin="0"
                    Background="Transparent"
                    ColumnSpacing="3"
                    ContextRequested="AttachmentContextRequested">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind FileName}" />
                    </ToolTipService.ToolTip>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Icon  -->
                    <ContentControl
                        VerticalAlignment="Center"
                        Content="{x:Bind AttachmentType}"
                        ContentTemplateSelector="{StaticResource FileTypeIconSelector}" />

                    <!--  Name && Size  -->
                    <Grid
                        Grid.Column="1"
                        MaxWidth="200"
                        VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            MaxLines="1"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind FileName}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="Gray"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ReadableSize}" />
                    </Grid>

                    <coreControls:WinoFontIcon
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="MailAttachmentContentTypeWarning"
                        AutomationProperties.Name="{x:Bind ContentTypeWarningText, Mode=OneWay}"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Icon="Important"
                        ToolTipService.ToolTip="{x:Bind ContentTypeWarningText, Mode=OneWay}"
                        Visibility="{x:Bind HasContentTypeMismatch, Mode=OneWay}" />
                </Grid>
                <ProgressBar
                    Grid.Row="1"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    IsIndeterminate="{x:Bind IsBusy, Mode=OneWay}"
                    ShowError="False"
                    ShowPaused="False"
                    Visibility="{x:Bind IsBusy, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--  Attachments and WebView2  -->
    <Grid
        x:Name="RendererGridFrame"
        Margin="0,2,0,0"
        RowSpacing="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--
            No children transition here. The page is reused across mail selections, so the
            intelligence header's visibility toggles on a live tree and a reposition transition
            would slide the whole reading pane on every switch.
        -->

        <Border
            Background="{ThemeResource ReadingPaneBackgroundColorBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,20">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.Subject, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsMailContentReady, Mode=OneWay}" />

                    <!--
                        The bar is sized by a proportional column rather than by an alignment plus a
                        MaxWidth: a shimmer has no content, so a Left-aligned one would measure to
                        zero width and never appear.
                    -->
                    <Grid
                        x:Name="SubjectSkeleton"
                        VerticalAlignment="Center"
                        x:Load="{x:Bind ViewModel.IsLoadingMailContent, Mode=OneWay}"
                        AutomationProperties.AccessibilityView="Raw">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <shimmer:WinoShimmer Height="18" />
                    </Grid>

                    <HyperlinkButton
                        Grid.Column="1"
                        Padding="5,1,5,1"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="MailRenderingPageHyperlinkButton"
                        Command="{x:Bind ViewModel.UnsubscribeCommand}"
                        Visibility="{x:Bind ViewModel.CanUnsubscribe, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <Viewbox Width="16" Height="16">
                                <coreControls:WinoFontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Icon="PersonDelete" />
                            </Viewbox>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.Unsubscribe}" />
                        </StackPanel>
                    </HyperlinkButton>


                    <!--  S/MIME Signed Email Indicator  -->
                    <HyperlinkButton
                        Grid.Column="2"
                        Margin="0,0,0,4"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="XBindDomainTranslatorSmimeSignedTooltipModeOneTime"
                        AutomationProperties.Name="{x:Bind domain:Translator.SmimeSignedTooltip, Mode=OneTime}"
                        Command="{x:Bind ViewModel.ShowSmimeSigningCertificateInfoCommand}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.SmimeSignedTooltip}"
                        Visibility="{x:Bind ViewModel.IsSmimeSigned, Mode=OneWay}">
                        <Grid
                            Width="Auto"
                            Height="Auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                            <Viewbox
                                Width="16"
                                Height="16"
                                Margin="0,0,4,0">
                                <coreControls:WinoFontIcon Icon="Certificate" />
                            </Viewbox>
                            <muxc:InfoBadge
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{ThemeResource CautionIconInfoBadgeStyle}"
                                Visibility="{x:Bind ViewModel.SmimeSignaturesInvalid, Mode=OneWay}" />
                            <muxc:InfoBadge
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{ThemeResource SuccessIconInfoBadgeStyle}"
                                Visibility="{x:Bind ViewModel.SmimeSignaturesValid, Mode=OneWay}" />
                        </Grid>
                    </HyperlinkButton>

                    <!--  S/MIME Encrypted Email Indicator  -->
                    <Viewbox
                        Grid.Column="3"
                        Width="16"
                        Height="16"
                        Margin="0,0,0,4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.SmimeEncryptedTooltip}"
                        Visibility="{x:Bind ViewModel.IsSmimeEncrypted, Mode=OneWay}">
                        <coreControls:WinoFontIcon Icon="LockClosed" />
                    </Viewbox>
                </Grid>
                <coreControls:OperationCommandBar
                    x:Name="RendererCommandBar"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    DefaultLabelPosition="Right"
                    IsEditorThemeDark="{x:Bind ViewModel.IsDarkWebviewRenderer, Mode=TwoWay}"
                    IsEditorThemeToggleVisible="True"
                    IsPopOutButtonVisible="{x:Bind SupportsPopOut, Mode=OneTime}"
                    IsReaderViewEnabled="{x:Bind IsReaderViewEnabled, Mode=TwoWay}"
                    IsReaderViewToggleVisible="True"
                    ItemInvokedCommand="{x:Bind ViewModel.OperationClickedCommand}"
                    MenuItems="{x:Bind ViewModel.MenuItems, Mode=OneWay}"
                    PopOutClicked="RendererCommandBar_PopOutClicked">
                    <coreControls:OperationCommandBar.Content>
                        <Grid Padding="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <mailControls:WinoContactPicture
                                x:Name="ContactImage"
                                Width="36"
                                Height="36"
                                AutomationProperties.AccessibilityView="Raw"
                                ContactPicture="{x:Bind helpers:XamlHelpers.GetContactPicture(ViewModel.CurrentMailItemDisplayInformation), Mode=OneWay}"
                                FontSize="16"
                                IsFaviconEnabled="{x:Bind helpers:XamlHelpers.GetFaviconEnabled(), Mode=OneTime}"
                                IsGravatarEnabled="{x:Bind helpers:XamlHelpers.GetGravatarEnabled(), Mode=OneTime}"
                                IsTabStop="False"
                                Visibility="{x:Bind ViewModel.IsMailContentReady, Mode=OneWay}" />

                            <!--  Stands in for the avatar, sender and date until the MIME is parsed.  -->
                            <Grid
                                x:Name="SenderSkeleton"
                                Grid.ColumnSpan="2"
                                VerticalAlignment="Center"
                                x:Load="{x:Bind ViewModel.IsLoadingMailContent, Mode=OneWay}"
                                AutomationProperties.AccessibilityView="Raw"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <shimmer:WinoShimmer
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18" />

                                <Grid
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <shimmer:WinoShimmer
                                        Width="220"
                                        Height="13"
                                        HorizontalAlignment="Left" />

                                    <shimmer:WinoShimmer
                                        Grid.Row="1"
                                        Width="140"
                                        Height="11"
                                        HorizontalAlignment="Left" />
                                </Grid>
                            </Grid>

                            <Grid
                                x:Name="SenderContent"
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsMailContentReady, Mode=OneWay}">
                                <StackPanel Spacing="1">
                                    <HyperlinkButton
                                        Margin="0"
                                        Padding="-1,2"
                                        AutomationProperties.AutomationId="XBindHelpersXamlHelpersGetMailAddressAutomationNameDomainTranslatorComposerFromViewModelFromNameViewModelFromAddressModeOneWay"
                                        AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetMailAddressAutomationName(domain:Translator.ComposerFrom, ViewModel.FromName, ViewModel.FromAddress), Mode=OneWay}"
                                        Command="{Binding ElementName=root, Path=ViewModel.CopyClipboardCommand}"
                                        CommandParameter="{x:Bind ViewModel.FromAddress, Mode=OneWay}"
                                        FontWeight="SemiBold">
                                        <Grid>
                                            <TextBlock Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityConverter(ViewModel.FromName), Mode=OneWay}">
                                                <Run Text="{x:Bind ViewModel.FromName, Mode=OneWay}" />
                                                <Run Text="&lt;" /><Run Text="{x:Bind ViewModel.FromAddress, Mode=OneWay}" /><Run Text="&gt;" />
                                            </TextBlock>
                                            <TextBlock Visibility="{x:Bind helpers:XamlHelpers.StringToVisibilityReversedConverter(ViewModel.FromName), Mode=OneWay}">
                                                <Run Text="{x:Bind ViewModel.FromAddress, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </HyperlinkButton>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind helpers:XamlHelpers.GetCreationDateString(ViewModel.CreationDate, ViewModel.PreferencesService.MailTimeFormatPreference), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </coreControls:OperationCommandBar.Content>
                </coreControls:OperationCommandBar>

                <ScrollViewer
                    Grid.Row="2"
                    MaxHeight="150"
                    Margin="5,0"
                    Visibility="{x:Bind ViewModel.IsMailContentReady, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,-1,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="{x:Bind domain:Translator.ComposerTo}"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.ToItems.Count), Mode=OneWay}" />

                            <ItemsControl
                                Grid.Column="1"
                                ItemTemplate="{StaticResource InternetAddressTemplate}"
                                ItemsSource="{x:Bind ViewModel.ToItems, Mode=OneWay}"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.ToItems.Count), Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <customcontrols:CustomWrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                FontWeight="SemiBold"
                                Text="Cc:"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.CcItems.Count), Mode=OneWay}" />
                            <ItemsControl
                                Grid.Column="1"
                                ItemTemplate="{StaticResource InternetAddressTemplate}"
                                ItemsSource="{x:Bind ViewModel.CcItems, Mode=OneWay}"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.CcItems.Count), Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <customcontrols:CustomWrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0,1,0,0"
                                VerticalAlignment="Top"
                                FontWeight="SemiBold"
                                Text="Bcc:"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.BccItems.Count), Mode=OneWay}" />

                            <ItemsControl
                                Grid.Column="1"
                                ItemTemplate="{StaticResource InternetAddressTemplate}"
                                ItemsSource="{x:Bind ViewModel.BccItems, Mode=OneWay}"
                                Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.BccItems.Count), Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <customcontrols:CustomWrapPanel />
                                        <!--<toolkit:WrapPanel Orientation="Horizontal" />-->
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </ScrollViewer>


                <!--  Attachments  -->
                <Grid
                    Grid.Row="4"
                    ColumnSpacing="8"
                    Visibility="{x:Bind ViewModel.IsMailContentReady, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView
                        x:Name="AttachmentsListView"
                        Grid.Row="0"
                        AutomationProperties.AutomationId="AttachmentsListView"
                        IsItemClickEnabled="True"
                        ItemClick="AttachmentClicked"
                        ItemTemplate="{StaticResource FileAttachmentTemplate}"
                        ItemsSource="{x:Bind ViewModel.DisplayedAttachments, Mode=OneWay}"
                        SelectionMode="None"
                        Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(ViewModel.Attachments.Count), Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <customcontrols:CustomWrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ListView>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <HyperlinkButton
                            AutomationProperties.AutomationId="MailRenderingPageHyperlinkButton2"
                            Command="{x:Bind ViewModel.ShowAllAttachmentsCommand}"
                            Content="{x:Bind domain:Translator.Reader_ShowAllAttachmentsButtonText, Mode=OneTime}"
                            Visibility="{x:Bind ViewModel.CanShowAllAttachments, Mode=OneWay}" />

                        <HyperlinkButton
                            AutomationProperties.AutomationId="MailRenderingPageHyperlinkButton3"
                            Command="{x:Bind ViewModel.SaveAllAttachmentsCommand}"
                            Content="{x:Bind domain:Translator.Reader_SaveAllAttachmentButtonText}"
                            Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverterWithThreshold(ViewModel.Attachments.Count, 1), Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <InfoBar
                    x:Name="ImageLoadingDisabledMessage"
                    Grid.Row="5"
                    HorizontalContentAlignment="Stretch"
                    x:Load="{x:Bind ViewModel.IsImageRenderingDisabled, Mode=OneWay}"
                    IsOpen="True"
                    Message="{x:Bind domain:Translator.ImageRenderingDisabled}"
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="MailRenderingPageButton"
                            Command="{x:Bind ViewModel.ForceImageLoadingCommand}"
                            Content="{x:Bind domain:Translator.Buttons_EnableImageRendering}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ProgressBar
                    x:Name="DownloadingProgressBar"
                    Grid.Row="4"
                    Margin="12,1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    x:Load="{x:Bind ViewModel.ShouldDisplayDownloadProgress, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsIndetermineProgress, Mode=OneWay}"
                    Value="{x:Bind ViewModel.CurrentDownloadPercentage, Mode=OneWay}" />
            </Grid>
        </Border>

        <intelligenceControls:WinoIntelligenceHeader
            x:Name="IntelligenceHeader"
            Grid.Row="1"
            ActionHeadingText="{x:Bind domain:Translator.WinoIntelligence_AskWino, Mode=OneTime}"
            ActionInvoked="IntelligenceHeader_ActionInvoked"
            AddToCalendarButtonText="{x:Bind domain:Translator.WinoIntelligence_AddToCalendar, Mode=OneTime}"
            AutomationProperties.AutomationId="MailRenderingIntelligenceHeader"
            CancelButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
            ClosePanelText="{x:Bind domain:Translator.WinoIntelligence_ClosePanel, Mode=OneTime}"
            CollapsedText="{x:Bind domain:Translator.WinoIntelligence_Collapsed, Mode=OneTime}"
            CopyCodeRequested="IntelligenceHeader_CopyCodeRequested"
            CopyCodeText="{x:Bind domain:Translator.Intelligence_ActionCopyCode, Mode=OneTime}"
            CopyText="{x:Bind domain:Translator.WinoIntelligence_Copy, Mode=OneTime}"
            DraftingRepliesText="{x:Bind domain:Translator.WinoIntelligence_DraftingReplies, Mode=OneTime}"
            ExpandedText="{x:Bind domain:Translator.WinoIntelligence_Expanded, Mode=OneTime}"
            FeatureCancelRequested="IntelligenceHeader_FeatureCancelRequested"
            FeatureRequested="IntelligenceHeader_FeatureRequested"
            FindSimilarButtonText="{x:Bind domain:Translator.WinoIntelligence_FindSimilar, Mode=OneTime}"
            HeaderTitle="{x:Bind domain:Translator.WinoIntelligence_HeaderTitle, Mode=OneTime}"
            InsightsLockedText="{x:Bind domain:Translator.WinoIntelligence_InsightsLocked, Mode=OneTime}"
            NeedsReplyText="{x:Bind domain:Translator.WinoIntelligence_NeedsReply, Mode=OneTime}"
            ProcessAutomationText="{x:Bind domain:Translator.WinoIntelligence_ProcessAutomation, Mode=OneTime}"
            ProcessButtonText="{x:Bind domain:Translator.WinoIntelligence_Process, Mode=OneTime}"
            ProcessRequested="IntelligenceHeader_ProcessRequested"
            ProcessingFailedSubtitleText="{x:Bind domain:Translator.WinoIntelligence_ProcessingFailed, Mode=OneTime}"
            ProcessingSubtitleText="{x:Bind domain:Translator.WinoIntelligence_Processing, Mode=OneTime}"
            QueuedSubtitleText="{x:Bind domain:Translator.WinoIntelligence_Queued, Mode=OneTime}"
            RegenerateText="{x:Bind domain:Translator.WinoIntelligence_Regenerate, Mode=OneTime}"
            RetryProcessButtonText="{x:Bind domain:Translator.WinoIntelligence_RetryProcess, Mode=OneTime}"
            ShowOriginalButtonText="{x:Bind domain:Translator.WinoIntelligence_ShowOriginal, Mode=OneTime}"
            SimilarMailHeadingText="{x:Bind domain:Translator.WinoIntelligence_SimilarMessages, Mode=OneTime}"
            SourceLanguageLabel="{x:Bind domain:Translator.WinoIntelligence_SourceLanguage, Mode=OneTime}"
            SuggestRepliesButtonText="{x:Bind domain:Translator.WinoIntelligence_SuggestReplies, Mode=OneTime}"
            SuggestedRepliesHeadingText="{x:Bind domain:Translator.WinoIntelligence_SuggestedReplies, Mode=OneTime}"
            SummarizeButtonText="{x:Bind domain:Translator.WinoIntelligence_Summarize, Mode=OneTime}"
            SummarizingText="{x:Bind domain:Translator.WinoIntelligence_Summarizing, Mode=OneTime}"
            SummaryHeadingText="{x:Bind domain:Translator.WinoIntelligence_Summary, Mode=OneTime}"
            TargetLanguageLabel="{x:Bind domain:Translator.WinoIntelligence_TargetLanguage, Mode=OneTime}"
            TranslateAgainButtonText="{x:Bind domain:Translator.WinoIntelligence_TranslateAgain, Mode=OneTime}"
            TranslateButtonText="{x:Bind domain:Translator.WinoIntelligence_Translate, Mode=OneTime}"
            TranslatePanelHeadingText="{x:Bind domain:Translator.WinoIntelligence_TranslateMessage, Mode=OneTime}"
            TranslateTargetHintFormat="{x:Bind domain:Translator.WinoIntelligence_TranslateTargetHintFormat, Mode=OneTime}"
            TranslationCancelButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
            UnavailableSubtitleText="{x:Bind domain:Translator.WinoIntelligence_Unavailable, Mode=OneTime}"
            UnprocessedSubtitleText="{x:Bind domain:Translator.WinoIntelligence_NotProcessed, Mode=OneTime}"
            Visibility="Collapsed" />

        <Border
            Grid.Row="2"
            Background="{ThemeResource ReadingPaneBackgroundColorBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid Margin="1" CornerRadius="8">

                <editor:WinoMailRenderer
                    x:Name="MailRenderer"
                    AutomationProperties.AutomationId="MailMessageRenderer"
                    AutomationProperties.HelpText="{x:Bind domain:Translator.Reader_MessageBodyAutomationHelpText, Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind domain:Translator.Reader_MessageBodyAutomationName, Mode=OneTime}"
                    InitializationFailed="MailRenderer_InitializationFailed"
                    IsDarkMode="{x:Bind ViewModel.IsDarkWebviewRenderer, Mode=OneWay}"
                    NavigationRequested="MailRenderer_NavigationRequested">
                    <editor:WinoMailRenderer.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" Invoked="EscapeInvoked" />
                    </editor:WinoMailRenderer.KeyboardAccelerators>
                </editor:WinoMailRenderer>

                <!--
                    Fully opaque, so the previously rendered message never shows through while the
                    next one loads: the reading pane brush is a translucent layer fill over the
                    window backdrop, which the WebView2 is happy to show through. The renderer itself
                    stays visible - collapsing it stalls WebView2's first initialization.
                -->
                <Grid
                    x:Name="BodyLoadingSkeleton"
                    Padding="20,18"
                    x:Load="{x:Bind ViewModel.IsLoadingMailContent, Mode=OneWay}"
                    AutomationProperties.AccessibilityView="Raw"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="8"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!--  Fills the rest of the pane so no part of the previous message shows through.  -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <shimmer:WinoShimmer Height="13" />
                    <shimmer:WinoShimmer Grid.Row="1" Height="13" />
                    <shimmer:WinoShimmer
                        Grid.Row="2"
                        Width="380"
                        Height="13"
                        HorizontalAlignment="Left" />
                    <shimmer:WinoShimmer
                        Grid.Row="3"
                        Height="140"
                        CornerRadius="6" />
                </Grid>

                <ProgressRing
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.ShouldDisplayDownloadProgress, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>

</abstract:MailRenderingPageAbstract>
