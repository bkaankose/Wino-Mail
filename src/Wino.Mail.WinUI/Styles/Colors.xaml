<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Microsoft.UI.Xaml.Media">

    <SolidColorBrush x:Key="AttentionBrush">#ff7675</SolidColorBrush>

    <SolidColorBrush x:Key="FolderSyncBrush">#1abc9c</SolidColorBrush>

    <SolidColorBrush x:Key="DiagnosticIdCopyBrush">#ff7675</SolidColorBrush>
    <SolidColorBrush x:Key="AliasUnverifiedBrush">#ff7675</SolidColorBrush>
    <SolidColorBrush x:Key="AliasVerifiedBrush">#1abc9c</SolidColorBrush>
    <SolidColorBrush x:Key="AliasUnknownBrush">#f39c12</SolidColorBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Name="Light">
            <SolidColorBrush x:Key="AttachmentBrush">#fdcb6e</SolidColorBrush>
            <SolidColorBrush x:Key="SwipeDeleteOperationBackgroundBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsPaneBorderBrush">#636e72</SolidColorBrush>
            <SolidColorBrush x:Key="WinoContentZoneBackgroud" Color="White" />
            <StaticResource x:Key="ReadingPaneBackgroundColorBrush" ResourceKey="WinoContentZoneBackgroud" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailItemFlaggedBackgroundBrush" Color="#ffffcc" />
            <SolidColorBrush x:Key="InformationBrush">#34495e</SolidColorBrush>
            <SolidColorBrush x:Key="FlaggedBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="DeleteBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="DeleteButtonForegroundBrush">White</SolidColorBrush>
            <SolidColorBrush x:Key="WinoAccentIndicatorBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="MailListUnreadSubjectBrush" Color="{ThemeResource SystemAccentColor}" />
            <LinearGradientBrush x:Key="WinoAccountHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1A6EE7B7" />
                <GradientStop Offset="0.5" Color="#2038BDF8" />
                <GradientStop Offset="1" Color="#1A818CF8" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="Dark">
            <SolidColorBrush x:Key="AttachmentBrush">#fdcb6e</SolidColorBrush>
            <SolidColorBrush x:Key="SwipeDeleteOperationBackgroundBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="SettingsPaneBorderBrush">#2d3436</SolidColorBrush>
            <StaticResource x:Key="WinoContentZoneBackgroud" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="ReadingPaneBackgroundColorBrush" ResourceKey="WinoContentZoneBackgroud" />
            <SolidColorBrush x:Key="WelcomeOverlayBrush">Transparent</SolidColorBrush>
            <SolidColorBrush x:Key="MailItemFlaggedBackgroundBrush" Color="#576574" />
            <SolidColorBrush x:Key="InformationBrush">#ecf0f1</SolidColorBrush>
            <SolidColorBrush x:Key="FlaggedBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="DeleteBrush">#e74c3c</SolidColorBrush>
            <SolidColorBrush x:Key="DeleteButtonForegroundBrush">White</SolidColorBrush>
            <SolidColorBrush x:Key="WinoAccentIndicatorBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="MailListUnreadSubjectBrush" Color="{ThemeResource SystemAccentColor}" />
            <LinearGradientBrush x:Key="WinoAccountHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#1A6EE7B7" />
                <GradientStop Offset="0.5" Color="#2038BDF8" />
                <GradientStop Offset="1" Color="#1A818CF8" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Name="HighContrast">
            <StaticResource x:Key="AttachmentBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SwipeDeleteOperationBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsPaneBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoContentZoneBackgroud" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="ReadingPaneBackgroundColorBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WelcomeOverlayBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MailItemFlaggedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="InformationBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="FlaggedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DeleteBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="DeleteButtonForegroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="WinoAccentIndicatorBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="MailListUnreadSubjectBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="WinoAccountHeroBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
