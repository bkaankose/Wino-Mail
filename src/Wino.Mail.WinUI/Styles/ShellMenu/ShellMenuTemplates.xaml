<ResourceDictionary
    x:Class="Wino.Mail.WinUI.Styles.ShellMenu.ShellMenuTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:Wino.Mail.WinUI.Behaviors"
    xmlns:contactData="using:Wino.Mail.ViewModels.Data"
    xmlns:controls="using:Wino.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:data="using:Wino.Calendar.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:enums="using:Wino.Core.Domain.Enums"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:interfaces="using:Wino.Core.Domain.Interfaces"
    xmlns:menu="using:Wino.Core.Domain.MenuItems"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!--
        Chrome-free navigation item used by pane entries that host a control or a caption
        rather than acting as a navigation target.
    -->
    <Style x:Key="ShellPaneHostNavigationViewItemStyle" TargetType="muxc:NavigationViewItem">
        <Setter Property="SelectsOnInvoked" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="muxc:NavigationViewItem">
                    <ContentPresenter
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Section caption between groups of navigation items.  -->
    <DataTemplate x:Key="ShellSectionHeaderTemplate" x:DataType="menu:ShellSectionHeaderMenuItem">
        <muxc:NavigationViewItem AutomationProperties.AutomationId="ShellMenuSectionHeader" Style="{StaticResource ShellPaneHostNavigationViewItemStyle}">
            <TextBlock
                Margin="14,12,12,2"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneTime}" />
        </muxc:NavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SharedAccountMenuTemplate" x:DataType="interfaces:IAccountNavigationMenuItem">
        <controls:AccountNavigationItem
            Height="50"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.AutomationId="ShellAccountSelector"
            AutomationProperties.Name="{x:Bind AccountName, Mode=OneWay}"
            BindingData="{x:Bind}"
            ContextRequested="AccountContextRequested"
            DataContext="{x:Bind}"
            IsActiveAccount="{x:Bind IsSelected, Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            SelectsOnInvoked="{x:Bind SelectsOnInvoked, Mode=OneTime}"
            Style="{StaticResource SingleAccountNavigationViewItemTemplate}">
            <muxc:NavigationViewItem.Icon>
                <accountIcon:WinoAccountIcon
                    Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account), Mode=OneWay}"
                    IconSize="22"
                    ProviderIconSize="16" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
                        MaxLines="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind AccountName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind AccountAddress, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Height="3"
                        Margin="0,4,0,0"
                        IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                        ShowError="False"
                        ShowPaused="False"
                        Visibility="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}"
                        Value="{x:Bind SynchronizationProgressValue, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    MinWidth="0"
                    Padding="4"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="AccountAttentionButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Info_AccountAttentionRequiredAction, Mode=OneTime}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    BorderThickness="1"
                    Click="AttentionIconClicked"
                    Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Info_AccountAttentionRequiredClickableMessage, Mode=OneTime}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsAttentionRequired), Mode=OneWay}">
                    <coreControls:WinoFontIcon Icon="Wrench" />
                </Button>
            </Grid>
        </controls:AccountNavigationItem>
    </DataTemplate>

    <DataTemplate x:Key="SharedCompactAccountMenuTemplate" x:DataType="interfaces:IAccountNavigationMenuItem">
        <controls:AccountNavigationItem
            Height="40"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            AutomationProperties.AutomationId="ShellAccountSelector"
            AutomationProperties.Name="{x:Bind AccountName, Mode=OneWay}"
            BindingData="{x:Bind}"
            ContextRequested="AccountContextRequested"
            DataContext="{x:Bind}"
            IsActiveAccount="{x:Bind IsSelected, Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            SelectsOnInvoked="{x:Bind SelectsOnInvoked, Mode=OneTime}"
            Style="{StaticResource SingleAccountNavigationViewItemTemplate}">
            <muxc:NavigationViewItem.Icon>
                <accountIcon:WinoAccountIcon
                    Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account), Mode=OneWay}"
                    IconSize="28"
                    ProviderIconSize="22" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Stretch">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
                        MaxLines="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind AccountName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Height="3"
                        VerticalAlignment="Bottom"
                        IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                        ShowError="False"
                        ShowPaused="False"
                        Visibility="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}"
                        Value="{x:Bind SynchronizationProgressValue, Mode=OneWay}" />
                </Grid>
                <Button
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    MinWidth="0"
                    Padding="4"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="CompactAccountAttentionButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Info_AccountAttentionRequiredAction, Mode=OneTime}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    BorderThickness="1"
                    Click="AttentionIconClicked"
                    Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Info_AccountAttentionRequiredClickableMessage, Mode=OneTime}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsAttentionRequired), Mode=OneWay}">
                    <coreControls:WinoFontIcon Icon="Wrench" />
                </Button>
            </Grid>
        </controls:AccountNavigationItem>
    </DataTemplate>

    <!--  Fix account issues.  -->
    <!--  Authentication  -->
    <DataTemplate x:Key="FixAuthenticationIssueTemplate" x:DataType="menu:FixAccountIssuesMenuItem">
        <coreControls:WinoNavigationViewItem AutomationProperties.AutomationId="WinoAppShellWinoNavigationViewItem" SelectsOnInvoked="False">
            <coreControls:WinoNavigationViewItem.Content>
                <TextBlock
                    Margin="0,10"
                    Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    HorizontalTextAlignment="Center"
                    TextWrapping="WrapWholeWords">
                    <Run Text="Account credentials can not be verified." /><LineBreak /><Run Text="Click here to fix it." />
                </TextBlock>
            </coreControls:WinoNavigationViewItem.Content>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Missing system folder config.  -->
    <DataTemplate x:Key="FixMissingFolderConfigTemplate" x:DataType="menu:FixAccountIssuesMenuItem">
        <coreControls:WinoNavigationViewItem AutomationProperties.AutomationId="WinoAppShellWinoNavigationViewItem2" SelectsOnInvoked="False">
            <coreControls:WinoNavigationViewItem.Content>
                <TextBlock
                    Margin="0,10"
                    Foreground="{ThemeResource InfoBarWarningSeverityIconBackground}"
                    HorizontalTextAlignment="Center"
                    TextWrapping="WrapWholeWords">
                    <Run Text="Account is missing system folder configuration." /><LineBreak /><LineBreak /><Run Text="Click here to fix it." />
                </TextBlock>
            </coreControls:WinoNavigationViewItem.Content>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  New Mail  -->
    <DataTemplate x:Key="CreateNewMailTemplate" x:DataType="menu:NewMailMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="50"
            AutomationProperties.AutomationId="XBindDomainTranslatorMenuNewMailModeOneTime"
            AutomationProperties.Name="{x:Bind domain:Translator.MenuNewMail, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="NewMail" />
            </muxc:NavigationViewItem.Icon>
            <TextBlock
                Margin="0"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.MenuNewMail}" />
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Inbox or any other folders.  -->
    <DataTemplate x:Key="FolderMenuTemplate" x:DataType="menu:FolderMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="40"
            AllowDrop="True"
            AutomationProperties.AutomationId="XBindFolderNameModeOneWay"
            AutomationProperties.Name="{x:Bind FolderName, Mode=OneWay}"
            ContextRequested="MenuItemContextRequested"
            DataContext="{x:Bind}"
            DragEnter="ItemDragEnterOnFolder"
            DragLeave="ItemDragLeaveFromFolder"
            Drop="ItemDroppedOnFolder"
            FontSize="50"
            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
            MenuItemsSource="{x:Bind SubMenuItems, Mode=OneWay}"
            SelectsOnInvoked="{x:Bind IsMoveTarget, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind FolderName, Mode=OneWay}">
            <animations:Implicit.Animations>
                <animations:ScaleAnimation Duration="0:0:0.5" />
            </animations:Implicit.Animations>
            <coreControls:WinoNavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="{x:Bind helpers:XamlHelpers.GetSpecialFolderPathIconGeometry(Parameter.SpecialFolderType)}" />
            </coreControls:WinoNavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    x:Name="FolderInfoBadge"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <muxc:NavigationViewItem.Content>
                <Grid
                    x:Name="FolderBackgroundGrid"
                    MaxHeight="36"
                    Padding="2"
                    VerticalAlignment="Center">
                    <Grid
                        x:Name="BackgroundColorGrid"
                        x:Load="{x:Bind HasTextColor, Mode=OneWay}"
                        Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(Parameter.BackgroundColorHex), Mode=OneWay}"
                        CornerRadius="3">
                        <TextBlock
                            x:Name="CustomColorTitle"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightBySyncState(IsSelected), Mode=OneWay}"
                            Foreground="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(Parameter.TextColorHex), Mode=OneWay}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind FolderName, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                    </Grid>

                    <TextBlock
                        x:Name="NormalTitle"
                        VerticalAlignment="Center"
                        x:Load="{x:Bind helpers:XamlHelpers.ReverseBoolConverter(HasTextColor)}"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightBySyncState(IsSelected), Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind FolderName, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />
                </Grid>
            </muxc:NavigationViewItem.Content>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="MailCategoryMenuTemplate" x:DataType="menu:MailCategoryMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="40"
            AutomationProperties.AutomationId="XBindFolderNameModeOneWay2"
            AutomationProperties.Name="{x:Bind FolderName, Mode=OneWay}"
            DataContext="{x:Bind}"
            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
            SelectsOnInvoked="True"
            ToolTipService.ToolTip="{x:Bind FolderName, Mode=OneWay}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Foreground="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneWay}" Icon="Tag" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <muxc:NavigationViewItem.Content>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightBySyncState(IsSelected), Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind FolderName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </muxc:NavigationViewItem.Content>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="MergedMailCategoryMenuTemplate" x:DataType="menu:MergedMailCategoryMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="40"
            AutomationProperties.AutomationId="XBindFolderNameModeOneWay3"
            AutomationProperties.Name="{x:Bind FolderName, Mode=OneWay}"
            DataContext="{x:Bind}"
            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
            SelectsOnInvoked="True"
            ToolTipService.ToolTip="{x:Bind FolderName, Mode=OneWay}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Foreground="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(TextColorHex), Mode=OneWay}" Icon="Tag" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <muxc:NavigationViewItem.Content>
                <Grid
                    MaxHeight="36"
                    Padding="2"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="10"
                        Height="10"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneWay}"
                        BorderBrush="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(TextColorHex), Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="3" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightBySyncState(IsSelected), Mode=OneWay}"
                        Foreground="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(TextColorHex), Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind FolderName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </muxc:NavigationViewItem.Content>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Merged Inbox  -->
    <DataTemplate x:Key="MergedAccountTemplate" x:DataType="menu:MergedAccountMenuItem">
        <controls:AccountNavigationItem
            x:Name="AccountItem"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            BindingData="{x:Bind}"
            DataContext="{x:Bind}"
            IsActiveAccount="{x:Bind IsSelected, Mode=TwoWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            MenuItemsSource="{x:Bind SubMenuItems}"
            SelectsOnInvoked="False"
            Style="{StaticResource SingleAccountNavigationViewItemTemplate}">

            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    x:Name="FolderInfoBadge"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <coreControls:WinoNavigationViewItem.ContentTransitions>
                <TransitionCollection>
                    <EdgeUIThemeTransition Edge="Top" />
                </TransitionCollection>
            </coreControls:WinoNavigationViewItem.ContentTransitions>
            <coreControls:WinoNavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="PeopleLink" />
            </coreControls:WinoNavigationViewItem.Icon>

            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        x:Name="AccountNameTextblock"
                        FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsChildSelected), Mode=OneWay}"
                        MaxLines="1"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind MergedAccountName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SynchronizationStatus, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}" />

                    <ProgressBar
                        Height="3"
                        Margin="0,4,0,0"
                        IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                        ShowError="False"
                        ShowPaused="False"
                        Visibility="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}"
                        Value="{x:Bind SynchronizationProgressValue, Mode=OneWay}" />

                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsSynchronizationProgressVisible), Mode=OneWay}">
                        <Run Text="{x:Bind MergedAccountCount, Mode=OneWay}" /><Run Text="{x:Bind domain:Translator.MenuMergedAccountItemAccountsSuffix}" />
                    </TextBlock>
                </StackPanel>

                <muxc:ProgressRing
                    x:Name="SynchronizationProgressBar"
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    Margin="8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}"
                    IsIndeterminate="{x:Bind IsProgressIndeterminate, Mode=OneWay}"
                    Visibility="{x:Bind IsSynchronizationProgressVisible, Mode=OneWay}" />
            </Grid>
        </controls:AccountNavigationItem>
    </DataTemplate>

    <!--  Merged Account Common Folder Item  -->
    <DataTemplate x:Key="MergedAccountFolderMenuItemTemplate" x:DataType="menu:MergedAccountFolderMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="30"
            AllowDrop="True"
            AutomationProperties.AutomationId="WinoAppShellWinoNavigationViewItem3"
            ContextRequested="MenuItemContextRequested"
            DataContext="{x:Bind}"
            DragEnter="ItemDragEnterOnFolder"
            DragLeave="ItemDragLeaveFromFolder"
            Drop="ItemDroppedOnFolder"
            FontSize="50"
            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
            SelectsOnInvoked="True"
            ToolTipService.ToolTip="{x:Bind FolderName, Mode=OneWay}">
            <animations:Implicit.Animations>
                <animations:ScaleAnimation Duration="0:0:0.5" />
            </animations:Implicit.Animations>
            <coreControls:WinoNavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="{x:Bind helpers:XamlHelpers.GetSpecialFolderPathIconGeometry(FolderType)}" />
            </coreControls:WinoNavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    x:Name="FolderInfoBadge"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(UnreadItemCount), Mode=OneWay}"
                    Value="{x:Bind UnreadItemCount, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
            <Grid
                x:Name="FolderBackgroundGrid"
                Padding="2"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="NormalTitle"
                    VerticalAlignment="Center"
                    FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightBySyncState(IsSelected), Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind FolderName, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Merged Account More Expansion Item  -->
    <DataTemplate x:Key="MergedAccountMoreFolderItemTemplate" x:DataType="menu:MergedAccountMoreFolderMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="30"
            AutomationProperties.AutomationId="WinoAppShellWinoNavigationViewItem4"
            Content="{x:Bind domain:Translator.More}"
            FontWeight="{x:Bind helpers:XamlHelpers.GetFontWeightByChildSelectedState(IsSelected), Mode=OneWay}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
            MenuItemsSource="{x:Bind SubMenuItems, Mode=OneWay}"
            SelectsOnInvoked="True">
            <animations:Implicit.Animations>
                <animations:ScaleAnimation Duration="0:0:0.5" />
            </animations:Implicit.Animations>
            <coreControls:WinoNavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="{x:Bind helpers:XamlHelpers.GetSpecialFolderPathIconGeometry(enums:SpecialFolderType.More)}" />
            </coreControls:WinoNavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  New event  -->
    <DataTemplate x:Key="CalendarNewEventTemplate" x:DataType="menu:NewCalendarEventMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="50"
            AutomationProperties.AutomationId="NewCalendarEventNavigationItem"
            AutomationProperties.Name="{x:Bind domain:Translator.CalendarEventCompose_NewEventButton, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="NewMail" />
            </muxc:NavigationViewItem.Icon>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.CalendarEventCompose_NewEventButton, Mode=OneTime}" />
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Visible date range picker  -->
    <DataTemplate x:Key="CalendarDatePickerTemplate" x:DataType="menu:CalendarDatePickerMenuItem">
        <muxc:NavigationViewItem AutomationProperties.AutomationId="CalendarPaneDatePickerHost" Style="{StaticResource ShellPaneHostNavigationViewItemStyle}">
            <coreControls:ShellCalendarView
                Margin="12,0,12,8"
                HorizontalAlignment="Stretch"
                behaviors:CalendarViewRangeBehavior.Client="{x:Bind Parameter, Mode=OneTime}"
                AutomationProperties.AutomationId="VisibleDateRangeCalendarView"
                ExpansionAutomationName="{x:Bind ExpansionAutomationName, Mode=OneWay}"
                ExpansionGlyph="{x:Bind ExpansionGlyph, Mode=OneWay}"
                ExpansionToolTip="{x:Bind ExpansionToolTip, Mode=OneWay}"
                IsPaneExpanded="{x:Bind IsCalendarExpanded, Mode=TwoWay}"
                SelectionMode="Multiple"
                Style="{StaticResource WinoCalendarViewStyle}" />
        </muxc:NavigationViewItem>
    </DataTemplate>

    <!--  One account's calendars  -->
    <DataTemplate x:Key="AccountCalendarGroupTemplate" x:DataType="data:AccountCalendarGroupMenuItem">
        <muxc:NavigationViewItem AutomationProperties.AutomationId="AccountCalendarGroupHost" Style="{StaticResource ShellPaneHostNavigationViewItemStyle}">
            <muxc:Expander
                Margin="8,2"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="AccountCalendarGroupExpander"
                IsExpanded="{x:Bind Parameter.IsExpanded, Mode=TwoWay}">
                <muxc:Expander.Header>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Width="26"
                            MinWidth="0"
                            AutomationProperties.AutomationId="AccountCalendarGroupCheckBox"
                            AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetCalendarsForAccountAutomationName(Parameter.Account.Name), Mode=OneWay}"
                            IsChecked="{x:Bind Parameter.IsCheckedState, Mode=TwoWay}"
                            IsThreeState="True" />

                        <Ellipse
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(Parameter.AccountColorHex), Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{x:Bind Parameter.Account.Name}" />
                                <Run FontSize="12" Text="{x:Bind Parameter.AccountAddressDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Parameter.SynchronizationStatus, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind Parameter.IsSynchronizationProgressVisible, Mode=OneWay}" />
                            <ProgressBar
                                Height="4"
                                IsIndeterminate="{x:Bind Parameter.IsProgressIndeterminate, Mode=OneWay}"
                                ShowError="False"
                                ShowPaused="False"
                                Visibility="{x:Bind Parameter.IsSynchronizationProgressVisible, Mode=OneWay}"
                                Value="{x:Bind Parameter.SynchronizationProgressValue, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </muxc:Expander.Header>
                <muxc:Expander.Content>
                    <ItemsControl ItemsSource="{x:Bind Parameter.AccountCalendars, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:AccountCalendarViewModel">
                                <CheckBox
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.AutomationId="AccountCalendarCheckBox"
                                    AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetCalendarToggleAutomationName(Name), Mode=OneWay}"
                                    IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                                    <Grid Margin="0,0,0,5" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(BackgroundColorHex), Mode=OneWay}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </muxc:Expander.Content>
            </muxc:Expander>
        </muxc:NavigationViewItem>
    </DataTemplate>

    <!--  Calendars for the active account in the ungrouped account layout.  -->
    <DataTemplate x:Key="UngroupedCalendarTemplate" x:DataType="data:UngroupedCalendarMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="40"
            Margin="{x:Bind helpers:XamlHelpers.GetCalendarPaneItemMargin(IsPaneCompact), Mode=OneWay}"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="UngroupedCalendarNavigationItem"
            AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetCalendarToggleAutomationName(Parameter.Name), Mode=OneWay}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False">
            <Grid Margin="0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    MinWidth="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="UngroupedCalendarCheckBox"
                    AutomationProperties.Name="{x:Bind helpers:XamlHelpers.GetCalendarToggleAutomationName(Parameter.Name), Mode=OneWay}"
                    IsChecked="{x:Bind Parameter.IsChecked, Mode=TwoWay}"
                    Tapped="UngroupedCalendarCheckBoxTapped"
                    Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsPaneCompact), Mode=OneWay}" />

                <Ellipse
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(Parameter.BackgroundColorHex), Mode=OneWay}" />

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind Parameter.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  New contact  -->
    <DataTemplate x:Key="NewContactTemplate" x:DataType="menu:NewContactMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="50"
            AutomationProperties.AutomationId="NewContactNavigationItem"
            AutomationProperties.Name="{x:Bind domain:Translator.ContactsPane_NewContact, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsEnabled), Mode=OneWay}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="NewMail" />
            </muxc:NavigationViewItem.Icon>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.ContactsPane_NewContact, Mode=OneTime}" />
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  New contact list  -->
    <DataTemplate x:Key="NewAddressListTemplate" x:DataType="menu:NewAddressListMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="44"
            AutomationProperties.AutomationId="ContactsPaneNewList"
            AutomationProperties.Name="{x:Bind domain:Translator.ContactList_NewTitle, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False"
            Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsEnabled), Mode=OneWay}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="PersonAdd" />
            </muxc:NavigationViewItem.Icon>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.ContactList_NewTitle, Mode=OneTime}" />
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--
        A contacts filter: all contacts, favorites, an address book or a local list.
        List entries accept dropped contacts through the shared drop behaviour.
    -->
    <DataTemplate x:Key="ContactFilterTemplate" x:DataType="contactData:ContactFilterViewModel">
        <coreControls:WinoNavigationViewItem
            MinHeight="36"
            behaviors:MenuItemDropBehavior.IsDropTarget="{x:Bind IsList, Mode=OneTime}"
            AutomationProperties.AutomationId="ContactsFilterItem"
            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
            ContextRequested="ContactListContextRequested"
            DataContext="{x:Bind}"
            Icon="{x:Bind helpers:XamlHelpers.GetAccountOrGlyphIcon(Account, Glyph), Mode=OneTime}"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            SelectsOnInvoked="True"
            ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(Count), Mode=OneWay}"
                    Value="{x:Bind Count, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>

            <Grid>
                <!--  Drop highlight for list entries.  -->
                <Border
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="4"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsDraggingItemOver), Mode=OneWay}" />

                <TextBlock
                    VerticalAlignment="Center"
                    Text="{x:Bind Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--
        The pane's command row. "New list" is the navigation item itself; "New group" rides along
        as an icon button on the right, which is where Microsoft To Do puts it. The button handles
        its own click, so the two actions never collide.
    -->
    <DataTemplate x:Key="NewTaskListTemplate" x:DataType="menu:NewTaskListMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="50"
            AutomationProperties.AutomationId="ToDoNewList"
            AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_NewList, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="Add" />
            </muxc:NavigationViewItem.Icon>
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.ToDoPage_NewList, Mode=OneTime}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ToDoNewGroup"
                    AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_NewGroup, Mode=OneTime}"
                    Click="NewGroup_Click"
                    Style="{StaticResource TransparentActionButtonStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.ToDoPage_NewGroup, Mode=OneTime}">
                    <coreControls:WinoFontIcon FontSize="14" Icon="Folder" />
                </Button>
            </Grid>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="MyDayTaskTemplate" x:DataType="menu:MyDayTaskMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="38"
            AutomationProperties.AutomationId="ToDoMyDayView"
            AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_MyDay, Mode=OneTime}"
            Content="{x:Bind domain:Translator.ToDoPage_MyDay, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="True">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="WeatherSunny" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    AutomationProperties.AutomationId="ToDoMyDayViewCount"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(Count), Mode=OneWay}"
                    Value="{x:Bind Count, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="PlannedTaskTemplate" x:DataType="menu:PlannedTaskMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="38"
            AutomationProperties.AutomationId="ToDoPlannedView"
            AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_Planned, Mode=OneTime}"
            Content="{x:Bind domain:Translator.ToDoPage_Planned, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="True">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="Calendar" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    AutomationProperties.AutomationId="ToDoPlannedViewCount"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(Count), Mode=OneWay}"
                    Value="{x:Bind Count, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="ImportantTaskTemplate" x:DataType="menu:ImportantTaskMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="38"
            AutomationProperties.AutomationId="ToDoImportantView"
            AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_Important, Mode=OneTime}"
            Content="{x:Bind domain:Translator.ToDoPage_Important, Mode=OneTime}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="True">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="Star" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    AutomationProperties.AutomationId="ToDoImportantViewCount"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(Count), Mode=OneWay}"
                    Value="{x:Bind Count, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="AccountTaskListGroupTemplate" x:DataType="menu:AccountTaskListGroupMenuItem">
        <coreControls:WinoNavigationViewItem
            MinHeight="38"
            AllowDrop="True"
            AutomationProperties.AutomationId="ToDoListGroup"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
            Background="Transparent"
            Content="{x:Bind Title, Mode=OneWay}"
            ContextRequested="TaskGroupContextRequested"
            DataContext="{x:Bind}"
            DragEnter="ShellItem_DragEnter"
            DragLeave="ShellItem_DragLeave"
            DragOver="ShellItem_DragOver"
            Drop="ShellItem_Drop"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            MenuItemsSource="{x:Bind SubMenuItems, Mode=OneWay}"
            SelectsOnInvoked="False">
            <coreControls:WinoNavigationViewItem.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">16</x:Double>
            </coreControls:WinoNavigationViewItem.Resources>
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="PanelLeft" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <!--  Lists carry an icon so they align with the smart views above them, plus the same badge.  -->
    <DataTemplate x:Key="AccountTaskListTemplate" x:DataType="menu:AccountTaskListMenuItem">
        <coreControls:WinoNavigationViewItem
            Height="38"
            AutomationProperties.AutomationId="ToDoListItem"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
            Background="Transparent"
            CanDrag="{x:Bind CanMoveToGroup, Mode=OneWay}"
            Content="{x:Bind Title, Mode=OneWay}"
            ContextRequested="TaskListContextRequested"
            DataContext="{x:Bind}"
            DragStarting="ShellItem_DragStarting"
            SelectsOnInvoked="True">
            <coreControls:WinoNavigationViewItem.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            </coreControls:WinoNavigationViewItem.Resources>
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Foreground="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ColorHex), Mode=OneWay}" Icon="Dot" />
            </muxc:NavigationViewItem.Icon>
            <muxc:NavigationViewItem.InfoBadge>
                <muxc:InfoBadge
                    AutomationProperties.AutomationId="ToDoListItemCount"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Visibility="{x:Bind helpers:XamlHelpers.CountToVisibilityConverter(Count), Mode=OneWay}"
                    Value="{x:Bind Count, Mode=OneWay}" />
            </muxc:NavigationViewItem.InfoBadge>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SeperatorTemplate">
        <muxc:NavigationViewItemSeparator Margin="-20,0" />
    </DataTemplate>

    <DataTemplate x:Key="SettingsShellPageItemTemplate" x:DataType="menu:SettingsShellPageMenuItem">
        <coreControls:WinoNavigationViewItem
            AutomationProperties.AutomationId="DataTemplatesWinoNavigationViewItem3"
            Content="{x:Bind Title}"
            DataContext="{x:Bind}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="{x:Bind Icon}" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>


    <DataTemplate x:Key="SettingsShellWinoAccountItemTemplate" x:DataType="menu:SettingsShellPageMenuItem">
        <coreControls:WinoNavigationViewItem
            AutomationProperties.AutomationId="DataTemplatesWinoNavigationViewItem4"
            Content="{x:Bind Title}"
            DataContext="{x:Bind}">
            <muxc:NavigationViewItem.Icon>
                <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/Wino_Icon.ico" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SettingsShellWinoIntelligenceItemTemplate" x:DataType="menu:SettingsShellPageMenuItem">
        <coreControls:WinoNavigationViewItem
            AutomationProperties.AutomationId="DataTemplatesWinoNavigationViewItem6"
            Content="{x:Bind Title}"
            DataContext="{x:Bind}">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Foreground="{ThemeResource WinoIntelligenceBrandIconBrush}" Icon="WinoIntelligence" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SettingsShellGroupItemTemplate" x:DataType="menu:SettingsShellGroupMenuItem">
        <coreControls:WinoNavigationViewItem
            AutomationProperties.AutomationId="SettingsShellGroupNavigationViewItem"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
            Content="{x:Bind Title, Mode=OneWay}"
            DataContext="{x:Bind}"
            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
            MenuItemsSource="{x:Bind SubMenuItems, Mode=OneWay}"
            SelectsOnInvoked="False">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon Icon="{x:Bind Icon}" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="SettingsShellSectionItemTemplate" x:DataType="menu:SettingsShellSectionMenuItem">
        <coreControls:WinoNavigationViewItem
            Margin="0,12,0,4"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="DataTemplatesWinoNavigationViewItem5"
            DataContext="{x:Bind}"
            IsEnabled="False"
            SelectsOnInvoked="False">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="24"
                    Height="24"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <coreControls:WinoFontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Icon="{x:Bind Icon}" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    CharacterSpacing="40"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title}"
                    TextWrapping="NoWrap" />

                <Border
                    Grid.Column="2"
                    Height="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>

    <DataTemplate x:Key="RatingItemTemplate" x:DataType="menu:RateMenuItem">
        <coreControls:WinoNavigationViewItem
            AutomationProperties.AutomationId="DataTemplatesWinoNavigationViewItem7"
            Content="{x:Bind domain:Translator.MenuRate}"
            DataContext="{x:Bind}"
            SelectsOnInvoked="False">
            <muxc:NavigationViewItem.Icon>
                <coreControls:WinoFontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Icon="Heart" />
            </muxc:NavigationViewItem.Icon>
        </coreControls:WinoNavigationViewItem>
    </DataTemplate>
</ResourceDictionary>
