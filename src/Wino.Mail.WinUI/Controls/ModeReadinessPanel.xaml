<UserControl
    x:Class="Wino.Controls.ModeReadinessPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <!--
        Stands in for a mode's working surface while the mode cannot be used. It says why and
        offers the one action that moves the user forward; the page keeps its create commands
        disabled until the state clears.
    -->
    <Grid Background="{x:Bind Background, Mode=OneWay}">
        <StackPanel
            MaxWidth="440"
            Padding="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ModeReadinessTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ModeReadinessMessage"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />
            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ModeReadinessProgress"
                AutomationProperties.Name="{x:Bind ViewModel.Title, Mode=OneWay}"
                IsActive="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}"
                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.IsProgressVisible), Mode=OneWay}" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    AutomationProperties.AutomationId="ModeReadinessPrimaryButton"
                    Command="{x:Bind ViewModel.PrimaryActionCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.PrimaryActionText, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.IsPrimaryActionVisible), Mode=OneWay}" />
                <Button
                    AutomationProperties.AutomationId="ModeReadinessManageAccountsButton"
                    Command="{x:Bind ViewModel.ManageAccountsCommand, Mode=OneWay}"
                    Content="{x:Bind ViewModel.SecondaryActionText, Mode=OneWay}"
                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(ViewModel.IsSecondaryActionVisible), Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
