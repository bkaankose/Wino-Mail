<UserControl
    x:Class="Wino.Mail.WinUI.Controls.DailyBriefingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:Wino.Mail.WinUI.Controls"
    xmlns:vm="using:Wino.Mail.ViewModels"
    MaxWidth="400"
    HorizontalAlignment="Right"
    AutomationProperties.AutomationId="DailyBriefingPanel"
    AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Grouped by the day each message was received, newest day first.  -->
        <CollectionViewSource
            x:Name="BriefingCollectionViewSource"
            IsSourceGrouped="True"
            ItemsPath="Items" />

        <Style x:Key="BriefingGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            A card states only what Jev and Luna produce: sender and time, labels,
            priority, the headline and a one-line summary. No action, status or due date.
        -->
        <DataTemplate x:Key="BriefingItemTemplate" x:DataType="vm:DailyBriefingItem">
            <SwipeControl Tag="{x:Bind}">
                <SwipeControl.RightItems>
                    <SwipeItems Mode="Reveal">
                        <SwipeItem
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                            Invoked="ToggleIgnoreInvoked"
                            Text="{x:Bind IgnoreActionText, Mode=OneWay}" />
                    </SwipeItems>
                </SwipeControl.RightItems>

                <Border
                    Margin="12,4"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="6">

                        <!--  Sender, time, and a marker for cards that arrived since the last view.  -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Source(Fact)}"
                                TextTrimming="CharacterEllipsis" />

                            <Border
                                Grid.Column="1"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.NewBadgeVisibility(IsNew), Mode=OneWay}">
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind domain:Translator.DailyBriefing_New, Mode=OneTime}" />
                            </Border>

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.When(Fact)}" />
                        </Grid>

                        <!--  Luna headline, falling back to the subject before Luna has run.  -->
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.Headline(Fact)}"
                            TextWrapping="Wrap" />

                        <!--  Luna one-line summary.  -->
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.Summary(Fact)}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.SummaryVisibility(Fact)}" />

                        <!--  Priority, then one chip per smart label Jev applied.  -->
                        <ItemsControl ItemsSource="{x:Bind LabelChips}" Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.LabelsVisibility(Fact)}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BriefingLabelChip">
                                    <Border
                                        Padding="6,2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="10" Glyph="{x:Bind Glyph}" />
                                            <TextBlock FontSize="11" Text="{x:Bind Text}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyVisibility(Fact)}">
                            <FontIcon
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="{x:Bind vm:DailyBriefingIcons.PriorityGlyph, Mode=OneTime}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyText(Fact)}" />
                        </StackPanel>

                        <!--  Open is the only action a card offers.  -->
                        <StackPanel
                            Margin="0,4,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                AutomationProperties.AutomationId="{x:Bind OpenActionAutomationId}"
                                Click="OpenItemClicked"
                                Content="{x:Bind domain:Translator.DailyBriefing_ActionOpen, Mode=OneTime}"
                                Tag="{x:Bind}" />
                            <Button
                                AutomationProperties.AutomationId="{x:Bind IgnoreActionAutomationId, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="IgnoreClicked"
                                IsEnabled="{x:Bind CanToggleIgnore, Mode=OneWay}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind IgnoreActionText, Mode=OneWay}">
                                <FontIcon FontSize="13" Glyph="{x:Bind IgnoreActionGlyph, Mode=OneWay}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </SwipeControl>
        </DataTemplate>

        <!--  One header per received day.  -->
        <DataTemplate x:Key="BriefingDayHeaderTemplate" x:DataType="vm:DailyBriefingDateItem">
            <Border Padding="16,10,16,6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SecondaryName}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="PanelRoot"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,1,0"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.Shadow>
            <ThemeShadow x:Name="shadow" />
        </Grid.Shadow>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Height="48"
            Padding="16,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}" />
            <ToggleButton
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingShowIgnoredToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsShowingIgnored, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}">
                <FontIcon FontSize="14" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
            </ToggleButton>
            <Button
                Grid.Column="2"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingCloseButton"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseClicked"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}">
                <FontIcon FontSize="13" Glyph="{x:Bind vm:DailyBriefingIcons.CloseGlyph, Mode=OneTime}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="BriefingListView"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="DailyBriefingContentListView"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
                IsItemClickEnabled="False"
                ItemTemplate="{StaticResource BriefingItemTemplate}"
                ItemsSource="{x:Bind BriefingCollectionViewSource.View, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource BriefingGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource BriefingDayHeaderTemplate}"
                        HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <intelligenceProgress:WinoIntelligenceProgressRing
                    Width="42"
                    Height="42"
                    Animation="Summarize"
                    AutomationProperties.AccessibilityView="Raw"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_ReadingLocal, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                <FontIcon
                    FontSize="26"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind vm:DailyBriefingIcons.WarningGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_LocalErrorTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DailyBriefingRetryButton"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="{x:Bind domain:Translator.DailyBriefing_Retry, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
