<UserControl
    x:Class="Wino.Mail.WinUI.Controls.DailyBriefingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:accountIcon="using:Wino.Mail.Controls.AccountIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:Wino.Mail.WinUI.Controls"
    xmlns:primitives="using:Wino.Mail.Controls.Primitives"
    xmlns:vm="using:Wino.Mail.ViewModels"
    MaxWidth="400"
    HorizontalAlignment="Right"
    AutomationProperties.AutomationId="DailyBriefingPanel"
    AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Name="BriefingCollectionViewSource" IsSourceGrouped="True" />

        <Style x:Key="BriefingGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="BriefingActionContentTemplate" x:DataType="vm:DailyBriefingActionPresentation">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                <TextBlock FontSize="12" Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BriefingItemTemplate" x:DataType="vm:DailyBriefingItem">
            <SwipeControl Tag="{x:Bind}">
                <Border
                    Margin="-4,0"
                    Padding="9,8,9,9"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{x:Bind helpers:XamlHelpers.GetBriefingPriorityBorderBrush(IsPriority)}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle
                            Width="3"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemFillColorCriticalBrush}"
                            RadiusX="2"
                            RadiusY="2"
                            Visibility="{x:Bind IsPriority}" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <primitives:WinoWrapPanel
                                    Margin="-5,0,0,0"
                                    HorizontalSpacing="5"
                                    VerticalSpacing="5">
                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="{x:Bind vm:DailyBriefingIcons.PriorityGlyph, Mode=OneTime}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyText(Fact)}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{x:Bind helpers:XamlHelpers.GetBriefingToneBackground(Tone)}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind helpers:XamlHelpers.GetBriefingToneForeground(Tone)}"
                                            Glyph="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryGlyph(Fact)}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind helpers:XamlHelpers.GetBriefingToneForeground(Tone)}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryText(Fact)}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.DueVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind vm:DailyBriefingIcons.TimeGlyph, Mode=OneTime}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.DueText(Fact)}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                </primitives:WinoWrapPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind presentation:DailyBriefingPanelPresentation.When(Fact)}" />
                            </Grid>

                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Headline(Fact)}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Detail(Fact)}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.DetailVisibility(Fact), Mode=OneWay}" />

                            <!--  Info  -->
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Source(Fact)}"
                                TextWrapping="WrapWholeWords"
                                Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.SourceVisibility(Fact), Mode=OneWay}" />

                            <!--  Actions  -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <primitives:WinoWrapPanel
                                    Grid.Column="0"
                                    HorizontalSpacing="6"
                                    VerticalSpacing="6">
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="{x:Bind Action.AutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Action.Label, Mode=OneWay}"
                                        Click="ActionClicked"
                                        Content="{x:Bind Action, Mode=OneWay}"
                                        ContentTemplate="{StaticResource BriefingActionContentTemplate}"
                                        CornerRadius="4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind Action.IsNative, Mode=OneWay}" />
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="{x:Bind Action.AutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Action.Label, Mode=OneWay}"
                                        Click="ActionClicked"
                                        Content="{x:Bind Action, Mode=OneWay}"
                                        ContentTemplate="{StaticResource BriefingActionContentTemplate}"
                                        CornerRadius="4"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind Action.IsSource, Mode=OneWay}" />
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="DailyBriefingOpenButton"
                                        AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ActionOpen, Mode=OneTime}"
                                        Click="OpenItemClicked"
                                        CornerRadius="4"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind ShowOpenAction, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="{x:Bind vm:DailyBriefingIcons.OpenMailGlyph, Mode=OneTime}" />
                                            <TextBlock FontSize="12" Text="{x:Bind domain:Translator.DailyBriefing_ActionOpen, Mode=OneTime}" />
                                        </StackPanel>
                                    </Button>
                                </primitives:WinoWrapPanel>

                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="{x:Bind IgnoreActionAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind IgnoreActionText, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="IgnoreClicked"
                                    IsEnabled="{x:Bind CanToggleIgnore, Mode=OneWay}"
                                    Style="{StaticResource TransparentActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind IgnoreActionText, Mode=OneWay}"
                                    Visibility="{x:Bind HasIgnoreAction, Mode=OneWay}">
                                    <FontIcon FontSize="13" Glyph="{x:Bind IgnoreActionGlyph, Mode=OneWay}" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="DailyBriefingDeleteButton"
                                    AutomationProperties.Name="{x:Bind DeleteActionText, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DeleteClicked"
                                    IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                    Style="{StaticResource TransparentActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind DeleteActionText, Mode=OneWay}"
                                    Visibility="{x:Bind HasIgnoreAction, Mode=OneWay}">
                                    <presentation:WinoFontIcon FontSize="13" Icon="Delete" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <SwipeControl.LeftItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem
                            Background="{ThemeResource SystemColorControlAccentBrush}"
                            Invoked="ToggleIgnoreInvoked"
                            Text="Toggle Ignore" />
                    </SwipeItems>
                </SwipeControl.LeftItems>
            </SwipeControl>
        </DataTemplate>

        <DataTemplate x:Key="BriefingAccountHeaderTemplate" x:DataType="vm:DailyBriefingAccountGroup">
            <Border
                Margin="10,10,10,4"
                Padding="0"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                        Width="3"
                        Margin="0,4"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        RadiusX="2"
                        RadiusY="2" />
                    <Border
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="0,6,0,6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <accountIcon:WinoAccountIcon
                            Account="{x:Bind helpers:XamlHelpers.GetAccountIconInfo(Account.Account)}"
                            IconSize="30" />
                    </Border>
                    <TextBlock
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind AccountName}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="PanelRoot"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,1,0"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.Shadow>
            <ThemeShadow x:Name="shadow" />
        </Grid.Shadow>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Height="48"
            Padding="16,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}" />
            <ToggleButton
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingShowIgnoredToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsShowingIgnored, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}">
                <FontIcon FontSize="14" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
            </ToggleButton>
            <Button
                Grid.Column="2"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingCloseButton"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseClicked"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}">
                <FontIcon FontSize="13" Glyph="{x:Bind vm:DailyBriefingIcons.CloseGlyph, Mode=OneTime}" />
            </Button>
        </Grid>

        <FlipView
            x:Name="DateFlipView"
            Grid.Row="1"
            Height="60"
            Padding="6,4"
            AutomationProperties.AutomationId="DailyBriefingDateFlipView"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1"
            ItemsSource="{x:Bind ViewModel.Dates, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SelectedDateIndex, Mode=TwoWay}">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:DailyBriefingDateItem">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Date.Day}" />
                    </StackPanel>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <Grid Grid.Row="2">
            <ListView
                x:Name="BriefingListView"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="DailyBriefingContentListView"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
                IsItemClickEnabled="False"
                ItemTemplate="{StaticResource BriefingItemTemplate}"
                ItemsSource="{x:Bind BriefingCollectionViewSource.View, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource BriefingGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource BriefingAccountHeaderTemplate}"
                        HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <intelligenceProgress:WinoIntelligenceProgressRing
                    Width="42"
                    Height="42"
                    Animation="Summarize"
                    AutomationProperties.AccessibilityView="Raw"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_ReadingLocal, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.LockGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                <FontIcon
                    FontSize="26"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind vm:DailyBriefingIcons.WarningGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_LocalErrorTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DailyBriefingRetryButton"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="{x:Bind domain:Translator.DailyBriefing_Retry, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
