<UserControl
    x:Class="Wino.Mail.WinUI.Controls.DailyBriefingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:Wino.Mail.WinUI.Controls"
    xmlns:vm="using:Wino.Mail.ViewModels"
    MaxWidth="400"
    HorizontalAlignment="Right"
    AutomationProperties.AutomationId="DailyBriefingPanel"
    AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Grouped by the day each message was received, newest day first.  -->
        <CollectionViewSource
            x:Name="BriefingCollectionViewSource"
            IsSourceGrouped="True"
            ItemsPath="Items" />

        <Style x:Key="BriefingGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!--
            A card carries three lines and nothing else: Luna's headline with the arrival time
            opposite it, her one-line summary, and Jev's labels beside the one action Jev chose.
            Neither the subject nor the sender is among them - the headline says what the message
            is about, and the card is a briefing entry rather than a second message list.
        -->
        <DataTemplate x:Key="BriefingItemTemplate" x:DataType="vm:DailyBriefingItem">
            <SwipeControl Tag="{x:Bind}">
                <SwipeControl.RightItems>
                    <SwipeItems Mode="Reveal">
                        <SwipeItem
                            Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}"
                            Invoked="ToggleIgnoreInvoked"
                            Text="{x:Bind IgnoreActionText, Mode=OneWay}" />
                    </SwipeItems>
                </SwipeControl.RightItems>

                <Border
                    Margin="4,3"
                    Padding="12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <StackPanel Spacing="4">

                        <!--
                            The headline leads the card, with the arrival time opposite it. The time
                            hugs the top so a headline that wraps to a second line does not drag it
                            down the card. A dot marks what arrived since the last view.
                        -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Summarization headline, falling back to the subject before Summarization has run.  -->
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Headline(Fact)}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DailyBriefingNewMarker"
                                    AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_New, Mode=OneTime}"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.NewBadgeVisibility(IsNew), Mode=OneWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind presentation:DailyBriefingPanelPresentation.When(Fact)}" />
                            </StackPanel>
                        </Grid>

                        <!--  Summarization one-line summary.  -->
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.Summary(Fact)}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.SummaryVisibility(Fact)}" />

                        <!--
                            Labels and the command share the last line. Priority is the first chip
                            rather than a line of its own, so an urgent card costs no extra height.
                        -->
                        <Grid Margin="0,4,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Border
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyVisibility(Fact)}">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Text="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyText(Fact)}" />
                                </Border>

                                <ItemsControl
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Bind presentation:DailyBriefingPanelPresentation.TopLabelChips(LabelChips, Fact)}"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.LabelsVisibility(Fact)}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BriefingLabelChip">
                                            <Border
                                                Padding="6,2"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="10">
                                                <TextBlock
                                                    MaxWidth="110"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Text}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!--  One command, worded by the action Classification chose for this message.  -->
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Padding="10,3"
                                    AutomationProperties.AutomationId="{x:Bind PrimaryActionAutomationId}"
                                    Click="PrimaryActionClicked"
                                    Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="{x:Bind PrimaryActionGlyph}" />
                                        <TextBlock FontSize="12" Text="{x:Bind PrimaryActionText}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="30"
                                    Height="28"
                                    Padding="0"
                                    AutomationProperties.AutomationId="{x:Bind IgnoreActionAutomationId, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="IgnoreClicked"
                                    IsEnabled="{x:Bind CanToggleIgnore, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind IgnoreActionText, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="{x:Bind IgnoreActionGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </SwipeControl>
        </DataTemplate>

        <!--  One header per received day.  -->
        <DataTemplate x:Key="BriefingDayHeaderTemplate" x:DataType="vm:DailyBriefingDateItem">
            <Border Padding="16,10,16,6" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind SecondaryName}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="PanelRoot"
        Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="8,0,0,0"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.Shadow>
            <ThemeShadow x:Name="shadow" />
        </Grid.Shadow>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Height="48"
            Padding="16,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}" />
            <ToggleButton
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingShowIgnoredToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsShowingIgnored, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}">
                <FontIcon FontSize="14" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
            </ToggleButton>
            <Button
                Grid.Column="2"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingCloseButton"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseClicked"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}">
                <FontIcon FontSize="13" Glyph="{x:Bind vm:DailyBriefingIcons.CloseGlyph, Mode=OneTime}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="BriefingListView"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="DailyBriefingContentListView"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
                IsItemClickEnabled="False"
                ItemTemplate="{StaticResource BriefingItemTemplate}"
                ItemsSource="{x:Bind BriefingCollectionViewSource.View, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource BriefingGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource BriefingDayHeaderTemplate}"
                        HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <intelligenceProgress:WinoIntelligenceProgressRing
                    Width="42"
                    Height="42"
                    Animation="Summarize"
                    AutomationProperties.AccessibilityView="Raw"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_ReadingLocal, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                <FontIcon
                    FontSize="26"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind vm:DailyBriefingIcons.WarningGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_LocalErrorTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DailyBriefingRetryButton"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="{x:Bind domain:Translator.DailyBriefing_Retry, Mode=OneTime}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
