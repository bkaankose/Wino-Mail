<UserControl
    x:Class="Wino.Mail.WinUI.Controls.DailyBriefingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:intelligenceProgress="using:Wino.Mail.Controls.IntelligenceProgressRing"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:Wino.Mail.WinUI.Controls"
    xmlns:primitives="using:Wino.Mail.Controls.Primitives"
    xmlns:vm="using:Wino.Mail.ViewModels"
    MaxWidth="400"
    HorizontalAlignment="Right"
    AutomationProperties.AutomationId="DailyBriefingPanel"
    AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <UserControl.Resources>
        <CollectionViewSource x:Name="BriefingCollectionViewSource" IsSourceGrouped="True" />

        <Style x:Key="BriefingGroupHeaderContainerStyle" TargetType="ListViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="BriefingActionContentTemplate" x:DataType="vm:DailyBriefingActionPresentation">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="12" Glyph="{x:Bind Glyph}" />
                <TextBlock FontSize="12" Text="{x:Bind Label}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BriefingItemTemplate" x:DataType="vm:DailyBriefingItem">
            <SwipeControl Tag="{x:Bind}">
                <Border
                    Margin="-4,0"
                    Padding="9,8,9,9"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{x:Bind helpers:XamlHelpers.GetBriefingPriorityBorderBrush(IsPriority)}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle
                            Width="3"
                            VerticalAlignment="Stretch"
                            Fill="{ThemeResource SystemFillColorCriticalBrush}"
                            RadiusX="2"
                            RadiusY="2"
                            Visibility="{x:Bind IsPriority}" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <primitives:WinoWrapPanel HorizontalSpacing="5" VerticalSpacing="5">
                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="{x:Bind vm:DailyBriefingIcons.PriorityGlyph, Mode=OneTime}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.UrgencyText(Fact)}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{x:Bind helpers:XamlHelpers.GetBriefingToneBackground(Tone)}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind helpers:XamlHelpers.GetBriefingToneForeground(Tone)}"
                                            Glyph="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryGlyph(Fact)}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{x:Bind helpers:XamlHelpers.GetBriefingToneForeground(Tone)}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.CategoryText(Fact)}" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    MinHeight="21"
                                    Padding="7,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="11"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.DueVisibility(Fact), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="{x:Bind vm:DailyBriefingIcons.TimeGlyph, Mode=OneTime}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind presentation:DailyBriefingPanelPresentation.DueText(Fact)}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </primitives:WinoWrapPanel>

                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Headline(Fact)}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind presentation:DailyBriefingPanelPresentation.Detail(Fact)}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.DetailVisibility(Fact), Mode=OneWay}" />

                            <!--  Info  -->
                            <Grid RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind presentation:DailyBriefingPanelPresentation.When(Fact)}" />

                                <TextBlock
                                    Grid.Row="1"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind presentation:DailyBriefingPanelPresentation.Source(Fact)}"
                                    TextWrapping="WrapWholeWords"
                                    Visibility="{x:Bind presentation:DailyBriefingPanelPresentation.SourceVisibility(Fact), Mode=OneWay}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="5" />

                            <!--  Actions  -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <primitives:WinoWrapPanel
                                    Grid.Column="0"
                                    HorizontalSpacing="6"
                                    VerticalSpacing="6">
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="{x:Bind Action.AutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Action.Label, Mode=OneWay}"
                                        Click="ActionClicked"
                                        Content="{x:Bind Action, Mode=OneWay}"
                                        ContentTemplate="{StaticResource BriefingActionContentTemplate}"
                                        CornerRadius="4"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind Action.IsNative, Mode=OneWay}" />
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="{x:Bind Action.AutomationId, Mode=OneWay}"
                                        AutomationProperties.Name="{x:Bind Action.Label, Mode=OneWay}"
                                        Click="ActionClicked"
                                        Content="{x:Bind Action, Mode=OneWay}"
                                        ContentTemplate="{StaticResource BriefingActionContentTemplate}"
                                        CornerRadius="4"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind Action.IsSource, Mode=OneWay}" />
                                    <Button
                                        MinHeight="30"
                                        Padding="10,3"
                                        AutomationProperties.AutomationId="DailyBriefingOpenButton"
                                        AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ActionOpen, Mode=OneTime}"
                                        Click="OpenItemClicked"
                                        CornerRadius="4"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind ShowOpenAction, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontSize="12" Glyph="{x:Bind vm:DailyBriefingIcons.OpenMailGlyph, Mode=OneTime}" />
                                            <TextBlock FontSize="12" Text="{x:Bind domain:Translator.DailyBriefing_ActionOpen, Mode=OneTime}" />
                                        </StackPanel>
                                    </Button>
                                </primitives:WinoWrapPanel>

                                <Button
                                    Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Margin="6,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="{x:Bind IgnoreActionAutomationId, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind IgnoreActionText, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="IgnoreClicked"
                                    IsEnabled="{x:Bind CanToggleIgnore, Mode=OneWay}"
                                    Style="{StaticResource TransparentActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind IgnoreActionText, Mode=OneWay}"
                                    Visibility="{x:Bind HasIgnoreAction, Mode=OneWay}">
                                    <FontIcon FontSize="13" Glyph="{x:Bind IgnoreActionGlyph, Mode=OneWay}" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    MinWidth="28"
                                    MinHeight="28"
                                    Margin="40,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="DailyBriefingDeleteButton"
                                    AutomationProperties.Name="{x:Bind DeleteActionText, Mode=OneWay}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="DeleteClicked"
                                    IsEnabled="{x:Bind CanDelete, Mode=OneWay}"
                                    Style="{StaticResource TransparentActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind DeleteActionText, Mode=OneWay}"
                                    Visibility="{x:Bind HasIgnoreAction, Mode=OneWay}">
                                    <PathIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Data="F1 M 19.375 3.125 C 19.375 3.26823 19.34733 3.382162 19.291992 3.466797 C 19.236652 3.551434 19.16341 3.61491 19.072266 3.657227 C 18.981119 3.699545 18.880207 3.727215 18.769531 3.740234 C 18.658854 3.753256 18.544922 3.759766 18.427734 3.759766 C 18.362629 3.759766 18.297525 3.758139 18.232422 3.754883 C 18.167316 3.751629 18.108723 3.75 18.056641 3.75 L 16.435547 17.783203 C 16.396484 18.095703 16.305338 18.387045 16.162109 18.657227 C 16.018879 18.927408 15.836588 19.161783 15.615234 19.360352 C 15.39388 19.55892 15.139974 19.71517 14.853516 19.829102 C 14.567057 19.943033 14.267578 20 13.955078 20 L 6.044922 20 C 5.732422 20 5.432942 19.943033 5.146484 19.829102 C 4.860026 19.71517 4.60612 19.55892 4.384766 19.360352 C 4.163411 19.161783 3.98112 18.927408 3.837891 18.657227 C 3.694661 18.387045 3.603516 18.095703 3.564453 17.783203 L 1.943359 3.75 C 1.910807 3.75 1.878255 3.75 1.845703 3.75 L 1.650391 3.759766 C 1.617839 3.759766 1.585286 3.759766 1.552734 3.759766 C 1.442057 3.759766 1.33138 3.753256 1.220703 3.740234 C 1.110026 3.727215 1.010742 3.697918 0.922852 3.652344 C 0.834961 3.606771 0.763346 3.541668 0.708008 3.457031 C 0.652669 3.372396 0.625 3.261719 0.625 3.125 C 0.625 2.95573 0.686849 2.809246 0.810547 2.685547 C 0.934245 2.56185 1.080729 2.5 1.25 2.5 L 6.933594 2.5 C 6.998697 2.141928 7.127278 1.809896 7.319336 1.503906 C 7.511393 1.197918 7.745768 0.932617 8.022461 0.708008 C 8.299153 0.483398 8.606771 0.309246 8.945312 0.185547 C 9.283854 0.06185 9.635416 0 10 0 C 10.364583 0 10.716146 0.06185 11.054688 0.185547 C 11.393229 0.309246 11.700846 0.483398 11.977539 0.708008 C 12.25423 0.932617 12.488605 1.197918 12.680664 1.503906 C 12.872721 1.809896 13.001302 2.141928 13.066406 2.5 L 18.75 2.5 C 18.91927 2.5 19.065754 2.56185 19.189453 2.685547 C 19.31315 2.809246 19.375 2.95573 19.375 3.125 Z M 8.232422 2.5 L 11.767578 2.5 C 11.702474 2.311199 11.611328 2.140301 11.494141 1.987305 C 11.376953 1.834311 11.240234 1.702475 11.083984 1.591797 C 10.927734 1.481121 10.758463 1.396484 10.576172 1.337891 C 10.39388 1.279297 10.201822 1.25 10 1.25 C 9.798177 1.25 9.606119 1.279297 9.423828 1.337891 C 9.241536 1.396484 9.072266 1.481121 8.916016 1.591797 C 8.759766 1.702475 8.623047 1.834311 8.505859 1.987305 C 8.388672 2.140301 8.297525 2.311199 8.232422 2.5 Z M 16.796875 3.75 L 3.203125 3.75 L 4.804688 17.646484 C 4.84375 17.972006 4.978841 18.237305 5.209961 18.442383 C 5.441081 18.647461 5.719401 18.75 6.044922 18.75 L 13.955078 18.75 C 14.111328 18.75 14.261067 18.72233 14.404297 18.666992 C 14.547525 18.611654 14.674479 18.535156 14.785156 18.4375 C 14.895833 18.339844 14.986979 18.222656 15.058594 18.085938 C 15.130208 17.949219 15.175781 17.802734 15.195312 17.646484 Z M 7.5 14.375 L 7.5 8.125 C 7.5 7.95573 7.561849 7.809246 7.685547 7.685547 C 7.809245 7.56185 7.955729 7.5 8.125 7.5 C 8.294271 7.5 8.440755 7.56185 8.564453 7.685547 C 8.68815 7.809246 8.75 7.95573 8.75 8.125 L 8.75 14.375 C 8.75 14.544271 8.68815 14.690756 8.564453 14.814453 C 8.440755 14.938151 8.294271 15 8.125 15 C 7.955729 15 7.809245 14.938151 7.685547 14.814453 C 7.561849 14.690756 7.5 14.544271 7.5 14.375 Z M 11.25 14.375 L 11.25 8.125 C 11.25 7.95573 11.311849 7.809246 11.435547 7.685547 C 11.559244 7.56185 11.705729 7.5 11.875 7.5 C 12.04427 7.5 12.190754 7.56185 12.314453 7.685547 C 12.43815 7.809246 12.5 7.95573 12.5 8.125 L 12.5 14.375 C 12.5 14.544271 12.43815 14.690756 12.314453 14.814453 C 12.190754 14.938151 12.04427 15 11.875 15 C 11.705729 15 11.559244 14.938151 11.435547 14.814453 C 11.311849 14.690756 11.25 14.544271 11.25 14.375 Z " />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <SwipeControl.LeftItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem
                            Background="{ThemeResource SystemColorControlAccentBrush}"
                            Invoked="ToggleIgnoreInvoked"
                            Text="Toggle Ignore" />
                    </SwipeItems>
                </SwipeControl.LeftItems>
            </SwipeControl>
        </DataTemplate>

        <DataTemplate x:Key="BriefingAccountHeaderTemplate" x:DataType="vm:DailyBriefingAccountGroup">
            <Border
                Margin="10,8,10,3"
                Padding="10,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture
                        Width="24"
                        Height="24"
                        Initials="{x:Bind AccountInitials}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind AccountName}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="PanelRoot"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,1,0"
        CornerRadius="{ThemeResource ControlCornerRadius}"
        DataContext="{x:Bind ViewModel, Mode=OneWay}">
        <Grid.Shadow>
            <ThemeShadow x:Name="shadow" />
        </Grid.Shadow>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Height="48"
            Padding="16,0,8,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}" />
            <ToggleButton
                Grid.Column="1"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingShowIgnoredToggle"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsShowingIgnored, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ShowIgnored, Mode=OneTime}">
                <FontIcon FontSize="14" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
            </ToggleButton>
            <Button
                Grid.Column="2"
                Width="34"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="DailyBriefingCloseButton"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseClicked"
                ToolTipService.ToolTip="{x:Bind domain:Translator.DailyBriefing_ClosePane, Mode=OneTime}">
                <FontIcon FontSize="13" Glyph="{x:Bind vm:DailyBriefingIcons.CloseGlyph, Mode=OneTime}" />
            </Button>
        </Grid>

        <FlipView
            x:Name="DateFlipView"
            Grid.Row="1"
            Height="60"
            Padding="6,4"
            AutomationProperties.AutomationId="DailyBriefingDateFlipView"
            Background="Transparent"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1"
            ItemsSource="{x:Bind ViewModel.Dates, Mode=OneWay}"
            SelectedIndex="{x:Bind ViewModel.SelectedDateIndex, Mode=TwoWay}">
            <FlipView.ItemTemplate>
                <DataTemplate x:DataType="vm:DailyBriefingDateItem">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="{x:Bind DisplayName}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Date.Day}" />
                    </StackPanel>
                </DataTemplate>
            </FlipView.ItemTemplate>
        </FlipView>

        <Grid Grid.Row="2">
            <ListView
                x:Name="BriefingListView"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="DailyBriefingContentListView"
                AutomationProperties.Name="{x:Bind domain:Translator.DailyBriefing_Title, Mode=OneTime}"
                IsItemClickEnabled="False"
                ItemTemplate="{StaticResource BriefingItemTemplate}"
                ItemsSource="{x:Bind BriefingCollectionViewSource.View, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel AreStickyGroupHeadersEnabled="True" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.GroupStyle>
                    <GroupStyle
                        HeaderContainerStyle="{StaticResource BriefingGroupHeaderContainerStyle}"
                        HeaderTemplate="{StaticResource BriefingAccountHeaderTemplate}"
                        HidesIfEmpty="True" />
                </ListView.GroupStyle>
            </ListView>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <intelligenceProgress:WinoIntelligenceProgressRing
                    Width="42"
                    Height="42"
                    Animation="Summarize"
                    AutomationProperties.AccessibilityView="Raw"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_ReadingLocal, Mode=OneTime}" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.InformationGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_EmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.ShowFilteredEmpty, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.VisibilityGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_FilteredEmptyMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
                <FontIcon FontSize="26" Glyph="{x:Bind vm:DailyBriefingIcons.LockGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_UnavailableMessage, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}">
                <FontIcon
                    FontSize="26"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="{x:Bind vm:DailyBriefingIcons.WarningGlyph, Mode=OneTime}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind domain:Translator.DailyBriefing_LocalErrorTitle, Mode=OneTime}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="DailyBriefingRetryButton"
                    Command="{x:Bind ViewModel.RetryCommand}"
