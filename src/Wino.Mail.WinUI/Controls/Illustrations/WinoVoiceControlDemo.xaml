<UserControl
    x:Class="Wino.Controls.Illustrations.WinoVoiceControlDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:voiceBubble="using:Wino.Mail.Controls.VoiceBubble"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--
        A small desktop corner that plays the real voice bubble through one command, so the page shows the feature
        instead of describing it. The bubble sits above the tray the way the app opens it.
    -->
    <Border
        Background="{ThemeResource WinoIllustrationLineSoftBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Viewbox Stretch="Uniform">
            <Grid Width="640" Height="340">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Border
                    Width="380"
                    Height="230"
                    Margin="32,24,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource WinoIllustrationSurfaceBrush}"
                    BorderBrush="{ThemeResource WinoIllustrationLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid Padding="16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <Rectangle
                                Height="8"
                                Fill="{ThemeResource WinoIllustrationLineBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="60"
                                Height="8"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="68"
                                Height="8"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="52"
                                Height="8"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="14">
                            <Rectangle
                                Width="160"
                                Height="10"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineBrush}"
                                RadiusX="5"
                                RadiusY="5" />
                            <Rectangle
                                Height="8"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="200"
                                Height="8"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Height="8"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="140"
                                Height="8"
                                HorizontalAlignment="Left"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="KeyCaps"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.25" />
                    </StackPanel.OpacityTransition>
                    <StackPanel.Resources>
                        <Style x:Key="KeyCapStyle" TargetType="Border">
                            <Setter Property="MinWidth" Value="56" />
                            <Setter Property="Height" Value="48" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Setter Property="BorderBrush" Value="{ThemeResource ControlElevationBorderBrush}" />
                            <Setter Property="BorderThickness" Value="1,1,1,3" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                        <Style x:Key="KeyCapTextStyle" TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="18" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </StackPanel.Resources>
                    <Border Style="{StaticResource KeyCapStyle}">
                        <TextBlock Style="{StaticResource KeyCapTextStyle}" Text="Ctrl" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="+" />
                    <Border Style="{StaticResource KeyCapStyle}">
                        <TextBlock Style="{StaticResource KeyCapTextStyle}" Text="Alt" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="+" />
                    <Border Style="{StaticResource KeyCapStyle}">
                        <TextBlock Style="{StaticResource KeyCapTextStyle}" Text="P" />
                    </Border>
                </StackPanel>

                <voiceBubble:WinoVoiceBubble
                    x:Name="Bubble"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" />

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Rectangle
                                Width="22"
                                Height="22"
                                Fill="{ThemeResource WinoIllustrationLineBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                            <Rectangle
                                Width="22"
                                Height="22"
                                Fill="{ThemeResource WinoIllustrationLineSoftBrush}"
                                RadiusX="4"
                                RadiusY="4" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,0,14,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Image
                                Width="18"
                                Height="18"
                                Source="ms-appx:///Wino.Mail.Controls.WinUI/Assets/WinoLogo.png" />
                            <Rectangle
                                Width="14"
                                Height="14"
                                Fill="{ThemeResource WinoIllustrationLineBrush}"
                                RadiusX="3"
                                RadiusY="3" />
                            <Rectangle
                                Width="36"
                                Height="10"
                                Fill="{ThemeResource WinoIllustrationLineBrush}"
                                RadiusX="3"
                                RadiusY="3" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Border>
</UserControl>
