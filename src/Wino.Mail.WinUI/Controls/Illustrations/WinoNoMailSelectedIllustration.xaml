<UserControl
    x:Class="Wino.Controls.Illustrations.WinoNoMailSelectedIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--
        "Letterhead." One sheet squared to the grid, with the accent carried by the header band alone.
        No envelope and no overlapping silhouettes, so no edge can fall out of alignment with another.
        
        The canvas is 128x84 rather than the family's 128x128: the drawing only ever filled the top of a
        square, and the empty quarter below it pushed the caption away from the artwork. Cropping the
        canvas to the artwork lets the caption sit where the layout puts it. Height is therefore driven
        by the host's Width alone - do not set an explicit Height on this control.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="128" Height="84">
            <Ellipse
                Canvas.Left="32"
                Canvas.Top="72.5"
                Width="64"
                Height="9"
                Fill="{ThemeResource WinoIllustrationShadowBrush}" />

            <!--  The sheet  -->
            <Rectangle
                Canvas.Left="26"
                Canvas.Top="6"
                Width="76"
                Height="62"
                Fill="{ThemeResource WinoIllustrationSurfaceBrush}"
                RadiusX="9"
                RadiusY="9"
                Stroke="{ThemeResource WinoIllustrationLineBrush}"
                StrokeThickness="1.5" />

            <!--  Header band. The one accent shape. Top corners match the sheet exactly.  -->
            <Path Data="M26,15 C26,10 30,6 35,6 L93,6 C98,6 102,10 102,15 L102,24 L26,24 Z" Fill="{ThemeResource WinoIllustrationAccentBrush}" />

            <!--  Body copy  -->
            <Rectangle
                Canvas.Left="38"
                Canvas.Top="36"
                Width="52"
                Height="4"
                Fill="{ThemeResource WinoIllustrationLineBrush}"
                RadiusX="2"
                RadiusY="2" />
            <Rectangle
                Canvas.Left="38"
                Canvas.Top="46"
                Width="44"
                Height="4"
                Fill="{ThemeResource WinoIllustrationLineBrush}"
                RadiusX="2"
                RadiusY="2" />
            <Rectangle
                Canvas.Left="38"
                Canvas.Top="56"
                Width="30"
                Height="4"
                Fill="{ThemeResource WinoIllustrationAccentBrush}"
                Opacity="0.2"
                RadiusX="2"
                RadiusY="2" />
        </Canvas>
    </Viewbox>
</UserControl>
