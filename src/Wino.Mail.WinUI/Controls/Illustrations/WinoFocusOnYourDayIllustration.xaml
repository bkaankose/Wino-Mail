<UserControl
    x:Class="Wino.Controls.Illustrations.WinoFocusOnYourDayIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <!--
        "Sunrise over the list." The warm disc is the only non-accent hue in the family and it
        lives here, where the state is about a fresh day. Accent marks the one done item.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="128" Height="128">
            <Ellipse
                Canvas.Left="30"
                Canvas.Top="101"
                Width="68"
                Height="10"
                Fill="{ThemeResource WinoIllustrationShadowBrush}" />

            <!--  Sun and halo  -->
            <Ellipse
                Canvas.Left="34"
                Canvas.Top="12"
                Width="60"
                Height="60"
                Fill="{ThemeResource WinoIllustrationWarmBrush}"
                Opacity="0.24" />
            <Ellipse
                Canvas.Left="50"
                Canvas.Top="26"
                Width="28"
                Height="28"
                Fill="{ThemeResource WinoIllustrationWarmBrush}" />

            <!--  The list  -->
            <Rectangle
                Canvas.Left="20"
                Canvas.Top="52"
                Width="88"
                Height="48"
                Fill="{ThemeResource WinoIllustrationSurfaceBrush}"
                RadiusX="11"
                RadiusY="11"
                Stroke="{ThemeResource WinoIllustrationLineBrush}"
                StrokeThickness="1.5" />

            <!--  Done row  -->
            <Ellipse
                Canvas.Left="27.5"
                Canvas.Top="60.5"
                Width="15"
                Height="15"
                Fill="{ThemeResource WinoIllustrationAccentBrush}" />
            <Path
                Data="M31.5,68 L34.2,70.7 L38.7,65.4"
                Stroke="{ThemeResource WinoIllustrationSurfaceBrush}"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeThickness="3" />
            <Rectangle
                Canvas.Left="49"
                Canvas.Top="64.5"
                Width="40"
                Height="6"
                Fill="{ThemeResource WinoIllustrationAccentBrush}"
                Opacity="0.2"
                RadiusX="3"
                RadiusY="3" />

            <!--  Pending row  -->
            <Ellipse
                Canvas.Left="27.5"
                Canvas.Top="78.5"
                Width="15"
                Height="15"
                Stroke="{ThemeResource WinoIllustrationLineBrush}"
                StrokeThickness="2.5" />
            <Rectangle
                Canvas.Left="49"
                Canvas.Top="82.5"
                Width="30"
                Height="6"
                Fill="{ThemeResource WinoIllustrationLineBrush}"
                RadiusX="3"
                RadiusY="3" />
        </Canvas>
    </Viewbox>
</UserControl>
