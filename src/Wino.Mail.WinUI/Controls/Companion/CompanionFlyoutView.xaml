<UserControl
    x:Class="Wino.Mail.WinUI.Controls.Companion.CompanionFlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendar="using:Wino.Calendar.ViewModels.Data"
    xmlns:contextFlyout="using:Wino.Mail.Controls.ContextFlyout"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mail="using:Wino.Mail.ViewModels.Data"
    xmlns:mailControls="using:Wino.Mail.Controls.ContactPicture"
    x:Name="Root"
    Width="400"
    MinHeight="460"
    MaxHeight="720"
    IsTabStop="True"
    KeyDown="Root_KeyDown">
    <Grid Background="{ThemeResource CompanionFlyoutBackgroundBrush}">
        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionInitializingState"
            Visibility="{x:Bind ViewModel.InitializingVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="42"
                    Height="42"
                    AutomationProperties.AutomationId="CompanionInitializingProgress"
                    IsActive="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_InitializingTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_InitializingDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionNoAccountsState"
            Visibility="{x:Bind ViewModel.NoAccountsVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <coreControls:WinoFontIcon
                    FontSize="48"
                    Icon="Person"
                    IsHitTestVisible="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_NoAccountsTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_NoAccountsDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="CompanionLaunchWinoNoAccountsButton"
                    Command="{x:Bind ViewModel.OpenWinoCommand}"
                    Content="{x:Bind domain:Translator.Companion_OpenWino, Mode=OneTime}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            Padding="32"
            AutomationProperties.AutomationId="CompanionUnavailableState"
            Visibility="{x:Bind ViewModel.UnavailableVisibility, Mode=OneWay}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <coreControls:WinoFontIcon
                    FontSize="48"
                    Icon="DismissCircle"
                    IsHitTestVisible="False" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind domain:Translator.Companion_UnavailableTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="280"
                    HorizontalAlignment="Center"
                    Text="{x:Bind domain:Translator.Companion_UnavailableDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="CompanionLaunchWinoUnavailableButton"
                    Command="{x:Bind ViewModel.OpenWinoCommand}"
                    Content="{x:Bind domain:Translator.Companion_OpenWino, Mode=OneTime}"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid AutomationProperties.AutomationId="CompanionReadyState" Visibility="{x:Bind ViewModel.ReadyVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="12,13,8,9" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.GreetingText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                        Text="{x:Bind ViewModel.DateText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ToggleSplitButton
                    Grid.Column="1"
                    Height="34"
                    AutomationProperties.AutomationId="CompanionSnoozeNotificationsButton"
                    AutomationProperties.Name="{x:Bind ViewModel.SnoozeActionText, Mode=OneWay}"
                    IsChecked="{x:Bind ViewModel.SnoozeNotifications, Mode=OneWay}"
                    IsCheckedChanged="SnoozeSplitButton_IsCheckedChanged"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SnoozeActionText, Mode=OneWay}">
                    <coreControls:WinoFontIcon FontSize="16" Glyph="{x:Bind ViewModel.SnoozeGlyph, Mode=OneWay}" />
                    <ToggleSplitButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <!--  Only shown while a custom snooze set in Settings is running.  -->
                            <ToggleMenuFlyoutItem
                                x:Name="CustomSnoozeItem"
                                AutomationProperties.AutomationId="CompanionSnoozeCustomItem"
                                IsChecked="True"
                                IsHitTestVisible="False"
                                Text="{x:Bind ViewModel.CustomSnoozeText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CustomSnoozeVisibility, Mode=OneWay}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeThirtyMinutes"
                                Click="SnoozePreset_Click"
                                Tag="ThirtyMinutes"
                                Text="{x:Bind domain:Translator.NotificationSnooze_ThirtyMinutes, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeOneHour"
                                Click="SnoozePreset_Click"
                                Tag="OneHour"
                                Text="{x:Bind domain:Translator.NotificationSnooze_OneHour, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeTwoHours"
                                Click="SnoozePreset_Click"
                                Tag="TwoHours"
                                Text="{x:Bind domain:Translator.NotificationSnooze_TwoHours, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeRestOfDay"
                                Click="SnoozePreset_Click"
                                Tag="RestOfDay"
                                Text="{x:Bind domain:Translator.NotificationSnooze_RestOfDay, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeTomorrowMorning"
                                Click="SnoozePreset_Click"
                                Tag="UntilTomorrowMorning"
                                Text="{x:Bind domain:Translator.NotificationSnooze_UntilTomorrowMorning, Mode=OneTime}" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="CompanionSnoozeUntilTurnedBackOn"
                                Click="SnoozePreset_Click"
                                Tag="UntilTurnedBackOn"
                                Text="{x:Bind domain:Translator.NotificationSnooze_UntilTurnedBackOn, Mode=OneTime}" />
                        </MenuFlyout>
                    </ToggleSplitButton.Flyout>
                </ToggleSplitButton>
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.AutomationId="CompanionOpenSettingsButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.Companion_Settings, Mode=OneTime}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    Style="{ThemeResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Settings, Mode=OneTime}">
                    <coreControls:WinoFontIcon FontSize="16" Icon="Settings" />
                </Button>

                <!--
                    The snooze button is icon only, so this strip is what actually tells the user
                    notifications are being held, and until when.
                -->
                <Border
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Margin="0,10,4,0"
                    Padding="10,6"
                    AutomationProperties.AutomationId="CompanionSnoozeInfoBar"
                    Background="{ThemeResource CompanionSubtleBackgroundBrush}"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.SnoozeInfoVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                            Icon="AlertOff" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                            Text="{x:Bind ViewModel.SnoozeInfoText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl
                Grid.Row="1"
                Padding="12,2,12,12"
                AutomationProperties.AutomationId="CompanionFavoriteContacts"
                ItemsSource="{x:Bind ViewModel.Favorites}"
                Visibility="{x:Bind ViewModel.FavoritesVisibility, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mail:AccountContactViewModel">
                        <Button
                            Width="56"
                            Padding="2,4"
                            AutomationProperties.AutomationId="CompanionFavoriteContactButton"
                            AutomationProperties.Name="{x:Bind Name}"
                            Click="Contact_Click"
                            CommandParameter="{x:Bind}"
                            CornerRadius="6"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind Name}">
                            <StackPanel Spacing="3">
                                <Grid HorizontalAlignment="Center">
                                    <mailControls:WinoContactPicture
                                        Width="34"
                                        Height="34"
                                        ContactPicture="{x:Bind helpers:XamlHelpers.GetContactPicture(SenderContact, FromName, FromAddress), Mode=OneWay}"
                                        FontSize="13"
                                        IsFaviconEnabled="{x:Bind helpers:XamlHelpers.GetFaviconEnabled(), Mode=OneTime}"
                                        IsGravatarEnabled="{x:Bind helpers:XamlHelpers.GetGravatarEnabled(), Mode=OneTime}"
                                        IsHitTestVisible="False" />
                                    <Border
                                        Margin="0,-2,-2,0"
                                        Padding="4,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(HasUnread), Mode=OneWay}">
                                        <TextBlock
                                            MinWidth="9"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind UnreadCountText, Mode=OneWay}"
                                            TextAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                    Text="{x:Bind FirstName, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border
                Grid.Row="2"
                Height="1"
                Margin="0,0,0,6"
                Background="{ThemeResource CompanionDividerBrush}" />

            <ScrollViewer
                Grid.Row="3"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Padding="12,0,12,10" Visibility="{x:Bind ViewModel.EventVisibility, Mode=OneWay}">
                        <Border
                            Padding="14,13"
                            AutomationProperties.AutomationId="CompanionNextEventCard"
                            Background="{ThemeResource CompanionCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="9,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="11">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind ViewModel.NextEventCountdownText, Mode=OneWay}" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CompanionSubtleBackgroundBrush}"
                                        CornerRadius="11"
                                        Visibility="{x:Bind ViewModel.NextEventOnlineVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <coreControls:WinoFontIcon
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Icon="Link" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind domain:Translator.Companion_EventOnline, Mode=OneTime}" />
                                        </StackPanel>
                                    </Border>
                                    <Button
                                        Grid.Column="3"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.AutomationId="CompanionEventMoreActionsButton"
                                        AutomationProperties.Name="{x:Bind domain:Translator.Companion_EventMoreActions, Mode=OneTime}"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_EventMoreActions, Mode=OneTime}">
                                        <coreControls:WinoFontIcon FontSize="14" Icon="More" />
                                        <Button.Flyout>
                                            <contextFlyout:WinoContextFlyout Placement="BottomEdgeAlignedRight">
                                                <contextFlyout:WinoContextFlyoutItem
                                                    AutomationId="CompanionOpenEvent"
                                                    Click="OpenEvent_Click"
                                                    IconGlyph="&#xE065;"
                                                    Text="{x:Bind domain:Translator.Companion_OpenEvent, Mode=OneTime}" />
                                                <contextFlyout:WinoContextFlyoutItem
                                                    AutomationId="CompanionOpenCalendar"
                                                    Command="{x:Bind ViewModel.OpenCalendarCommand}"
                                                    IconGlyph="&#xE912;"
                                                    Text="{x:Bind domain:Translator.Companion_OpenCalendar, Mode=OneTime}" />
                                            </contextFlyout:WinoContextFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.NextEvent.Title, Mode=OneWay, TargetNullValue=''}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                        Text="{x:Bind ViewModel.NextEventTimeText, Mode=OneWay}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Visibility="{x:Bind ViewModel.NextEventCalendarVisibility, Mode=OneWay}">
                                        <Rectangle
                                            Width="8"
                                            Height="8"
                                            VerticalAlignment="Center"
                                            Fill="{x:Bind helpers:XamlHelpers.GetSolidColorBrushFromHex(ViewModel.NextEventCalendarColorHex), Mode=OneWay}"
                                            RadiusX="2"
                                            RadiusY="2" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                            Text="{x:Bind ViewModel.NextEventCalendarName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    FontSize="12.5"
                                    Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                    Text="{x:Bind ViewModel.NextEvent.Location, Mode=OneWay, TargetNullValue=''}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind ViewModel.NextEventLocationVisibility, Mode=OneWay}" />
                                <Grid Margin="0,5,0,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                        Text="{x:Bind ViewModel.NextEventAttendeesText, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.NextEventAttendeesVisibility, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.AutomationId="CompanionEventPrimaryButton"
                                        Command="{x:Bind ViewModel.OpenPrimaryEventCommand}"
                                        CommandParameter="{x:Bind ViewModel.NextEvent, Mode=OneWay}"
                                        Content="{x:Bind ViewModel.NextEventPrimaryActionText, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button
                            Margin="0,6,0,0"
                            Padding="10,6"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.AutomationId="CompanionMoreEventsButton"
                            Visibility="{x:Bind ViewModel.LaterEventsVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <coreControls:WinoFontIcon
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Icon="ChevronRight" />
                                <TextBlock
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.LaterEventsText, Mode=OneWay}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Width="320" Spacing="4">
                                        <TextBlock
                                            Margin="4,0,0,4"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                            Text="{x:Bind domain:Translator.Companion_RestOfToday, Mode=OneTime}" />
                                        <ItemsControl AutomationProperties.AutomationId="CompanionLaterEventsList" ItemsSource="{x:Bind ViewModel.LaterEvents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="calendar:CalendarItemViewModel">
                                                    <Button
                                                        Margin="0,1"
                                                        Padding="8"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        AutomationProperties.AutomationId="CompanionLaterEventButton"
                                                        Click="LaterEvent_Click"
                                                        CommandParameter="{x:Bind}"
                                                        Style="{ThemeResource SubtleButtonStyle}">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                                                                Text="{x:Bind DisplayStartTime, Mode=OneWay}"
                                                                TextAlignment="Right" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{x:Bind Title}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                                                    Text="{x:Bind Location}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="12,2,12,8"
                        Background="{ThemeResource CompanionDividerBrush}"
                        Visibility="{x:Bind ViewModel.EventMailSeparatorVisibility, Mode=OneWay}" />

                    <StackPanel Padding="12,0,12,6" Visibility="{x:Bind ViewModel.UnreadMailVisibility, Mode=OneWay}">
                        <Grid Padding="0,0,0,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                Text="{x:Bind domain:Translator.Companion_Unread, Mode=OneTime}" />
                            <Border
                                Grid.Column="1"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="9">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="{x:Bind ViewModel.UnreadTotalText, Mode=OneWay}" />
                            </Border>
                        </Grid>
                        <ItemsControl AutomationProperties.AutomationId="CompanionUnreadMailList" ItemsSource="{x:Bind ViewModel.UnreadMail}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mail:MailItemViewModel">
                                    <Grid
                                        Background="Transparent"
                                        PointerEntered="MailRow_PointerEntered"
                                        PointerExited="MailRow_PointerExited"
                                        Tag="{x:Bind}"
                                        Tapped="MailRow_Tapped">
                                        <ContentPresenter
                                            Height="64"
                                            Content="{x:Bind}"
                                            ContentTemplate="{StaticResource CompactSingleMailItemTemplate}"
                                            IsHitTestVisible="False" />
                                        <StackPanel
                                            x:Name="HoverActions"
                                            Margin="0,0,8,0"
                                            Padding="3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            Visibility="Collapsed">
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                AutomationProperties.AutomationId="CompanionArchiveMailButton"
                                                AutomationProperties.Name="{x:Bind domain:Translator.Companion_Archive, Mode=OneTime}"
                                                Click="ArchiveMail_Click"
                                                CommandParameter="{x:Bind}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Archive, Mode=OneTime}">
                                                <coreControls:WinoFontIcon
                                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                                    FontSize="14"
                                                    Icon="Archive" />
                                            </Button>
                                            <Button
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                AutomationProperties.AutomationId="CompanionMarkReadButton"
                                                AutomationProperties.Name="{x:Bind domain:Translator.Companion_MarkRead, Mode=OneTime}"
                                                Click="MarkMailRead_Click"
                                                CommandParameter="{x:Bind}"
                                                Style="{ThemeResource SubtleButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_MarkRead, Mode=OneTime}">
                                                <coreControls:WinoFontIcon
                                                    FontFamily="{ThemeResource WinoIconFontFamily}"
                                                    FontSize="14"
                                                    Icon="MarkRead" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="12,2,12,8"
                        Background="{ThemeResource CompanionDividerBrush}"
                        Visibility="{x:Bind ViewModel.MailTaskSeparatorVisibility, Mode=OneWay}" />

                    <StackPanel Padding="12,0,12,8" Visibility="{x:Bind ViewModel.TasksVisibility, Mode=OneWay}">
                        <Grid Padding="0,0,0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                Text="{x:Bind domain:Translator.Companion_MyDay, Mode=OneTime}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                Text="{x:Bind ViewModel.TaskProgressText, Mode=OneWay}" />
                        </Grid>
                        <ItemsControl AutomationProperties.AutomationId="CompanionTaskList" ItemsSource="{x:Bind ViewModel.Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="mail:TaskItemViewModel">
                                    <CheckBox
                                        MinHeight="40"
                                        Margin="0,1"
                                        AutomationProperties.AutomationId="CompanionTaskCheckBox"
                                        Click="TaskCompleted_Click"
                                        CommandParameter="{x:Bind}"
                                        IsChecked="{x:Bind IsCompleted, Mode=OneWay}">
                                        <StackPanel Margin="4,5,0,5">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                Text="{x:Bind domain:Translator.Companion_TaskOverdue, Mode=OneTime}"
                                                Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(IsOverdue), Mode=OneWay}" />
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsOverdue), Mode=OneWay}">
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                                    Text="{x:Bind ListName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11.5"
                                                    Foreground="{ThemeResource CompanionTertiaryTextBrush}"
                                                    Text="{x:Bind DueDisplayText}"
                                                    Visibility="{x:Bind helpers:XamlHelpers.BoolToVisibilityConverter(HasDueDate), Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                Grid.Row="3"
                Padding="28,22,28,26"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="CompanionCaughtUpState"
                Spacing="2"
                Visibility="{x:Bind ViewModel.CaughtUpVisibility, Mode=OneWay}">
                <Viewbox
                    Width="128"
                    Height="104"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
                    <Canvas Width="128" Height="104">
                        <Path
                            Data="M26 52h20l6 10h24l6-10h20v28a6 6 0 0 1-6 6H32a6 6 0 0 1-6-6V52z"
                            Fill="{ThemeResource CompanionSubtleBackgroundBrush}"
                            Stroke="{ThemeResource CompanionTertiaryTextBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <Path
                            Data="M26 52 38 30a6 6 0 0 1 5.2-3h41.6A6 6 0 0 1 90 30l12 22"
                            Stroke="{ThemeResource CompanionTertiaryTextBrush}"
                            StrokeLineJoin="Round"
                            StrokeThickness="2" />
                        <Ellipse
                            Canvas.Left="49"
                            Canvas.Top="19"
                            Width="30"
                            Height="30"
                            Fill="{ThemeResource AccentFillColorSecondaryBrush}" />
                        <Path
                            Data="M57 34.4l5 5 10-10.4"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="3.4" />
                    </Canvas>
                </Viewbox>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{x:Bind domain:Translator.Companion_CaughtUpTitle, Mode=OneTime}" />
                <TextBlock
                    MaxWidth="260"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource CompanionSecondaryTextBrush}"
                    Text="{x:Bind domain:Translator.Companion_CaughtUpDescription, Mode=OneTime}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="4"
                Padding="12,10,12,12"
                Background="{ThemeResource CompanionSubtleBackgroundBrush}"
                BorderBrush="{ThemeResource CompanionDividerBrush}"
                BorderThickness="0,1,0,0">
                <Grid
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="CompanionAppModeSwitcher"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CompanionDockMailButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.Companion_Mail, Mode=OneTime}"
                        Command="{x:Bind ViewModel.OpenInboxCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Mail, Mode=OneTime}">
                        <Image
                            Width="28"
                            Height="28"
                            Source="ms-appx:///Assets/AppEntries/Mail.svg" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CompanionDockCalendarButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.Companion_Calendar, Mode=OneTime}"
                        Command="{x:Bind ViewModel.OpenCalendarCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Calendar, Mode=OneTime}">
                        <Image
                            Width="28"
                            Height="28"
                            Source="ms-appx:///Assets/AppEntries/Calendar.svg" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CompanionDockContactsButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.Companion_Contacts, Mode=OneTime}"
                        Command="{x:Bind ViewModel.FindAnyContactCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Contacts, Mode=OneTime}">
                        <Image
                            Width="28"
                            Height="28"
                            Source="ms-appx:///Assets/AppEntries/People.svg" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CompanionDockTasksButton"
                        AutomationProperties.Name="{x:Bind domain:Translator.Companion_Tasks, Mode=OneTime}"
                        Command="{x:Bind ViewModel.OpenTasksCommand}"
                        Style="{ThemeResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Companion_Tasks, Mode=OneTime}">
                        <Image
                            Width="28"
                            Height="28"
                            Source="ms-appx:///Assets/AppEntries/ToDo.svg" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
