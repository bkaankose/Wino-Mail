<UserControl
    x:Class="Wino.Controls.UnreadBadgeLocationIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mailViewModels="using:Wino.Mail.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="124"
    Height="78"
    AutomationProperties.AccessibilityView="Raw"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="IllustrationBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>

        <!--  Where a badge would be when the location is turned off.  -->
        <Style x:Key="IllustrationEmptyBadgeStyle" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="7" />
            <Setter Property="RadiusY" Value="7" />
            <Setter Property="Stroke" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="StrokeDashArray" Value="2,2" />
            <Setter Property="StrokeThickness" Value="1" />
        </Style>

        <Style x:Key="IllustrationLineStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Fill" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
    </UserControl.Resources>

    <!--
        Small drawings of the three places a badge can appear. They are decoration: the card next to
        each one names the place and its switch says whether it is on.
    -->
    <Border
        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>

            <!--  Account badge: the account row in the navigation pane.  -->
            <StackPanel
                Padding="8"
                Spacing="7"
                Visibility="{x:Bind GetKindVisibility(Kind, 0), Mode=OneWay}">
                <Border
                    Padding="6,4"
                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                    CornerRadius="4">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Width="12"
                            Height="12"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <Rectangle
                                Width="30"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource IllustrationLineStyle}" />
                            <Rectangle Width="40" Style="{StaticResource IllustrationLineStyle}" />
                        </StackPanel>
                        <Grid Grid.Column="2">
                            <Border
                                Height="14"
                                MinWidth="20"
                                Padding="4,0"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="7"
                                Visibility="{x:Bind IsOn, Mode=OneWay}">
                                <TextBlock Style="{StaticResource IllustrationBadgeTextStyle}" Text="{x:Bind FormatCount(Count), Mode=OneWay}" />
                            </Border>
                            <Rectangle
                                Width="20"
                                Height="14"
                                Style="{StaticResource IllustrationEmptyBadgeStyle}"
                                Visibility="{x:Bind GetOffVisibility(IsOn), Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
                <Grid Padding="6,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="12"
                        Height="12"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="34"
                        VerticalAlignment="Center"
                        Style="{StaticResource IllustrationLineStyle}" />
                </Grid>
                <Grid Padding="6,0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        Width="12"
                        Height="12"
                        Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Rectangle
                        Grid.Column="1"
                        Width="26"
                        VerticalAlignment="Center"
                        Style="{StaticResource IllustrationLineStyle}" />
                </Grid>
            </StackPanel>

            <!--  Taskbar badge: Wino's button on the Windows taskbar.  -->
            <Grid Visibility="{x:Bind GetKindVisibility(Kind, 1), Mode=OneWay}">
                <StackPanel
                    Margin="8"
                    VerticalAlignment="Top"
                    Spacing="4">
                    <Rectangle Width="46" Style="{StaticResource IllustrationLineStyle}" />
                    <Rectangle Width="30" Style="{StaticResource IllustrationLineStyle}" />
                </StackPanel>
                <Border
                    Height="38"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                    CornerRadius="0,0,3,3">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Rectangle
                            Width="18"
                            Height="18"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.5"
                            RadiusX="4"
                            RadiusY="4" />
                        <Rectangle
                            Width="18"
                            Height="18"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.5"
                            RadiusX="4"
                            RadiusY="4" />
                        <Grid Width="26" Height="26">
                            <Image
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Source="ms-appx:///Assets/AppEntries/Mail.svg" />
                            <Border
                                Height="15"
                                MinWidth="15"
                                Padding="3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8"
                                Visibility="{x:Bind IsOn, Mode=OneWay}">
                                <TextBlock
                                    FontSize="9"
                                    Style="{StaticResource IllustrationBadgeTextStyle}"
                                    Text="{x:Bind FormatCount(Count), Mode=OneWay}" />
                            </Border>
                            <Rectangle
                                Width="15"
                                Height="15"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource IllustrationEmptyBadgeStyle}"
                                Visibility="{x:Bind GetOffVisibility(IsOn), Mode=OneWay}" />
                        </Grid>
                        <Rectangle
                            Width="18"
                            Height="18"
                            Fill="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.5"
                            RadiusX="4"
                            RadiusY="4" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Folder badges: the account's own folders with their numbers.  -->
            <ItemsControl
                Padding="8,6"
                IsTabStop="False"
                ItemsSource="{x:Bind Folders, Mode=OneWay}"
                Visibility="{x:Bind GetKindVisibility(Kind, 2), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="5" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="mailViewModels:UnreadBadgeFolderViewModel">
                        <Grid Height="16" ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <coreControls:WinoFontIcon
                                FontFamily="{ThemeResource WinoIconFontFamily}"
                                FontSize="10"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Icon="Folder" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Text="{x:Bind FolderName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind UnreadCount, Mode=OneWay}"
                                Visibility="{x:Bind IsIllustrationBadgeVisible, Mode=OneWay}" />
                            <Rectangle
                                Grid.Column="2"
                                Width="14"
                                Height="11"
                                Style="{StaticResource IllustrationEmptyBadgeStyle}"
                                Visibility="{x:Bind IsIllustrationBadgeHidden, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
