                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </controls:WinoSwipeControl>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
