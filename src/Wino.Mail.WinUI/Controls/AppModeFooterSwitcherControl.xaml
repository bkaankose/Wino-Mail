<UserControl
    x:Class="Wino.Mail.WinUI.Controls.AppModeFooterSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:domain="using:Wino.Core.Domain"
    HorizontalAlignment="Stretch"
    IsTabStop="False"
    Loaded="ControlLoaded"
    Unloaded="ControlUnloaded">


    <!--
        The switcher itself is domain agnostic, so the modes, their wording and what a click
        means all live here. Settings is one of the cells rather than a separate command
        surface, but it still resolves to its own application mode.

        Each glyph is an app icon with its tile removed, taken from the shared app icon
        resources: the theme dictionary picks the artwork drawn for the current surface, and
        the control recolours it so the blues follow the app accent.

        The monochrome asset beside it is the same mode drawn in one ink, for users who have
        turned the app artwork off. It is a second file rather than a recolouring: collapsing
        the artwork to one ink turns its cards into outlines and its paper regions into holes.
    -->
    <appMode:WinoAppModeSwitcher
        x:Name="Switcher"
        AutomationProperties.AutomationId="FooterAppModeSwitcher"
        ModeInvoked="ModeInvoked"
        SettingsInvoked="SettingsInvoked"
        SettingsLabel="{x:Bind domain:Translator.MenuSettings}">
        <appMode:WinoAppModeSwitcherItem
            Glyph="{ThemeResource AppIconMail}"
            MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Mail.svg"
            Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}" />
        <appMode:WinoAppModeSwitcherItem
            Glyph="{ThemeResource AppIconCalendar}"
            MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/Calendar.svg"
            Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}" />
        <appMode:WinoAppModeSwitcherItem
            Glyph="{ThemeResource AppIconPeople}"
            MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/People.svg"
            Label="{x:Bind domain:Translator.ContactsPage_Title}" />
        <appMode:WinoAppModeSwitcherItem
            Glyph="{ThemeResource AppIconToDo}"
            MonochromeGlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mono/ToDo.svg"
            Label="{x:Bind domain:Translator.ToDoPage_Title}" />
    </appMode:WinoAppModeSwitcher>
</UserControl>
