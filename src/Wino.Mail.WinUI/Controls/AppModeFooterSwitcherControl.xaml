<controls:Segmented
    x:Class="Wino.Mail.WinUI.Controls.AppModeFooterSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    Padding="0"
    HorizontalAlignment="Stretch"
    Loaded="ControlLoaded"
    SelectionChanged="ModeSegmentedControlSelectionChanged"
    Unloaded="ControlUnloaded">
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon Icon="Mail" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon Icon="Calendar" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.ContactsPage_Title}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.ContactsPage_Title}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon Icon="People" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_Title}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.ToDoPage_Title}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon Icon="Checkmark" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.MenuSettings}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.MenuSettings}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon Icon="Settings" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
</controls:Segmented>
