<UserControl
    x:Class="Wino.Mail.WinUI.Controls.AppModeFooterSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:domain="using:Wino.Core.Domain"
    HorizontalAlignment="Stretch"
    IsTabStop="False"
    Loaded="ControlLoaded"
    Unloaded="ControlUnloaded">


    <!--
        The switcher itself is domain agnostic, so the modes, their wording and what a click
        means all live here. Settings is one of the cells rather than a separate command
        surface, but it still resolves to its own application mode.

        Each glyph is an app icon with its tile removed, handed over as an asset rather than
        as a ready-made icon: the control recolours it, so the artwork follows the app accent
        and takes whichever paper colour reads against the surface it lands on.
    -->
    <appMode:WinoAppModeSwitcher
        x:Name="Switcher"
        AutomationProperties.AutomationId="FooterAppModeSwitcher"
        ModeInvoked="ModeInvoked"
        SettingsInvoked="SettingsInvoked"
        SettingsLabel="{x:Bind domain:Translator.MenuSettings}">
        <appMode:WinoAppModeSwitcherItem GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg" Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}" />
        <appMode:WinoAppModeSwitcherItem GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg" Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}" />
        <appMode:WinoAppModeSwitcherItem GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg" Label="{x:Bind domain:Translator.ContactsPage_Title}" />
        <appMode:WinoAppModeSwitcherItem GlyphSource="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg" Label="{x:Bind domain:Translator.ToDoPage_Title}" />
    </appMode:WinoAppModeSwitcher>
</UserControl>
