<controls:Segmented
    x:Class="Wino.Mail.WinUI.Controls.AppModeFooterSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:domain="using:Wino.Core.Domain"
    Padding="0"
    HorizontalAlignment="Stretch"
    Loaded="ControlLoaded"
    SelectionChanged="ModeSegmentedControlSelectionChanged"
    Unloaded="ControlUnloaded">
    <!--
        Modes rest as Regular outlines in secondary ink. The selected mode switches to its Filled
        glyph (code-behind) and takes the accent color from SegmentedItemForegroundSelected.
    -->
    <controls:Segmented.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="SegmentedItemForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="SegmentedItemForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="AccentTextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="SegmentedItemForeground" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPointerOver" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundPressed" ResourceKey="SystemColorButtonTextColorBrush" />
                    <StaticResource x:Key="SegmentedItemForegroundSelected" ResourceKey="SystemColorButtonTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </controls:Segmented.Resources>

    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon x:Name="MailModeIcon" Icon="Mail" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon x:Name="CalendarModeIcon" Icon="Calendar" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.ContactsPage_Title}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.ContactsPage_Title}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon x:Name="ContactsModeIcon" Icon="People" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.ToDoPage_Title}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.ToDoPage_Title}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon x:Name="ToDoModeIcon" Icon="CheckmarkCircle" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
    <controls:SegmentedItem
        Padding="0"
        AutomationProperties.Name="{x:Bind domain:Translator.MenuSettings}"
        ToolTipService.ToolTip="{x:Bind domain:Translator.MenuSettings}">
        <controls:SegmentedItem.Icon>
            <coreControls:WinoFontIcon x:Name="SettingsModeIcon" Icon="Settings" />
        </controls:SegmentedItem.Icon>
    </controls:SegmentedItem>
</controls:Segmented>
