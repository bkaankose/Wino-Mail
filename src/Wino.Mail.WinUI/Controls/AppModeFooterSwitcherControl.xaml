<UserControl
    x:Class="Wino.Mail.WinUI.Controls.AppModeFooterSwitcherControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appMode="using:Wino.Mail.Controls.AppModeSwitcher"
    xmlns:domain="using:Wino.Core.Domain"
    HorizontalAlignment="Stretch"
    IsTabStop="False"
    Loaded="ControlLoaded"
    Unloaded="ControlUnloaded">


    <!--
        The switcher itself is domain agnostic, so the modes, their wording and what a click
        means all live here. Settings is deliberately not one of the items: it is a global
        command, and the control keeps it outside the card that holds the modes.

        Each glyph is an app icon with its tile removed, so selecting a mode slides a tile
        back under it and it reads as the app icon again. The tile takes the app's accent
        rather than the icon's own blue, so it follows whatever accent the user has set.
    -->
    <appMode:WinoAppModeSwitcher
        x:Name="Switcher"
        AutomationProperties.AutomationId="FooterAppModeSwitcher"
        ModeInvoked="ModeInvoked"
        SettingsInvoked="SettingsInvoked"
        SettingsLabel="{x:Bind domain:Translator.MenuSettings}">
        <appMode:WinoAppModeSwitcherItem Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeMail}">
            <appMode:WinoAppModeSwitcherItem.Icon>
                <ImageIcon
                    Width="30"
                    Height="30"
                    Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Mail.svg" />
            </appMode:WinoAppModeSwitcherItem.Icon>
        </appMode:WinoAppModeSwitcherItem>
        <appMode:WinoAppModeSwitcherItem Label="{x:Bind domain:Translator.KeyboardShortcuts_ModeCalendar}">
            <appMode:WinoAppModeSwitcherItem.Icon>
                <ImageIcon
                    Width="30"
                    Height="30"
                    Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/Calendar.svg" />
            </appMode:WinoAppModeSwitcherItem.Icon>
        </appMode:WinoAppModeSwitcherItem>
        <appMode:WinoAppModeSwitcherItem Label="{x:Bind domain:Translator.ContactsPage_Title}">
            <appMode:WinoAppModeSwitcherItem.Icon>
                <ImageIcon
                    Width="30"
                    Height="30"
                    Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/People.svg" />
            </appMode:WinoAppModeSwitcherItem.Icon>
        </appMode:WinoAppModeSwitcherItem>
        <appMode:WinoAppModeSwitcherItem Label="{x:Bind domain:Translator.ToDoPage_Title}">
            <appMode:WinoAppModeSwitcherItem.Icon>
                <ImageIcon
                    Width="30"
                    Height="30"
                    Source="ms-appx:///Wino.Mail.Controls/Assets/AppModes/ToDo.svg" />
            </appMode:WinoAppModeSwitcherItem.Icon>
        </appMode:WinoAppModeSwitcherItem>
    </appMode:WinoAppModeSwitcher>
</UserControl>
