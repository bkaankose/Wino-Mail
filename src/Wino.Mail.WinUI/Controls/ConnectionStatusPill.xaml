<UserControl
    x:Class="Wino.Controls.ConnectionStatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        One pill per state, each with its own theme brushes. Status always has text beside the
        colour, so it reads the same in High Contrast and to a screen reader.
    -->
    <Grid VerticalAlignment="Center">
        <Border
            Padding="8,2"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Visibility="{x:Bind GetStateVisibility(State, 0), Mode=OneWay}">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind domain:Translator.ImapSetup_StatusNotTested, Mode=OneTime}" />
        </Border>

        <Border
            Padding="8,2"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="10"
            Visibility="{x:Bind GetStateVisibility(State, 1), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ProgressRing
                    Width="12"
                    Height="12"
                    IsActive="{x:Bind IsTesting(State), Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.ImapSetup_StatusTesting, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <Border
            Padding="8,2"
            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            CornerRadius="10"
            Visibility="{x:Bind GetStateVisibility(State, 2), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.ImapSetup_StatusConnected, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <Border
            Padding="8,2"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            CornerRadius="10"
            Visibility="{x:Bind GetStateVisibility(State, 3), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE711;" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.ImapSetup_StatusFailed, Mode=OneTime}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
