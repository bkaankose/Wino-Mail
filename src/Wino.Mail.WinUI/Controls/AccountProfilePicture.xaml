<UserControl
    x:Class="Wino.Mail.WinUI.Controls.AccountProfilePicture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wino.Mail.WinUI.Controls">
    <Grid x:Name="ProfilePictureRoot" Visibility="Collapsed">
        <local:WinoFontIcon
            x:Name="ProviderIcon"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            FontSize="20"
            Visibility="Collapsed" />
        <Ellipse x:Name="ProfileImage" AutomationProperties.AccessibilityView="Raw" />
        <Ellipse
            x:Name="AccountColorBorder"
            AutomationProperties.AccessibilityView="Raw"
            IsHitTestVisible="False"
            StrokeThickness="2"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
