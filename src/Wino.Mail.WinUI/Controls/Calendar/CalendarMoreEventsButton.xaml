<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Wino.Calendar.Controls.CalendarMoreEventsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wino.Calendar.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:Wino.Calendar.ViewModels.Data"
    d:DesignHeight="20"
    d:DesignWidth="140"
    mc:Ignorable="d">

    <HyperlinkButton
        x:Name="MoreButton"
        MinHeight="0"
        Padding="4,0,4,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        VerticalContentAlignment="Center"
        AutomationProperties.Name="{x:Bind Overflow.AccessibleName, Mode=OneWay}"
        Click="MoreButtonClick"
        ToolTipService.ToolTip="{x:Bind Overflow.AccessibleName, Mode=OneWay}">
        <TextBlock
            FontSize="12"
            FontWeight="SemiBold"
            Text="{x:Bind Overflow.MoreText, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="HiddenItemsFlyout" Placement="Bottom">
                <ScrollViewer
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        Width="280"
                        ItemsSource="{x:Bind Overflow.HiddenItems, Mode=OneWay}"
                        Tapped="HiddenItemsTapped">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CalendarItemViewModel">
                                <local:CalendarItemControl
                                    Height="30"
                                    Margin="0,0,0,4"
                                    CalendarItem="{x:Bind}"
                                    IsCustomEventArea="True"
                                    IsDragDisabled="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </HyperlinkButton>
</UserControl>
