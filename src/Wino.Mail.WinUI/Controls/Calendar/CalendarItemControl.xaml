<UserControl
    x:Class="Wino.Calendar.Controls.CalendarItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:calendarHelpers="using:Wino.Calendar.Helpers"
    xmlns:controls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Wino.Calendar.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    ActualThemeChanged="OnControlActualThemeChanged"
    AutomationProperties.Name="{x:Bind calendarHelpers:CalendarXamlHelpers.GetEventAutomationName(CalendarItem.Title, CalendarItem.StartDate, CalendarItem.EndDate, CalendarItem.IsAllDayEvent, CalendarItem.IsRecurringEvent, CalendarItem.Location, CalendarItem.AssignedCalendar.Name, CalendarItem.StateDescription, CalendarItem.CalendarSettings), Mode=OneWay}"
    CanDrag="{x:Bind local:CalendarItemControl.CanDragItem(CalendarItem.CanDragDrop, IsDragDisabled), Mode=OneWay, FallbackValue=False}"
    DragStarting="ControlDragStarting"
    DropCompleted="ControlDropped"
    Loaded="OnControlLoaded"
    SizeChanged="ControlSizeChanged"
    Unloaded="OnControlUnloaded"
    mc:Ignorable="d">

    <!--
        Tinted tile: a wash of the calendar colour pre-mixed with an opaque grid colour, a 3 px bar of
        the full colour, theme text, and the time line in a contrast-safe variant of the colour. The
        colour brushes come from code (CalendarTileColors); shapes and theme brushes switch here.
    -->
    <Grid
        x:Name="MainGrid"
        Background="Transparent"
        CornerRadius="4"
        DoubleTapped="ControlDoubleTapped"
        PointerCanceled="MainGridPointerLeft"
        PointerCaptureLost="MainGridPointerLeft"
        PointerEntered="MainGridPointerEntered"
        PointerExited="MainGridPointerLeft"
        RightTapped="ControlRightTapped"
        Tapped="ControlTapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.ContextFlyout>
            <local:CalendarItemCommandBarFlyout
                Closed="CalendarItemCommandBarFlyout_Closed"
                Opening="CalendarItemCommandBarFlyout_Opening"
                Placement="BottomEdgeAlignedLeft"
                ShowMode="Auto" />
        </Grid.ContextFlyout>
        <ToolTipService.ToolTip>
            <ToolTip Content="{x:Bind calendarHelpers:CalendarXamlHelpers.GetEventToolTip(CalendarItem.DisplayTitle, CalendarItem.StateDescription), Mode=OneWay}" />
        </ToolTipService.ToolTip>

        <Border
            x:Name="WashLayer"
            Grid.ColumnSpan="3"
            Background="{x:Bind TileBackground, Mode=OneWay}" />

        <Border
            x:Name="HoverLayer"
            Grid.ColumnSpan="3"
            Background="{x:Bind TileHover, Mode=OneWay}"
            Opacity="0" />

        <Border
            x:Name="SelectedLayer"
            Grid.ColumnSpan="3"
            Background="{x:Bind TileHover, Mode=OneWay}"
            Opacity="0" />

        <Grid
            x:Name="BarHost"
            Width="3"
            Margin="2,2,0,2"
            SizeChanged="BarHostSizeChanged">
            <Rectangle
                x:Name="SolidBar"
                Fill="{x:Bind TileAccent, Mode=OneWay}"
                RadiusX="1.5"
                RadiusY="1.5" />
            <Rectangle
                x:Name="HollowBar"
                RadiusX="1.5"
                RadiusY="1.5"
                Stroke="{x:Bind TileAccent, Mode=OneWay}"
                StrokeThickness="1"
                Visibility="Collapsed" />
            <!--  Dash lengths are in multiples of the 3 px thickness: 4 px dashes, 3 px gaps.  -->
            <Line
                x:Name="DashedBar"
                Stroke="{x:Bind TileAccent, Mode=OneWay}"
                StrokeDashArray="1.3333 1"
                StrokeThickness="3"
                Visibility="Collapsed"
                X1="1.5"
                X2="1.5"
                Y1="0"
                Y2="0" />
        </Grid>

        <Rectangle
            x:Name="StatusOutline"
            Grid.ColumnSpan="3"
            RadiusX="4"
            RadiusY="4"
            Stroke="{x:Bind TileOutline, Mode=OneWay}"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="EventTextPanel"
            Grid.Column="1"
            Margin="6,3,4,0"
            VerticalAlignment="Top"
            Spacing="2">
            <!--  Spacing sits on the optional elements: Grid ColumnSpacing still applies around collapsed columns.  -->
            <Grid x:Name="TitleRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StartTimeTextBlock"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                    Text="{x:Bind CalendarItem.DisplayStartTime, Mode=OneWay}"
                    Visibility="Collapsed" />
                <controls:WinoFontIcon
                    x:Name="PrivateGlyph"
                    Grid.Column="1"
                    Margin="0,3,4,0"
                    VerticalAlignment="Top"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Icon="LockClosed"
                    Visibility="{x:Bind CalendarItem.IsPrivate, Mode=OneWay}" />
                <TextBlock
                    x:Name="EventTitleTextblock"
                    Grid.Column="2"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    HorizontalTextAlignment="Left"
                    MaxLines="2"
                    Text="{x:Bind CalendarItem.DisplayTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
            <StackPanel
                x:Name="EventDetailsPanel"
                Spacing="2"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="EventTimeTextBlock"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                    Text="{x:Bind CalendarItem.DisplayTimeRange, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="EventLocationTextBlock"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind CalendarItem.Location, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <muxc:ProgressRing
            x:Name="BusyRing"
            Grid.Column="2"
            Width="10"
            Height="10"
            Margin="0,4,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsActive="False"
            Visibility="Collapsed" />

        <StackPanel
            x:Name="AttributeStack"
            Grid.Column="2"
            Margin="0,4,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="4">
            <controls:WinoFontIcon
                FontSize="12"
                Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                Icon="QuestionCircle"
                Visibility="{x:Bind CalendarItem.NeedsResponse, Mode=OneWay}" />

            <controls:WinoFontIcon
                FontSize="12"
                Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                Icon="Airplane"
                Visibility="{x:Bind CalendarItem.IsOutOfOffice, Mode=OneWay}" />

            <controls:WinoFontIcon
                FontSize="12"
                Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                Icon="Home"
                Visibility="{x:Bind CalendarItem.IsWorkingElsewhere, Mode=OneWay}" />

            <controls:WinoFontIcon
                FontSize="12"
                Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                Icon="CalendarEventRepeat"
                Visibility="{x:Bind CalendarItem.IsRecurringEvent, Mode=OneWay}" />

            <controls:WinoFontIcon
                FontSize="12"
                Foreground="{x:Bind TileTextBrush, Mode=OneWay}"
                Icon="CalendarEventMuiltiDay"
                Visibility="{x:Bind CalendarItem.IsMultiDayEvent, Mode=OneWay}" />
        </StackPanel>

        <Border
            x:Name="SelectionBorder"
            Grid.ColumnSpan="3"
            BorderBrush="{ThemeResource CalendarItemSelectedBorderBrush}"
            BorderThickness="2"
            CornerRadius="4"
            Visibility="Collapsed" />

        <Rectangle
            x:Name="DragOutline"
            Grid.ColumnSpan="3"
            RadiusX="4"
            RadiusY="4"
            Stroke="{ThemeResource CalendarItemDraggingBorderBrush}"
            StrokeDashArray="2.5"
            StrokeThickness="2"
            Visibility="Collapsed" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="TitlePlacementStates">
                <VisualState x:Name="DefaultTitlePlacement" />
                <VisualState x:Name="ProtectedTitlePlacement">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind ProtectTitle, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="EventTitleTextblock.VerticalAlignment" Value="Top" />
                        <Setter Target="EventTitleTextblock.HorizontalTextAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="PointerNormal" />
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="HoverLayer.Opacity" Value="0.12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="NonSelected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="SelectionBorder.Visibility" Value="Visible" />
                        <Setter Target="SelectedLayer.Opacity" Value="0.12" />
                    </VisualState.Setters>
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind CalendarItem.IsSelected, Mode=OneWay, FallbackValue=False}" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="DraggingStates">
                <VisualState x:Name="NotDragging" />
                <VisualState x:Name="Dragging">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsDragging, Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DragOutline.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="BusyStates">
                <VisualState x:Name="NotBusy" />
                <VisualState x:Name="Busy">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind CalendarItem.IsBusy, Mode=OneWay, FallbackValue=False}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="MainGrid.Opacity" Value="0.6" />
                        <Setter Target="BusyRing.IsActive" Value="True" />
                        <Setter Target="BusyRing.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--  Show-as: Busy keeps the solid bar, Free hollows it and Tentative dashes it.  -->
            <VisualStateGroup x:Name="BarStates">
                <VisualState x:Name="SolidBarState" />
                <VisualState x:Name="HollowBarState">
                    <VisualState.Setters>
                        <Setter Target="SolidBar.Visibility" Value="Collapsed" />
                        <Setter Target="HollowBar.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DashedBarState">
                    <VisualState.Setters>
                        <Setter Target="SolidBar.Visibility" Value="Collapsed" />
                        <Setter Target="DashedBar.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="OutlineStates">
                <VisualState x:Name="NoOutline" />
                <VisualState x:Name="SolidOutline">
                    <VisualState.Setters>
                        <Setter Target="StatusOutline.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DashedOutline">
                    <VisualState.Setters>
                        <Setter Target="StatusOutline.Visibility" Value="Visible" />
                        <Setter Target="StatusOutline.StrokeThickness" Value="1.5" />
                        <Setter Target="StatusOutline.StrokeDashArray" Value="3 2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="EmphasisStates">
                <VisualState x:Name="NormalEmphasis" />
                <VisualState x:Name="PastEmphasis">
                    <VisualState.Setters>
                        <Setter Target="BarHost.Opacity" Value="0.45" />
                        <Setter Target="EventTitleTextblock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="PrivateGlyph.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="EventTimeTextBlock.Opacity" Value="0.7" />
                        <Setter Target="StartTimeTextBlock.Opacity" Value="0.7" />
                        <Setter Target="AttributeStack.Opacity" Value="0.7" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CancelledEmphasis">
                    <VisualState.Setters>
                        <Setter Target="BarHost.Opacity" Value="0.35" />
                        <Setter Target="EventTitleTextblock.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="EventTitleTextblock.TextDecorations" Value="Strikethrough" />
                        <Setter Target="PrivateGlyph.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Setter Target="EventTimeTextBlock.Opacity" Value="0.7" />
                        <Setter Target="StartTimeTextBlock.Opacity" Value="0.7" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="EventDurationStates">
                <!--  Regular event template in the panel. The bottom pixel separates back-to-back tiles.  -->
                <VisualState x:Name="RegularEvent">
                    <VisualState.Setters>
                        <Setter Target="MainGrid.Margin" Value="0,0,0,1" />
                    </VisualState.Setters>
                </VisualState>

                <!--  All-Day template for top area.  -->
                <VisualState x:Name="AllDayEvent">
                    <VisualState.Setters>
                        <Setter Target="EventTextPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="EventTextPanel.Margin" Value="6,0,4,0" />
                        <Setter Target="EventTitleTextblock.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="EventTitleTextblock.HorizontalTextAlignment" Value="Left" />
                        <Setter Target="AttributeStack.VerticalAlignment" Value="Center" />
                        <Setter Target="AttributeStack.Margin" Value="0,0,5,0" />
                    </VisualState.Setters>
                </VisualState>

                <!--  Month row of a timed event: start time, then the title.  -->
                <VisualState x:Name="MonthEvent">
                    <VisualState.Setters>
                        <Setter Target="BarHost.Height" Value="14" />
                        <Setter Target="BarHost.VerticalAlignment" Value="Center" />
                        <Setter Target="BarHost.Margin" Value="3,0,0,0" />
                        <Setter Target="EventTextPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="EventTextPanel.Margin" Value="5,0,4,0" />
                        <Setter Target="StartTimeTextBlock.Visibility" Value="Visible" />
                        <Setter Target="PrivateGlyph.Margin" Value="0,2,4,0" />
                        <Setter Target="EventTitleTextblock.FontSize" Value="12" />
                        <Setter Target="AttributeStack.VerticalAlignment" Value="Center" />
                        <Setter Target="AttributeStack.Margin" Value="0,0,4,0" />
                    </VisualState.Setters>
                </VisualState>

                <!--  All-day and multi-day rows of the month view.  -->
                <VisualState x:Name="CustomAreaMultiDayEvent">
                    <VisualState.Setters>
                        <Setter Target="BarHost.Height" Value="14" />
                        <Setter Target="BarHost.VerticalAlignment" Value="Center" />
                        <Setter Target="BarHost.Margin" Value="3,0,0,0" />
                        <Setter Target="EventTextPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="EventTextPanel.Margin" Value="5,0,4,0" />
                        <Setter Target="PrivateGlyph.Margin" Value="0,2,4,0" />
                        <Setter Target="EventTitleTextblock.FontSize" Value="12" />
                        <Setter Target="EventTitleTextblock.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="EventTitleTextblock.HorizontalTextAlignment" Value="Left" />
                        <Setter Target="AttributeStack.VerticalAlignment" Value="Center" />
                        <Setter Target="AttributeStack.Margin" Value="0,0,4,0" />
                    </VisualState.Setters>
                </VisualState>

                <!--
                    Ghost rendering for multi-day events in the panel.
                    All-Multi day area template is CustomAreaMultiDayEvent
                -->

                <VisualState x:Name="MultiDayEvent">
                    <VisualState.Setters>
                        <Setter Target="MainGrid.CornerRadius" Value="0" />
                        <Setter Target="MainGrid.IsHitTestVisible" Value="False" />
                        <Setter Target="BarHost.Visibility" Value="Collapsed" />
                        <Setter Target="AttributeStack.Opacity" Value="0" />
                        <Setter Target="EventTextPanel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="HeightStates">
                <VisualState x:Name="TwoLineHeight" />
                <VisualState x:Name="HiddenTextHeight">
                    <VisualState.Setters>
                        <Setter Target="TitleRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactHeight">
                    <VisualState.Setters>
                        <Setter Target="EventTitleTextblock.FontSize" Value="11" />
                        <Setter Target="EventTitleTextblock.MaxLines" Value="1" />
                        <Setter Target="PrivateGlyph.Margin" Value="0,2,4,0" />
                        <Setter Target="EventTextPanel.Margin" Value="6,0,4,0" />
                        <Setter Target="EventTextPanel.VerticalAlignment" Value="Center" />
                        <Setter Target="AttributeStack.Margin" Value="0,0,5,0" />
                        <Setter Target="AttributeStack.VerticalAlignment" Value="Center" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SingleLineHeight">
                    <VisualState.Setters>
                        <Setter Target="EventTitleTextblock.MaxLines" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="TwoLineWithTimeHeight">
                    <VisualState.Setters>
                        <Setter Target="EventDetailsPanel.Visibility" Value="Visible" />
                        <Setter Target="EventLocationTextBlock.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="FullHeight">
                    <VisualState.Setters>
                        <Setter Target="EventDetailsPanel.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="RegularWidth" />
                <VisualState x:Name="NarrowWidth">
                    <VisualState.Setters>
                        <Setter Target="AttributeStack.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
