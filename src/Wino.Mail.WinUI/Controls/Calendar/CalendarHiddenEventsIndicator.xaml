<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Wino.Calendar.Controls.CalendarHiddenEventsIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Center"
    d:DesignHeight="20"
    d:DesignWidth="48"
    mc:Ignorable="d">

    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="10">
        <Button
            x:Name="IndicatorButton"
            Height="20"
            MinWidth="0"
            MinHeight="0"
            Padding="8,0,8,0"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="IndicatorButtonClick"
            CornerRadius="10">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <coreControls:WinoFontIcon
                    x:Name="ChevronIcon"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Icon="ChevronUp" />
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Button>
    </Border>
</UserControl>
