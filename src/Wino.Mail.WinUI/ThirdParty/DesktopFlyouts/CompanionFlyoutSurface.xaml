<UserControl
    x:Class="Wino.Mail.WinUI.ThirdParty.DesktopFlyouts.CompanionFlyoutSurface"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <!--  DesktopFlyouts.Wasdk/DesktopFlyout.xaml: one island, including its material and shadow.  -->
    <Grid
        Margin="12"
        RenderTransformOrigin="0.5,0.5"
        TabFocusNavigation="Cycle">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="SurfaceTransform" />
        </Grid.RenderTransform>
        <Grid
            Background="Transparent"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Translation="0,0,36">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <!--  Shown only when neither Mica nor Acrylic is supported, so transparent theme brushes stay readable.  -->
            <Border
                x:Name="SurfaceFallbackBackground"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="7"
                Visibility="Collapsed" />
            <SystemBackdropElement x:Name="SurfaceBackdrop" CornerRadius="7" />
            <ContentPresenter
                x:Name="SurfaceContent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
