<ContentDialog
    x:Class="Wino.Mail.WinUI.Dialogs.PictureResizeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.ImageResizeDialog_Title, Mode=OneTime}"
    AutomationProperties.AutomationId="PictureResizeDialog"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonClick="ApplyClicked"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind domain:Translator.ImageResizeDialog_Apply, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="WidthBox"
                AutomationProperties.AutomationId="PictureResizeWidth"
                Header="{x:Bind domain:Translator.ImageResizeDialog_Width, Mode=OneTime}"
                Maximum="4000"
                Minimum="1"
                SpinButtonPlacementMode="Compact"
                ValueChanged="WidthBox_ValueChanged" />
            <NumberBox
                x:Name="HeightBox"
                Grid.Column="1"
                AutomationProperties.AutomationId="PictureResizeHeight"
                Header="{x:Bind domain:Translator.ImageResizeDialog_Height, Mode=OneTime}"
                Maximum="4000"
                Minimum="1"
                SpinButtonPlacementMode="Compact"
                ValueChanged="HeightBox_ValueChanged" />
        </Grid>
        <CheckBox
            x:Name="KeepProportionsCheckBox"
            AutomationProperties.AutomationId="PictureResizeKeepProportions"
            Content="{x:Bind domain:Translator.ImageResizeDialog_KeepProportions, Mode=OneTime}"
            IsChecked="True" />
    </StackPanel>
</ContentDialog>
