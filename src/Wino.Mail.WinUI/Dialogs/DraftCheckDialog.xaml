<ContentDialog
    x:Class="Wino.Mail.WinUI.Dialogs.DraftCheckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="using:Wino.Mail.WinUI.Dialogs"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.DraftCheckDialog_Title, Mode=OneTime}"
    AutomationProperties.AutomationId="DraftCheckDialog"
    CloseButtonText="{x:Bind domain:Translator.DraftCheckDialog_GoBack, Mode=OneTime}"
    DefaultButton="Close"
    SecondaryButtonClick="SendAnywayClicked"
    SecondaryButtonText="{x:Bind domain:Translator.DraftCheckDialog_SendAnyway, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="12">
        <TextBlock
            x:Name="MessageText"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="WrapWholeWords" />
        <ItemsControl AutomationProperties.AutomationId="DraftCheckIssues" ItemsSource="{x:Bind Rows, Mode=OneTime}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dialogs:DraftCheckIssueRow">
                    <Grid
                        Margin="0,0,0,6"
                        Padding="12,10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ColumnSpacing="12"
                        CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Item.Title}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Item.Detail}"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                AutomationProperties.AutomationId="DraftCheckShow"
                                Click="ShowClicked"
                                Content="{x:Bind domain:Translator.DraftCheckDialog_Show}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind Item.CanShow}" />
                            <Button
                                AutomationProperties.AutomationId="DraftCheckDescribe"
                                Click="DescribeClicked"
                                Content="{x:Bind domain:Translator.DraftCheckDialog_Describe}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind Item.CanDescribe}" />
                            <Button
                                AutomationProperties.AutomationId="DraftCheckNotNeeded"
                                Click="NotNeededClicked"
                                Content="{x:Bind domain:Translator.DraftCheckDialog_NotNeeded}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind Item.CanMarkNotNeeded}" />
                            <Button
                                AutomationProperties.AutomationId="DraftCheckFix"
                                Click="FixClicked"
                                Content="{x:Bind domain:Translator.DraftCheckDialog_Fix}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Tag="{x:Bind}"
                                Visibility="{x:Bind Item.CanFix}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ContentDialog>
