<ContentDialog
    x:Class="Wino.Dialogs.EmbeddedBrowserSignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.EmbeddedBrowserSignInDialog_Title, Mode=OneTime}"
    AutomationProperties.AutomationId="WinoEmbeddedBrowserSignInDialog"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Closed="DialogClosed"
    Closing="DialogClosing"
    DefaultButton="Close"
    Loaded="DialogLoaded"
    Opened="DialogOpened"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>
    <Grid x:Name="SignInContent">
        <WebView2
            x:Name="SignInWebView"
            AutomationProperties.AutomationId="WinoEmbeddedBrowserSignInWebView"
            NavigationCompleted="WebViewNavigationCompleted"
            NavigationStarting="WebViewNavigationStarting" />
        <ProgressRing
            x:Name="LoadingRing"
            Width="40"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />
    </Grid>
</ContentDialog>
