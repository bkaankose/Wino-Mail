<ContentDialog
    x:Class="Wino.Dialogs.WinoAccountLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Closing="DialogClosing"
    PrimaryButtonClick="LoginClicked"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_SignIn, Mode=OneTime}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ContentDialog.Resources>

    <!--  The right padding keeps the fields clear of the vertical scrollbar.  -->
    <ScrollViewer Padding="0,0,16,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <!--  Header. The product mark and the title replace the default title row so the logo can lead. Code-behind sets the title per mode.  -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Image
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppEntries/Mail.svg"
                    Stretch="Uniform" />
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="HeaderTitleTextBlock"
                        HorizontalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="SignInDescriptionTextBlock"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind domain:Translator.WinoAccount_LoginDialog_Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="ForgotPasswordInfoPanel"
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind domain:Translator.WinoAccount_ForgotPasswordDialog_Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords"
                        Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>

            <!--  Input fields  -->
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="EmailTextBox"
                    AutomationProperties.AutomationId="EmailTextBox"
                    Header="{x:Bind domain:Translator.WinoAccount_EmailLabel, Mode=OneTime}"
                    InputScope="EmailSmtpAddress"
                    KeyDown="EmailTextBox_KeyDown"
                    PlaceholderText="{x:Bind domain:Translator.WinoAccount_EmailPlaceholder, Mode=OneTime}"
                    TextChanging="InputChanged" />

                <StackPanel x:Name="PasswordPanel">
                    <PasswordBox
                        x:Name="PasswordBox"
                        AutomationProperties.AutomationId="PasswordBox"
                        Header="{x:Bind domain:Translator.WinoAccount_PasswordLabel, Mode=OneTime}"
                        KeyDown="PasswordBox_KeyDown"
                        PasswordChanged="InputChanged" />
                </StackPanel>

                <HyperlinkButton
                    x:Name="ModeToggleButton"
                    Margin="-11,-4,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ModeToggleButton"
                    Click="ModeToggleButton_Click"
                    Content="{x:Bind domain:Translator.WinoAccount_LoginDialog_ForgotPasswordLink, Mode=OneTime}" />
            </StackPanel>

            <!--
                Sign in with Google, Apple and Microsoft under an "or" rule, Google first on Windows. All run the
                API browser flow; the wino://auth-complete protocol activation completes them. Hidden in forgot-password mode.
            -->
            <StackPanel x:Name="ExternalSignInPanel" Spacing="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoAccount_LoginDialog_OrDivider, Mode=OneTime}" />
                    <Border
                        Grid.Column="2"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Grid>

                <!--  Google: a standard button with the colourful Google mark.  -->
                <Button
                    x:Name="GoogleSignInButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="GoogleSignInButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_SignInWithGoogle, Mode=OneTime}"
                    Click="GoogleSignInButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Icon="Google" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoAccount_SignInWithGoogle, Mode=OneTime}" />
                    </StackPanel>
                </Button>

                <!--  Apple's own look: black fill, white mark and title; a hairline so it reads on a dark dialog.  -->
                <Button
                    x:Name="AppleSignInButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="AppleSignInButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_SignInWithApple, Mode=OneTime}"
                    Background="Black"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Click="AppleSignInButton_Click"
                    Foreground="White">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F1F1F" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Icon="Apple" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoAccount_SignInWithApple, Mode=OneTime}" />
                    </StackPanel>
                </Button>

                <!--  Microsoft: a standard button with the four-colour Microsoft mark, as the brand guidelines ask.  -->
                <Button
                    x:Name="MicrosoftSignInButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="MicrosoftSignInButton"
                    AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_SignInWithMicrosoft, Mode=OneTime}"
                    Click="MicrosoftSignInButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Icon="Microsoft" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.WinoAccount_SignInWithMicrosoft, Mode=OneTime}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Request status. Only one of these is visible at a time.  -->
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="ErrorTextBlock"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
