<ContentDialog
    x:Class="Wino.Dialogs.TaskListPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:shared="using:Wino.Core.Domain.Entities.Shared"
    Title="{x:Bind domain:Translator.ToDoSettings_ListPicker_Title}"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel}"
    Style="{StaticResource WinoDialogStyle}">
    <ListView
        AutomationProperties.AutomationId="TaskListPickerList"
        IsItemClickEnabled="True"
        ItemClick="ItemClicked"
        ItemsSource="{x:Bind TaskLists}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="shared:AccountTaskList">
                <TextBlock Margin="8" Text="{x:Bind Title}" />
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
