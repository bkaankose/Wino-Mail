<ContentDialog
    x:Class="Wino.Mail.Dialogs.ServerCertificateTrustDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:connectivity="using:Wino.Core.Domain.Models.Connectivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind Prompt.Title, Mode=OneTime}"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind IsAcceptInitiallyEnabled, Mode=OneTime}"
    PrimaryButtonText="{x:Bind Prompt.AcceptButtonText, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer
        MaxHeight="560"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="600"
            Padding="0,0,12,0"
            Spacing="16">
            <TextBlock
                Text="{x:Bind Prompt.Intro, Mode=OneTime}"
                TextWrapping="Wrap"
                Visibility="{x:Bind IsNormal, Mode=OneTime}" />

            <InfoBar
                Title="{x:Bind Prompt.ProblemsHeader, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Prompt.ProblemsHeader, Mode=OneTime}"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind WarningMessage, Mode=OneTime}"
                Severity="{x:Bind ProblemsSeverity, Mode=OneTime}">
                <ItemsControl Margin="0,0,0,12" ItemsSource="{x:Bind Prompt.Problems, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Margin="0,2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="•" />
                                <TextBlock
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </InfoBar>

            <ItemsControl ItemsSource="{x:Bind Prompt.Facts, Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="connectivity:ServerCertificateFact">
                        <Grid Margin="0,3" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Value, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{x:Bind Prompt.Closing, Mode=OneTime}" TextWrapping="Wrap" />

            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind domain:Translator.IMAPSetupDialog_CertificateDetails, Mode=OneTime}"
                Header="{x:Bind domain:Translator.IMAPSetupDialog_CertificateDetails, Mode=OneTime}"
                Visibility="{x:Bind HasCertificateDetails, Mode=OneTime}">
                <ScrollViewer
                    MaxHeight="240"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind CertificateDetails, Mode=OneTime}"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Expander>

            <CheckBox
                x:Name="AcknowledgementCheckBox"
                Checked="AcknowledgementChanged"
                Content="{x:Bind Prompt.AcknowledgementText, Mode=OneTime}"
                Unchecked="AcknowledgementChanged"
                Visibility="{x:Bind Prompt.IsDangerous, Mode=OneTime}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
