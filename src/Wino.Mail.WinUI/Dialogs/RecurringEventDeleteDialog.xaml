<ContentDialog
    x:Class="Wino.Dialogs.RecurringEventDeleteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.DialogMessage_DeleteRecurringEventTitle, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonClick="PrimaryButtonClicked"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Delete, Mode=OneTime}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.DialogMessage_DeleteRecurringEventMessage, Mode=OneTime}"
            TextWrapping="Wrap" />

        <StackPanel Spacing="4">
            <RadioButton
                x:Name="ThisEventOption"
                AutomationProperties.AutomationId="RecurringEventDeleteThisEventOption"
                Content="{x:Bind domain:Translator.CalendarContextMenu_ThisEventOnly, Mode=OneTime}"
                GroupName="RecurringEventDeleteScope"
                IsChecked="True" />

            <RadioButton
                x:Name="SeriesOption"
                AutomationProperties.AutomationId="RecurringEventDeleteSeriesOption"
                Content="{x:Bind domain:Translator.CalendarContextMenu_AllEventsInSeries, Mode=OneTime}"
                GroupName="RecurringEventDeleteScope" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
