<ContentDialog
    x:Class="Wino.Dialogs.IntelligenceFolderPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    Title="{x:Bind domain:Translator.SemanticIndex_FoldersPickerTitle}"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Apply}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel}"
    Style="{StaticResource WinoDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
    </ContentDialog.Resources>

    <ListView
        AutomationProperties.AutomationId="IntelligenceFolderPickerList"
        ItemsSource="{x:Bind Folders}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <!--
                The message count sits next to the name because this is where including a folder is
                decided, and a name alone does not say whether it costs eighty messages or eight thousand.
            -->
            <DataTemplate x:DataType="data:IntelligenceFolderSelectionItem">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        Margin="{x:Bind helpers:XamlHelpers.LeftMargin(IndentMargin)}"
                        AutomationProperties.AutomationId="{x:Bind RemoteFolderId}"
                        AutomationProperties.Name="{x:Bind DisplayName}"
                        Content="{x:Bind DisplayName}"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind AvailableMessageCountText}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</ContentDialog>
