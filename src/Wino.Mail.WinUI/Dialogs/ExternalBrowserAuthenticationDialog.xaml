<ContentDialog
    x:Class="Wino.Dialogs.ExternalBrowserAuthenticationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.ExternalBrowserAuthenticationDialog_Title, Mode=OneTime}"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Closing="DialogClosing"
    DefaultButton="Close"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">420</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="16">
        <ProgressBar
            AutomationProperties.AutomationId="ExternalBrowserAuthenticationDialogProgressBar"
            AutomationProperties.Name="{x:Bind domain:Translator.ExternalBrowserAuthenticationDialog_Title, Mode=OneTime}"
            IsIndeterminate="True" />

        <TextBlock
            AutomationProperties.AutomationId="ExternalBrowserAuthenticationDialogMessage"
            Style="{ThemeResource BodyTextBlockStyle}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextWrapping="Wrap" />

        <InfoBar
            AutomationProperties.AutomationId="ExternalBrowserAuthenticationDialogBrowserNotOpenedInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind IsBrowserLaunchFailed, Mode=OneWay}"
            Message="{x:Bind domain:Translator.ExternalBrowserAuthenticationDialog_BrowserNotOpened, Mode=OneTime}"
            Severity="Warning" />

        <HyperlinkButton
            AutomationProperties.AutomationId="ExternalBrowserAuthenticationDialogCopyLinkButton"
            Click="CopyLinkClicked"
            Content="{x:Bind domain:Translator.ExternalBrowserAuthenticationDialog_CopyLink, Mode=OneTime}" />

        <InfoBar
            AutomationProperties.AutomationId="ExternalBrowserAuthenticationDialogLinkCopiedInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind IsLinkCopied, Mode=OneWay}"
            Message="{x:Bind domain:Translator.ExternalBrowserAuthenticationDialog_LinkCopied, Mode=OneTime}"
            Severity="Success" />
    </StackPanel>
</ContentDialog>
