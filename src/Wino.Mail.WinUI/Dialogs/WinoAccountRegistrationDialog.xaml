<ContentDialog
    x:Class="Wino.Dialogs.WinoAccountRegistrationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="{x:Bind domain:Translator.WinoAccount_RegisterDialog_Title, Mode=OneTime}"
    PrimaryButtonClick="RegisterClicked"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind domain:Translator.WinoAccount_RegisterDialog_PrimaryButton, Mode=OneTime}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">440</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">440</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <!--  Header. Matches the sign-in dialog: the product mark leads, then the title and one line of purpose.  -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Image
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppEntries/Mail.svg"
                    Stretch="Uniform" />
                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind domain:Translator.WinoAccount_RegisterDialog_Title, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        MaxWidth="340"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind domain:Translator.WinoAccount_RegisterDialog_Description, Mode=OneTime}"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </StackPanel>

            <!--  Input fields  -->
            <StackPanel Spacing="12">
                <TextBox
                    x:Name="EmailTextBox"
                    AutomationProperties.AutomationId="EmailTextBox"
                    Header="{x:Bind domain:Translator.WinoAccount_EmailLabel, Mode=OneTime}"
                    InputScope="EmailSmtpAddress"
                    KeyDown="EmailTextBox_KeyDown"
                    PlaceholderText="{x:Bind domain:Translator.WinoAccount_EmailPlaceholder, Mode=OneTime}"
                    TextChanging="InputChanged" />

                <TextBox
                    x:Name="DisplayNameTextBox"
                    AutomationProperties.AutomationId="WinoRegistrationDisplayName"
                    Header="{x:Bind domain:Translator.WinoAccount_Profile_NameOptional, Mode=OneTime}"
                    MaxLength="256" />

                <PasswordBox
                    x:Name="PasswordBox"
                    AutomationProperties.AutomationId="PasswordBox"
                    Header="{x:Bind domain:Translator.WinoAccount_PasswordLabel, Mode=OneTime}"
                    KeyDown="PasswordBox_KeyDown"
                    PasswordChanged="InputChanged" />

                <PasswordBox
                    x:Name="ConfirmPasswordBox"
                    AutomationProperties.AutomationId="ConfirmPasswordBox"
                    Header="{x:Bind domain:Translator.WinoAccount_ConfirmPasswordLabel, Mode=OneTime}"
                    KeyDown="ConfirmPasswordBox_KeyDown"
                    PasswordChanged="InputChanged" />
            </StackPanel>

            <!--  Creating the account is the agreement; the API takes no separate consent flag.  -->
            <StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind domain:Translator.WinoAccount_RegisterDialog_PrivacyAgreement, Mode=OneTime}"
                    TextWrapping="WrapWholeWords" />
                <HyperlinkButton
                    Margin="-11,0,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="WinoAccountRegistrationDialogHyperlinkButton"
                    Click="PrivacyPolicyLink_Click"
                    Content="{x:Bind domain:Translator.WinoAccount_RegisterDialog_PrivacyLinkText, Mode=OneTime}" />
            </StackPanel>

            <!--  Request status. Only one of these is visible at a time.  -->
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="ErrorTextBlock"
                AutomationProperties.LiveSetting="Assertive"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
