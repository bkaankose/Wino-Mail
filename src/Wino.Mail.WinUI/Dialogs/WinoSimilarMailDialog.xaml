<ContentDialog
    x:Class="Wino.Mail.Dialogs.WinoSimilarMailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:intelligence="using:Wino.Core.Domain.Models.Intelligence"
    x:Name="root"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Close, Mode=OneTime}"
    Title="{x:Bind domain:Translator.WinoIntelligence_SimilarDialogTitle, Mode=OneTime}">
    <Grid MinWidth="420" MaxWidth="620" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.WinoIntelligence_SimilarDialogDescription, Mode=OneTime}"
            TextWrapping="Wrap" />
        <ListView
            x:Name="SimilarMailList"
            Grid.Row="1"
            MaxHeight="420"
            AutomationProperties.AutomationId="WinoSimilarMailResultsList"
            IsItemClickEnabled="True"
            ItemClick="SimilarMailItemClicked"
            ItemsSource="{x:Bind Items, Mode=OneTime}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="intelligence:WinoSimilarMailItem">
                    <Grid Padding="4,8" RowSpacing="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{x:Bind Subject}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Row="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Sender}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
