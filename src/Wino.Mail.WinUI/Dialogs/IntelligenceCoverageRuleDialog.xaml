<ContentDialog
    x:Class="Wino.Dialogs.IntelligenceCoverageRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    x:Name="DialogRoot"
    Title="{x:Bind Editor.Title}"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Save}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel}"
    DefaultButton="Primary"
    Style="{StaticResource WinoDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">560</x:Double>

        <!--  One column of message volume. Covered columns are opaque, the rest recede.  -->
        <DataTemplate x:Key="RuleBucketTemplate" x:DataType="data:IntelligenceCoverageBucketItem">
            <Grid Width="{x:Bind BarWidth}" Height="40">
                <Border
                    Height="{x:Bind BarHeight}"
                    Margin="0,0,1.5,0"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource WinoIntelligenceBrandIconBrush}"
                    CornerRadius="1.5"
                    Opacity="{x:Bind SelectionOpacity, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tooltip}" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <TextBlock
                AutomationProperties.AutomationId="WinoIntelligenceRuleDialogSubtitle"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{x:Bind Editor.Subtitle}"
                TextWrapping="Wrap" />

            <!--  Two peer choices, so radio buttons rather than a segmented control.  -->
            <RadioButtons
                AutomationProperties.AutomationId="WinoIntelligenceRuleModeRadioButtons"
                Header="{x:Bind domain:Translator.SemanticIndex_CoverageModeTitle, Mode=OneTime}"
                MaxColumns="2"
                SelectedIndex="{x:Bind Editor.CoverageModeIndex, Mode=TwoWay}">
                <RadioButton AutomationProperties.AutomationId="WinoIntelligenceRuleDateRangeRadioButton">
                    <StackPanel>
                        <TextBlock Text="{x:Bind domain:Translator.SemanticIndex_CoverageModeDateRange, Mode=OneTime}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.SemanticIndex_CoverageModeDateRangeDescription, Mode=OneTime}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton AutomationProperties.AutomationId="WinoIntelligenceRuleLatestCountRadioButton">
                    <StackPanel>
                        <TextBlock Text="{x:Bind domain:Translator.SemanticIndex_CoverageModeLatestCount, Mode=OneTime}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind domain:Translator.SemanticIndex_CoverageModeLatestCountDescription, Mode=OneTime}" />
                    </StackPanel>
                </RadioButton>
            </RadioButtons>

            <!--
                Eight periods in a ComboBox rather than a row of chips: the chips cost three rows of
                the dialog, and the count each period selects still rides along in the item label.
            -->
            <StackPanel Spacing="10" Visibility="{x:Bind Editor.IsDateCoverageMode, Mode=OneWay}">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="WinoIntelligenceRuleDatePresetComboBox"
                    Header="{x:Bind domain:Translator.SemanticIndex_CoveragePeriod, Mode=OneTime}"
                    ItemsSource="{x:Bind Editor.DatePresets}"
                    SelectedItem="{x:Bind Editor.SelectedDatePreset, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="data:CoverageDatePresetOption">
                            <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid ColumnSpacing="10" Visibility="{x:Bind Editor.IsCustomDateRange, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CalendarDatePicker
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="WinoIntelligenceRuleCutoffDatePicker"
                        Date="{x:Bind Editor.CutoffUtc, Mode=TwoWay}"
                        Header="{x:Bind domain:Translator.SemanticIndex_CoverageFrom, Mode=OneTime}" />
                    <CalendarDatePicker
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="WinoIntelligenceRuleThroughDatePicker"
                        Date="{x:Bind Editor.ThroughUtcExclusive, Mode=TwoWay}"
                        Header="{x:Bind domain:Translator.SemanticIndex_CoverageThrough, Mode=OneTime}" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="10" Visibility="{x:Bind Editor.IsLatestCountCoverageMode, Mode=OneWay}">
                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="WinoIntelligenceRuleCountPresetComboBox"
                    DisplayMemberPath="DisplayName"
                    Header="{x:Bind domain:Translator.SemanticIndex_CoverageNewestCount, Mode=OneTime}"
                    ItemsSource="{x:Bind Editor.CountPresets}"
                    SelectedItem="{x:Bind Editor.SelectedCountPreset, Mode=TwoWay}" />
                <NumberBox
                    AutomationProperties.AutomationId="WinoIntelligenceRuleCountNumberBox"
                    AutomationProperties.Name="{x:Bind domain:Translator.SemanticIndex_CoverageNewestCount, Mode=OneTime}"
                    Maximum="{x:Bind Editor.CustomCountMaximum}"
                    Minimum="0"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind Editor.CustomCount, Mode=TwoWay}"
                    Visibility="{x:Bind Editor.IsCustomCount, Mode=OneWay}" />
            </StackPanel>

            <!--  What the draft actually selects, restated as one number before it is saved.  -->
            <Border
                Padding="14,11"
                AutomationProperties.AutomationId="WinoIntelligenceRuleResult"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Bottom">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{x:Bind Editor.SelectedMessageCount, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.ResultDetail, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  The histogram is decorative; the result line above states the same fact in text.  -->
            <StackPanel Spacing="4">
                <ItemsRepeater
                    Height="40"
                    AutomationProperties.AccessibilityView="Raw"
                    AutomationProperties.AutomationId="WinoIntelligenceRuleHistogram"
                    ItemTemplate="{StaticResource RuleBucketTemplate}"
                    ItemsSource="{x:Bind Editor.Buckets}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind domain:Translator.SemanticIndex_CoverageToday, Mode=OneTime}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.MiddleDateText}" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Editor.OldestDateText}" />
                </Grid>
            </StackPanel>

            <CheckBox
                AutomationProperties.AutomationId="WinoIntelligenceRuleApplyToAllCheckBox"
                Content="{x:Bind domain:Translator.SemanticIndex_CoverageApplyToEveryFolder, Mode=OneTime}"
                IsChecked="{x:Bind Editor.ApplyToAllFolders, Mode=TwoWay}"
                Visibility="{x:Bind Editor.CanApplyToAllFolders}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
