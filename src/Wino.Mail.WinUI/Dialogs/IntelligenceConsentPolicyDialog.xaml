<ContentDialog
    x:Class="Wino.Dialogs.IntelligenceConsentPolicyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.AutomationId="WinoConsentPolicyDialog"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    Closed="DialogClosed"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="AcceptClicked"
    PrimaryButtonText="{x:Bind domain:Translator.Intelligence_AcceptPrivacyPolicyButton, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <!--  The default 548 maximum is narrower than the policy content and clips it.  -->
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>
    <ContentDialog.Title>
        <TextBlock Text="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentPolicyTitle, Mode=OneTime}" TextWrapping="WrapWholeWords" />
    </ContentDialog.Title>
    <Grid
        Width="720"
        Height="560"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Bind domain:Translator.WinoAccount_IntelligenceConsentPolicyNotice, Mode=OneTime}" TextWrapping="WrapWholeWords" />
        <WebView2
            x:Name="PolicyWebView"
            Grid.Row="1"
            AutomationProperties.AutomationId="WinoConsentPolicyWebView" />
        <CheckBox
            x:Name="AcknowledgementCheckBox"
            Grid.Row="2"
            AutomationProperties.AutomationId="WinoConsentPolicyAcknowledgementCheckBox"
            Checked="AcknowledgementChanged"
            Unchecked="AcknowledgementChanged">
            <TextBlock Text="{x:Bind domain:Translator.Intelligence_PrivacyPolicyAcknowledgement, Mode=OneTime}" TextWrapping="WrapWholeWords" />
        </CheckBox>
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="3"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind domain:Translator.Intelligence_ConsentAcceptanceFailed, Mode=OneTime}"
            TextWrapping="WrapWholeWords"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
