<ContentDialog
    x:Class="Wino.Dialogs.WinoAssistantDemoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.WinoIntelligence_Perk_Voice_Title, Mode=OneTime}"
    AutomationProperties.AutomationId="WinoAssistantDemoDialog"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Close, Mode=OneTime}"
    Closed="DialogClosed"
    DefaultButton="Close"
    Loaded="DialogLoaded"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1040</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">800</x:Double>
    </ContentDialog.Resources>

    <MediaPlayerElement
        x:Name="DemoPlayer"
        Width="960"
        Height="540"
        AreTransportControlsEnabled="True"
        AutoPlay="True"
        AutomationProperties.AutomationId="WinoAssistantDemoPlayer"
        AutomationProperties.Name="{x:Bind domain:Translator.WinoIntelligence_SeeItInAction, Mode=OneTime}"
        Stretch="Uniform" />
</ContentDialog>
