<ContentDialog
    x:Class="Wino.Mail.WinUI.Dialogs.MailClientImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="using:Wino.Mail.ViewModels.Data"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiHelpers="using:Wino.Mail.WinUI.Helpers"
    Title="{x:Bind domain:Translator.MailClientImport_Title}"
    AutomationProperties.AutomationId="MailClientImportDialog"
    Closing="DialogClosing"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Model.CanImport, Mode=OneWay}"
    Opened="DialogOpened"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Import}"
    SecondaryButtonText="{x:Bind domain:Translator.Buttons_Cancel}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>

        <Style x:Key="MailClientImportItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="MailClientImportItemTemplate" x:DataType="data:MailClientImportItem">
            <Border
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Title}"
                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                        IsEnabled="{x:Bind CanSelect}" />
                    <coreControls:WinoFontIcon
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource WinoIconFontFamily}"
                        FontSize="24"
                        Icon="{x:Bind IconGlyph}" />
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            IsClosable="False"
            IsOpen="True"
            Message="{x:Bind domain:Translator.MailClientImport_SignInNotice}"
            Severity="Informational" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind Model.IsScanning, Mode=OneWay}">
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind Model.IsScanning, Mode=OneWay}" />
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="MailClientImportScanStatus"
                Text="{x:Bind Model.ScanStatus, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Spacing="8"
            Visibility="{x:Bind Model.IsNoAccountsMessageVisible, Mode=OneWay}">
            <TextBlock AutomationProperties.AutomationId="MailClientImportNoAccounts" Text="{x:Bind domain:Translator.MailClientImport_NoAccounts}" />
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind Model.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            MaxHeight="420"
            AutomationProperties.AutomationId="MailClientImportAccountsList"
            AutomationProperties.Name="{x:Bind domain:Translator.MailClientImport_Title}"
            ItemContainerStyle="{StaticResource MailClientImportItemContainerStyle}"
            ItemTemplate="{StaticResource MailClientImportItemTemplate}"
            ItemsSource="{x:Bind Model.Items}"
            SelectionMode="None"
            Visibility="{x:Bind Model.IsAccountListVisible, Mode=OneWay}" />
    </Grid>
</ContentDialog>
