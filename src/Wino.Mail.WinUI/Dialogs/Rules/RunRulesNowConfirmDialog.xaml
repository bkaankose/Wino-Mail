<ContentDialog
    x:Class="Wino.Dialogs.Rules.RunRulesNowConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:helpers="using:Wino.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind Header}"
    CloseButtonText="{x:Bind domain:Translator.Rules_Cancel, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonText="{x:Bind domain:Translator.Rules_RunNowApply, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <DataTemplate x:Key="SummaryLineTemplate" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" />
        </DataTemplate>
    </ContentDialog.Resources>

    <StackPanel Spacing="6">
        <ItemsControl ItemTemplate="{StaticResource SummaryLineTemplate}" ItemsSource="{x:Bind SummaryLines}" />

        <TextBlock
            Margin="0,4,0,0"
            Opacity="0.7"
            Text="{x:Bind SkippedNote}"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsSkippedNoteEmpty)}" />

        <TextBlock
            Margin="0,4,0,0"
            Opacity="0.7"
            Text="{x:Bind ReadOnlyNote}"
            TextWrapping="Wrap"
            Visibility="{x:Bind helpers:XamlHelpers.ReverseBoolToVisibilityConverter(IsReadOnlyNoteEmpty)}" />
    </StackPanel>
</ContentDialog>
