<ContentDialog
    x:Class="Wino.Dialogs.Rules.RulesManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="using:Wino.Dialogs.Rules"
    Padding="0"
    HorizontalContentAlignment="Stretch"
    Loaded="Dialog_Loaded"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>

        <Style x:Key="RuleBadgeStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="RuleRowTemplate" x:DataType="rules:RuleListItem">
            <Grid Padding="10,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RulesManagerDialogCheckBox"
                    Click="RuleEnabledToggled"
                    IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                    IsEnabled="{x:Bind CanToggle}" />

                <coreControls:WinoFontIcon
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Icon="Folder" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{x:Bind Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Summary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        Style="{StaticResource RuleBadgeStyle}"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Rules_ReadOnlyTooltip, Mode=OneTime}"
                        Visibility="{x:Bind ReadOnlyBadgeVisibility}">
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind domain:Translator.Rules_ReadOnlyBadge, Mode=OneTime}" />
                    </Border>
                    <Border Style="{StaticResource RuleBadgeStyle}" Visibility="{x:Bind StopBadgeVisibility}">
                        <TextBlock
                            FontSize="10.5"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind domain:Translator.Rules_StopBadge, Mode=OneTime}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid Width="648">
        <Grid x:Name="ListPane" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{ThemeResource AccentFillColorDefaultBrush}" />

            <!--  header  -->
            <Grid
                Grid.Row="1"
                Padding="18,0,8,0"
                Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <coreControls:WinoFontIcon
                    VerticalAlignment="Center"
                    FontSize="17"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Icon="Reminder" />
                <TextBlock
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{x:Bind domain:Translator.Rules_ManagerTitle, Mode=OneTime}" />
                <Button
                    Grid.Column="2"
                    Width="34"
                    Height="32"
                    AutomationProperties.AutomationId="RulesManagerDialogButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DoneClicked">
                    <coreControls:WinoFontIcon FontSize="12" Icon="Dismiss" />
                </Button>
            </Grid>

            <!--  toolbar  -->
            <Grid
                Grid.Row="2"
                Padding="16,12,16,4"
                ColumnSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        AutomationProperties.AutomationId="RulesManagerDialogButton2"
                        Click="NewRuleClicked"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="+" />
                            <TextBlock Text="{x:Bind domain:Translator.Rules_NewRule, Mode=OneTime}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ChangeButton"
                        AutomationProperties.AutomationId="ChangeButton"
                        Click="ChangeRuleClicked"
                        Content="{x:Bind domain:Translator.Rules_ChangeRule, Mode=OneTime}"
                        IsEnabled="False" />
                    <Button
                        x:Name="CopyButton"
                        AutomationProperties.AutomationId="CopyButton"
                        Click="CopyRuleClicked"
                        Content="{x:Bind domain:Translator.Rules_Copy, Mode=OneTime}"
                        IsEnabled="False" />
                    <Button
                        x:Name="DeleteButton"
                        AutomationProperties.AutomationId="DeleteButton"
                        Click="DeleteRuleClicked"
                        Content="{x:Bind domain:Translator.Rules_Delete, Mode=OneTime}"
                        IsEnabled="False" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="MoveUpButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="MoveUpButton"
                        Click="MoveUpClicked"
                        IsEnabled="False"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Rules_MoveUp, Mode=OneTime}">
                        <TextBlock FontSize="11" Text="&#x25B4;" />
                    </Button>
                    <Button
                        x:Name="MoveDownButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="MoveDownButton"
                        Click="MoveDownClicked"
                        IsEnabled="False"
                        ToolTipService.ToolTip="{x:Bind domain:Translator.Rules_MoveDown, Mode=OneTime}">
                        <TextBlock FontSize="11" Text="&#x25BE;" />
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="16,4,16,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind domain:Translator.Rules_OrderHint, Mode=OneTime}"
                TextWrapping="Wrap" />

            <!--  rules list  -->
            <Grid
                Grid.Row="4"
                MinHeight="120"
                Margin="16,8,16,0">
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <ListView
                            x:Name="RulesListView"
                            MaxHeight="300"
                            AutomationProperties.AutomationId="RulesListView"
                            DoubleTapped="RulesListView_DoubleTapped"
                            ItemTemplate="{StaticResource RuleRowTemplate}"
                            SelectionChanged="RulesListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock
                            x:Name="EmptyText"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind domain:Translator.Rules_NoRules, Mode=OneTime}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <ProgressRing
                            x:Name="BusyRing"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="False" />
                    </Grid>
                </Border>
            </Grid>

            <!--  description + error  -->
            <StackPanel Grid.Row="5" Margin="16,12,16,12">
                <Border
                    Padding="12,10"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind domain:Translator.Rules_RuleDescription, Mode=OneTime}" />
                        <TextBlock
                            x:Name="DescriptionText"
                            FontSize="13.5"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind domain:Translator.Rules_SelectRuleHint, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock
                    x:Name="ErrorText"
                    Margin="2,8,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="RemoveBlobRetryButton"
                    Margin="2,8,0,0"
                    AutomationProperties.AutomationId="RemoveBlobRetryButton"
                    Click="RemoveBlobRetryClicked"
                    Content="{x:Bind domain:Translator.Rules_RemoveOutlookBlob_Button, Mode=OneTime}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  footer  -->
            <Grid
                Grid.Row="6"
                Padding="16,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Button
                    x:Name="RunRulesNowButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="RunRulesNowButton"
                    Click="RunRulesNowClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <coreControls:WinoFontIcon FontSize="14" Icon="Sync" />
                        <TextBlock Text="{x:Bind domain:Translator.Rules_RunRulesNow, Mode=OneTime}" />
                    </StackPanel>
                </Button>
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="RulesManagerDialogButton3"
                    Click="DoneClicked"
                    Content="{x:Bind domain:Translator.Rules_Done, Mode=OneTime}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>

        <!--  editor, shown in place of the list (dialogs cannot stack)  -->
        <rules:RuleEditorView
            x:Name="EditorPane"
            Cancelled="Editor_Cancelled"
            DeleteRequested="Editor_DeleteRequested"
            SaveRequested="Editor_SaveRequested"
            Visibility="Collapsed" />
    </Grid>
</ContentDialog>
