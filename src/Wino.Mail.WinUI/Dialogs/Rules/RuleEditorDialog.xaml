<ContentDialog
    x:Class="Wino.Dialogs.Rules.RuleEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="using:Wino.Dialogs.Rules"
    Padding="0"
    HorizontalContentAlignment="Stretch"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">720</x:Double>
    </ContentDialog.Resources>

    <rules:RuleEditorView
        x:Name="Editor"
        Width="640"
        Cancelled="Editor_Cancelled"
        DeleteRequested="Editor_DeleteRequested"
        SaveRequested="Editor_SaveRequested" />
</ContentDialog>
