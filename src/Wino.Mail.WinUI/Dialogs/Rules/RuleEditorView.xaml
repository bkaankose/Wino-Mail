<UserControl
    x:Class="Wino.Dialogs.Rules.RuleEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreControls="using:Wino.Mail.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mail="using:Wino.Core.Domain.Entities.Mail"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rules="using:Wino.Dialogs.Rules"
    HorizontalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="FieldOptionTemplate" x:DataType="rules:RuleFieldOption">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>

        <DataTemplate x:Key="ActionOptionTemplate" x:DataType="rules:RuleActionOption">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>

        <DataTemplate x:Key="FolderOptionTemplate" x:DataType="mail:MailItemFolder">
            <TextBlock Text="{x:Bind FolderName}" />
        </DataTemplate>

        <DataTemplate x:Key="CategoryOptionTemplate" x:DataType="mail:MailCategory">
            <TextBlock Text="{x:Bind Name}" />
        </DataTemplate>

        <DataTemplate x:Key="ImportanceOptionTemplate" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" />
        </DataTemplate>

        <Style x:Key="RuleAddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="ConditionRowTemplate" x:DataType="rules:RuleConditionRow">
            <Grid
                Margin="0,0,0,8"
                Padding="8,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="8"
                CornerRadius="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="RuleEditorViewComboBox"
                    ItemTemplate="{StaticResource FieldOptionTemplate}"
                    ItemsSource="{x:Bind FieldOptions}"
                    SelectedItem="{x:Bind SelectedFieldOption, Mode=TwoWay}" />

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox2"
                        ItemTemplate="{StaticResource FolderOptionTemplate}"
                        ItemsSource="{x:Bind Folders}"
                        SelectedItem="{x:Bind SelectedFolder, Mode=TwoWay}"
                        Visibility="{x:Bind FolderVisibility, Mode=OneWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox3"
                        ItemTemplate="{StaticResource CategoryOptionTemplate}"
                        ItemsSource="{x:Bind Categories}"
                        SelectedItem="{x:Bind SelectedCategory, Mode=TwoWay}"
                        Visibility="{x:Bind CategoryVisibility, Mode=OneWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox4"
                        ItemTemplate="{StaticResource ImportanceOptionTemplate}"
                        ItemsSource="{x:Bind ImportanceOptions}"
                        SelectedItem="{x:Bind ImportanceValue, Mode=TwoWay}"
                        Visibility="{x:Bind ImportanceVisibility, Mode=OneWay}" />
                    <TextBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewTextBox"
                        PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                        Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind domain:Translator.Rules_NoValueNeeded, Mode=OneTime}"
                        Visibility="{x:Bind NoneVisibility, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    AutomationProperties.AutomationId="RuleEditorViewButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RemoveCondition_Click"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Rules_Remove, Mode=OneTime}">
                    <coreControls:WinoFontIcon FontSize="11" Icon="Dismiss" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionRowTemplate" x:DataType="rules:RuleActionRow">
            <Grid
                Margin="0,0,0,8"
                Padding="8,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="8"
                CornerRadius="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="168" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="RuleEditorViewComboBox5"
                    ItemTemplate="{StaticResource ActionOptionTemplate}"
                    ItemsSource="{x:Bind ActionOptions}"
                    SelectedItem="{x:Bind SelectedActionOption, Mode=TwoWay}" />

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox6"
                        ItemTemplate="{StaticResource FolderOptionTemplate}"
                        ItemsSource="{x:Bind Folders}"
                        SelectedItem="{x:Bind SelectedFolder, Mode=TwoWay}"
                        Visibility="{x:Bind FolderVisibility, Mode=OneWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox7"
                        ItemTemplate="{StaticResource CategoryOptionTemplate}"
                        ItemsSource="{x:Bind Categories}"
                        SelectedItem="{x:Bind SelectedCategory, Mode=TwoWay}"
                        Visibility="{x:Bind CategoryVisibility, Mode=OneWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewComboBox8"
                        ItemTemplate="{StaticResource ImportanceOptionTemplate}"
                        ItemsSource="{x:Bind ImportanceOptions}"
                        SelectedItem="{x:Bind ImportanceValue, Mode=TwoWay}"
                        Visibility="{x:Bind ImportanceVisibility, Mode=OneWay}" />
                    <TextBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="RuleEditorViewTextBox2"
                        PlaceholderText="{x:Bind ValuePlaceholder, Mode=OneWay}"
                        Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind domain:Translator.Rules_NoValueNeeded, Mode=OneTime}"
                        Visibility="{x:Bind NoneVisibility, Mode=OneWay}" />
                </Grid>

                <Button
                    Grid.Column="2"
                    Width="30"
                    Height="30"
                    Padding="0"
                    AutomationProperties.AutomationId="RuleEditorViewButton2"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="RemoveAction_Click"
                    ToolTipService.ToolTip="{x:Bind domain:Translator.Rules_Remove, Mode=OneTime}">
                    <coreControls:WinoFontIcon FontSize="11" Icon="Dismiss" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <!--  accent strip  -->
        <Border Grid.Row="0" Background="{ThemeResource AccentFillColorDefaultBrush}" />

        <!--  header  -->
        <Grid
            Grid.Row="1"
            Padding="18,0,8,0"
            Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <coreControls:WinoFontIcon
                VerticalAlignment="Center"
                FontSize="17"
                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                Icon="Reminder" />
            <TextBlock
                x:Name="EditorTitleText"
                Grid.Column="1"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold" />
            <Button
                Grid.Column="2"
                Width="34"
                Height="32"
                AutomationProperties.AutomationId="RuleEditorViewButton3"
                Background="Transparent"
                BorderThickness="0"
                Click="CloseClicked">
                <coreControls:WinoFontIcon FontSize="12" Icon="Dismiss" />
            </Button>
        </Grid>

        <!--  body  -->
        <ScrollViewer
            Grid.Row="2"
            MaxHeight="440"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="22,18,22,18" Spacing="18">

                <!--  name + enabled  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="RuleNameTextBox"
                        AutomationProperties.AutomationId="RuleNameTextBox"
                        Header="{x:Bind domain:Translator.Rules_RuleName, Mode=OneTime}"
                        PlaceholderText="{x:Bind domain:Translator.Rules_RuleNamePlaceholder, Mode=OneTime}"
                        TextChanged="RuleNameChanged" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ToggleSwitch
                            x:Name="EnabledSwitch"
                            MinWidth="0"
                            AutomationProperties.AutomationId="EnabledSwitch"
                            IsOn="True"
                            OffContent=""
                            OnContent="" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind domain:Translator.Rules_Enabled, Mode=OneTime}" />
                    </StackPanel>
                </Grid>

                <!--  conditions  -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Icon="Find" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind domain:Translator.Rules_ConditionsHeader, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl x:Name="ConditionsList" ItemTemplate="{StaticResource ConditionRowTemplate}" />
                    <Button
                        AutomationProperties.AutomationId="RuleEditorViewButton4"
                        Click="AddCondition_Click"
                        Style="{StaticResource RuleAddButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Text="+" />
                            <TextBlock Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="{x:Bind domain:Translator.Rules_AddCondition, Mode=OneTime}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  actions  -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <coreControls:WinoFontIcon
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Icon="Move" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind domain:Translator.Rules_DoTheFollowing, Mode=OneTime}" />
                    </StackPanel>
                    <ItemsControl x:Name="ActionsList" ItemTemplate="{StaticResource ActionRowTemplate}" />
                    <Button
                        AutomationProperties.AutomationId="RuleEditorViewButton5"
                        Click="AddAction_Click"
                        Style="{StaticResource RuleAddButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Text="+" />
                            <TextBlock Foreground="{ThemeResource AccentFillColorDefaultBrush}" Text="{x:Bind domain:Translator.Rules_AddAction, Mode=OneTime}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <CheckBox
                    x:Name="StopProcessingCheck"
                    AutomationProperties.AutomationId="StopProcessingCheck"
                    Content="{x:Bind domain:Translator.Rules_StopProcessing, Mode=OneTime}" />

                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!--  footer  -->
        <Grid
            Grid.Row="3"
            Padding="16,8"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Button
                x:Name="DeleteButton"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="DeleteButton"
                Click="DeleteClicked"
                Content="{x:Bind domain:Translator.Rules_Delete, Mode=OneTime}"
                Visibility="Collapsed" />
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressRing
                    x:Name="BusyRing"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="CancelButton"
                    Click="CloseClicked"
                    Content="{x:Bind domain:Translator.Rules_Cancel, Mode=OneTime}" />
                <Button
                    x:Name="SaveButton"
                    MinWidth="110"
                    AutomationProperties.AutomationId="SaveButton"
                    Click="SaveClicked"
                    Content="{x:Bind domain:Translator.Rules_SaveRule, Mode=OneTime}"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
