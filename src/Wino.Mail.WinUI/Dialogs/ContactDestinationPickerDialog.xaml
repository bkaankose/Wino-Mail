<ContentDialog
    x:Class="Wino.Dialogs.ContactDestinationPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contacts="using:Wino.Core.Domain.Models.Contacts"
    xmlns:domain="using:Wino.Core.Domain"
    Title="{x:Bind domain:Translator.PeopleSettings_DestinationPicker_Title}"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel}"
    Style="{StaticResource WinoDialogStyle}">
    <ListView AutomationProperties.AutomationId="ContactDestinationPickerList" IsItemClickEnabled="True" ItemClick="ItemClicked" ItemsSource="{x:Bind Destinations}" SelectionMode="None">
        <ListView.ItemTemplate><DataTemplate x:DataType="contacts:ContactCreateDestination"><TextBlock Margin="8" Text="{x:Bind DisplayName}" /></DataTemplate></ListView.ItemTemplate>
    </ListView>
</ContentDialog>
