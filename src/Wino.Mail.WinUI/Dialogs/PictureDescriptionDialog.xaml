<ContentDialog
    x:Class="Wino.Mail.WinUI.Dialogs.PictureDescriptionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="using:Wino.Core.Domain"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Bind domain:Translator.PictureDescriptionDialog_Title, Mode=OneTime}"
    AutomationProperties.AutomationId="PictureDescriptionDialog"
    CloseButtonText="{x:Bind domain:Translator.Buttons_Cancel, Mode=OneTime}"
    DefaultButton="Primary"
    PrimaryButtonClick="SaveClicked"
    PrimaryButtonStyle="{ThemeResource AccentButtonStyle}"
    PrimaryButtonText="{x:Bind domain:Translator.Buttons_Save, Mode=OneTime}"
    Style="{StaticResource WinoDialogStyle}"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind domain:Translator.PictureDescriptionDialog_Message, Mode=OneTime}"
            TextWrapping="WrapWholeWords" />
        <TextBox
            x:Name="DescriptionTextBox"
            MinHeight="80"
            AutomationProperties.AutomationId="PictureDescriptionTextBox"
            AutomationProperties.Name="{x:Bind domain:Translator.PictureDescriptionDialog_Title, Mode=OneTime}"
            PlaceholderText="{x:Bind domain:Translator.PictureDescriptionDialog_Placeholder, Mode=OneTime}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
