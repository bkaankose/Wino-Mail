    </Page>
    <Page Update="Styles\WinoCalendarTypeSelectorControl.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\Calendar\CalendarAppShell.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Views\Calendar\CalendarPage.xaml">
      <Generator>MSBuild:Compile</Generator>
