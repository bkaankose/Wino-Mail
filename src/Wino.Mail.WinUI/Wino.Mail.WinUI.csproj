<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wino.Mail.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Visual Studio solution builds set Platform but do not set RuntimeIdentifier. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Bundle the Windows App SDK and .NET runtime into per-architecture MSIX outputs. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <UseNativeAot Condition="'$(UseNativeAot)' == ''">true</UseNativeAot>
    <PublishAot Condition="'$(WinoIsReleaseBuild)' == 'true'">$(UseNativeAot)</PublishAot>
    <PublishTrimmed Condition="'$(WinoIsReleaseBuild)' == 'true'">$(UseNativeAot)</PublishTrimmed>
    <TrimMode Condition="'$(WinoIsReleaseBuild)' == 'true'">full</TrimMode>
    <IncludePublishItemsOutputGroup Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true'">true</IncludePublishItemsOutputGroup>
    <!--
      Ical.Net 5.2.3 intentionally reflects over its RFC 5545 model and serializer types,
      MimeKit's otherwise-unused default context probes SQLite dynamically, and CsWinRT's
      generic WinRT fallback marshaler lacks the linker annotations required by IL2081.
      Wino.Mail.AI.Abstractions also carries the package-level IL3053 summary for its
      contract JSON converters; Wino serializes the concrete payloads it uses through
      generated JSON contexts.
      Wino roots Ical.Net and the explicit Windows S/MIME context below, so only these
      upstream analyzer limitations are suppressed during the whole-program AOT link.
      Ordinary Release analyzer builds remain unsuppressed and continue to reject
      first-party IL warnings.
    -->
    <NoWarn Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true'">$(NoWarn);IL2026;IL2070;IL2072;IL2075;IL2077;IL2080;IL2081;IL2087;IL3053</NoWarn>
    <Nullable>enable</Nullable>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<!-- Single instancing -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
	<NotificationHostBuildSuffix>bin\$(Platform)\$(Configuration)\net10.0-windows10.0.26100.0\$(RuntimeIdentifier)\</NotificationHostBuildSuffix>
	<NotificationHostPublishRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)$(Platform)\$(Configuration)\NotificationHosts'))</NotificationHostPublishRoot>
	<MailNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' != 'true'">$(MSBuildProjectDirectory)\..\Wino.Mail.NotificationHost\$(NotificationHostBuildSuffix)</MailNotificationHostOutput>
	<CalendarNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' != 'true'">$(MSBuildProjectDirectory)\..\Wino.Calendar.NotificationHost\$(NotificationHostBuildSuffix)</CalendarNotificationHostOutput>
	<PeopleNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' != 'true'">$(MSBuildProjectDirectory)\..\Wino.People.NotificationHost\$(NotificationHostBuildSuffix)</PeopleNotificationHostOutput>
	<TasksNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' != 'true'">$(MSBuildProjectDirectory)\..\Wino.Tasks.NotificationHost\$(NotificationHostBuildSuffix)</TasksNotificationHostOutput>
	<MailNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' == 'true'">$(NotificationHostPublishRoot)Mail\</MailNotificationHostOutput>
	<CalendarNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' == 'true'">$(NotificationHostPublishRoot)Calendar\</CalendarNotificationHostOutput>
	<PeopleNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' == 'true'">$(NotificationHostPublishRoot)People\</PeopleNotificationHostOutput>
	<TasksNotificationHostOutput Condition="'$(WinoIsReleaseBuild)' == 'true'">$(NotificationHostPublishRoot)Tasks\</TasksNotificationHostOutput>
</PropertyGroup>

