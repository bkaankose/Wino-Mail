<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>MailCal.Core</RootNamespace>
		<Platforms>x86;x64;arm64</Platforms>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<ProduceReferenceAssembly>true</ProduceReferenceAssembly>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Serilog" />
		<PackageReference Include="CommunityToolkit.Diagnostics" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="HtmlAgilityPack" />
		<PackageReference Include="HtmlKit" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Graph.Core" />
		<PackageReference Include="Microsoft.Identity.Client" />
		<PackageReference Include="Microsoft.Identity.Client.Broker" />
		<PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" />
		<PackageReference Include="MimeKit" />
		<PackageReference Include="morelinq" />
		<PackageReference Include="Nito.AsyncEx.Tasks" />
		<PackageReference Include="NodaTime" />
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\MailCal.Authentication\MailCal.Authentication.csproj" />
		<ProjectReference Include="..\MailCal.Core.Domain\MailCal.Core.Domain.csproj" />
		<ProjectReference Include="..\MailCal.Messages\MailCal.Messaging.csproj" />
		<ProjectReference Include="..\MailCal.Services\MailCal.Services.csproj" />
	</ItemGroup>
	
	<ItemGroup>
	  <Folder Include="Domain\Models\Errors\" />
	</ItemGroup>
</Project>
