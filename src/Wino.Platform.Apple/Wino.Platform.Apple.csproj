<Project Sdk="Microsoft.NET.Sdk">
  <!-- Apple platform services shared by the Mac and iOS apps: Foundation, Security (Keychain), StoreKit,
       UserNotifications and WebKit. AppKit-only services stay in Wino.Platform.MacOS; UIKit-only ones go
       to Wino.Platform.iOS. WinoTargetPlatform is not set here: the app head passes MacOS or iOS, and
       Directory.Build.targets imports the matching policy per target framework. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos;net10.0-ios</TargetFrameworks>
    <!-- An app build that passes a RuntimeIdentifier (-r osx-arm64, -r iossimulator-arm64) or a universal
         RuntimeIdentifiers list passes it to every project it restores. The other platform's target framework
         cannot restore with that RID (NU1102), so such a build only contains the target framework of the RID's platform. -->
    <TargetFrameworks Condition="$(RuntimeIdentifier.StartsWith('osx-')) or $(RuntimeIdentifiers.StartsWith('osx-'))">net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$(RuntimeIdentifier.StartsWith('ios-')) or $(RuntimeIdentifier.StartsWith('iossimulator-')) or $(RuntimeIdentifiers.StartsWith('ios'))">net10.0-ios</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Wino.Core.Domain/Wino.Core.Domain.csproj" />
    <ProjectReference Include="../Wino.Authentication/Wino.Authentication.csproj" />
    <ProjectReference Include="../Wino.Services/Wino.Services.csproj" />
    <ProjectReference Include="../Wino.Core.Apple.Bindings/Wino.Core.Apple.Bindings.csproj" />
  </ItemGroup>
</Project>
