		<ProjectReference Include="..\Wino.Services\Wino.Services.csproj" />
		<ProjectReference Include="..\Wino.Mail.ViewModels\Wino.Mail.ViewModels.csproj" />
		<ProjectReference Include="..\..\controls\Wino.Editor.Abstractions\Wino.Editor.Abstractions.csproj" />
	</ItemGroup>
	<Import Project="..\..\build\Wino.Renderer.Engine.props" />
</Project>
