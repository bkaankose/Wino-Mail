<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- The app theme: Material 3 day/night without an action bar, drawn edge to edge behind transparent system bars.
       Colours are the Wino tokens (values/colors.xml, values-night/colors.xml); dynamic colour is not applied. -->
  <style name="Theme.Wino" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/wino_accent</item>
    <item name="colorOnPrimary">@color/wino_on_accent</item>
    <item name="colorPrimaryContainer">@color/wino_accent_container</item>
    <item name="colorOnPrimaryContainer">@color/wino_accent_text</item>
    <item name="colorSecondary">@color/wino_accent</item>
    <item name="colorOnSecondary">@color/wino_on_accent</item>
    <!-- Material 3 tonal containers: navigation indicators, the checked segment and the selected drawer item. -->
    <item name="colorSecondaryContainer">@color/wino_secondary_container</item>
    <item name="colorOnSecondaryContainer">@color/wino_text_primary</item>
    <item name="colorSurface">@color/wino_zone</item>
    <item name="colorOnSurface">@color/wino_text_primary</item>
    <item name="colorOnSurfaceVariant">@color/wino_text_secondary</item>
    <item name="colorSurfaceVariant">@color/wino_surface_variant</item>
    <!-- Sheets, the bottom app bar and the action mode use the Wino zone surface rather than Material's tinted containers. -->
    <item name="colorSurfaceContainerLowest">@color/wino_zone</item>
    <item name="colorSurfaceContainerLow">@color/wino_zone</item>
    <item name="colorSurfaceContainer">@color/wino_zone</item>
    <item name="colorSurfaceContainerHigh">@color/wino_zone</item>
    <item name="colorSurfaceContainerHighest">@color/wino_surface_variant</item>
    <item name="colorOutline">@color/wino_outline</item>
    <item name="android:colorBackground">@color/wino_backdrop</item>
    <item name="android:windowBackground">@color/wino_backdrop</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">@bool/wino_light_system_bars</item>
    <item name="materialButtonStyle">@style/Widget.Wino.Button</item>
    <item name="materialButtonOutlinedStyle">@style/Widget.Wino.Button.Outlined</item>
    <!-- Material 3 small top app bar height (canvas Material pass): the contextual action mode uses it too. -->
    <item name="actionBarSize">@dimen/wino_top_bar_height</item>
    <!-- Multi-select (the mail list's contextual action mode) covers the page's app bar instead of pushing it down. -->
    <item name="windowActionModeOverlay">true</item>
    <item name="actionModeStyle">@style/Widget.WinoKit.ActionMode</item>
    <item name="actionModeBackground">@color/wino_surface_variant</item>
    <item name="actionModeCloseDrawable">@drawable/wino_ic_close</item>
    <item name="actionOverflowButtonStyle">@style/Widget.WinoKit.Overflow</item>
    <item name="floatingActionButtonStyle">@style/Widget.WinoKit.Fab</item>
    <item name="bottomNavigationStyle">@style/Widget.WinoKit.NavigationBar</item>
    <item name="navigationRailStyle">@style/Widget.WinoKit.NavigationRail</item>
  </style>

  <style name="Widget.Wino.Button" parent="Widget.Material3.Button">
    <item name="android:textAllCaps">false</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
  </style>

  <style name="Widget.Wino.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:textAllCaps">false</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:textColor">@color/wino_accent_text</item>
    <item name="strokeColor">@color/wino_outline</item>
  </style>

  <style name="Widget.Wino.Button.Text" parent="Widget.Material3.Button.TextButton">
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/wino_accent_text</item>
  </style>

  <style name="TextAppearance.Wino.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
    <item name="android:textSize">26sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/wino_text_primary</item>
  </style>

  <style name="TextAppearance.Wino.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
    <item name="android:textSize">20sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/wino_text_primary</item>
  </style>

  <style name="TextAppearance.Wino.Body" parent="TextAppearance.Material3.BodyMedium">
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/wino_text_secondary</item>
  </style>

  <style name="TextAppearance.Wino.RowTitle" parent="TextAppearance.Material3.BodyMedium">
    <item name="android:textSize">14sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/wino_text_primary</item>
  </style>

  <style name="TextAppearance.Wino.Caption" parent="TextAppearance.Material3.BodySmall">
    <item name="android:textSize">12sp</item>
    <item name="android:textColor">@color/wino_text_secondary</item>
  </style>
</resources>
