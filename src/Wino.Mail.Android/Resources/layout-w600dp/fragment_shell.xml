<?xml version="1.0" encoding="utf-8"?>
<!-- Shell, medium width (600 dp and wider, under 840 dp or under 480 dp tall: every phone in landscape; canvas board
     Landscape): a navigation rail with New mail and the four modes and the avatar at its foot, the content page in a
     360 dp list pane and the reader filling the rest. Folders stay in the modal drawer. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:id="@+id/shell_root"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="horizontal">

    <!-- A landscape phone is too short for New mail, four modes and the avatar: the rail column scrolls there. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Unlabelled: a landscape phone is too short for labelled destinations under New mail. -->
        <com.google.android.material.navigationrail.NavigationRailView
            android:id="@+id/shell_rail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="unlabeled" />

        <com.winomail.presentation.WinoIconView
            android:id="@+id/shell_rail_avatar"
            android:layout_width="@dimen/wino_m3_rail_avatar"
            android:layout_height="@dimen/wino_m3_rail_avatar"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/wino_m3_rail_gap"
            android:layout_marginBottom="@dimen/wino_m3_rail_gap"
            android:background="@drawable/shell_avatar_background"
            android:gravity="center"
            android:textColor="@color/wino_on_accent" />
      </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="@dimen/wino_shell_list_width_medium"
        android:layout_height="match_parent">

      <include layout="@layout/shell_list_host" />
    </FrameLayout>

    <include layout="@layout/shell_reader_host" />
  </LinearLayout>

  <com.google.android.material.navigation.NavigationView
      android:id="@+id/shell_navigation"
      style="@style/Widget.WinoKit.NavigationDrawer">

    <include layout="@layout/shell_menu_panel" />
  </com.google.android.material.navigation.NavigationView>
</androidx.drawerlayout.widget.DrawerLayout>
