<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar invitation card in the reader (Windows MailInvitationCard): card fill, hairline stroke, 8 dp corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/wino_card" />
  <stroke android:width="1dp" android:color="@color/wino_card_stroke" />
  <corners android:radius="@dimen/wino_radius_large" />
</shape>
