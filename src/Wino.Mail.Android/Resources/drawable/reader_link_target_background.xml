<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's link bar (Windows WinoMailRenderer LinkTargetBar): a small rounded card with a hairline stroke that
     shows the hovered or focused link's address over the bottom of the reader. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <solid android:color="@color/wino_card" />
  <stroke android:width="1dp" android:color="@color/wino_card_stroke" />
  <corners android:radius="@dimen/wino_strip_radius" />
</shape>
