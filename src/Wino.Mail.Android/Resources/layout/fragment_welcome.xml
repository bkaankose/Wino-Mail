<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome (Windows WelcomePageV2 order in the Material look): the logo, the title and the tagline, the primary get-started
     button directly under them, then the restore links under a caption. The import progress and status follow the links.
     One column of at most 560 dp, centred on wide windows and vertically in the screen; everything scrolls when the window
     is short. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcome_insets"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <com.winomail.presentation.WinoMaxWidthLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center_horizontal">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="vertical"
          android:paddingStart="@dimen/onboarding_page_padding"
          android:paddingTop="@dimen/onboarding_hero_top_padding"
          android:paddingEnd="@dimen/onboarding_page_padding"
          android:paddingBottom="@dimen/onboarding_page_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

          <com.google.android.material.imageview.ShapeableImageView
              android:id="@+id/welcome_logo"
              android:layout_width="@dimen/onboarding_logo_size"
              android:layout_height="@dimen/onboarding_logo_size"
              android:elevation="3dp"
              android:scaleType="fitCenter"
              android:src="@drawable/wino_logo"
              app:shapeAppearanceOverlay="@style/ShapeAppearance.Wino.Logo" />

          <TextView
              android:id="@+id/welcome_title"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/onboarding_hero_gap"
              android:accessibilityHeading="true"
              android:gravity="center_horizontal"
              android:textAppearance="@style/TextAppearance.Wino.HeroTitle" />

          <TextView
              android:id="@+id/welcome_description"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/wino_space_xs"
              android:gravity="center_horizontal"
              android:textAppearance="@style/TextAppearance.Wino.HeroSubtitle" />

          <com.google.android.material.button.MaterialButton
              android:id="@+id/welcome_add_account"
              style="@style/Widget.Wino.Onboarding.PrimaryButton"
              android:layout_width="match_parent"
              android:layout_marginTop="@dimen/onboarding_hero_gap" />

          <TextView
              android:id="@+id/welcome_restore_caption"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/onboarding_hero_gap"
              android:gravity="center"
              android:textAppearance="@style/TextAppearance.Wino.Caption" />

          <com.winomail.controls.WinoFlowView
              android:id="@+id/welcome_restore_links"
              android:layout_width="wrap_content"
              android:layout_gravity="center_horizontal"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/wino_space_xs">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/welcome_import_account"
                style="@style/Widget.Wino.Onboarding.TextButton"
                android:layout_width="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/welcome_import_file"
                style="@style/Widget.Wino.Onboarding.TextButton"
                android:layout_width="wrap_content" />
          </com.winomail.controls.WinoFlowView>

          <LinearLayout
              android:id="@+id/welcome_import_progress"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/onboarding_welcome_gap"
              android:orientation="vertical"
              android:visibility="gone">

            <TextView
                android:id="@+id/welcome_import_progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Wino.Caption" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/onboarding_welcome_gap"
                android:indeterminate="true" />
          </LinearLayout>

          <TextView
              android:id="@+id/welcome_status"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/onboarding_welcome_gap"
              android:accessibilityLiveRegion="polite"
              android:gravity="center"
              android:textAppearance="@style/TextAppearance.Wino.Caption"
              android:visibility="gone" />
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
  </com.winomail.presentation.WinoMaxWidthLayout>
</FrameLayout>
