<?xml version="1.0" encoding="utf-8"?>
<!-- The insert/edit link dialog body: URL, and the link text unless an image link is edited. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Wino.Compose.DialogBody"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/link_url_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/wino_compose_dialog_field_spacing">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/link_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textUri"
        android:singleLine="true" />
  </com.google.android.material.textfield.TextInputLayout>

  <com.google.android.material.textfield.TextInputLayout
      android:id="@+id/link_text_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/wino_compose_dialog_field_spacing">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/link_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:singleLine="true" />
  </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
