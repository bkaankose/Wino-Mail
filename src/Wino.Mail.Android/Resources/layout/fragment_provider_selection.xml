<?xml version="1.0" encoding="utf-8"?>
<!-- Add account (canvas Material pass board AddAccount; Windows ProviderSelectionPage): the top app bar over the
     wallpaper, then one Wino zone with the shared wizard's three steps: the provider list, the account name and colour,
     and what the account is used for. Continue sits at the bottom of the zone on the later steps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_insets"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <com.winomail.presentation.WinoMaxWidthLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

      <com.google.android.material.appbar.MaterialToolbar
          android:id="@+id/onboarding_toolbar"
          style="@style/Widget.Wino.Onboarding.TopBar" />

      <com.winomail.presentation.WinoZoneLayout
          style="@style/Widget.Wino.Onboarding.Zone"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

          <androidx.core.widget.NestedScrollView
              android:id="@+id/provider_scroll"
              android:layout_width="match_parent"
              android:layout_height="0dp"
              android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

              <TextView
                  android:id="@+id/provider_subtitle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:paddingStart="@dimen/onboarding_content_padding"
                  android:paddingTop="16dp"
                  android:paddingEnd="@dimen/onboarding_content_padding"
                  android:paddingBottom="8dp"
                  android:textAppearance="@style/TextAppearance.Wino.ListSupporting" />

              <!-- Step 1: providers (rows from onboarding_provider_row). -->
              <LinearLayout
                  android:id="@+id/provider_step"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/provider_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

              </LinearLayout>

              <!-- Step 2: account name and colour. -->
              <LinearLayout
                  android:id="@+id/identity_step"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:paddingStart="@dimen/onboarding_content_padding"
                  android:paddingEnd="@dimen/onboarding_content_padding">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/identity_name_layout"
                    style="@style/Widget.Wino.Onboarding.TextField">

                  <com.google.android.material.textfield.TextInputEditText
                      android:id="@+id/identity_name"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:imeOptions="actionDone"
                      android:inputType="textCapWords"
                      android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/identity_color_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textAppearance="@style/TextAppearance.Wino.SectionLabel" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                  <LinearLayout
                      android:id="@+id/identity_colors"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/identity_color_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Wino.Caption" />
              </LinearLayout>

              <!-- Step 3: what the account is used for, and the mail download range. -->
              <LinearLayout
                  android:id="@+id/capability_step"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical">

                <include
                    android:id="@+id/capability_mail"
                    layout="@layout/onboarding_capability_row" />

                <include
                    android:id="@+id/capability_calendar"
                    layout="@layout/onboarding_capability_row" />

                <include
                    android:id="@+id/capability_contacts"
                    layout="@layout/onboarding_capability_row" />

                <include
                    android:id="@+id/capability_tasks"
                    layout="@layout/onboarding_capability_row" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/onboarding_content_padding"
                    android:paddingEnd="@dimen/onboarding_content_padding">

                  <com.google.android.material.textfield.TextInputLayout
                      android:id="@+id/capability_range_layout"
                      style="@style/Widget.Wino.Onboarding.Dropdown">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/capability_range"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                  </com.google.android.material.textfield.TextInputLayout>

                  <TextView
                      android:id="@+id/capability_range_warning"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="8dp"
                      android:textAppearance="@style/TextAppearance.Wino.Caption"
                      android:textColor="@color/wino_critical" />

                  <TextView
                      android:id="@+id/capability_hint"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="12dp"
                      android:textAppearance="@style/TextAppearance.Wino.Caption" />

                  <TextView
                      android:id="@+id/capability_missing"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="12dp"
                      android:accessibilityLiveRegion="polite"
                      android:textAppearance="@style/TextAppearance.Wino.Caption"
                      android:textColor="@color/wino_critical" />
                </LinearLayout>
              </LinearLayout>
            </LinearLayout>
          </androidx.core.widget.NestedScrollView>

          <LinearLayout
              android:id="@+id/provider_actions"
              style="@style/Widget.Wino.Onboarding.ActionBar">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/provider_continue"
                style="@style/Widget.Wino.Onboarding.PrimaryButton.Small"
                android:layout_width="wrap_content" />
          </LinearLayout>
        </LinearLayout>
      </com.winomail.presentation.WinoZoneLayout>
    </LinearLayout>
  </com.winomail.presentation.WinoMaxWidthLayout>
</FrameLayout>
