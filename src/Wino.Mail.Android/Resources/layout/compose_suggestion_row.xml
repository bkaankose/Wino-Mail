<?xml version="1.0" encoding="utf-8"?>
<!-- One recipient suggestion (Mac and iOS ComposeRecipientSuggestionList rows): avatar, name, and the address or a list's
     member count with the source. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Wino.Compose.SuggestionRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

  <com.winomail.controls.WinoContactPicture
      android:id="@+id/suggestion_picture"
      android:layout_width="@dimen/wino_compose_suggestion_avatar"
      android:layout_height="@dimen/wino_compose_suggestion_avatar"
      android:layout_marginEnd="@dimen/wino_compose_suggestion_avatar_margin"
      android:importantForAccessibility="no" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@+id/suggestion_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Wino.Body"
        android:textColor="@color/wino_text_primary" />

    <TextView
        android:id="@+id/suggestion_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Wino.Caption" />
  </LinearLayout>
</LinearLayout>
