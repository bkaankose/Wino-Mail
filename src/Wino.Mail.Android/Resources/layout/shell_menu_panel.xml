<?xml version="1.0" encoding="utf-8"?>
<!-- The navigation pane content (modal Material 3 drawer on compact and medium widths, pinned pane on expanded; canvas
     Material pass Mailboxes): the drawer items starting with New mail (accounts show their own synchronization), then
     Settings at the foot, or on expanded widths the labelled mode switcher card, which carries Settings itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/shell_menu"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:paddingTop="@dimen/wino_m3_drawer_list_padding_top"
      android:paddingBottom="@dimen/wino_space_s" />

  <FrameLayout
      android:id="@+id/shell_panel_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingBottom="@dimen/wino_space_s" />

  <LinearLayout
      android:id="@+id/shell_mode_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="72dp"
      android:layout_margin="@dimen/wino_space_s"
      android:background="@drawable/wino_zone_background"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="@dimen/wino_space_2xs"
      android:paddingTop="@dimen/wino_space_s"
      android:paddingEnd="@dimen/wino_space_2xs"
      android:paddingBottom="@dimen/wino_space_s"
      android:visibility="gone" />
</LinearLayout>
