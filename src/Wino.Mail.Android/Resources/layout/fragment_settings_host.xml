<?xml version="1.0" encoding="utf-8"?>
<!-- Settings, compact width: a Material 3 small top app bar (Back, the 22 sp page title,
     search on the root list) over the theme wallpaper, then one Wino zone holding a plain Material 3 preference list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <FrameLayout
      android:id="@+id/settings_bar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <com.winomail.presentation.WinoBarBackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/wino_top_app_bar_height"
        android:background="@android:color/transparent"
        app:titleTextAppearance="@style/TextAppearance.WinoKit.TopAppBarTitle" />
  </FrameLayout>

  <com.winomail.presentation.WinoZoneLayout
      android:id="@+id/settings_detail_zone"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:layout_marginStart="@dimen/wino_zone_gutter"
      android:layout_marginEnd="@dimen/wino_zone_gutter"
      android:layout_marginBottom="@dimen/wino_zone_gutter">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings_detail_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
  </com.winomail.presentation.WinoZoneLayout>
</LinearLayout>
