<?xml version="1.0" encoding="utf-8"?>
<!-- Address-first Add account (Windows AccountSetupPage): the top app bar over the wallpaper, then one Wino zone with a
     scrolling column (the account pill with Change, the step's question and description, the step, the advanced and local setup links) and
     Back with the step's primary action at the zone's foot. The page fills the step container from the shared ViewModel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_insets"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <com.winomail.presentation.WinoMaxWidthLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

      <com.google.android.material.appbar.MaterialToolbar
          android:id="@+id/onboarding_toolbar"
          style="@style/Widget.Wino.Onboarding.TopBar" />

      <com.winomail.presentation.WinoZoneLayout
          style="@style/Widget.Wino.Onboarding.Zone"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

          <androidx.core.widget.NestedScrollView
              android:id="@+id/setup_page_scroll"
              android:layout_width="match_parent"
              android:layout_height="0dp"
              android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/onboarding_page_padding"
                android:paddingTop="@dimen/account_setup_page_top_padding"
                android:paddingEnd="@dimen/onboarding_page_padding"
                android:paddingBottom="@dimen/onboarding_page_padding">

              <!-- The account so far: one pill, with Change beside it. -->
              <LinearLayout
                  android:id="@+id/setup_page_known_row"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center_horizontal"
                  android:layout_marginBottom="@dimen/account_setup_section_gap"
                  android:gravity="center_vertical"
                  android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/setup_page_known_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp">

                  <com.winomail.presentation.WinoIconView
                      android:id="@+id/setup_page_known_icon"
                      android:layout_width="32dp"
                      android:layout_height="32dp" />

                  <LinearLayout
                      android:layout_width="0dp"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="10dp"
                      android:layout_weight="1"
                      android:orientation="vertical">

                    <TextView
                        android:id="@+id/setup_page_known_identity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Wino.ListTitle" />

                    <LinearLayout
                        android:id="@+id/setup_page_known_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                  </LinearLayout>

                  <com.google.android.material.progressindicator.CircularProgressIndicator
                      android:id="@+id/setup_page_known_progress"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginStart="8dp"
                      android:indeterminate="true"
                      android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setup_page_change"
                    style="@style/Widget.Wino.Onboarding.TextButton.Small"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="4dp" />
              </LinearLayout>

              <!-- The address step shows the Wino Mail logo; no other step has one. -->
              <ImageView
                  android:id="@+id/setup_page_logo"
                  android:layout_width="@dimen/onboarding_logo_size"
                  android:layout_height="@dimen/onboarding_logo_size"
                  android:layout_gravity="center_horizontal"
                  android:layout_marginBottom="8dp"
                  android:importantForAccessibility="no"
                  android:scaleType="fitCenter"
                  android:src="@drawable/wino_logo" />

              <TextView
                  android:id="@+id/setup_page_title"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:accessibilityHeading="true"
                  android:gravity="center_horizontal"
                  android:textAppearance="@style/TextAppearance.Wino.Headline" />

              <TextView
                  android:id="@+id/setup_page_subtitle"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:gravity="center_horizontal"
                  android:textAppearance="@style/TextAppearance.Wino.ListSupporting" />

              <!-- The current step, built from the shared ViewModel. -->
              <LinearLayout
                  android:id="@+id/setup_page_step"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/account_setup_section_gap"
                  android:orientation="vertical" />

              <!-- Advanced setup and Local account setup (address step only). -->
              <LinearLayout
                  android:id="@+id/setup_page_links"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center_horizontal"
                  android:layout_marginTop="@dimen/account_setup_section_gap"
                  android:gravity="center_vertical"
                  android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setup_page_advanced"
                    style="@style/Widget.Wino.Onboarding.TextButton.Small"
                    android:layout_width="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/setup_page_local"
                    style="@style/Widget.Wino.Onboarding.TextButton.Small"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="4dp" />

                <com.winomail.presentation.WinoIconView
                    android:id="@+id/setup_page_local_info"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true" />
              </LinearLayout>
            </LinearLayout>
          </androidx.core.widget.NestedScrollView>

          <!-- Back, then the step's action: Set up manually while discovery runs, the provider's sign-in on the review of
               Gmail, Outlook and modern-auth Exchange, otherwise the primary button. -->
          <LinearLayout
              android:id="@+id/onboarding_actions"
              style="@style/Widget.Wino.Onboarding.ActionBar">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setup_page_back"
                style="@style/Widget.Wino.Onboarding.TextButton.Small"
                android:layout_width="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setup_page_cancel_discovery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/wino_pill_button_height_small" />

            <FrameLayout
                android:id="@+id/setup_page_social_host"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/setup_page_primary"
                style="@style/Widget.Wino.Onboarding.PrimaryButton.Small"
                android:layout_width="wrap_content" />
          </LinearLayout>
        </LinearLayout>
      </com.winomail.presentation.WinoZoneLayout>
    </LinearLayout>
  </com.winomail.presentation.WinoMaxWidthLayout>
</FrameLayout>
