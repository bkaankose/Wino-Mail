<Project>
	<!-- Windows runtime defaults, imported by Directory.Build.props when WinoTargetPlatform is Windows. -->
	<PropertyGroup>
		<!-- The SDK's default projection (10.0.26100.55) cannot marshal generic results of the window-handle interop
		     helpers under Native AOT: UserConsentVerifierInterop (Windows Hello) throws NotSupportedException. -->
		<WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
	</PropertyGroup>
	<PropertyGroup Condition="'$(WinoIsReleaseBuild)' == 'true'">
		<!-- Bundle inner builds and their references need matching restore/runtime inputs. -->
		<RuntimeIdentifiers Condition="'$(RuntimeIdentifier)' == ''">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<!-- Bundle inner builds select Platform but do not propagate the app publish profile to project references. -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
	</PropertyGroup>
</Project>
