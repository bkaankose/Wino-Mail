<Project>
  <!-- macOS build policy, imported by Directory.Build.targets when WinoTargetPlatform is MacOS. -->

  <!-- The AppKit libraries stay outside the shared Release analyzer gate. The app itself is published with
       Native AOT in Release (Wino.Mail.MacOS.csproj); Debug runs on CoreCLR. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-macos')) and '$(OutputType)' != 'Exe'">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <!--
    Native AOT link warnings, as in Wino.Windows.targets and Wino.Linux.targets. A trim or AOT warning fails the
    publish, and every assembly reports each warning in detail. Ical.Net and the EWS client
    (Exchange.WebServices.NETCore) alone report a single summary warning, and only that summary code is ignored:
    both reflect over their own models, and both whole assemblies are rooted here so the reflected members are
    preserved. Do not add IL codes to NoWarn.
  -->
  <PropertyGroup Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true' and '$(OutputType)' == 'Exe'">
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true' and '$(OutputType)' == 'Exe'">
    <TrimmerRootAssembly Include="Ical.Net" />
    <TrimmerRootAssembly Include="Exchange.WebServices.NETCore" />
  </ItemGroup>

  <Target Name="WinoCollapseUpstreamTrimWarnings"
          AfterTargets="PrepareForILLink"
          Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true' and '$(OutputType)' == 'Exe'">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Ical.Net' or '%(Filename)' == 'Exchange.WebServices.NETCore'">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>
</Project>
