<Project>
  <!-- macOS build policy, imported by Directory.Build.targets when WinoTargetPlatform is MacOS. -->

  <!-- Native AppKit uses the macOS workload's managed runtime for the foundation.
       The portable libraries and Windows release retain their AOT analyzer gates. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
    <IsAotCompatible>false</IsAotCompatible>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
</Project>
