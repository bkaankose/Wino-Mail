<Project>
  <!--
    The native mail renderer is referenced from a local checkout by absolute path until it ships as a package.
    WINO_RENDERER_ROOT (environment) or -p:WinoRendererRoot names the checkout; Windows falls back to the maintainer's
    default path. A value given on the command line cannot be changed here, so the trailing slash goes into a property
    of its own.
  -->
  <PropertyGroup Condition="'$(WinoRendererRootImported)' != 'true'">
    <WinoRendererRootImported>true</WinoRendererRootImported>
    <WinoRendererRoot Condition="'$(WinoRendererRoot)' == '' and '$(WINO_RENDERER_ROOT)' != ''">$(WINO_RENDERER_ROOT)</WinoRendererRoot>
    <WinoRendererRoot Condition="'$(WinoRendererRoot)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">D:\Wino-Mail-Renderer.worktrees\wino-integration</WinoRendererRoot>
    <WinoRendererDirectory Condition="'$(WinoRendererRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(WinoRendererRoot)'))</WinoRendererDirectory>
  </PropertyGroup>

  <Target Name="WinoRendererRootRequired" BeforeTargets="ResolveProjectReferences;_CheckForInvalidConfigurationAndPlatform" Condition="'$(WinoRendererRoot)' == ''">
    <Error Text="The native mail renderer checkout is not set. Set the WINO_RENDERER_ROOT environment variable or pass -p:WinoRendererRoot=&lt;path to the Wino-Mail-Renderer checkout&gt;." />
  </Target>
</Project>
