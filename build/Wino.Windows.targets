<Project>
  <!-- Windows build policy, imported by Directory.Build.targets when WinoTargetPlatform is Windows:
       CsWinRT AOT settings, WinUI head warnings, and MSIX payload handling. -->

  <PropertyGroup Condition="'$(WinoIsReleaseBuild)' == 'true' and $(TargetFramework.Contains('-windows'))">
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <!-- Level 3 is the strictest CsWinRT level: it adds trim/AOT checks on casts to WinRT runtime classes. -->
    <CsWinRTAotWarningLevel>3</CsWinRTAotWarningLevel>
    <EnableBindingDiagnostics>true</EnableBindingDiagnostics>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Wino.Mail.WinUI'">
    <!-- WinAppSDK experimental-channel generated code references experimental WinUI APIs. -->
    <NoWarn>$(NoWarn);CS8305</NoWarn>
    <!-- Generated XamlTypeInfo.g.cs registers obsolete WinAppSDK members (for example Icon); keep them as warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Native AOT link warnings. ILC fails the build on any warning through TreatWarningsAsErrors, so
    every assembly reports each trim and AOT warning in detail. Ical.Net alone reports a single
    summary warning, and only that summary code is ignored: it reflects over its RFC 5545 model and
    serializers, and Wino roots the whole assembly (TrimmerRootAssembly in the WinUI project), so
    the reflected members are preserved. Assemblies that declare themselves trimmable always
    report in detail. No other assembly collapses to a summary, so a new first-party or package
    warning still fails the build. Do not add IL codes to NoWarn.
  -->
  <PropertyGroup Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true'">
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <Target Name="WinoCollapseUpstreamTrimWarnings"
          AfterTargets="PrepareForILLink"
          Condition="'$(WinoIsReleaseBuild)' == 'true' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' == 'Ical.Net'">
        <TrimmerSingleWarn>true</TrimmerSingleWarn>
      </ManagedAssemblyToLink>
    </ItemGroup>
  </Target>

  <!--
    The MSIX targets can retain both a pre-link CopyLocal item and its Native AOT
    publish replacement. Prefer the publish item for every colliding package path;
    non-colliding XAML, PRI, manifest, and Windows App SDK payload items are untouched.
  -->
  <Target Name="WinoPreferNativeAotPublishPayload"
          AfterTargets="WinAppSdkRemoveLinkedFilesFromPayload"
          BeforeTargets="_ComputeAppxPackagePayload"
          Condition="'$(MSBuildProjectName)' == 'Wino.Mail.WinUI' and '$(PublishAot)' == 'true' and '$(IncludePublishItemsOutputGroup)' == 'true'">
    <PropertyGroup>
      <_WinoNativeAotLinkedOutputRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)linked\'))</_WinoNativeAotLinkedOutputRoot>
      <_WinoNativeAotExecutable>$(OutputPath)native\$(TargetName).exe</_WinoNativeAotExecutable>
    </PropertyGroup>
    <ItemGroup>
      <_WinoNativeAotPublishPayload Include="@(PackagingOutputs)"
                                    Condition="'%(OutputGroup)' == 'PublishItemsOutputGroupOutput'" />
      <PackagingOutputs Remove="@(_WinoNativeAotPublishPayload)"
                        MatchOnMetadata="TargetPath"
                        MatchOnMetadataOptions="PathLike" />
      <PackagingOutputs Include="@(_WinoNativeAotPublishPayload)" />
      <_WinoNativeAotPublishPayload Remove="@(_WinoNativeAotPublishPayload)" />

      <!--
        CallTarget isolates ILC's item lists on .NET 10, so also filter by the
        metadata/path that survives into PackagingOutputs. Native runtime assets
        (WinAppSDK, WebView2, SQLite, MSAL) have no NearestTargetFramework.
      -->
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="'%(PackagingOutputs.Extension)' == '.dll' and '%(PackagingOutputs.NearestTargetFramework)' != ''" />
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="'%(PackagingOutputs.Extension)' == '.dll' and $([System.String]::Copy('%(PackagingOutputs.FullPath)').Contains('\lib\net'))" />
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="$([System.String]::Copy('%(PackagingOutputs.FullPath)').Contains('\microsoft.netcore.app.runtime.win-'))" />

      <!-- The linked directory contains IL inputs to ILC, never Native AOT runtime payload. -->
      <PackagingOutputs Remove="@(PackagingOutputs)"
                        Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_WinoNativeAotLinkedOutputRoot)'))" />

      <!-- .NET 10 does not surface the ILC executable in ResolvedFileToPublish for this WinUI app. -->
      <PackagingOutputs Include="$(_WinoNativeAotExecutable)" Condition="Exists('$(_WinoNativeAotExecutable)')">
        <TargetPath>$(TargetName).exe</TargetPath>
        <OutputGroup>PublishItemsOutputGroupOutput</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
      </PackagingOutputs>
    </ItemGroup>
  </Target>
</Project>
