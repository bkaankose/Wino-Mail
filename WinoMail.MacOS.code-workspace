{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "dotnet.defaultSolution": "WinoMail.MacOS.slnx"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Wino Mail (macOS, arm64)",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder}/src/Wino.Mail.MacOS/Wino.Mail.MacOS.csproj",
          "-c",
          "Debug",
          "-r",
          "osx-arm64",
          "-p:WinoTargetRuntimeIdentifier=osx-arm64",
          "-p:WinoTargetPlatform=MacOS",
          "-p:EnableWindowsTargeting=true"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Build Wino Mail (macOS, x64)",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "${workspaceFolder}/src/Wino.Mail.MacOS/Wino.Mail.MacOS.csproj",
          "-c",
          "Debug",
          "-r",
          "osx-x64",
          "-p:WinoTargetRuntimeIdentifier=osx-x64",
          "-p:WinoTargetPlatform=MacOS",
          "-p:EnableWindowsTargeting=true"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "problemMatcher": "$msCompile"
      },
      {
        "label": "Prepare Wino Mail macOS debugger",
        "type": "process",
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/scripts/maintenance/macos/setup-macos-debugger.sh"
        ],
        "problemMatcher": []
      },
      {
        "label": "Prepare and build Wino Mail (macOS, arm64)",
        "dependsOrder": "sequence",
        "dependsOn": [
          "Prepare Wino Mail macOS debugger",
          "Build Wino Mail (macOS, arm64)"
        ],
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Wino Mail (macOS, arm64)",
        "type": "coreclr",
        "request": "launch",
        "justMyCode": true,
        "pipeTransport": {
          "pipeProgram": "/bin/zsh",
          "pipeArgs": [
            "-c",
            "${debuggerCommand}"
          ],
          "debuggerPath": "${env:HOME}/.local/share/wino-vsdbg/vsdbg",
          "pipeEnv": {
            "TMPDIR": "${env:HOME}/Library/Containers/com.winomail.macos/Data/tmp"
          },
          "quoteArgs": false
        },
        "preLaunchTask": "Prepare and build Wino Mail (macOS, arm64)",
        "program": "${workspaceFolder}/src/Wino.Mail.MacOS/bin/Debug/net10.0-macos/osx-arm64/Wino Mail.app/Contents/MacOS/Wino.Mail.MacOS",
        "cwd": "${workspaceFolder}",
        "args": [],
        "stopAtEntry": false,
        "console": "internalConsole",
        "env": {
          "DOTNET_EnableDiagnostics": "1",
          "TMPDIR": "${env:HOME}/Library/Containers/com.winomail.macos/Data/tmp"
        },
        "requireExactSource": true
      }
    ]
  }
}
